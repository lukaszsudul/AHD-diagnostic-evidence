+#!/usr/bin/env python3
+"""Static C2 contract checks; reads Git/source only and never accesses hardware."""
+from __future__ import annotations
+
+import re
+import subprocess
+import unittest
+from pathlib import Path
+
+BASE = "20c3323d79d3896edc586d6db1df7deee60f9e41"
+REL = "rtl/nvp/nvp6134c_i2c_bringup.vhd"
+ROOT = Path(__file__).resolve().parents[2]
+SOURCE = (ROOT / REL).read_text(encoding="utf-8")
+BASE_SOURCE = subprocess.run(
+    ["git", "-C", str(ROOT), "show", f"{BASE}:{REL}"],
+    check=True,
+    stdout=subprocess.PIPE,
+    text=True,
+    encoding="utf-8",
+).stdout
+
+
+def block(text: str, start: str, end: str) -> str:
+    left = text.index(start)
+    right = text.index(end, left)
+    return text[left:right]
+
+
+def state_body(text: str, start: str, end: str) -> str:
+    """Select the main FSM occurrence, after any decoder/predicate occurrence."""
+    left = text.rindex(start)
+    right = text.index(end, left)
+    return text[left:right]
+
+
+class CandidateBContractTests(unittest.TestCase):
+    def test_exact_frozen_ordinary_high_set(self) -> None:
+        function = block(
+            SOURCE,
+            "function is_ordinary_protocol_high",
+            "end function;",
+        )
+        true_clause = re.search(
+            r"case\s+s\s+is\s+when\s+(.*?)\s*=>\s*return\s+true;",
+            function,
+            re.DOTALL,
+        )
+        self.assertIsNotNone(true_clause)
+        states = set(re.findall(r"\b[A-Z][A-Z0-9_]*\b", true_clause.group(1)))
+        self.assertEqual(states, {
+            "START_W_A", "START_W_B", "SEND_W_HIGH", "ACK_W_HIGH",
+            "SEND_REG_HIGH", "ACK_REG_HIGH", "SEND_DATA_HIGH", "ACK_DATA_HIGH",
+            "REP_HIGH", "REP_START_A", "SEND_R_HIGH", "ACK_R_HIGH",
+            "READ_HIGH", "MASTER_NACK_HIGH",
+        })
+        self.assertNotIn("STOP_B", function)
+        self.assertNotIn("STOP_C", function)
+
+    def test_requires_scl_high_predicate_is_exact_base(self) -> None:
+        self.assertEqual(
+            block(SOURCE, "function requires_scl_high", "end function;"),
+            block(BASE_SOURCE, "function requires_scl_high", "end function;"),
+        )
+
+    def test_divider_only_removes_scl_stall_for_exact_set(self) -> None:
+        divider = block(SOURCE, "tick <= '1'", "-- R1i reuses")
+        self.assertIn("not is_ordinary_protocol_high(state)", divider)
+        self.assertIn("scl_filtered_r = '0'", divider)
+        self.assertEqual(divider.count("is_ordinary_protocol_high"), 1)
+
+    def test_endpoint_low_reuses_existing_deadline_and_recovery(self) -> None:
+        guard = "(is_ordinary_protocol_high(state) and tick = '1')"
+        self.assertEqual(SOURCE.count(guard), 2)
+        self.assertEqual(SOURCE.count("constant C_SCL_TIMEOUT_CYCLES"), 1)
+        self.assertIn("state <= ABORT_HIGH_RECOVERY;", SOURCE)
+        self.assertNotIn("C_R1I_B", SOURCE)
+
+    def test_ack_and_read_bodies_are_exact_base(self) -> None:
+        anchors = [
+            ("when ACK_W_HIGH =>", "when SEND_REG_LOW =>"),
+            ("when ACK_REG_HIGH =>", "when SEND_DATA_LOW =>"),
+            ("when ACK_DATA_HIGH =>", "when REP_LOW =>"),
+            ("when ACK_R_HIGH =>", "when READ_LOW =>"),
+            ("when READ_HIGH =>", "when MASTER_NACK_LOW =>"),
+        ]
+        for start, end in anchors:
+            self.assertEqual(state_body(SOURCE, start, end), state_body(BASE_SOURCE, start, end))
+
+    def test_non_ack_ordinary_high_bodies_are_exact_base(self) -> None:
+        anchors = [
+            ("when START_W_A =>", "when START_W_B =>"),
+            ("when START_W_B =>", "when SEND_W_LOW =>"),
+            ("when SEND_W_HIGH =>", "when ACK_W_LOW =>"),
+            ("when SEND_REG_HIGH =>", "when ACK_REG_LOW =>"),
+            ("when SEND_DATA_HIGH =>", "when ACK_DATA_LOW =>"),
+            ("when REP_HIGH =>", "when REP_START_A =>"),
+            ("when REP_START_A =>", "when REP_START_B =>"),
+            ("when SEND_R_HIGH =>", "when ACK_R_LOW =>"),
+            ("when MASTER_NACK_HIGH =>", "when STOP_A =>"),
+        ]
+        for start, end in anchors:
+            self.assertEqual(state_body(SOURCE, start, end), state_body(BASE_SOURCE, start, end))
+
+    def test_stop_abort_busfree_retry_and_bank_bodies_are_exact_base(self) -> None:
+        anchors = [
+            ("when STOP_B =>", "when STOP_C =>"),
+            ("when STOP_C =>", "when ABORT_RELEASE =>"),
+            ("when ABORT_RELEASE =>", "when ABORT_HIGH_RECOVERY =>"),
+            ("when ABORT_HIGH_RECOVERY =>", "when BUS_FREE =>"),
+            ("when BUS_FREE =>", "when STORE_RESULT =>"),
+            ("when RETRY_BACKOFF =>", "when RETRY_START =>"),
+            ("when RETRY_START =>", "when FINISH =>"),
+        ]
+        for start, end in anchors:
+            self.assertEqual(state_body(SOURCE, start, end), state_body(BASE_SOURCE, start, end))
+        self.assertEqual(
+            block(SOURCE, "if r1f_after_check_pending_r", "if start = '1'"),
+            block(BASE_SOURCE, "if r1f_after_check_pending_r", "if start = '1'"),
+        )
+
+    def test_frozen_state_encoding_filters_decoder_and_abi(self) -> None:
+        for start, end in [
+            ("type t_state is", "type t_phase is"),
+            ("process(state, byte_tx", "gen_nack_log"),
+            ("process(clk)\n  begin\n    if rising_edge(clk) then\n      if rst = '1' then\n        sda_sync_r", "tick <= '1'"),
+            ("r1i_poc_telemetry_dbg <=", "-- Same open-drain phase decoder"),
+        ]:
+            self.assertEqual(block(SOURCE, start, end), block(BASE_SOURCE, start, end))
+
+    def test_no_candidate_a_selected_sample_latch(self) -> None:
+        lowered = SOURCE.lower()
+        for forbidden in (
+            "selected_ack", "ack_selected", "ack_sample_valid",
+            "selected sample latch", "first_high_ack",
+        ):
+            self.assertNotIn(forbidden, lowered)
+
+    def test_only_allowlisted_source_and_isolated_tests_differ(self) -> None:
+        names = subprocess.run(
+            ["git", "-C", str(ROOT), "status", "--porcelain", "--untracked-files=all"],
+            check=True,
+            stdout=subprocess.PIPE,
+            text=True,
+            encoding="utf-8",
+        ).stdout.splitlines()
+        allowed_prefix = "research_tests/r1i_b/"
+        for entry in names:
+            path = entry[3:].replace("\\", "/")
+            self.assertTrue(path == REL or path.startswith(allowed_prefix), path)
+        production_build = (ROOT / "scripts/v41/r1i_build.tcl").read_text(encoding="utf-8")
+        self.assertNotIn("research_tests", production_build)
+
+
+if __name__ == "__main__":
+    unittest.main(verbosity=2)
