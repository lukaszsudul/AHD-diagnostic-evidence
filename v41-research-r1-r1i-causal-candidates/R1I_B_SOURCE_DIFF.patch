+    if($LASTEXITCODE -ne 0) { throw "$Label failed with exit $LASTEXITCODE" }
+}
+Push-Location $simRoot
+try {
+    Invoke-SimTool xvlog (@('--sv','--work','work') +
+        ($inputs | ForEach-Object { Join-Path $RepoRoot $_ })) 'mmio_compile'
+    foreach($case in @(
+        @{Top='tb_r1i_poc_mmio';Marker='R1I_POC_MMIO_PASS'},
+        @{Top='tb_r1h_mmio_read_service';Marker='R1H_MMIO_READ_SERVICE_PASS'},
+        @{Top='tb_r1h_mmio_integration_exhaustive';Marker='R1H_MMIO_INTEGRATION_EXHAUSTIVE_PASS'}
+    )) {
+        $snapshot="$($case.Top)_candidate_b"
+        Invoke-SimTool xelab @("work.$($case.Top)",'-s',$snapshot,'--debug','typical','--relax') "$snapshot`_elaborate"
