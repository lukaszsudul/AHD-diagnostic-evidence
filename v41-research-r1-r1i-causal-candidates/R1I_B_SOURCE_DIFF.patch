+}
+$localTemp=Join-Path $EvidenceRoot 'temp'
+[void][IO.Directory]::CreateDirectory($localTemp)
+$env:XILINX_LOCAL_USER_DATA='NO'
+$env:XILINX_TCLAPP_REPO='C:/AMDDesignTools/2025.2/Vivado/data/XilinxTclStore'
+$env:TEMP=$localTemp
+$env:TMP=$localTemp
