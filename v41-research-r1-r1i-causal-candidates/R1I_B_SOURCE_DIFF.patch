+++ b/research_tests/r1i_b/run_inherited_r1i_with_env.ps1
@@ -0,0 +1,26 @@
+[CmdletBinding()]
+param(
+    [Parameter(Mandatory)][string]$RepoRoot,
+    [Parameter(Mandatory)][string]$EvidenceRoot,
+    [string]$ReferenceRoot='V:\WORKTREES\V41_NVP_R1H_BRAM_BACKED_LARGE_SAMPLE'
+)
+$ErrorActionPreference='Stop'
+Set-StrictMode -Version Latest
+foreach($path in @($RepoRoot,$EvidenceRoot,$ReferenceRoot)) {
+    if($path -notmatch '^[A-Za-z]:\\[\x20-\x7e]+$' -or $path -match '["&|<>^%!]') {
