diff --git a/research_tests/r1i_b/run_r1i_b_focused_sim.ps1 b/research_tests/r1i_b/run_r1i_b_focused_sim.ps1
new file mode 100644
index 0000000000000000000000000000000000000000..f2af130dbdc75e6843b8d3c7cfbe8b31fbb71096
--- /dev/null
+++ b/research_tests/r1i_b/run_r1i_b_focused_sim.ps1
@@ -0,0 +1,82 @@
+[CmdletBinding()]
+param(
+    [Parameter(Mandatory)][string]$RepoRoot,
+    [Parameter(Mandatory)][string]$EvidenceRoot,
+    [string]$ReferenceRoot='V:\WORKTREES\V41_NVP_R1H_BRAM_BACKED_LARGE_SAMPLE',
+    [string]$VivadoBin='C:\AMDDesignTools\2025.2\Vivado\bin'
+)
+$ErrorActionPreference='Stop'
+Set-StrictMode -Version Latest
+foreach($path in @($RepoRoot,$EvidenceRoot)) {
+    if($path -notmatch '^[A-Za-z]:\\[\x20-\x7e]+$' -or $path -match '["&|<>^%!]') {
+        throw 'Candidate-B simulation paths must be absolute local ASCII paths without shell metacharacters'
+    }
+}
+$referenceCommit=(& git --no-optional-locks -c "safe.directory=$ReferenceRoot" -C $ReferenceRoot rev-parse HEAD).Trim()
+$referenceTree=(& git --no-optional-locks -c "safe.directory=$ReferenceRoot" -C $ReferenceRoot rev-parse 'HEAD^{tree}').Trim()
+if($referenceCommit -ne 'c4f4bfcf577c92c3021d1fe83c05878dd12e001c' -or
+   $referenceTree -ne '161e561f007912d73dba93c5ecd78e3cc3a6955b' -or
+   (& git --no-optional-locks -c "safe.directory=$ReferenceRoot" -C $ReferenceRoot status --porcelain)) {
+    throw 'Immutable R1h test reference identity/cleanliness mismatch'
+}
+$simRoot=Join-Path $EvidenceRoot 'candidate_b_focused'
+[void][IO.Directory]::CreateDirectory($simRoot)
+$localTemp=Join-Path $EvidenceRoot 'temp'
+[void][IO.Directory]::CreateDirectory($localTemp)
+$inputs=@(
+    'rtl/nvp/nvp6134c_diagnostics_pkg.vhd',
+    'rtl/nvp/r1f_transaction_serial_counter.vhd',
+    'rtl/nvp/nvp6134c_i2c_bringup.vhd',
+    'tests/v41/r1i_master_test_adapter.vhd',
+    'research_tests/r1i_b/tb_r1i_b_c2.sv'
+)
+$inputHashes=@{}
+foreach($input in $inputs) {
+    $hash=(Get-FileHash -Algorithm SHA256 -LiteralPath (Join-Path $RepoRoot $input)).Hash
+    $inputHashes[$input]=$hash
+    Write-Output "TEST_INPUT_SHA256=$hash $input"
+}
+function Invoke-SimTool([string]$Tool,[string[]]$Arguments,[string]$Label) {
+    $env:XILINX_LOCAL_USER_DATA='NO'
+    $env:XILINX_TCLAPP_REPO='C:/AMDDesignTools/2025.2/Vivado/data/XilinxTclStore'
+    $env:TEMP=$localTemp
+    $env:TMP=$localTemp
+    Write-Output "SIM_ENV=$Label XILINX_LOCAL_USER_DATA=$($env:XILINX_LOCAL_USER_DATA) XILINX_TCLAPP_REPO=$($env:XILINX_TCLAPP_REPO) TEMP=$($env:TEMP) TMP=$($env:TMP)"
+    Write-Output "SIM_STEP=$Label"
+    & (Join-Path $VivadoBin "$Tool.bat") @Arguments 2>&1 |
+        Tee-Object -FilePath (Join-Path $simRoot "$Label.console.log")
+    if($LASTEXITCODE -ne 0) { throw "$Label failed with exit $LASTEXITCODE" }
+}
+Push-Location $simRoot
+try {
+    Invoke-SimTool xvhdl @('--work','r1h_ref',
+        (Join-Path $ReferenceRoot 'rtl/nvp/nvp6134c_diagnostics_pkg.vhd'),
+        (Join-Path $ReferenceRoot 'rtl/nvp/r1f_transaction_serial_counter.vhd'),
+        (Join-Path $ReferenceRoot 'rtl/nvp/nvp6134c_i2c_bringup.vhd')) 'reference_compile'
+    Invoke-SimTool xvhdl @('--work','work',
+        (Join-Path $RepoRoot 'rtl/nvp/nvp6134c_diagnostics_pkg.vhd'),
+        (Join-Path $RepoRoot 'rtl/nvp/r1f_transaction_serial_counter.vhd'),
+        (Join-Path $RepoRoot 'rtl/nvp/nvp6134c_i2c_bringup.vhd'),
+        (Join-Path $RepoRoot 'tests/v41/r1i_master_test_adapter.vhd')) 'candidate_b_compile'
+    Invoke-SimTool xvlog @('--sv','--work','work',
+        (Join-Path $RepoRoot 'research_tests/r1i_b/tb_r1i_b_c2.sv')) 'candidate_b_testbench_compile'
+    foreach($case in @(
+        @{Top='tb_r1i_b_endpoint_high';Snapshot='r1i_b_endpoint_high';Marker='PASS R1I_B_ENDPOINT_HIGH_AND_DIVIDER_INDEPENDENCE'},
+        @{Top='tb_r1i_b_endpoint_low';Snapshot='r1i_b_endpoint_low';Marker='PASS R1I_B_ENDPOINT_LOW_NO_SAMPLE_NO_ADVANCE_AND_SAFE_RECOVERY'}
+    )) {
+        Invoke-SimTool xelab @("work.$($case.Top)",'-s',$case.Snapshot,'--debug','typical','--relax') "$($case.Snapshot)_elaborate"
+        Invoke-SimTool xsim @($case.Snapshot,'-runall','-log',"$($case.Snapshot).xsim.log") "$($case.Snapshot)_run"
+        if(-not (Select-String -LiteralPath "$($case.Snapshot).xsim.log" -SimpleMatch $case.Marker)) {
+            throw "Completion marker absent for $($case.Top)"
+        }
+    }
+    foreach($input in $inputs) {
+        if((Get-FileHash -Algorithm SHA256 -LiteralPath (Join-Path $RepoRoot $input)).Hash -ne $inputHashes[$input]) {
+            throw "Test input changed during Candidate-B focused simulation: $input"
+        }
+    }
+    Write-Output 'TEST_INPUT_HASHES_STABLE_DURING_COMPILE_AND_RUN=PASS'
+    Write-Output 'R1I_B_CANDIDATE_SPECIFIC_FOCUSED_SIM=PASS'
+} finally {
+    Pop-Location
+}
