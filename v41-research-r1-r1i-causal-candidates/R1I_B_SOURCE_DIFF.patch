diff --git a/research_tests/r1i_b/tb_r1i_b_c2.sv b/research_tests/r1i_b/tb_r1i_b_c2.sv
new file mode 100644
index 0000000000000000000000000000000000000000..a308b3a36d5aa4a83d60bdbd449be5c3119c33cb
--- /dev/null
+++ b/research_tests/r1i_b/tb_r1i_b_c2.sv
@@ -0,0 +1,236 @@
+`timescale 1ns/1ps
+
+// Candidate-B-only pin-level scheduling tests.  This source is compiled only
+// by research_tests/r1i_b/run_r1i_b_focused_sim.ps1 and is not in a production
+// synthesis fileset.
+module r1i_b_c2_test #(parameter integer TEST_MODE=0);
+  localparam integer CLK_HZ=1000000;
+  localparam integer I2C_HZ=25000;
+  localparam integer DIVIDER=CLK_HZ/(I2C_HZ*2);
+  localparam integer EXPECTED_DWELL=DIVIDER+1;
+
+  localparam [7:0] ST_START_W_A=8'd2;
+  localparam [7:0] ST_START_W_B=8'd3;
+  localparam [7:0] ST_SEND_W_LOW=8'd4;
+  localparam [7:0] ST_SEND_W_HIGH=8'd5;
+  localparam [7:0] ST_ACK_W_LOW=8'd6;
+  localparam [7:0] ST_ACK_W_HIGH=8'd7;
+  localparam [7:0] ST_SEND_REG_LOW=8'd8;
+  localparam [7:0] ST_STOP_A=8'd28;
+  localparam [7:0] ST_STOP_B=8'd29;
+  localparam [7:0] ST_STORE_RESULT=8'd30;
+  localparam [7:0] ST_STOP_C=8'd35;
+  localparam [7:0] ST_BUS_FREE=8'd36;
+  localparam [7:0] ST_RETRY_BACKOFF=8'd37;
+  localparam [7:0] ST_ABORT_HIGH_RECOVERY=8'd41;
+
+  logic clk=0, rst=1, start=0;
+  always #500 clk=~clk;
+  wire scl_oen,sda_oen,busy,done,any_error;
+  logic slave_sda=1,slave_scl=1;
+  wire scl_i=scl_oen & slave_scl;
+  wire sda_i=sda_oen & slave_sda;
+  wire [127:0] values,afe_values;
+  wire [63:0] output_values;
+  wire [15:0] read_errors,aux_errors,afe_errors,nack_count,timeout_count,serial_next;
+  wire [7:0] write_errors,original_ff,restored_ff,meta_bank,phys_bank;
+  wire phys_bank_valid,first_valid,record_valid;
+  wire [7:0] phase_dbg,step_dbg,last_reg,last_wdata,last_rdata,i2c_state,first_code;
+  wire [2:0] last_op;
+  wire [255:0] phase_counts;
+  wire [127:0] txn_counts;
+  wire [191:0] failed_record;
+  wire [31:0] bank_errors;
+  wire [1023:0] poc;
+
+  r1i_master_test_adapter #(
+    .REF_MODE(0),.CLK_HZ(CLK_HZ),.I2C_HZ(I2C_HZ)
+  ) dut(.*);
+
+  function automatic integer unsigned p(input integer word_index);
+    p=poc[32*word_index +: 32];
+  endfunction
+
+  task automatic boot_candidate;
+    begin
+      rst=1; start=0; slave_sda=1; slave_scl=1;
+      repeat(12) @(posedge clk);
+      #50; rst=0;
+      repeat(12) @(posedge clk);
+      #50; start=1;
+      repeat(3) @(posedge clk);
+      #50; start=0;
+    end
+  endtask
+
+  task automatic wait_state(input [7:0] wanted,input integer limit);
+    integer waited;
+    begin
+      waited=0;
+      while(i2c_state!==wanted && waited<limit) begin
+        @(negedge clk);
+        waited=waited+1;
+      end
+      if(i2c_state!==wanted)
+        $fatal(1,"timeout waiting state %0d; observed %0d",wanted,i2c_state);
+    end
+  endtask
+
+  task automatic require_nominal_dwell(input integer observed,input integer tag);
+    begin
+      // Sampling state_dbg on negedges may include either boundary negedge;
+      // the accepted one-cycle aperture still rejects any SCL-dependent stall.
+      if(observed<EXPECTED_DWELL-1 || observed>EXPECTED_DWELL+1)
+        $fatal(1,"ordinary HIGH tag%0d dwell %0d expected %0d",tag,observed,EXPECTED_DWELL);
+    end
+  endtask
+
+  integer dwell;
+  integer held;
+  integer safety_wait;
+  initial begin
+    boot_candidate();
+    if(TEST_MODE==0) begin : endpoint_high_case
+      // Immediate-HIGH START scheduling retains the exact divider dwell.
+      wait_state(ST_START_W_A,20000);
+      dwell=0;
+      while(i2c_state==ST_START_W_A && dwell<100) begin
+        @(negedge clk); dwell=dwell+1;
+      end
+      require_nominal_dwell(dwell,1);
+      if(i2c_state!==ST_START_W_B)
+        $fatal(1,"immediate-HIGH START_W_A did not advance normally: %0d",i2c_state);
+
+      // Delay physical SCL HIGH inside one SEND_W_HIGH interval.  Candidate B
+      // must not restart its divider, yet endpoint-HIGH progression stays legal.
+      wait_state(ST_SEND_W_LOW,2000);
+      slave_scl=0;
+      wait_state(ST_SEND_W_HIGH,2000);
+      dwell=0;
+      repeat(7) begin
+        @(negedge clk); dwell=dwell+1;
+        if(i2c_state!==ST_SEND_W_HIGH)
+          $fatal(1,"delayed-HIGH SEND_W_HIGH exited before divider endpoint");
+      end
+      slave_scl=1;
+      while(i2c_state==ST_SEND_W_HIGH && dwell<100) begin
+        @(negedge clk); dwell=dwell+1;
+      end
+      require_nominal_dwell(dwell,2);
+      if(i2c_state!==ST_SEND_W_LOW)
+        $fatal(1,"endpoint-HIGH SEND_W_HIGH did not advance normally: %0d",i2c_state);
+      if(p(28)!=0)
+        $fatal(1,"sub-deadline delayed HIGH falsely counted an SCL deadline");
+
+      // Preserve the passive end-of-LOW observation, then change SDA during
+      // ACK_W_HIGH.  The live filtered endpoint value must decide the ACK.
+      wait_state(ST_ACK_W_LOW,10000);
+      slave_sda=1;
+      wait_state(ST_ACK_W_HIGH,2000);
+      dwell=0;
+      repeat(8) begin
+        @(negedge clk); dwell=dwell+1;
+        if(i2c_state!==ST_ACK_W_HIGH)
+          $fatal(1,"ACK_W_HIGH exited before its nominal endpoint");
+      end
+      slave_sda=0;
+      while(i2c_state==ST_ACK_W_HIGH && dwell<100) begin
+        @(negedge clk); dwell=dwell+1;
+      end
+      require_nominal_dwell(dwell,3);
+      if(i2c_state!==ST_SEND_REG_LOW)
+        $fatal(1,"endpoint-HIGH ACK did not enter register phase: %0d",i2c_state);
+      if(p(3)!=1 || p(4)!=1 || p(5)!=0 || p(6)!=1 || p(19)!=0 || nack_count!=0)
+        $fatal(1,"live endpoint ACK/passive early telemetry mismatch opp=%0d early=%0d nack=%0d false=%0d raw=%0d",
+          p(3),p(4),p(5),p(6),p(19));
+      $display("PASS R1I_B_ENDPOINT_HIGH_AND_DIVIDER_INDEPENDENCE dwell=%0d",dwell);
+      $finish;
+    end else begin : endpoint_low_and_safety_case
+      // Reach the first ACK, keep resolved SCL LOW for the entire ordinary
+      // ACK-HIGH interval, and present SDA=1.  No selected opportunity or NACK
+      // may be consumed; the only legal endpoint is inherited recovery.
+      wait_state(ST_ACK_W_LOW,30000);
+      slave_scl=0;
+      slave_sda=1;
+      wait_state(ST_ACK_W_HIGH,2000);
+      dwell=0;
+      while(i2c_state==ST_ACK_W_HIGH && dwell<100) begin
+        @(negedge clk); dwell=dwell+1;
+      end
+      require_nominal_dwell(dwell,4);
+      if(i2c_state!==ST_ABORT_HIGH_RECOVERY)
+        $fatal(1,"endpoint-LOW ACK advanced outside recovery: state=%0d",i2c_state);
+      if(p(3)!=0 || p(4)!=1 || p(5)!=0 || p(6)!=0 || p(19)!=0 || nack_count!=0)
+        $fatal(1,"endpoint-LOW selected/passive telemetry mismatch opp=%0d early=%0d nack=%0d false=%0d raw=%0d legacy=%0d",
+          p(3),p(4),p(5),p(6),p(19),nack_count);
+      if(p(28)!=1)
+        $fatal(1,"endpoint-LOW did not record exactly one existing SCL deadline: %0d",p(28));
+
+      // Recovery body is untouched.  Let it finish the released HIGH, then
+      // prove STOP_B and STOP_C still wait on physical SCL qualification.
+      slave_scl=1;
+      wait_state(ST_STOP_A,10000);
+      slave_scl=0;
+      wait_state(ST_STOP_B,2000);
+      repeat(8) begin
+        @(negedge clk);
+        if(i2c_state!==ST_STOP_B || sda_oen!==1'b0)
+          $fatal(1,"STOP_B progressed/released SDA while physical SCL LOW");
+      end
+      slave_scl=1;
+      safety_wait=0;
+      while(i2c_state==ST_STOP_B && safety_wait<100) begin
+        @(negedge clk); safety_wait=safety_wait+1;
+      end
+      if(i2c_state!==ST_STOP_C || safety_wait<EXPECTED_DWELL)
+        $fatal(1,"STOP_B lacked filtered-HIGH full dwell: next=%0d wait=%0d",i2c_state,safety_wait);
+
+      slave_scl=0;
+      repeat(8) begin
+        @(negedge clk);
+        if(i2c_state!==ST_STOP_C)
+          $fatal(1,"STOP_C progressed while physical SCL LOW");
+      end
+      slave_scl=1;
+      safety_wait=0;
+      while(i2c_state==ST_STOP_C && safety_wait<100) begin
+        @(negedge clk); safety_wait=safety_wait+1;
+      end
+      if(i2c_state!==ST_BUS_FREE || safety_wait<EXPECTED_DWELL)
+        $fatal(1,"STOP_C lacked filtered-HIGH full dwell: next=%0d wait=%0d",i2c_state,safety_wait);
+
+      // BUS_FREE remains a filtered-idle proof and cannot be bypassed by the
+      // ordinary-HIGH divider change.
+      slave_scl=0;
+      repeat(30) begin
+        @(negedge clk);
+        if(i2c_state!==ST_BUS_FREE)
+          $fatal(1,"BUS_FREE completed while physical SCL LOW");
+      end
+      slave_scl=1;
+      safety_wait=0;
+      while(i2c_state==ST_BUS_FREE && safety_wait<200) begin
+        @(negedge clk); safety_wait=safety_wait+1;
+      end
+      if(i2c_state!==ST_STORE_RESULT || safety_wait<EXPECTED_DWELL)
+        $fatal(1,"BUS_FREE did not require a stable physical idle: next=%0d wait=%0d",i2c_state,safety_wait);
+      if(p(28)!=1)
+        $fatal(1,"STOP/BUS_FREE safety observation double-counted endpoint deadline: %0d",p(28));
+      wait_state(ST_RETRY_BACKOFF,200);
+      if(!record_valid || failed_record[175:168]!==8'h07 || !failed_record[59] ||
+         failed_record[55:48]!==8'h00 || !failed_record[61])
+        $fatal(1,"endpoint-LOW record/retry mismatch valid=%0d code=%02x timeout=%0d opp_nack=%02x atomic=%0d",
+          record_valid,failed_record[175:168],failed_record[59],failed_record[55:48],failed_record[61]);
