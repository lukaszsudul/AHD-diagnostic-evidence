resize_pblock [get_pblocks {CLKAG_NVP_PHYSICAL_FRONTEND/nvp_clk}] -add {CLOCKREGION_X0Y0:CLOCKREGION_X0Y0 CLOCKREGION_X0Y1:CLOCKREGION_X0Y1 CLOCKREGION_X1Y0:CLOCKREGION_X1Y0 CLOCKREGION_X1Y1:CLOCKREGION_X1Y1}
#endgroup

# Clock net "NVP_PHYSICAL_FRONTEND/idelay_refclk" driven by instance "NVP_PHYSICAL_FRONTEND/u_idelay_refclk_bufg" located at site "BUFGCTRL_X0Y16"
#startgroup
create_pblock {CLKAG_NVP_PHYSICAL_FRONTEND/idelay_refclk}
add_cells_to_pblock [get_pblocks  {CLKAG_NVP_PHYSICAL_FRONTEND/idelay_refclk}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL } -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="NVP_PHYSICAL_FRONTEND/idelay_refclk"}]]]
resize_pblock [get_pblocks {CLKAG_NVP_PHYSICAL_FRONTEND/idelay_refclk}] -add {CLOCKREGION_X0Y1:CLOCKREGION_X0Y1}
#endgroup
