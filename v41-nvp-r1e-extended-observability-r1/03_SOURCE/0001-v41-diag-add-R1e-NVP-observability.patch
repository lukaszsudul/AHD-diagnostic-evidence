+++ b/tb/v41/tb_r1e_legacy_nack_window.sv
@@ -0,0 +1,80 @@
+`timescale 1ns/1ps
+
+module tb_r1e_legacy_nack_window;
+  logic clk=0, reset=1;
+  always #4 clk=~clk;
+  logic req_valid=0, req_write=0, rsp_ready=0;
+  logic [16:0] req_addr=0;
+  logic [31:0] req_wdata=0;
+  logic [3:0] req_be=0;
+  wire req_ready, rsp_valid;
+  wire [31:0] rsp_data;
+  logic [735:0] diag_detail;
+  integer i;
+
+  g0p8c2_bar_target #(.SLOT_COUNT(2)) dut (
+    .producer_clk(clk), .producer_reset(reset), .producer_slot_index(4'b0),
+    .producer_word_address(9'b0), .producer_write_data(64'b0),
+    .producer_write_enable(1'b0), .producer_commit(1'b0),
+    .producer_generation(24'b0), .producer_free_mask(),
+    .pcie_user_clk(clk), .pcie_user_reset(reset),
+    .host_req_valid(req_valid), .host_req_ready(req_ready),
+    .host_req_write(req_write), .host_req_addr(req_addr),
+    .host_req_wdata(req_wdata), .host_req_be(req_be),
+    .host_rsp_valid(rsp_valid), .host_rsp_ready(rsp_ready),
+    .host_rsp_rdata(rsp_data),
+    .capture_submit_pcie(), .capture_arm_pcie(), .capture_abort_pcie(),
+    .capture_clear_errors_pcie(), .capture_single_line_pcie(),
+    .capture_window_16_lines_pcie(), .capture_target_line_pcie(),
+    .capture_line_count_pcie(), .capture_request_busy(1'b0),
+    .capture_busy(1'b0), .capture_armed(1'b0), .capture_done(1'b0),
+    .capture_aborted(1'b0), .telemetry_frame_seq(32'b0),
+    .telemetry_first_line(32'b0), .telemetry_line_count(32'b0),
+    .telemetry_generation(32'b0), .telemetry_bad_marker(32'b0),
+    .telemetry_bad_length(32'b0), .telemetry_overflow(32'b0),
+    .telemetry_arm_rejected(32'b0), .diag_last_memwr_addr(17'b0),
+    .diag_last_memwr_raw_data(32'b0),
+    .diag_last_memwr_logical_data(32'b0),
+    .diag_capture_submit_count(32'b0), .diag_mailbox_request_count(32'b0),
+    .diag_mailbox_ack_count(32'b0), .diag_vclk_edge_count(32'b0),
+    .diag_nvp_autoinit_done(1'b1), .diag_nvp_autoinit_error(1'b1),
+    .diag_nvp_autoinit_detail(diag_detail),
+    .diag_active_sav_candidate_count(32'b0), .diag_slot_commit_count(32'b0)
+  );
+
+  task automatic read_check(input [16:0] address, input [31:0] expected);
+    begin
+      @(negedge clk); req_addr=address; req_write=0; req_valid=1;
+      do @(posedge clk); while(!req_ready);
+      @(negedge clk); req_valid=0;
+      while(!rsp_valid) @(negedge clk);
+      if(rsp_data!==expected)
+        $fatal(1,"read %05h expected=%08h got=%08h",address,expected,rsp_data);
+      rsp_ready=1; @(posedge clk); @(negedge clk); rsp_ready=0;
+    end
+  endtask
+
+  task automatic write_word(input [16:0] address);
+    begin
+      @(negedge clk); req_addr=address; req_write=1;
+      req_wdata=32'hdeadbeef; req_be=4'hf; req_valid=1;
+      do @(posedge clk); while(!req_ready);
+      @(negedge clk); req_valid=0; req_write=0; req_wdata=0; req_be=0;
+    end
+  endtask
+
+  initial begin
+    diag_detail='0;
+    for(i=0;i<23;i=i+1) diag_detail[i*32 +: 32]=32'ha5000000+i;
+    repeat(4) @(posedge clk); @(negedge clk); reset=0;
+    for(i=0;i<17;i=i+1)
+      read_check(17'h10098+i*4,diag_detail[192+i*32 +: 32]);
+    for(i=0;i<17;i=i+1) write_word(17'h10098+i*4);
+    for(i=0;i<17;i=i+1)
+      read_check(17'h10098+i*4,diag_detail[192+i*32 +: 32]);
+    read_check(17'h10099,32'b0);
+    $display("NACK_LOG_ADDRESS_MAP_AUDIT=PASS_EXACT_SOURCE_AND_SIMULATION");
+    $display("LEGACY_NACK_WORDS_READ=17 HEADER=0x10098 DATA=0x1009C..0x100D8 READ_ONLY=YES");
+    $finish;
+  end
+endmodule
