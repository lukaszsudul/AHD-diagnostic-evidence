+++ b/tb/v41/tb_r1e_pre_done_equivalence.sv
@@ -0,0 +1,86 @@
+`timescale 1ns/1ps
+
+module tb_r1e_pre_done_equivalence;
+  logic clk=0, rst=1;
+  always #500 clk=~clk;
+  logic [47:0] freerun=0;
+  always_ff @(posedge clk) freerun<=freerun+1'b1;
+
+  wire r_scl_oen,r_sda_oen,r_nvp_rst,r_vdd1,r_vdd3,r_busy,r_done,r_error;
+  wire [735:0] r_detail;
+  wire c_scl_oen,c_sda_oen,c_nvp_rst,c_vdd1,c_vdd3,c_busy,c_done,c_error;
+  wire [735:0] c_detail;
+  wire probe_scl,probe_sda;
+  wire effective_scl=c_scl_oen & probe_scl;
+  wire effective_sda=c_sda_oen & probe_sda;
+
+  function automatic logic sda_model(input logic release_request,
+                                     input logic [7:0] state_code);
+    begin
+      case(state_code)
+        8'd7,8'd11,8'd15,8'd23: sda_model=1'b0;
+        default: sda_model=release_request;
+      endcase
+    end
+  endfunction
+  wire r_scl_i=r_scl_oen;
+  wire c_scl_i=effective_scl;
+  wire r_sda_i=sda_model(r_sda_oen,r_detail[167:160]);
+  wire c_sda_i=sda_model(effective_sda,c_detail[167:160]);
+
+  v40a_nvp_autoinit #(.CLK_HZ(1_000_000),.I2C_HZ(25_000)) reference (
+    .clk,.rst,.scl_i(r_scl_i),.sda_i(r_sda_i),.scl_oen(r_scl_oen),
+    .sda_oen(r_sda_oen),.nvp_rst(r_nvp_rst),.nvp_en_vdd1x(r_vdd1),
+    .nvp_en_vdd3x(r_vdd3),.init_busy(r_busy),.init_done(r_done),
+    .init_error(r_error),.diag_detail(r_detail)
+  );
+  v40a_nvp_autoinit #(.CLK_HZ(1_000_000),.I2C_HZ(25_000)) candidate_core (
+    .clk,.rst,.scl_i(c_scl_i),.sda_i(c_sda_i),.scl_oen(c_scl_oen),
+    .sda_oen(c_sda_oen),.nvp_rst(c_nvp_rst),.nvp_en_vdd1x(c_vdd1),
+    .nvp_en_vdd3x(c_vdd3),.init_busy(c_busy),.init_done(c_done),
+    .init_error(c_error),.diag_detail(c_detail)
+  );
+  nvp_i2c_address_probe #(
+    .CLK_HZ(1_000_000),.PROBE_I2C_HZ(25_000),.PROBE_TARGET_COUNT(1),
+    .PROBE_POST_INIT_GUARD_CYCLES(100)
+  ) candidate_probe (
+    .clk,.init_done(c_done),.init_busy(c_busy),.nvp_rst(c_nvp_rst),
+    .init_scl_release(c_scl_oen),.init_sda_release(c_sda_oen),
+    .raw_scl_i(c_scl_i),.raw_sda_i(c_sda_i),.freerun_count(freerun),
+    .probe_scl_release(probe_scl),.probe_sda_release(probe_sda),
+    .probe_count(),.probe_ack_count(),.probe_nack_count(),
+    .probe_timeout_count(),.probe_status(),.probe_first_nack_index(),
+    .probe_last_nack_index(),.probe_max_consecutive_nacks(),
+    .probe_start_freerun(),.probe_done_freerun()
+  );
+
+  integer checked_cycles=0;
+  always @(posedge clk) begin
+    #1;
+    if ({r_nvp_rst,r_vdd1,r_vdd3,r_scl_oen,r_sda_oen,r_busy,r_done,r_error}
+        !== {c_nvp_rst,c_vdd1,c_vdd3,c_scl_oen,c_sda_oen,c_busy,c_done,c_error})
+      $fatal(1,"candidate/reference control mismatch at cycle %0d",freerun);
+    if (r_detail !== c_detail)
+      $fatal(1,"candidate/reference diag_detail mismatch at cycle %0d",freerun);
+    if (!r_done) begin
+      checked_cycles=checked_cycles+1;
+      if(!probe_scl || !probe_sda)
+        $fatal(1,"probe drive before init_done at cycle %0d",freerun);
+      if(effective_scl!==c_scl_oen || effective_sda!==c_sda_oen)
+        $fatal(1,"inactive open-drain equivalence mismatch at cycle %0d",freerun);
+    end else begin
+      $display("PRE_INIT_DONE_CYCLE_EQUIVALENCE=PASS CYCLES=%0d",checked_cycles);
+      $display("AUTOINIT_TRANSACTION_STREAM_BYTE_IDENTICAL=YES");
+      $display("PROBE_ACTIVE_BEFORE_INIT_DONE=0 PROBE_BUS_DRIVE_BEFORE_INIT_DONE=0");
+      $finish;
+    end
+  end
+
+  initial begin
+    repeat(10) @(posedge clk); @(negedge clk); rst=0;
+  end
+  initial begin
+    repeat(3_000_000) @(posedge clk);
+    $fatal(1,"equivalence timeout");
+  end
+endmodule
diff --git a/tb/v41/tb_r1e_probe_10k.sv b/tb/v41/tb_r1e_probe_10k.sv
new file mode 100644
index 0000000..27c6440
--- /dev/null
+++ b/tb/v41/tb_r1e_probe_10k.sv
@@ -0,0 +1,51 @@
+`timescale 1ns/1ps
+
+module tb_r1e_probe_10k;
+  logic clk=0, init_done=0, init_busy=0, nvp_rst=1;
+  logic [47:0] freerun=0;
+  always #1 clk=~clk;
+  always_ff @(posedge clk) freerun<=freerun+1'b1;
+  wire scl_release, sda_release;
+  wire [31:0] count, ack, nack, timeout, status, first_nack, last_nack, max_run;
+  wire [47:0] start_time, done_time;
+
+  nvp_i2c_address_probe #(
+    .CLK_HZ(100), .PROBE_I2C_HZ(10), .PROBE_TARGET_COUNT(10000),
+    .PROBE_POST_INIT_GUARD_CYCLES(2), .SCL_TIMEOUT_CYCLES(20),
+    .BUS_IDLE_TIMEOUT_CYCLES(20)
+  ) dut (
+    .clk, .init_done, .init_busy, .nvp_rst,
+    .init_scl_release(1'b1), .init_sda_release(1'b1),
+    .raw_scl_i(scl_release),
+    .raw_sda_i(sda_release && !(dut.state==4'd7 || dut.state==4'd8)),
+    .freerun_count(freerun), .probe_scl_release(scl_release),
+    .probe_sda_release(sda_release), .probe_count(count),
+    .probe_ack_count(ack), .probe_nack_count(nack),
+    .probe_timeout_count(timeout), .probe_status(status),
+    .probe_first_nack_index(first_nack), .probe_last_nack_index(last_nack),
+    .probe_max_consecutive_nacks(max_run), .probe_start_freerun(start_time),
+    .probe_done_freerun(done_time)
+  );
+
+  integer stop_count=0;
+  always @(posedge sda_release) if (scl_release && dut.state==4'd2)
+    stop_count=stop_count+1;
+
+  initial begin
+    repeat(8) @(posedge clk); init_done=1;
+    wait(status[0]); repeat(3) @(posedge clk);
+    if (status[1] || count!=10000 || ack!=10000 || nack!=0 || timeout!=0 ||
+        first_nack!=32'hffffffff || last_nack!=32'hffffffff || max_run!=0 ||
+        !scl_release || !sda_release || done_time<=start_time)
+      $fatal(1,"10k invariant mismatch status=%08h count=%0d ack=%0d nack=%0d timeout=%0d",
+             status,count,ack,nack,timeout);
+    $display("R1E_PROBE_10K_TEST=PASS COUNT=%0d ACK=%0d NACK=%0d TIMEOUT=%0d",count,ack,nack,timeout);
+    $display("TRANSACTIONS=10000 ADDRESS_BYTE=60 REGISTER_BYTES=0 DATA_BYTES=0 READ_ADDRESS_BYTES=0 REPEATED_STARTS=0");
+    $finish;
+  end
+
+  initial begin
+    repeat(2000000) @(posedge clk);
+    $fatal(1,"10k test timeout");
+  end
+endmodule
diff --git a/tb/v41/tb_r1e_probe_small.sv b/tb/v41/tb_r1e_probe_small.sv
new file mode 100644
index 0000000..e24469c
--- /dev/null
+++ b/tb/v41/tb_r1e_probe_small.sv
@@ -0,0 +1,136 @@
+`timescale 1ns/1ps
+
+module tb_r1e_probe_small;
+  logic clk = 1'b0;
+  always #5 clk = ~clk;
+  logic [47:0] freerun = 48'b0;
+  always_ff @(posedge clk) freerun <= freerun + 1'b1;
+
+  logic p_init_done=0, p_init_busy=1, p_rst=0, p_init_scl=0, p_init_sda=1;
+  wire p_scl_release, p_sda_release;
+  wire [31:0] p_count, p_ack, p_nack, p_timeout, p_status;
+  wire [31:0] p_first, p_last, p_max;
+  wire [47:0] p_start, p_done_time;
+  wire pattern_nack = p_count==2 || p_count==3 || p_count==4 || p_count==9;
+  wire ack_drive_low = (p_dut.state == 4'd7 || p_dut.state == 4'd8) &&
+                       !pattern_nack;
+  wire p_scl_i = p_scl_release;
+  wire p_sda_i = p_sda_release && !ack_drive_low;
+  wire effective_scl = p_init_scl && p_scl_release;
+  wire effective_sda = p_init_sda && p_sda_release;
+
+  nvp_i2c_address_probe #(
+    .CLK_HZ(100), .PROBE_I2C_HZ(10), .PROBE_TARGET_COUNT(12),
+    .PROBE_POST_INIT_GUARD_CYCLES(4), .SCL_TIMEOUT_CYCLES(10),
+    .BUS_IDLE_TIMEOUT_CYCLES(20)
+  ) p_dut (
+    .clk, .init_done(p_init_done), .init_busy(p_init_busy), .nvp_rst(p_rst),
+    .init_scl_release(p_init_scl), .init_sda_release(p_init_sda),
+    .raw_scl_i(p_scl_i), .raw_sda_i(p_sda_i), .freerun_count(freerun),
+    .probe_scl_release(p_scl_release), .probe_sda_release(p_sda_release),
+    .probe_count(p_count), .probe_ack_count(p_ack),
+    .probe_nack_count(p_nack), .probe_timeout_count(p_timeout),
+    .probe_status(p_status), .probe_first_nack_index(p_first),
+    .probe_last_nack_index(p_last), .probe_max_consecutive_nacks(p_max),
+    .probe_start_freerun(p_start), .probe_done_freerun(p_done_time)
+  );
+
+  logic b_init_done=0, b_init_busy=0, b_rst=1;
+  wire b_scl_release, b_sda_release;
+  wire [31:0] b_count, b_ack, b_nack, b_timeout, b_status;
+  nvp_i2c_address_probe #(
+    .CLK_HZ(100), .PROBE_I2C_HZ(10), .PROBE_TARGET_COUNT(1),
+    .PROBE_POST_INIT_GUARD_CYCLES(2), .SCL_TIMEOUT_CYCLES(20),
+    .BUS_IDLE_TIMEOUT_CYCLES(8)
+  ) b_dut (
+    .clk, .init_done(b_init_done), .init_busy(b_init_busy), .nvp_rst(b_rst),
+    .init_scl_release(1'b1), .init_sda_release(1'b1),
+    .raw_scl_i(1'b1), .raw_sda_i(1'b0), .freerun_count(freerun),
+    .probe_scl_release(b_scl_release), .probe_sda_release(b_sda_release),
+    .probe_count(b_count), .probe_ack_count(b_ack),
+    .probe_nack_count(b_nack), .probe_timeout_count(b_timeout),
+    .probe_status(b_status), .probe_first_nack_index(),
+    .probe_last_nack_index(), .probe_max_consecutive_nacks(),
+    .probe_start_freerun(), .probe_done_freerun()
+  );
+
+  logic s_init_done=0, s_init_busy=0, s_rst=1, s_force_low=0;
+  wire s_scl_release, s_sda_release;
+  wire [31:0] s_count, s_ack, s_nack, s_timeout, s_status;
+  wire s_scl_i = s_scl_release && !s_force_low;
+  nvp_i2c_address_probe #(
+    .CLK_HZ(100), .PROBE_I2C_HZ(10), .PROBE_TARGET_COUNT(1),
+    .PROBE_POST_INIT_GUARD_CYCLES(2), .SCL_TIMEOUT_CYCLES(4),
+    .BUS_IDLE_TIMEOUT_CYCLES(100)
+  ) s_dut (
+    .clk, .init_done(s_init_done), .init_busy(s_init_busy), .nvp_rst(s_rst),
+    .init_scl_release(1'b1), .init_sda_release(1'b1),
+    .raw_scl_i(s_scl_i), .raw_sda_i(s_sda_release),
+    .freerun_count(freerun), .probe_scl_release(s_scl_release),
+    .probe_sda_release(s_sda_release), .probe_count(s_count),
+    .probe_ack_count(s_ack), .probe_nack_count(s_nack),
+    .probe_timeout_count(s_timeout), .probe_status(s_status),
+    .probe_first_nack_index(), .probe_last_nack_index(),
+    .probe_max_consecutive_nacks(), .probe_start_freerun(),
+    .probe_done_freerun()
+  );
+
+  integer starts=0, stops=0, addr_bits=0, ack_bits=0;
+  logic in_tx=0;
+  logic [7:0] decoded_byte=0;
+  always @(negedge p_sda_i) if (p_scl_i) begin
+    if (in_tx) $fatal(1,"repeated START detected");
+    in_tx=1; starts=starts+1; addr_bits=0; decoded_byte=0;
+  end
+  // STOP_B raises SCL with SDA held low before the STOP edge; it is not an
+  // additional data bit.
+  always @(posedge p_scl_i) if (in_tx && p_dut.state != 4'd10) begin
+    if (addr_bits < 8) begin
+      decoded_byte = {decoded_byte[6:0],p_sda_i};
+      addr_bits = addr_bits+1;
+    end else if (addr_bits == 8) begin
+      ack_bits=ack_bits+1; addr_bits=9;
+    end else $fatal(1,"byte after address ACK detected");
+  end
+  always @(posedge p_sda_i) if (p_scl_i && in_tx) begin
+    if (addr_bits != 9 || decoded_byte != 8'h60)
+      $fatal(1,"decoded stream mismatch bits=%0d byte=%02h",addr_bits,decoded_byte);
+    stops=stops+1; in_tx=0;
+  end
+
+  always @(posedge clk) if (!p_init_done) begin
+    if (!p_scl_release || !p_sda_release) $fatal(1,"probe drove before init_done");
+    if (effective_scl !== p_init_scl || effective_sda !== p_init_sda)
+      $fatal(1,"inactive open-drain equivalence failed");
+  end
+
+  initial begin
+    repeat(12) @(posedge clk);
+    p_init_scl=1; p_rst=1; p_init_busy=0; p_init_done=1;
+    b_init_done=1; s_init_done=1;
+    wait (s_status[2]);
+    repeat(3) @(posedge clk); s_force_low=1;
+    wait (p_status[0] && b_status[0] && s_status[0]);
+    repeat(3) @(posedge clk);
+    if (p_status[1] || p_count!=12 || p_ack!=8 || p_nack!=4 || p_timeout!=0 ||
+        p_first!=2 || p_last!=9 || p_max!=3 || starts!=12 || stops!=12 ||
+        ack_bits!=12 || p_start==0 || p_done_time<=p_start)
+      $fatal(1,"pattern result mismatch count=%0d ack=%0d nack=%0d first=%0d last=%0d max=%0d starts=%0d stops=%0d",
+             p_count,p_ack,p_nack,p_first,p_last,p_max,starts,stops);
+    if (!b_status[1] || !b_status[7] || b_status[6] || b_timeout!=1 || b_count!=0)
+      $fatal(1,"bus-idle timeout classification mismatch status=%08h",b_status);
+    if (!s_status[1] || !s_status[6] || s_status[7] || s_timeout!=1 || s_count!=0)
+      $fatal(1,"released-SCL timeout classification mismatch status=%08h",s_status);
+    if (!p_scl_release || !p_sda_release || !b_scl_release || !b_sda_release ||
+        !s_scl_release || !s_sda_release)
+      $fatal(1,"probe did not release both lines at terminal state");
+    $display("R1E_PROBE_SMALL_ADVERSARIAL_TEST=PASS");
+    $display("DECODED_TRANSACTIONS=%0d ADDRESS_BYTE=60 REGISTER_BYTES=0 DATA_BYTES=0 READ_ADDRESS_BYTES=0 REPEATED_STARTS=0 STOPS=%0d",starts,stops);
+    $finish;
+  end
+
+  initial begin
+    repeat(10000) @(posedge clk);
+    $fatal(1,"test timeout");
+  end
+endmodule
diff --git a/tests/python/test_nvp_r1e_tools.py b/tests/python/test_nvp_r1e_tools.py
new file mode 100644
index 0000000..7b5009b
--- /dev/null
+++ b/tests/python/test_nvp_r1e_tools.py
@@ -0,0 +1,52 @@
+#!/usr/bin/env python3
+from __future__ import annotations
+
+import importlib.util
+import math
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[2]
+SPEC = importlib.util.spec_from_file_location("reader", ROOT / "scripts/v41/read_nvp_r1e.py")
+assert SPEC and SPEC.loader
+reader = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(reader)
+
+
+def make_detail(nack_count: int, records: list[int], overflow: int = 0) -> list[int]:
+    value = 0
+    value |= nack_count << 128
+    value |= min(nack_count, 8) << 192
+    value |= overflow << 196
+    value |= 8 << 216
+    for index, record in enumerate(records):
+        value |= record << (224 + 64 * index)
+    return [(value >> (32 * index)) & 0xFFFFFFFF for index in range(23)]
+
+
+def record(op: int, phase: int, reg: int, data: int, pb: int, mb: int) -> int:
+    return op | phase << 8 | reg << 16 | data << 24 | pb << 32 | mb << 40 | 3 << 48
+
+
+def main() -> int:
+    words = make_detail(2, [record(4, 1, 0xFF, 2, 1, 2),
+                            record(5, 3, 0x20, 0x11, 2, 2)])
+    decoded = reader.decode_detail(words)
+    assert decoded["header_consistency"] == "PASS"
+    assert decoded["records"][0]["phase_name"] == "WRITE_ADDRESS_ACK"
+    assert decoded["records"][1]["phase_name"] == "DATA_ACK"
+    assert decoded["records"][0]["register"] == 0xFF
+    zero_low, zero_high = reader.wilson95(0, 10000)
+    assert zero_low == 0.0
+    assert 0.00038 < zero_high < 0.00039
+    low, high = reader.wilson95(100, 10000)
+    assert low < 0.01 < high and math.isfinite(low) and math.isfinite(high)
+    overflow = reader.decode_detail(make_detail(9, [record(i, 2, i, i, 0, 0)
+                                                     for i in range(8)], 1))
+    assert overflow["header_consistency"] == "PASS"
+    assert overflow["control_flow_replay_scope"] == "PARTIAL_FIRST_8_RECORDS_ONLY"
+    print("R1E_HOST_DECODE_FIXTURES=PASS")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
