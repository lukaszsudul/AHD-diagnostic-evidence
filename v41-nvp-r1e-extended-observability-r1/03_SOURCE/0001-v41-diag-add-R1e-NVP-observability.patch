@@ -0,0 +1,47 @@
+if {$argc != 3} {
+  puts stderr "usage: r1e_compare_routed_dcp.tcl R1_DCP R1E_DCP OUTPUT_DIR"
+  exit 2
+}
+set r1_dcp [file normalize [lindex $argv 0]]
+set r1e_dcp [file normalize [lindex $argv 1]]
+set out [file normalize [lindex $argv 2]]
+file mkdir $out
+
+proc write_lines {path lines} {
+  set fh [open $path w]; fconfigure $fh -translation lf
+  foreach line $lines {puts $fh $line}; close $fh
+}
+
+proc audit {label dcp out} {
+  open_checkpoint $dcp
+  report_utilization -file [file join $out ${label}_utilization.rpt]
+  report_utilization -hierarchical -hierarchical_depth 20 \
+    -file [file join $out ${label}_utilization_hierarchical.rpt]
+  report_power -file [file join $out ${label}_power.rpt]
+  report_io -file [file join $out ${label}_io.rpt]
+  report_clock_utilization -file [file join $out ${label}_clock_power_proxy.rpt]
+  set ports [get_ports {nvp_scl nvp_sda}]
+  report_timing -delay_type max -to $ports -max_paths 32 -nworst 16 \
+    -file [file join $out ${label}_nvp_output_paths.rpt]
+  report_timing -delay_type max -from $ports -max_paths 32 -nworst 16 \
+    -file [file join $out ${label}_nvp_input_paths.rpt]
+  set iobufs [get_cells -quiet -hier -filter \
+    {NAME =~ *NVP_SCL_IOBUF || NAME =~ *NVP_SDA_IOBUF}]
+  report_property -file [file join $out ${label}_nvp_iobuf_properties.txt] $iobufs
+  set sync_cells [get_cells -quiet -hier -filter \
+    {NAME =~ *scl_sync* || NAME =~ *sda_sync*}]
+  set lines [list "LABEL=$label" "DCP=$dcp"]
+  foreach cell [lsort $sync_cells] {
+    lappend lines "CELL=[get_property NAME $cell]|REF=[get_property REF_NAME $cell]|LOC=[get_property LOC $cell]|BEL=[get_property BEL $cell]"
+  }
+  write_lines [file join $out ${label}_synchronizer_placement.txt] $lines
+  close_design
+}
+
+audit R1 $r1_dcp $out
+audit R1E $r1e_dcp $out
+write_lines [file join $out R1E_IMPLEMENTATION_IMPACT_STATUS.txt] [list \
+  "R1E_OBSERVER_IMPLEMENTATION_DELTA=QUANTIFIED" \
+  "R1E_PLACEMENT_NEUTRAL=NOT_CLAIMED" \
+  "R1_DCP=$r1_dcp" "R1E_DCP=$r1e_dcp"]
+puts "R1E_OBSERVER_IMPLEMENTATION_DELTA=QUANTIFIED"
diff --git a/scripts/v41/r1e_timing_model.py b/scripts/v41/r1e_timing_model.py
new file mode 100644
index 0000000..770b38b
--- /dev/null
+++ b/scripts/v41/r1e_timing_model.py
@@ -0,0 +1,106 @@
+#!/usr/bin/env python3
+"""Fail-closed source/timing model for the frozen R1e configuration."""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import re
+from pathlib import Path
+
+CLK_HZ = 62_500_000
+I2C_HZ = 25_000
+DIVIDER = CLK_HZ // (I2C_HZ * 2)
+TICK_CYCLES = DIVIDER + 1
+AUTOINIT_TICK_ACTIONS = 31_043
+AUTOINIT_TICK_INTERVALS = AUTOINIT_TICK_ACTIONS - 1
+ENGINE_START_SAMPLE_EDGE = 93_750_322
+EXPECTED_ACTIVE = 132_584_734
+EXPECTED_50 = 113_182_679
+PROBE_TARGET = 10_000
+PROBE_TICKS = 23
+PROBE_GUARD_CYCLES = 62_500
+PROBE_STABLE_IDLE_CYCLES = TICK_CYCLES
+
+PROTECTED = {
+    "rtl/nvp/nvp6134c_autoinit.vhd":
+        "5dc0230cd569f03d68452055db6b10c5fcade751",
+    "rtl/nvp/nvp6134c_i2c_bringup.vhd":
+        "cfe33464d8e75c514462786593b278d90b4059a4",
+    "rtl/nvp/nvp6134c_diagnostics_pkg.vhd":
+        "7ddd60fc86da49cda1adcd7af7b772b337c95df6",
+}
+
+
+def git_blob_id(data: bytes) -> str:
+    header = f"blob {len(data)}\0".encode()
+    return hashlib.sha1(header + data).hexdigest()
+
+
+def require(condition: bool, message: str) -> None:
+    if not condition:
+        raise RuntimeError(message)
+
+
+def model(source: Path) -> dict[str, int | float | str]:
+    top = (source / "rtl/top/ahd_capture_top_xdma.sv").read_text()
+    bringup = (source / "rtl/nvp/nvp6134c_i2c_bringup.vhd").read_text()
+    probe = (source / "rtl/v41/nvp_i2c_address_probe.sv").read_text()
+    require(re.search(r"NVP_AUTOINIT_CLK_HZ\s*=\s*62500000", top) is not None,
+            "autoinit clock mismatch")
+    require(".I2C_HZ(25000)" in top, "active autoinit frequency mismatch")
+    require("constant DIVIDER : positive := CLK_HZ / (I2C_HZ * 2);" in bringup,
+            "protected divider formula mismatch")
+    for fragment in ("PROBE_TARGET_COUNT(10000)", "PROBE_ADDRESS_BYTE(8'h60)",
+                     "PROBE_POST_INIT_GUARD_CYCLES(62500)"):
+        require(fragment in top, f"missing frozen probe integration: {fragment}")
+    require("parameter integer PROBE_I2C_HZ = 25000" in probe,
+            "probe frequency default mismatch")
+
+    for relative, expected in PROTECTED.items():
+        actual = git_blob_id((source / relative).read_bytes())
+        require(actual == expected, f"protected blob mismatch: {relative} {actual}")
+
+    first_idle = 1 + ((ENGINE_START_SAMPLE_EDGE - 1 + TICK_CYCLES - 1)
+                      // TICK_CYCLES) * TICK_CYCLES
+    expected = first_idle + AUTOINIT_TICK_INTERVALS * TICK_CYCLES
+    require(DIVIDER == 1250 and TICK_CYCLES == 1251, "probe divider mismatch")
+    require(expected == EXPECTED_ACTIVE, "25-kHz lifecycle count mismatch")
+
+    probe_cycles = PROBE_TARGET * PROBE_TICKS * TICK_CYCLES
+    modeled_complete_cycles = (EXPECTED_ACTIVE + 1 + PROBE_GUARD_CYCLES +
+                               PROBE_STABLE_IDLE_CYCLES + probe_cycles)
+    modeled_seconds = modeled_complete_cycles / CLK_HZ
+    required_wait = max(10.0, modeled_seconds + 2.0)
+    return {
+        "STATUS": "PASS",
+        "CLK_HZ": CLK_HZ,
+        "AUTOINIT_I2C_HZ": I2C_HZ,
+        "DIVIDER": DIVIDER,
+        "TICK_CYCLES": TICK_CYCLES,
+        "EXPECTED_CNT_AT_INIT_DONE_ACTIVE": expected,
+        "EXPECTED_CNT_AT_INIT_DONE_50KHZ": EXPECTED_50,
+        "PROBE_TARGET_COUNT": PROBE_TARGET,
+        "PROBE_TICKS_PER_TRANSACTION": PROBE_TICKS,
+        "PROBE_CYCLES_PER_TRANSACTION": PROBE_TICKS * TICK_CYCLES,
+        "PROBE_TOTAL_CYCLES": probe_cycles,
+        "PROBE_TOTAL_SECONDS": probe_cycles / CLK_HZ,
+        "PROBE_GUARD_CYCLES": PROBE_GUARD_CYCLES,
+        "PROBE_STABLE_IDLE_CYCLES": PROBE_STABLE_IDLE_CYCLES,
+        "MODELED_PROBE_COMPLETE_CYCLES_FROM_CONFIGURATION": modeled_complete_cycles,
+        "MODELED_PROBE_COMPLETE_SECONDS_FROM_CONFIGURATION": modeled_seconds,
+        "ARM_A_REQUIRED_WAIT_SECONDS": required_wait,
+    }
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--source", required=True, type=Path)
+    args = parser.parse_args()
+    print(json.dumps(model(args.source), indent=2, sort_keys=True))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/scripts/v41/read_nvp_r1e.py b/scripts/v41/read_nvp_r1e.py
new file mode 100644
index 0000000..fc15160
--- /dev/null
+++ b/scripts/v41/read_nvp_r1e.py
@@ -0,0 +1,205 @@
+#!/usr/bin/env python3
+"""Bounded read-only R1e/formal telemetry and ordered-NACK decoder."""
+
+from __future__ import annotations
+
+import argparse
+import json
+import math
+import os
+import struct
+import time
+from typing import Any
+
+PHASE_NAMES = {
+    0x01: "WRITE_ADDRESS_ACK",
+    0x02: "REGISTER_ADDRESS_ACK",
+    0x03: "DATA_ACK",
+    0x04: "READ_ADDRESS_ACK",
+}
+STATIC_LOCAL = tuple(range(0x8C, 0xB8, 4))
+STATIC_R1E = tuple(range(0x2014, 0x2098, 4))
+R1E_PAGE = tuple(range(0x2000, 0x2100, 4))
+LEGACY_DETAIL = tuple(range(0x10080, 0x100DC, 4))
+
+
+def read_word(fd: int, offset: int, os_module=os) -> int:
+    payload = os_module.pread(fd, 4, offset)
+    if len(payload) != 4:
+        raise RuntimeError(f"pread at 0x{offset:05X} returned {len(payload)} bytes")
+    return struct.unpack("<I", payload)[0]
+
+
+def read48(fd: int, low: int, high: int, os_module=os) -> int:
+    for _ in range(3):
+        high1 = read_word(fd, high, os_module) & 0xFFFF
+        lowv = read_word(fd, low, os_module)
+        high2 = read_word(fd, high, os_module) & 0xFFFF
+        if high1 == high2:
+            return (high1 << 32) | lowv
+    raise RuntimeError(f"incoherent 48-bit counter at 0x{low:05X}")
+
+
+def decode_detail(words: list[int]) -> dict[str, Any]:
+    if len(words) != 23:
+        raise RuntimeError("legacy detail vector must contain 23 words")
+    value = sum(word << (32 * index) for index, word in enumerate(words))
+    field = lambda hi, lo: (value >> lo) & ((1 << (hi - lo + 1)) - 1)
+    count = field(195, 192)
+    overflow = field(196, 196)
+    records = []
+    for index in range(8):
+        raw = field(224 + index * 64 + 63, 224 + index * 64)
+        records.append({
+            "index": index,
+            "raw": f"0x{raw:016X}",
+            "operation_index": raw & 0xFF,
+            "phase_code": (raw >> 8) & 0xFF,
+            "phase_name": PHASE_NAMES.get((raw >> 8) & 0xFF, "UNKNOWN"),
+            "register": (raw >> 16) & 0xFF,
+            "data": (raw >> 24) & 0xFF,
+            "physical_bank": (raw >> 32) & 0xFF,
+            "metadata_bank": (raw >> 40) & 0xFF,
+            "valid": (raw >> 48) & 1,
+            "physical_bank_valid": (raw >> 49) & 1,
+            "reserved": (raw >> 50) & 0x3FFF,
+        })
+    aggregate = field(143, 128)
+    consistent = (count == min(aggregate, 8) and
+                  overflow == int(aggregate > 8) and
+                  all(record["valid"] for record in records[:count]))
+    return {
+        "phase": field(7, 0), "operation_index": field(15, 8),
+        "table_length": field(31, 16), "first_error_valid": field(80, 80),
+        "first_error_code": field(95, 88),
+        "first_error_step": field(103, 96),
+        "first_error_metadata_bank": field(111, 104),
+        "first_error_register": field(119, 112),
+        "first_error_data": field(127, 120),
+        "nack_count": aggregate, "timeout_count": field(159, 144),
+        "i2c_state": field(167, 160), "original_ff": field(175, 168),
+        "restored_ff": field(183, 176),
+        "first_error_physical_bank": field(191, 184),
+        "log_count": count, "log_overflow": overflow,
+        "physical_bank_valid": field(197, 197),
+        "current_metadata_bank": field(207, 200),
+        "current_physical_bank": field(215, 208),
+        "log_capacity": field(223, 216),
+        "header_consistency": "PASS" if consistent else "FAIL",
+        "control_flow_replay_scope":
+            "PARTIAL_FIRST_8_RECORDS_ONLY" if overflow else "COMPLETE_LOG_AVAILABLE",
+        "records": records[:count],
+    }
+
+
+def wilson95(successes: int, total: int) -> tuple[float, float]:
+    if total <= 0:
+        raise RuntimeError("Wilson interval requires positive total")
+    z = 1.959963984540054
+    p = successes / total
+    denominator = 1 + z * z / total
+    centre = (p + z * z / (2 * total)) / denominator
+    half = z * math.sqrt(p * (1 - p) / total + z * z / (4 * total * total)) / denominator
+    return centre - half, centre + half
+
+
+def snapshot(fd: int, os_module=os) -> dict[str, Any]:
+    local = {f"0x{off:05X}": read_word(fd, off, os_module)
+             for off in range(0, 0xE4, 4)}
+    page = {f"0x{off:05X}": read_word(fd, off, os_module) for off in R1E_PAGE}
+    legacy_words = [read_word(fd, off, os_module) for off in LEGACY_DETAIL]
+    legacy_log_raw = [read_word(fd, off, os_module)
+                      for off in range(0x10098, 0x100DC, 4)]
+    detail = decode_detail(legacy_words)
+    probe_count = page["0x02068"]
+    probe_nack = page["0x02070"]
+    probe_stats = None
+    if probe_count:
+        low, high = wilson95(probe_nack, probe_count)
+        probe_stats = {
+            "rate": probe_nack / probe_count,
+            "rate_ppm": 1_000_000 * probe_nack / probe_count,
+            "wilson95_lower": low, "wilson95_upper": high,
+            "rule_of_three_upper_approx": 3 / probe_count if probe_nack == 0 else None,
+        }
+    actual = read48(fd, 0x2014, 0x2018, os_module)
+    expected = (page["0x02058"] << 32) | page["0x02054"]
+    signed = actual - expected if page["0x02000"] == 0x314B4C43 else None
+    lifecycle = None if signed is None else {
+        "actual": actual, "expected": expected, "signed_error_cycles": signed,
+        "shortening_cycles": max(-signed, 0), "extension_cycles": max(signed, 0),
+        "shortening_ticks_exact": max(-signed, 0) / 1251,
+        "shortening_ticks_nearest": round(max(-signed, 0) / 1251),
+        "shortening_residual_cycles":
+            max(-signed, 0) - round(max(-signed, 0) / 1251) * 1251,
+    }
+    return {
+        "local": local, "r1e_page": page,
+        "legacy_nack_raw_17_words": [f"0x{x:08X}" for x in legacy_log_raw],
+        "ordered_nack": detail, "lifecycle": lifecycle,
+        "probe_statistics": probe_stats,
+        "coherent_freerun": read48(fd, 0x200C, 0x2010, os_module),
+    }
+
+
+def static_projection(item: dict[str, Any]) -> dict[str, Any]:
+    return {
+        "local": {f"0x{x:05X}": item["local"][f"0x{x:05X}"] for x in STATIC_LOCAL},
+        "r1e": {f"0x{x:05X}": item["r1e_page"][f"0x{x:05X}"] for x in STATIC_R1E},
+        "legacy": item["legacy_nack_raw_17_words"],
+    }
+
+
+def validate(item: dict[str, Any], expected_image: str) -> None:
+    page = item["r1e_page"]
+    if item["ordered_nack"]["header_consistency"] != "PASS":
+        raise RuntimeError("ordered-NACK header/record consistency failed")
+    if expected_image == "formal":
+        if any(page.values()):
+            raise RuntimeError("formal image did not return zero across 0x2000..0x20FF")
+    elif expected_image == "r1e":
+        required = {
+            "0x02000": 0x314B4C43, "0x02004": 1,
+            "0x02040": 0x31453152, "0x02044": 1,
+            "0x0204C": 25000, "0x02050": 1251,
+            "0x02054": 132584734, "0x02064": 10000,
+            "0x02068": 10000, "0x02074": 0,
+        }
+        for key, value in required.items():
+            if page[key] != value:
+                raise RuntimeError(f"R1e invariant {key} expected {value} got {page[key]}")
+        status = page["0x02078"]
+        if not (status & 1) or (status & 2) or (status & 4):
+            raise RuntimeError(f"invalid R1e probe terminal status 0x{status:08X}")
+        if page["0x0206C"] + page["0x02070"] != page["0x02068"]:
+            raise RuntimeError("probe ACK+NACK invariant failed")
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--node", required=True, help="exact already-proven XDMA user node")
+    parser.add_argument("--expect", choices=("r1e", "formal", "none"), default="none")
+    parser.add_argument("--twice", action="store_true")
+    parser.add_argument("--delay", type=float, default=1.0)
+    args = parser.parse_args()
+    fd = os.open(args.node, os.O_RDONLY | os.O_CLOEXEC)
+    try:
+        first = snapshot(fd)
+        validate(first, args.expect)
+        second = None
+        if args.twice:
+            time.sleep(max(args.delay, 0.0))
+            second = snapshot(fd)
+            validate(second, args.expect)
+            if static_projection(first) != static_projection(second):
+                raise RuntimeError("T0/T1 static telemetry mismatch")
+    finally:
+        os.close(fd)
+    print(json.dumps({"T0": first, "T1": second}, indent=2, sort_keys=True))
+    print("READ_ONLY=YES")
+    print(f"STATIC_SNAPSHOTS_MATCH={'YES' if args.twice else 'NOT_REQUESTED'}")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/scripts/v41/verify_r1e_static.py b/scripts/v41/verify_r1e_static.py
new file mode 100644
index 0000000..6c41c2a
--- /dev/null
+++ b/scripts/v41/verify_r1e_static.py
@@ -0,0 +1,108 @@
+#!/usr/bin/env python3
+"""Fail-closed static gate for the R1e source scope and isolation contract."""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import re
+import subprocess
+from pathlib import Path
+
+BASE = "f007dc172d43d30b02729755e60382f8ce3dbff4"
+PROTECTED = {
+    "rtl/nvp/nvp6134c_autoinit.vhd": "5dc0230cd569f03d68452055db6b10c5fcade751",
+    "rtl/nvp/nvp6134c_i2c_bringup.vhd": "cfe33464d8e75c514462786593b278d90b4059a4",
+    "rtl/nvp/nvp6134c_diagnostics_pkg.vhd": "7ddd60fc86da49cda1adcd7af7b772b337c95df6",
+    "xdc/boards/current/nvp_control.xdc": "2e4a6f56d5dfa227a968492fe4476d25721f09f9",
+}
+LIFECYCLE = {
+    "rtl/v41/axi_clock_lifecycle_monitor.sv": "c8c8145b12494cbdd54de7760f0558e6ab5fef11",
+    "rtl/v41/axi_clock_measurement_regs.sv": "64f4a3df745bcde00f9facac3030637a32a19485",
+}
+ALLOWED = {
+    "rtl/top/ahd_capture_top_xdma.sv", "rtl/v41/control_status_regs.sv",
+    *LIFECYCLE, "rtl/v41/r1e_measurement_regs.sv",
+    "rtl/v41/nvp_i2c_address_probe.sv", "scripts/v41/r1e_build.tcl",
+    "scripts/v41/r1e_compare_routed_dcp.tcl", "scripts/v41/r1e_timing_model.py",
+    "scripts/v41/read_nvp_r1e.py", "scripts/v41/verify_r1e_static.py",
+    "tb/v41/tb_control_status_regs.sv", "tb/v41/tb_r1e_measurement_regs.sv",
+    "tb/v41/tb_r1e_probe_small.sv", "tb/v41/tb_r1e_probe_10k.sv",
+    "tb/v41/tb_r1e_legacy_nack_window.sv",
+    "tb/v41/tb_r1e_pre_done_equivalence.sv",
+    "tests/python/test_nvp_r1e_tools.py",
+}
+
+
+def run(repo: Path, *args: str) -> str:
+    result = subprocess.run(["git", "-C", str(repo), *args], text=True,
+                            stdout=subprocess.PIPE, stderr=subprocess.PIPE)
+    if result.returncode:
+        raise RuntimeError(result.stderr)
+    return result.stdout.rstrip()
+
+
+def blob(path: Path) -> str:
+    data = path.read_bytes()
+    return hashlib.sha1(f"blob {len(data)}\0".encode() + data).hexdigest()
+
+
+def require(value: bool, message: str) -> None:
+    if not value:
+        raise RuntimeError(message)
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--repo", required=True, type=Path)
+    args = parser.parse_args()
+    repo = args.repo.resolve()
+    require(run(repo, "rev-parse", f"{BASE}^{{tree}}") ==
+            "b8f87966c8021396acb6341bd2d7d86a10fd7f13", "base tree mismatch")
+    changed = set(run(repo, "status", "--porcelain", "--untracked-files=all").splitlines())
+    changed_paths = {line[3:].replace("\\", "/") for line in changed if line}
+    require(changed_paths <= ALLOWED,
+            f"unauthorized source paths: {sorted(changed_paths - ALLOWED)}")
+    for relative, expected in PROTECTED.items():
+        require(blob(repo / relative) == expected, f"protected blob changed: {relative}")
+    for relative, expected in LIFECYCLE.items():
+        require(blob(repo / relative) == expected, f"R1 lifecycle blob mismatch: {relative}")
+
+    top = (repo / "rtl/top/ahd_capture_top_xdma.sv").read_text()
+    probe = (repo / "rtl/v41/nvp_i2c_address_probe.sv").read_text()
+    regs = (repo / "rtl/v41/control_status_regs.sv").read_text()
+    pio = (repo / "rtl/pio/pio_bar_target.sv").read_text()
+    require(".I2C_HZ(25000)" in top, "autoinit I2C_HZ changed")
+    require("nvp_init_scl_release & probe_scl_release" in top and
+            "nvp_init_sda_release & probe_sda_release" in top,
+            "open-drain AND integration missing")
+    require(".PROBE_TARGET_COUNT(10000)" in top and
+            ".PROBE_ADDRESS_BYTE(8'h60)" in top, "frozen probe constants mismatch")
+    require("input  logic        init_done" in probe and
+            "if (state == ST_WAIT_INIT)" in probe, "probe terminal gate missing")
+    require("PROBE_ADDRESS_BYTE[bit_index]" in probe,
+            "probe does not source the fixed address byte directly")
+    require("measurement_read_select = !host_req_write" in regs,
+            "measurement page is not read-only local selection")
+    require("host_req_addr[16:8] == 9'h020" in regs, "measurement page mismatch")
+    for index, off in enumerate(range(0x98, 0xDC, 4)):
+        lo = 192 + index * 32
+        hi = lo + 31
+        fragment = f"8'h{off:02X}: reg_read = diag_nvp_autoinit_detail[{hi}:{lo}]"
+        require(fragment in pio, f"legacy ordered-log mapping missing: {fragment}")
+    require(".diag_nvp_autoinit_detail(nvp_diag_axi[737:2])" in top,
+            "full 736-bit legacy vector forwarding missing")
+    require(".nvp_detail(nvp_diag_axi[193:2])" in top,
+            "existing local 192-bit diagnostic contract changed")
+    xci = "ip/v41/xdma_v41_m1.xci"
+    require(blob(repo / xci) == run(repo, "rev-parse", f"{BASE}:{xci}"),
+            "XDMA XCI changed")
+    print("R1E_STATIC_GATE=PASS")
+    print("PROTECTED_NVP_BLOBS_UNCHANGED=YES")
+    print("NACK_LOG_EXISTING_LEGACY_WINDOW=PASS")
+    print("PROBE_TO_AUTOINIT_FUNCTIONAL_FANOUT=0_BY_SOURCE_BOUNDARY")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
