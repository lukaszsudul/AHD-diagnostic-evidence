diff --git a/rtl/v41/r1h_mmio_read_service.sv b/rtl/v41/r1h_mmio_read_service.sv
new file mode 100644
index 0000000..9ac1f56
--- /dev/null
+++ b/rtl/v41/r1h_mmio_read_service.sv
@@ -0,0 +1,162 @@
+`timescale 1ns/1ps
+
+// R1h read sequencer for the complete R1f diagnostic page.  The enclosing
+// AXI-Lite bridge already permits at most one request, but this module also
+// advertises ready only while idle and holds each response until accepted.
+// Ordinary registers take the registered scalar path.  Record words require
+// one synchronous BRAM transaction; packed index words require two ordered
+// 16-bit BRAM transactions.
+module v41_r1h_mmio_read_service (
+  input  logic        clk,
+  input  logic        reset,
+
+  input  logic        req_valid,
+  output logic        req_ready,
+  input  logic [13:0] req_offset,
+  output logic        rsp_valid,
+  input  logic        rsp_ready,
+  output logic [31:0] rsp_data,
+
+  input  logic [31:0] scalar_read_data,
+  input  logic        record_select,
+  input  logic [5:0]  record_index,
+  input  logic [2:0]  record_word,
+  input  logic        probe_index_select,
+  input  logic [1:0]  probe_index_phase,
+  input  logic [7:0]  probe_index_word,
+
+  output logic        record_read_enable,
+  output logic [5:0]  record_read_index,
+  output logic [2:0]  record_read_word,
+  input  logic        record_read_valid,
+  input  logic [31:0] record_read_data,
+
+  output logic        index_read_enable,
+  output logic [1:0]  index_read_phase,
+  output logic [8:0]  index_read_address,
+  input  logic        index_read_valid,
+  input  logic [15:0] index_read_data,
+  input  logic [15:0] waddr_index_stored_count,
+  input  logic [15:0] regaddr_index_stored_count,
+  input  logic [15:0] data_index_stored_count
+);
+  typedef enum logic [2:0] {
+    IDLE,
+    RECORD_WAIT,
+    INDEX_LOW_WAIT,
+    INDEX_HIGH_WAIT,
+    RESPONSE
+  } state_t;
+
+  state_t state;
+  logic [1:0] index_phase_q;
+  logic [7:0] index_word_q;
+  logic [15:0] index_count_q;
+  logic [15:0] index_low_q;
+
+  function automatic [15:0] selected_index_count(input logic [1:0] phase);
+    begin
+      case (phase)
+        2'd0: selected_index_count = waddr_index_stored_count;
+        2'd1: selected_index_count = regaddr_index_stored_count;
+        2'd2: selected_index_count = data_index_stored_count;
+        default: selected_index_count = 16'b0;
+      endcase
+    end
+  endfunction
+
+  // Never acknowledge a request while either reset domain has made the
+  // storage response pipelines unavailable. The top combines AXI reset and
+  // NVP-POR reset at this input, so reset also cancels a pending memory read.
+  assign req_ready = (state == IDLE) && !reset;
+  assign rsp_valid = (state == RESPONSE) && !reset;
+
+  // BRAM request pulses are derived from an accepted host request or from the
+  // completion of the low-half index read.  Address/control are stable for the
+  // complete cycle preceding the sampling clock edge.
+  always_comb begin
+    record_read_enable = 1'b0;
+    record_read_index = record_index;
+    record_read_word = record_word;
+    index_read_enable = 1'b0;
+    index_read_phase = probe_index_phase;
+    index_read_address = {probe_index_word, 1'b0};
+
+    if (state == IDLE && req_valid && req_ready) begin
+      if (record_select)
+        record_read_enable = 1'b1;
+      else if (probe_index_select)
+        index_read_enable = 1'b1;
+    end else if (state == INDEX_LOW_WAIT && index_read_valid) begin
+      index_read_enable = 1'b1;
+      index_read_phase = index_phase_q;
+      index_read_address = {index_word_q, 1'b1};
+    end
+  end
+
+  always_ff @(posedge clk) begin
+    if (reset) begin
+      state <= IDLE;
+      rsp_data <= 32'b0;
+      index_phase_q <= 2'b0;
+      index_word_q <= 8'b0;
+      index_count_q <= 16'b0;
+      index_low_q <= 16'b0;
+    end else begin
+      case (state)
+        IDLE: begin
+          if (req_valid && req_ready) begin
+            if (record_select) begin
+              state <= RECORD_WAIT;
+            end else if (probe_index_select) begin
+              index_phase_q <= probe_index_phase;
+              index_word_q <= probe_index_word;
+              index_count_q <= selected_index_count(probe_index_phase);
+              state <= INDEX_LOW_WAIT;
+            end else begin
+              rsp_data <= scalar_read_data;
+              state <= RESPONSE;
+            end
+          end
+        end
+
+        RECORD_WAIT: begin
+          if (record_read_valid) begin
+            rsp_data <= record_read_data;
+            state <= RESPONSE;
+          end
+        end
+
+        INDEX_LOW_WAIT: begin
+          if (index_read_valid) begin
+            index_low_q <= ({index_word_q, 1'b0} < index_count_q) ?
+                           index_read_data : 16'b0;
+            state <= INDEX_HIGH_WAIT;
+          end
+        end
+
+        INDEX_HIGH_WAIT: begin
+          if (index_read_valid) begin
+            rsp_data[15:0] <= index_low_q;
+            rsp_data[31:16] <= ({index_word_q, 1'b1} < index_count_q) ?
+                               index_read_data : 16'b0;
+            state <= RESPONSE;
+          end
+        end
+
+        RESPONSE: begin
+          if (rsp_ready)
+            state <= IDLE;
+        end
+
+        default: state <= IDLE;
+      endcase
+    end
+  end
+
+  // Keep the request offset in the interface contract for direct protocol
+  // assertions and traceability even though the decoder consumes it in the
+  // enclosing top level.
+  logic [13:0] unused_req_offset;
+  always_comb unused_req_offset = req_offset;
+endmodule
