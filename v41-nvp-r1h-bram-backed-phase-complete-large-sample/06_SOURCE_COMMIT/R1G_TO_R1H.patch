+      xpm_memory_sdpram #(
+        .ADDR_WIDTH_A(9),
+        .ADDR_WIDTH_B(9),
+        .AUTO_SLEEP_TIME(0),
+        .BYTE_WRITE_WIDTH_A(16),
+        .CLOCKING_MODE("common_clock"),
+        .ECC_MODE("no_ecc"),
+        .MEMORY_INIT_FILE("none"),
+        .MEMORY_INIT_PARAM("0"),
+        .MEMORY_OPTIMIZATION("true"),
+        .MEMORY_PRIMITIVE("block"),
+        .MEMORY_SIZE(8192),
+        .MESSAGE_CONTROL(0),
+        .READ_DATA_WIDTH_B(16),
+        .READ_LATENCY_B(1),
+        .READ_RESET_VALUE_B("0"),
+        .RST_MODE_B("SYNC"),
+        .SIM_ASSERT_CHK(1),
+        .USE_EMBEDDED_CONSTRAINT(0),
+        .USE_MEM_INIT(0),
+        .WAKEUP_TIME("disable_sleep"),
+        .WRITE_DATA_WIDTH_A(16),
+        .WRITE_MODE_B("read_first")
+      ) INDEX_PAYLOAD_RAM (
+        .clka(clk),
+        .ena(write_enable[phase_bank]),
+        .wea(write_enable[phase_bank]),
+        .addra(write_address),
+        .dina(write_data),
+        .clkb(clk),
+        .enb(read_enable[phase_bank]),
+        .addrb(read_address),
+        .doutb(read_bank_data[phase_bank]),
+        .rstb(rst),
+        .regceb(1'b1),
+        .sleep(1'b0),
+        .injectsbiterra(1'b0),
+        .injectdbiterra(1'b0),
+        .sbiterrb(),
+        .dbiterrb()
+      );
+    end
+  endgenerate
