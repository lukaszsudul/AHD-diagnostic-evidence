+    .probe_index_read_select(reference_index_select),
+    .probe_index_read_data(reference_index_data),
+    .read_data(reference_read_data)
+  );
+
+  v41_r1h_mmio_read_service read_service (
+    .clk(clk),
+    .reset(reset),
+    .req_valid(r1h_req_valid),
+    .req_ready(r1h_req_ready),
+    .req_offset(r1h_req_offset),
+    .rsp_valid(r1h_rsp_valid),
+    .rsp_ready(r1h_rsp_ready),
+    .rsp_data(r1h_rsp_data),
+    .scalar_read_data(candidate_scalar_data),
+    .record_select(candidate_record_select),
+    .record_index(candidate_record_index),
+    .record_word(candidate_record_word),
+    .probe_index_select(candidate_index_select),
+    .probe_index_phase(candidate_index_phase),
+    .probe_index_word(candidate_index_word),
+    .record_read_enable(record_read_enable),
+    .record_read_index(record_read_index),
+    .record_read_word(record_read_word),
+    .record_read_valid(record_read_valid),
+    .record_read_data(record_read_data),
+    .index_read_enable(index_read_enable),
+    .index_read_phase(index_read_phase),
+    .index_read_address(index_read_address),
+    .index_read_valid(index_read_valid),
+    .index_read_data(index_read_data),
+    .waddr_index_stored_count(16'd512),
+    .regaddr_index_stored_count(16'd512),
+    .data_index_stored_count(16'd512)
+  );
+
+  v41_control_status_regs control_regs (
+    .clk(clk),
+    .reset(reset),
+    .host_req_valid(host_req_valid),
+    .host_req_ready(host_req_ready),
+    .host_req_write(host_req_write),
+    .host_req_addr(host_req_addr),
+    .host_req_wdata(host_req_wdata),
+    .host_req_be(host_req_be),
+    .host_rsp_valid(host_rsp_valid),
+    .host_rsp_ready(host_rsp_ready),
+    .host_rsp_rdata(host_rsp_rdata),
+    .app_req_valid(app_req_valid),
+    .app_req_ready(app_req_ready),
+    .app_req_write(app_req_write),
+    .app_req_addr(app_req_addr),
+    .app_req_wdata(app_req_wdata),
+    .app_req_be(app_req_be),
+    .app_rsp_valid(app_rsp_valid),
+    .app_rsp_ready(app_rsp_ready),
+    .app_rsp_rdata(app_rsp_rdata),
+    .measurement_read_data(32'hfeed_cafe),
+    .r1h_req_valid(r1h_req_valid),
+    .r1h_req_ready(r1h_req_ready),
+    .r1h_req_offset(r1h_req_offset),
+    .r1h_rsp_valid(r1h_rsp_valid),
+    .r1h_rsp_ready(r1h_rsp_ready),
+    .r1h_rsp_data(r1h_rsp_data),
+    .capture_request_busy(1'b0),
+    .capture_busy(1'b0),
+    .capture_armed(1'b0),
+    .capture_done(1'b0),
+    .capture_aborted(1'b0),
+    .capture_generation(32'b0),
+    .captured_line_count(32'b0),
+    .first_source_line(32'b0),
+    .frame_sequence(32'b0),
+    .bad_marker_count(32'b0),
+    .bad_length_count(32'b0),
+    .capture_overflow_count(32'b0),
+    .malformed_count(32'b0),
+    .capture_dropped_count(32'b0),
+    .arm_rejected_count(32'b0),
+    .mailbox_rejected_count(32'b0),
+    .vclk_edge_count(32'b0),
+    .active_sav_count(32'b0),
+    .record_commit_count(32'b0),
+    .nvp_init_busy(1'b0),
+    .nvp_init_done(1'b0),
+    .nvp_init_error(1'b0),
+    .nvp_reset_released(1'b0),
+    .nvp_vdd1x_active(1'b0),
+    .nvp_vdd3x_active(1'b0),
+    .nvp_scl_sample(1'b0),
+    .nvp_sda_sample(1'b0),
+    .nvp_detail(192'b0),
+    .dma_status(32'b0),
+    .records_streamed(32'b0),
+    .dropped_records(32'b0),
+    .c2h_stall_cycles(64'b0),
+    .last_streamed_capture_sequence(32'b0),
+    .stream_protocol_errors(32'b0),
+    .user_irq_count(32'b0),
+    .h2c_attempt_count(32'b0)
+  );
+
+  task automatic require_true(input logic condition, input string message);
+    begin
+      if (condition !== 1'b1) begin
+        $display("FAIL: %s time=%0t addr=0x%05x", message, $time,
+                 host_req_addr);
+        $fatal(1);
+      end
+    end
+  endtask
+
+  task automatic read_and_compare(input logic [16:0] address,
+                                  input integer backpressure_cycles);
+    logic [31:0] expected;
+    integer wait_cycles;
+    integer hold_index;
+    begin
+      @(negedge clk);
+      host_req_addr = address;
+      host_req_write = 1'b0;
+      host_req_wdata = 32'b0;
+      host_req_be = 4'b0;
+      host_req_valid = 1'b1;
+      host_rsp_ready = 1'b0;
+      #1;
+      expected = reference_read_data;
+      require_true(host_req_ready, "diagnostic read not accepted from idle");
+      require_true(r1h_req_valid, "diagnostic read did not enter R1h service");
+      require_true(!app_req_valid, "diagnostic read leaked to app path");
+      @(posedge clk);
+      #1;
+      host_req_valid = 1'b0;
+
+      wait_cycles = 0;
+      while (!host_rsp_valid && wait_cycles < 16) begin
+        @(posedge clk);
+        #1;
+        wait_cycles = wait_cycles + 1;
+      end
+      require_true(host_rsp_valid, "diagnostic response timeout");
+      require_true(host_rsp_rdata === expected,
+                   "R1h response differs from exact R1g decoder");
+      require_true(!host_req_ready,
+                   "new request accepted while response outstanding");
+
+      for (hold_index = 0; hold_index < backpressure_cycles;
+           hold_index = hold_index + 1) begin
+        @(posedge clk);
+        #1;
+        require_true(host_rsp_valid, "response valid dropped under backpressure");
+        require_true(host_rsp_rdata === expected,
+                     "response data changed under backpressure");
+        require_true(!host_req_ready,
+                     "request ready rose under response backpressure");
+      end
+
+      @(negedge clk);
+      host_rsp_ready = 1'b1;
+      #1;
+      require_true(host_rsp_valid, "response vanished before ready handshake");
+      require_true(host_rsp_rdata === expected,
+                   "response changed before ready handshake");
+      @(posedge clk);
+      #1;
+      host_rsp_ready = 1'b0;
+      require_true(!host_rsp_valid, "response duplicated after acceptance");
+      read_count = read_count + 1;
+    end
+  endtask
+
+  task automatic check_forwarded_write(input logic [16:0] address);
+    logic [31:0] value;
+    begin
+      value = 32'h5a00_0000 ^ {15'b0, address};
+      @(negedge clk);
+      host_req_addr = address;
+      host_req_write = 1'b1;
+      host_req_wdata = value;
+      host_req_be = address[3:0];
+      host_req_valid = 1'b1;
+      #1;
+      require_true(host_req_ready, "forwarded write not accepted");
+      require_true(app_req_valid, "R1h-range write not forwarded to app");
+      require_true(app_req_write, "forwarded request lost write direction");
+      require_true(app_req_addr == address, "forwarded write address changed");
+      require_true(app_req_wdata == value, "forwarded write data changed");
+      require_true(app_req_be == address[3:0], "forwarded byte enables changed");
+      require_true(!r1h_req_valid, "R1h-range write entered read service");
+      @(posedge clk);
+      #1;
+      host_req_valid = 1'b0;
+      host_req_write = 1'b0;
+      write_count = write_count + 1;
+    end
+  endtask
+
+  task automatic check_order_and_busy_rejection;
+    logic [31:0] first_expected;
+    logic [31:0] second_expected;
+    integer wait_cycles;
+    begin
+      // Accept the first request.
+      @(negedge clk);
+      host_req_addr = 17'h020a0;
+      host_req_write = 1'b0;
+      host_req_valid = 1'b1;
+      host_rsp_ready = 1'b0;
+      #1;
+      first_expected = reference_read_data;
+      require_true(host_req_ready, "first ordering request not ready");
+      @(posedge clk);
+      #1;
+
+      // Present a second request while the first response is outstanding.
+      host_req_addr = 17'h020a4;
+      #1;
+      second_expected = reference_read_data;
+      wait_cycles = 0;
+      while (!host_rsp_valid && wait_cycles < 8) begin
+        require_true(!host_req_ready,
+                     "second request accepted before first response");
+        @(posedge clk);
+        #1;
+        wait_cycles = wait_cycles + 1;
+      end
+      require_true(host_rsp_valid, "first ordering response timeout");
+      require_true(host_rsp_rdata === first_expected,
+                   "first ordering response changed");
+      require_true(!host_req_ready,
+                   "second request ready before first response handshake");
+
+      // Consume the first while keeping the second request asserted.  It may
+      // only be accepted after the service returns to IDLE.
+      @(negedge clk);
+      host_rsp_ready = 1'b1;
+      @(posedge clk);
+      #1;
+      host_rsp_ready = 1'b0;
+      require_true(!host_rsp_valid, "first response duplicated");
+      require_true(host_req_ready, "second request not released after first response");
+      @(posedge clk);
+      #1;
+      host_req_valid = 1'b0;
+
+      wait_cycles = 0;
+      while (!host_rsp_valid && wait_cycles < 8) begin
+        @(posedge clk);
+        #1;
+        wait_cycles = wait_cycles + 1;
+      end
+      require_true(host_rsp_valid, "second ordering response timeout");
+      require_true(host_rsp_rdata === second_expected,
+                   "response order/value mismatch");
+      @(negedge clk);
+      host_rsp_ready = 1'b1;
+      @(posedge clk);
+      #1;
+      host_rsp_ready = 1'b0;
+      require_true(!host_rsp_valid, "second response duplicated");
+    end
+  endtask
+
+  task automatic check_reset_cancels_pending;
+    integer quiet_cycle;
+    begin
+      // Cancel a response which is already being held for the host.
+      @(negedge clk);
+      host_req_addr = 17'h020a0;
+      host_req_write = 1'b0;
+      host_req_valid = 1'b1;
+      host_rsp_ready = 1'b0;
+      #1;
+      require_true(host_req_ready, "reset-response request not accepted");
+      @(posedge clk);
+      #1;
+      host_req_valid = 1'b0;
+      require_true(host_rsp_valid, "scalar response not pending before reset");
+      @(negedge clk);
+      reset = 1'b1;
+      @(posedge clk);
+      #1;
+      require_true(!host_rsp_valid, "reset did not cancel held response");
+      @(negedge clk);
+      reset = 1'b0;
+
+      // Cancel an index request after its low-half BRAM request was accepted
+      // but before the packed response could be assembled.
+      host_req_addr = 17'h02a00;
+      host_req_valid = 1'b1;
+      #1;
+      require_true(host_req_ready, "reset-index request not accepted");
+      @(posedge clk);
+      #1;
+      host_req_valid = 1'b0;
+      require_true(!host_rsp_valid, "index response appeared before both halves");
+      @(negedge clk);
+      reset = 1'b1;
+      @(posedge clk);
+      #1;
+      require_true(!host_rsp_valid, "reset did not cancel pending index read");
+      @(negedge clk);
+      reset = 1'b0;
+
+      for (quiet_cycle = 0; quiet_cycle < 3; quiet_cycle = quiet_cycle + 1) begin
+        @(posedge clk);
+        #1;
+        require_true(!host_rsp_valid, "cancelled response leaked after reset");
+      end
+    end
+  endtask
+
+  integer address_iterator;
+  integer byte_offset;
+  initial begin
+    $display("R1H_MMIO_INTEGRATION_EXHAUSTIVE_BEGIN");
+    #1;
+    require_true(!r1h_req_ready && !r1h_rsp_valid,
+                 "R1h service advertised request/response during reset");
+    repeat (3) @(posedge clk);
+    #1;
+    reset = 1'b0;
+
+    check_reset_cancels_pending();
+    check_order_and_busy_rejection();
+
+    // Every aligned address in the complete R1f/R1g page, including reserved
+    // holes, must return the exact R1g value in order.  Backpressure varies by
+    // address and covers zero through four held cycles.
+    for (address_iterator = 17'h020a0;
+         address_iterator <= 17'h035fc;
+         address_iterator = address_iterator + 4)
+      read_and_compare(address_iterator[16:0],
+                       (address_iterator >> 2) % 5);
+
+    // Every unaligned byte address in the same page is an accepted local read
+    // whose implicit status is OKAY and whose value is deterministic zero.
+    for (address_iterator = 17'h020a0;
+         address_iterator <= 17'h035fc;
+         address_iterator = address_iterator + 4) begin
+      for (byte_offset = 1; byte_offset <= 3; byte_offset = byte_offset + 1) begin
+        read_and_compare((address_iterator + byte_offset),
+                         (address_iterator + byte_offset) % 3);
+        require_true(reference_read_data == 32'b0,
+                     "exact R1g unaligned reference was not zero");
+        unaligned_count = unaligned_count + 1;
+      end
+    end
+
+    // Writes are not part of the diagnostic read service.  Exhaustively prove
+    // that every aligned address retains R1g forwarding semantics.
+    for (address_iterator = 17'h020a0;
+         address_iterator <= 17'h035fc;
+         address_iterator = address_iterator + 4)
+      check_forwarded_write(address_iterator[16:0]);
+
+    require_true(read_count == 5472,
+                 "unexpected exhaustive diagnostic read count");
+    require_true(unaligned_count == 4104,
+                 "unexpected exhaustive unaligned read count");
+    require_true(write_count == 1368,
+                 "unexpected exhaustive forwarded-write count");
+
+    $display("R1H_MMIO_INTEGRATION_EXHAUSTIVE_PASS aligned_reads=1368 unaligned_reads=%0d forwarded_writes=%0d ordering_pairs=1 reset_cancellations=2",
+             unaligned_count, write_count);
+    $finish;
+  end
+
+  initial begin
+    #5_000_000;
+    $fatal(1, "timeout");
+  end
+endmodule
diff --git a/tests/v41/tb_r1h_mmio_read_service.sv b/tests/v41/tb_r1h_mmio_read_service.sv
new file mode 100644
index 0000000..31c0f5f
--- /dev/null
+++ b/tests/v41/tb_r1h_mmio_read_service.sv
@@ -0,0 +1,378 @@
+`timescale 1ns/1ps
+
+module tb_r1h_mmio_read_service;
+  logic clk = 1'b0;
+  logic reset = 1'b1;
+
+  logic        req_valid = 1'b0;
+  logic        req_ready;
+  logic [13:0] req_offset = 14'b0;
+  logic        rsp_valid;
+  logic        rsp_ready = 1'b0;
+  logic [31:0] rsp_data;
+
+  logic [31:0] scalar_read_data = 32'b0;
+  logic        record_select = 1'b0;
+  logic [5:0]  record_index = 6'b0;
+  logic [2:0]  record_word = 3'b0;
+  logic        probe_index_select = 1'b0;
+  logic [1:0]  probe_index_phase = 2'b0;
+  logic [7:0]  probe_index_word = 8'b0;
+
+  logic        record_read_enable;
+  logic [5:0]  record_read_index;
+  logic [2:0]  record_read_word;
+  logic        record_read_valid = 1'b0;
+  logic [31:0] record_read_data = 32'b0;
+
+  logic        index_read_enable;
+  logic [1:0]  index_read_phase;
+  logic [8:0]  index_read_address;
+  logic        index_read_valid = 1'b0;
+  logic [15:0] index_read_data = 16'b0;
+  logic [15:0] waddr_index_stored_count = 16'b0;
+  logic [15:0] regaddr_index_stored_count = 16'b0;
+  logic [15:0] data_index_stored_count = 16'b0;
+
+  integer accepted_count = 0;
+  integer consumed_count = 0;
+
+  always #5 clk = ~clk;
+
+  always @(posedge clk) begin
+    if (!reset) begin
+      if (req_valid && req_ready)
+        accepted_count <= accepted_count + 1;
+      if (rsp_valid && rsp_ready)
+        consumed_count <= consumed_count + 1;
+    end
+  end
+
+  v41_r1h_mmio_read_service dut (
+    .clk(clk),
+    .reset(reset),
+    .req_valid(req_valid),
+    .req_ready(req_ready),
+    .req_offset(req_offset),
+    .rsp_valid(rsp_valid),
+    .rsp_ready(rsp_ready),
+    .rsp_data(rsp_data),
+    .scalar_read_data(scalar_read_data),
+    .record_select(record_select),
+    .record_index(record_index),
+    .record_word(record_word),
+    .probe_index_select(probe_index_select),
+    .probe_index_phase(probe_index_phase),
+    .probe_index_word(probe_index_word),
+    .record_read_enable(record_read_enable),
+    .record_read_index(record_read_index),
+    .record_read_word(record_read_word),
+    .record_read_valid(record_read_valid),
+    .record_read_data(record_read_data),
+    .index_read_enable(index_read_enable),
+    .index_read_phase(index_read_phase),
+    .index_read_address(index_read_address),
+    .index_read_valid(index_read_valid),
+    .index_read_data(index_read_data),
+    .waddr_index_stored_count(waddr_index_stored_count),
+    .regaddr_index_stored_count(regaddr_index_stored_count),
+    .data_index_stored_count(data_index_stored_count)
+  );
+
+  task automatic require_true(input logic condition, input string message);
+    begin
+      if (condition !== 1'b1) begin
+        $display("FAIL: %s", message);
+        $fatal(1);
+      end
+    end
+  endtask
+
+  task automatic clear_request;
+    begin
+      req_valid = 1'b0;
+      req_offset = 14'b0;
+      scalar_read_data = 32'b0;
+      record_select = 1'b0;
+      record_index = 6'b0;
+      record_word = 3'b0;
+      probe_index_select = 1'b0;
+      probe_index_phase = 2'b0;
+      probe_index_word = 8'b0;
+    end
+  endtask
+
+  task automatic clear_memory_response;
+    begin
+      record_read_valid = 1'b0;
+      record_read_data = 32'b0;
+      index_read_valid = 1'b0;
+      index_read_data = 16'b0;
+    end
+  endtask
+
+  task automatic synchronous_reset;
+    begin
+      @(negedge clk);
+      clear_request();
+      clear_memory_response();
+      rsp_ready = 1'b0;
+      reset = 1'b1;
+      @(posedge clk);
+      #1;
+      require_true(!req_ready, "service must not accept a request during reset");
+      require_true(!rsp_valid, "reset must cancel any pending response");
+      require_true(!record_read_enable, "reset must not leave a record request asserted");
+      require_true(!index_read_enable, "reset must not leave an index request asserted");
+      reset = 1'b0;
+      #1;
+      require_true(req_ready, "service did not return to IDLE after reset release");
+    end
+  endtask
+
+  task automatic start_scalar(input logic [13:0] offset,
+                              input logic [31:0] value);
+    begin
+      @(negedge clk);
+      req_offset = offset;
+      scalar_read_data = value;
+      record_select = 1'b0;
+      probe_index_select = 1'b0;
+      req_valid = 1'b1;
+      #1;
+      require_true(req_ready, "scalar request must be accepted from IDLE");
+      @(posedge clk);
+      #1;
+      clear_request();
+      require_true(rsp_valid, "scalar response must be registered after request acceptance");
+      require_true(rsp_data == value, "scalar response data mismatch");
+      require_true(!req_ready, "service must not accept another request while response is pending");
+    end
+  endtask
+
+  task automatic start_record(input logic [5:0] index_value,
+                              input logic [2:0] word_value);
+    begin
+      @(negedge clk);
+      req_offset = 14'h2400 + ((index_value * 6 + word_value) << 2);
+      record_select = 1'b1;
+      record_index = index_value;
+      record_word = word_value;
+      probe_index_select = 1'b0;
+      req_valid = 1'b1;
+      #1;
+      require_true(req_ready, "record request must be accepted from IDLE");
+      require_true(record_read_enable, "accepted record request must pulse BRAM enable");
+      require_true(record_read_index == index_value, "record BRAM row mismatch");
+      require_true(record_read_word == word_value, "record BRAM bank mismatch");
+      @(posedge clk);
+      #1;
+      clear_request();
+      require_true(!req_ready, "record wait must block a second request");
+      require_true(!rsp_valid, "record response must wait for record_read_valid");
+      require_true(!record_read_enable, "record BRAM request must be a single-cycle pulse");
+    end
+  endtask
+
+  task automatic complete_record(input logic [31:0] value);
+    begin
+      @(negedge clk);
+      record_read_data = value;
+      record_read_valid = 1'b1;
+      @(posedge clk);
+      #1;
+      record_read_valid = 1'b0;
+      require_true(rsp_valid, "record response missing after record_read_valid");
+      require_true(rsp_data == value, "record response data mismatch");
+      require_true(!req_ready, "pending record response must block requests");
+    end
+  endtask
+
+  task automatic start_index(input logic [1:0] phase_value,
+                             input logic [7:0] word_value,
+                             input logic [15:0] count_value);
+    begin
+      @(negedge clk);
+      case (phase_value)
+        2'd0: waddr_index_stored_count = count_value;
+        2'd1: regaddr_index_stored_count = count_value;
+        2'd2: data_index_stored_count = count_value;
+        default: begin end
+      endcase
+      req_offset = 14'h2A00 + ({6'b0, word_value} << 2);
+      record_select = 1'b0;
+      probe_index_select = 1'b1;
+      probe_index_phase = phase_value;
+      probe_index_word = word_value;
+      req_valid = 1'b1;
+      #1;
+      require_true(req_ready, "index request must be accepted from IDLE");
+      require_true(index_read_enable, "accepted index request must issue low-half read");
+      require_true(index_read_phase == phase_value, "low-half phase mismatch");
+      require_true(index_read_address == {word_value, 1'b0}, "low-half address mismatch");
+      @(posedge clk);
+      #1;
+      clear_request();
+      require_true(!req_ready, "index low wait must block a second request");
+      require_true(!rsp_valid, "packed index response must wait for both halves");
+      require_true(!index_read_enable, "low-half request must be a single-cycle pulse");
+    end
+  endtask
+
+  task automatic complete_index_low(input logic [15:0] value,
+                                    input logic [1:0] expected_phase,
+                                    input logic [8:0] expected_high_address);
+    begin
+      @(negedge clk);
+      index_read_data = value;
+      index_read_valid = 1'b1;
+      #1;
+      require_true(index_read_enable, "low-half completion must issue high-half read");
+      require_true(index_read_phase == expected_phase, "high-half phase must use latched phase");
+      require_true(index_read_address == expected_high_address, "high-half address mismatch");
+      @(posedge clk);
+      #1;
+      index_read_valid = 1'b0;
+      require_true(!rsp_valid, "index response must not appear after only the low half");
+      require_true(!req_ready, "index high wait must block a second request");
+      require_true(!index_read_enable, "high-half BRAM request must be a single-cycle pulse");
+    end
+  endtask
+
+  task automatic complete_index_high(input logic [15:0] value,
+                                     input logic [31:0] expected_value);
+    begin
+      @(negedge clk);
+      index_read_data = value;
+      index_read_valid = 1'b1;
+      @(posedge clk);
+      #1;
+      index_read_valid = 1'b0;
+      require_true(rsp_valid, "packed index response missing after high-half completion");
+      require_true(rsp_data == expected_value, "packed index response or masking mismatch");
+      require_true(!req_ready, "pending packed index response must block requests");
+    end
+  endtask
+
+  task automatic verify_busy_rejects_second_request;
+    begin
+      @(negedge clk);
+      req_valid = 1'b1;
+      req_offset = 14'h20A0;
+      scalar_read_data = 32'hBAD0_BAD0;
+      record_select = 1'b0;
+      probe_index_select = 1'b0;
+      #1;
+      require_true(!req_ready, "busy service exposed request ready");
+      require_true(!record_read_enable, "rejected busy request emitted record enable");
+      require_true(!index_read_enable, "rejected busy request emitted index enable");
+      @(posedge clk);
+      #1;
+      clear_request();
+    end
+  endtask
+
+  task automatic hold_response_and_consume(input logic [31:0] expected_value,
+                                           input integer hold_cycles);
+    integer cycle_index;
+    begin
+      rsp_ready = 1'b0;
+      for (cycle_index = 0; cycle_index < hold_cycles; cycle_index = cycle_index + 1) begin
+        @(posedge clk);
+        #1;
+        require_true(rsp_valid, "response valid dropped under backpressure");
+        require_true(rsp_data == expected_value, "response data changed under backpressure");
+        require_true(!req_ready, "service accepted a request under response backpressure");
+      end
+      @(negedge clk);
+      rsp_ready = 1'b1;
+      #1;
+      require_true(rsp_valid, "response vanished before ready handshake");
+      @(posedge clk);
+      #1;
+      rsp_ready = 1'b0;
+      require_true(!rsp_valid, "response duplicated after one ready handshake");
+      require_true(req_ready, "service did not return to IDLE after response handshake");
+    end
+  endtask
+
+  initial begin
+    $display("R1H_MMIO_TEST_BEGIN");
+    #1;
+    require_true(!req_ready && !rsp_valid,
+                 "service advertised request/response during reset");
+    synchronous_reset();
+
+    // Registered scalar response, arbitrary response backpressure and stability.
+    start_scalar(14'h20A0, 32'hDEAD_BEEF);
+    verify_busy_rejects_second_request();
+    hold_response_and_consume(32'hDEAD_BEEF, 3);
+
+    // Record path: request pulse, arbitrary memory latency and stable response.
+    start_record(6'd13, 3'd4);
+    verify_busy_rejects_second_request();
+    repeat (2) begin
+      @(posedge clk);
+      #1;
+      require_true(!rsp_valid, "record wait completed without record_read_valid");
+    end
+    complete_record(32'hA50D_0401);
+    hold_response_and_consume(32'hA50D_0401, 2);
+
+    // Packed index read.  Count is snapshotted at acceptance: changing the live
+    // REGADDR count to zero cannot suppress either already-valid half.
+    start_index(2'd1, 8'd1, 16'd4);
+    regaddr_index_stored_count = 16'd0;
+    complete_index_low(16'h2222, 2'd1, 9'd3);
+    complete_index_high(16'h3333, 32'h3333_2222);
+    hold_response_and_consume(32'h3333_2222, 1);
+
+    // Both addresses are beyond the request-time stored count and therefore
+    // read as deterministic zero despite non-zero physical payload outputs.
+    start_index(2'd0, 8'd4, 16'd2);
+    complete_index_low(16'h8888, 2'd0, 9'd9);
+    complete_index_high(16'h9999, 32'h0000_0000);
+    hold_response_and_consume(32'h0000_0000, 1);
+
+    // Last odd stored entry: index 4 is valid and index 5 is unused.  Growing
+    // the live count after acceptance must not expose the upper half.
+    start_index(2'd2, 8'd2, 16'd5);
+    data_index_stored_count = 16'd6;
+    complete_index_low(16'h4444, 2'd2, 9'd5);
+    complete_index_high(16'h5555, 32'h0000_4444);
+    hold_response_and_consume(32'h0000_4444, 2);
+
+    // Reset must cancel each pending state without leaking or duplicating a
+    // response.  These cancelled requests are intentionally not consumed.
+    start_record(6'd7, 3'd2);
+    synchronous_reset();
+
+    start_index(2'd0, 8'd3, 16'd8);
+    synchronous_reset();
+
+    start_index(2'd1, 8'd5, 16'd12);
+    complete_index_low(16'hAAAA, 2'd1, 9'd11);
+    synchronous_reset();
+
+    start_scalar(14'h21FC, 32'hC0DE_CAFE);
+    synchronous_reset();
+
+    // Service remains usable after all reset-abort paths.
+    start_scalar(14'h20A4, 32'h1357_9BDF);
+    hold_response_and_consume(32'h1357_9BDF, 1);
+
+    require_true(accepted_count == 10,
+                 "unexpected accepted-request count (lost or duplicate acceptance)");
+    require_true(consumed_count == 6,
+                 "unexpected consumed-response count (lost or duplicate response)");
+
+    $display("R1H_MMIO_READ_SERVICE_PASS accepted=%0d consumed=%0d reset_cancelled=4",
+             accepted_count, consumed_count);
+    $finish;
+  end
+
+  initial begin
+    #20000;
+    $fatal(1, "timeout");
+  end
+endmodule
diff --git a/tests/v41/tb_r1h_probe_index_bram_store.sv b/tests/v41/tb_r1h_probe_index_bram_store.sv
new file mode 100644
index 0000000..3316278
--- /dev/null
+++ b/tests/v41/tb_r1h_probe_index_bram_store.sv
@@ -0,0 +1,116 @@
+`timescale 1ns/1ps
+
+module tb_r1h_probe_index_bram_store;
+  logic clk = 1'b0;
+  logic rst = 1'b1;
+  logic write_valid = 1'b0;
+  logic [1:0] write_phase = 2'b0;
+  logic [8:0] write_address = 9'b0;
+  logic [15:0] write_data = 16'b0;
+  logic read_req = 1'b0;
+  logic [1:0] read_phase = 2'b0;
+  logic [8:0] read_address = 9'b0;
+  logic read_valid;
+  logic [15:0] read_data;
+
+  always #5 clk = ~clk;
+
+  r1h_probe_index_bram_store dut (.*);
+
+  function automatic logic [15:0] payload_value(
+    input integer phase_number,
+    input integer entry_number
+  );
+    payload_value = {phase_number[1:0], 5'b10101, entry_number[8:0]};
+  endfunction
+
+  task automatic write_entry(
+    input logic [1:0] phase_number,
+    input logic [8:0] entry_number,
+    input logic [15:0] value
+  );
+    begin
+      @(negedge clk);
+      write_phase = phase_number;
+      write_address = entry_number;
+      write_data = value;
+      write_valid = 1'b1;
+      @(posedge clk);
+      #1;
+      @(negedge clk);
+      write_valid = 1'b0;
+    end
+  endtask
+
+  task automatic expect_entry(
+    input logic [1:0] phase_number,
+    input logic [8:0] entry_number,
+    input logic [15:0] expected
+  );
+    begin
+      @(negedge clk);
+      read_phase = phase_number;
+      read_address = entry_number;
+      read_req = 1'b1;
+      @(posedge clk);
+      #1;
+      if (!read_valid || read_data !== expected)
+        $fatal(1,
+               "probe index BRAM mismatch phase=%0d entry=%0d valid=%b actual=%04x expected=%04x",
+               phase_number, entry_number, read_valid, read_data, expected);
+      @(negedge clk);
+      read_req = 1'b0;
+    end
+  endtask
+
+  initial begin : run_test
+    integer phase_number;
+    integer entry_number;
+
+    repeat (4) @(posedge clk);
+    rst <= 1'b0;
+
+    for (phase_number = 0; phase_number < 3; phase_number = phase_number + 1)
+      for (entry_number = 0; entry_number < 512; entry_number = entry_number + 1)
+        write_entry(phase_number[1:0], entry_number[8:0],
+                    payload_value(phase_number, entry_number));
+
+    for (phase_number = 0; phase_number < 3; phase_number = phase_number + 1)
+      for (entry_number = 0; entry_number < 512; entry_number = entry_number + 1)
+        expect_entry(phase_number[1:0], entry_number[8:0],
+                     payload_value(phase_number, entry_number));
+
+    // A write into one physical bank must not perturb a simultaneous read from
+    // another bank.
+    @(negedge clk);
+    write_valid = 1'b1;
+    write_phase = 2'd1;
+    write_address = 9'd100;
+    write_data = 16'hbeef;
+    read_req = 1'b1;
+    read_phase = 2'd2;
+    read_address = 9'd100;
+    @(posedge clk);
+    #1;
+    if (!read_valid || read_data !== payload_value(2, 100))
+      $fatal(1, "independent-bank concurrent read/write failed");
+    @(negedge clk);
+    write_valid = 1'b0;
+    read_req = 1'b0;
+    expect_entry(2'd1, 9'd100, 16'hbeef);
+
+    // Invalid phase requests still complete deterministically with zero.
+    expect_entry(2'd3, 9'd0, 16'h0000);
+
+    // Reset clears only the output-valid pipeline, never payload RAM.
+    @(negedge clk);
+    rst = 1'b1;
+    repeat (2) @(posedge clk);
+    @(negedge clk);
+    rst = 1'b0;
+    expect_entry(2'd1, 9'd100, 16'hbeef);
+
+    $display("R1H_PROBE_INDEX_BRAM_STORE_PASS entries=1536 banks=3");
+    $finish;
+  end
+endmodule
