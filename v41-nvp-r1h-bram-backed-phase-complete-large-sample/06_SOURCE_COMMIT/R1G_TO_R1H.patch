+    read_data = 16'b0;
+    if (read_valid) begin
+      case (read_phase_q)
+        2'd0: read_data = read_bank_data[0];
+        2'd1: read_data = read_bank_data[1];
+        2'd2: read_data = read_bank_data[2];
+        default: read_data = 16'b0;
+      endcase
