diff --git a/tests/v41/r1g_measurement_regs_reference.sv b/tests/v41/r1g_measurement_regs_reference.sv
new file mode 100644
index 0000000..ac8214a
--- /dev/null
+++ b/tests/v41/r1g_measurement_regs_reference.sv
@@ -0,0 +1,260 @@
+`timescale 1ns/1ps
+
+// Read-only R1f map decoder. Storage remains behind narrow submodule read
+// ports; no log or index array is flattened through this interface.
+module v41_r1g_measurement_regs_reference #(
+  parameter logic [7:0] SAFE_PROBE_BANK = 8'h00,
+  parameter logic [7:0] SAFE_PROBE_REGISTER = 8'h00,
+  parameter logic [7:0] SAFE_PROBE_DATA = 8'h00,
+  parameter logic       SAFE_PROBE_TARGET_PROVEN = 1'b0
+) (
+  input  logic [13:0] offset,
+
+  input  logic [31:0] autoinit_waddr_opportunities,
+  input  logic [31:0] autoinit_waddr_nacks,
+  input  logic [31:0] autoinit_regaddr_opportunities,
+  input  logic [31:0] autoinit_regaddr_nacks,
+  input  logic [31:0] autoinit_data_opportunities,
+  input  logic [31:0] autoinit_data_nacks,
+  input  logic [31:0] autoinit_raddr_opportunities,
+  input  logic [31:0] autoinit_raddr_nacks,
+  input  logic [31:0] autoinit_transaction_starts,
+  input  logic [31:0] autoinit_transaction_completions,
+  input  logic [31:0] autoinit_failed_transactions,
+  input  logic [31:0] autoinit_timeout_transactions,
+  input  logic        phase_counters_final,
+  input  logic        phase_counter_saturation,
+  input  logic [31:0] legacy_aggregate_nack_count,
+  input  logic        legacy_first8_reconciliation_supported,
+
+  input  logic [31:0] failed_txn_total_count,
+  input  logic [6:0]  failed_txn_stored_count,
+  input  logic        failed_txn_overflow,
+  input  logic [15:0] first_failed_txn_index,
+  input  logic        first_failed_txn_index_valid,
+  input  logic [15:0] last_failed_txn_index,
+  input  logic        last_failed_txn_index_valid,
+  input  logic [15:0] next_transaction_serial,
+  input  logic        transaction_serial_overflow,
+  input  logic        failed_txn_total_count_saturated,
+  input  logic        failed_txn_input_protocol_error,
+
+  input  logic [31:0] bank_invariant_check_count,
+  input  logic [31:0] bank_invariant_error_count,
+  input  logic [31:0] first_bank_invariant_error,
+  input  logic [7:0]  final_physical_bank,
+  input  logic        final_physical_bank_valid,
+
+  input  logic [31:0] tri_phase_probe_status,
+  input  logic [31:0] probe_timeout_count_total,
+  input  logic [31:0] probe_setup_restore_status,
+  input  logic [7:0]  safe_target_pre_readback,
+  input  logic        safe_target_pre_readback_valid,
+  input  logic [7:0]  safe_target_post_readback,
+  input  logic        safe_target_post_readback_valid,
+  input  logic [7:0]  original_bank_readback,
+  input  logic        original_bank_readback_valid,
+  input  logic [7:0]  restored_bank_readback,
+  input  logic        restored_bank_readback_valid,
+  input  logic        restored_bank_verified,
+  input  logic [47:0] probe_start_freerun,
+  input  logic [47:0] probe_done_freerun,
+
+  output logic [6:0]  probe_detail_read_word,
+  output logic        probe_detail_read_select,
+  input  logic [31:0] probe_detail_read_data,
+
+  output logic [5:0]  record_read_index,
+  output logic [2:0]  record_read_word,
+  input  logic [31:0] record_read_data,
+
+  output logic [1:0]  probe_index_read_phase,
+  output logic [7:0]  probe_index_read_word,
+  output logic        probe_index_read_select,
+  input  logic [31:0] probe_index_read_data,
+
+  output logic [31:0] read_data
+);
+  localparam logic [31:0] R1F_MAGIC = 32'h31463152;
+  localparam logic [31:0] R1F_VERSION = 32'd1;
+  localparam logic [31:0] R1F_CAPABILITIES = 32'h000007ff;
+
+  logic [33:0] phase_nack_sum_wide;
+  logic phase_nacks_le_opportunities;
+  logic transaction_counts_coherent;
+  logic log_stored_count_coherent;
+  logic [31:0] phase_counter_status;
+  logic [31:0] phase_reconciliation_status;
+  logic [31:0] log_status;
+  logic [14:0] record_byte_delta;
+  logic [8:0] record_linear_word;
+
+  always_comb begin
+    phase_nack_sum_wide = {2'b0, autoinit_waddr_nacks} +
+                          {2'b0, autoinit_regaddr_nacks} +
+                          {2'b0, autoinit_data_nacks} +
+                          {2'b0, autoinit_raddr_nacks};
+    phase_nacks_le_opportunities =
+        autoinit_waddr_nacks <= autoinit_waddr_opportunities &&
+        autoinit_regaddr_nacks <= autoinit_regaddr_opportunities &&
+        autoinit_data_nacks <= autoinit_data_opportunities &&
+        autoinit_raddr_nacks <= autoinit_raddr_opportunities;
+    transaction_counts_coherent =
+        autoinit_transaction_completions <= autoinit_transaction_starts &&
+        autoinit_failed_transactions <= autoinit_transaction_completions &&
+        autoinit_timeout_transactions <= autoinit_failed_transactions;
+    log_stored_count_coherent =
+        failed_txn_total_count < 32'd64
+          ? failed_txn_stored_count == failed_txn_total_count[6:0]
+          : failed_txn_stored_count == 7'd64;
+
+    phase_counter_status = 32'b0;
+    phase_counter_status[0] = phase_counters_final;
+    phase_counter_status[1] = !phase_counter_saturation;
+    phase_counter_status[2] = phase_nacks_le_opportunities;
+    phase_counter_status[3] = transaction_counts_coherent;
+
+    phase_reconciliation_status = 32'b0;
+    phase_reconciliation_status[0] =
+        phase_nack_sum_wide == {2'b0, legacy_aggregate_nack_count};
+    // Static capability bit only.  The host reader performs the measured
+    // legacy-first-eight reconciliation from both raw record sets.
+    phase_reconciliation_status[1] = legacy_first8_reconciliation_supported;
+    phase_reconciliation_status[2] =
+        autoinit_failed_transactions == failed_txn_total_count;
+
+    log_status = 32'b0;
+    log_status[0] = first_failed_txn_index_valid;
+    log_status[1] = last_failed_txn_index_valid;
+    log_status[2] = failed_txn_overflow;
+    log_status[3] = autoinit_failed_transactions == failed_txn_total_count;
+    log_status[4] = log_stored_count_coherent;
+    log_status[5] = 1'b1; // logger masks every unused entry to zero
+    log_status[6] = 1'b1; // append pointer never revisits a valid entry
+    log_status[7] = transaction_serial_overflow;
+    log_status[8] = failed_txn_input_protocol_error;
+    log_status[9] = failed_txn_total_count_saturated;
+  end
+
+  always_comb begin
+    probe_detail_read_word = 7'b0;
+    probe_detail_read_select = 1'b0;
+    record_read_index = 6'b0;
+    record_read_word = 3'b0;
+    probe_index_read_phase = 2'b0;
+    probe_index_read_word = 8'b0;
+    probe_index_read_select = 1'b0;
+    record_byte_delta = 15'b0;
+    record_linear_word = 9'b0;
+    read_data = 32'b0;
+
+    if (offset[1:0] != 2'b00) begin
+      read_data = 32'b0;
+    end else if (offset >= 14'h20a0 && offset <= 14'h21ff) begin
+      case (offset)
+        14'h20a0: read_data = R1F_MAGIC;
+        14'h20a4: read_data = R1F_VERSION;
+        14'h20a8: read_data = R1F_CAPABILITIES;
+        14'h20ac: read_data = 32'd1;
+        14'h20b0: read_data = 32'd192;
+        14'h20b4: read_data = 32'd6;
+        14'h20b8: read_data = 32'd64;
+        14'h20bc: read_data = 32'h00000007;
+        14'h20c0: read_data = {SAFE_PROBE_TARGET_PROVEN, 7'b0,
+                                  SAFE_PROBE_DATA, SAFE_PROBE_REGISTER,
+                                  SAFE_PROBE_BANK};
+        14'h20c4: read_data = 32'd25000;
+        14'h20c8: read_data = 32'd25000;
+        14'h20cc: read_data = 32'd10000;
+        14'h20d0: read_data = 32'd10;
+        14'h20d4: read_data = 32'd1000;
+        14'h20d8: read_data = 32'd12000;
+        14'h20dc: read_data = 32'd512;
+        14'h20e0: read_data = autoinit_waddr_opportunities;
+        14'h20e4: read_data = autoinit_waddr_nacks;
+        14'h20e8: read_data = autoinit_regaddr_opportunities;
+        14'h20ec: read_data = autoinit_regaddr_nacks;
+        14'h20f0: read_data = autoinit_data_opportunities;
+        14'h20f4: read_data = autoinit_data_nacks;
+        14'h20f8: read_data = autoinit_raddr_opportunities;
+        14'h20fc: read_data = autoinit_raddr_nacks;
+        14'h2100: read_data = autoinit_transaction_starts;
+        14'h2104: read_data = autoinit_transaction_completions;
+        14'h2108: read_data = autoinit_failed_transactions;
+        14'h210c: read_data = autoinit_timeout_transactions;
+        14'h2110: read_data = phase_counter_status;
+        14'h2114: read_data = legacy_aggregate_nack_count;
+        14'h2118: read_data = phase_nack_sum_wide[31:0];
+        14'h211c: read_data = phase_reconciliation_status;
+        14'h2120: read_data = failed_txn_total_count;
+        14'h2124: read_data = {25'b0, failed_txn_stored_count};
+        14'h2128: read_data = {31'b0, failed_txn_overflow};
+        14'h212c: read_data = {16'b0, first_failed_txn_index};
+        14'h2130: read_data = {16'b0, last_failed_txn_index};
+        14'h2134: read_data = log_status;
+        14'h2138: read_data = {15'b0, transaction_serial_overflow,
+                                  next_transaction_serial};
+        14'h213c: read_data = bank_invariant_check_count;
+        14'h2140: read_data = bank_invariant_error_count;
+        14'h2144: read_data = first_bank_invariant_error;
+        14'h2148: read_data = {23'b0, final_physical_bank_valid,
+                                  final_physical_bank};
+        14'h214c: read_data = tri_phase_probe_status;
+        14'h2150: read_data = probe_timeout_count_total;
+        14'h2154: read_data = probe_setup_restore_status;
+        14'h2158: read_data = {23'b0, safe_target_pre_readback_valid,
+                                  safe_target_pre_readback};
+        14'h215c: read_data = {23'b0, safe_target_post_readback_valid,
+                                  safe_target_post_readback};
+        14'h2160: read_data = {23'b0, original_bank_readback_valid,
+                                  original_bank_readback};
+        14'h2164: read_data = {22'b0, restored_bank_verified,
+                                  restored_bank_readback_valid,
+                                  restored_bank_readback};
+        14'h2168: read_data = probe_start_freerun[31:0];
+        14'h216c: read_data = {16'b0, probe_start_freerun[47:32]};
+        14'h2170: read_data = probe_done_freerun[31:0];
+        14'h2174: read_data = {16'b0, probe_done_freerun[47:32]};
+        default: read_data = 32'b0;
+      endcase
+    end else if (offset >= 14'h2200 && offset <= 14'h23ff) begin
+      probe_detail_read_select = 1'b1;
+      probe_detail_read_word = (offset - 14'h2200) >> 2;
+      read_data = probe_detail_read_data;
+    end else if (offset >= 14'h2400 && offset <= 14'h29ff) begin
+      record_byte_delta = offset - 14'h2400;
+      record_linear_word = record_byte_delta[10:2];
+      record_read_index = record_linear_word / 6;
+      record_read_word = record_linear_word % 6;
+      read_data = record_read_data;
+    end else if (offset >= 14'h2a00 && offset <= 14'h2dff) begin
+      probe_index_read_select = 1'b1;
+      probe_index_read_phase = 2'd0;
+      probe_index_read_word = (offset - 14'h2a00) >> 2;
+      read_data = probe_index_read_data;
+    end else if (offset >= 14'h2e00 && offset <= 14'h31ff) begin
+      probe_index_read_select = 1'b1;
+      probe_index_read_phase = 2'd1;
+      probe_index_read_word = (offset - 14'h2e00) >> 2;
+      read_data = probe_index_read_data;
+    end else if (offset >= 14'h3200 && offset <= 14'h35ff) begin
+      probe_index_read_select = 1'b1;
+      probe_index_read_phase = 2'd2;
+      probe_index_read_word = (offset - 14'h3200) >> 2;
+      read_data = probe_index_read_data;
+    end
+  end
+endmodule
+
+// Fixture-only source model of the exact formal Phase-2 decode over the R1f
+// address region. The source proof is that SLOT_COUNT=2 sends slot-2/3 reads
+// through the deterministic-zero branch. This module is never instantiated in
+// the R1f image; it exists for exhaustive host/map fixture compilation.
+module v41_r1g_formal_zero_model_reference (
+  input  logic [13:0] offset,
+  output logic [31:0] read_data
+);
+  always_comb begin
+    read_data = 32'b0;
+  end
+endmodule
diff --git a/tests/v41/r1h_memory_inference_top.sv b/tests/v41/r1h_memory_inference_top.sv
new file mode 100644
index 0000000..43c6c38
--- /dev/null
+++ b/tests/v41/r1h_memory_inference_top.sv
@@ -0,0 +1,69 @@
+`timescale 1ns/1ps
+
+// Verification-only OOC synthesis top.  Every payload write/read and metadata
+// signal is kept at the boundary so the two R1h storage wrappers cannot be
+// optimized away during the pre-commit memory-mapping check.
+module r1h_memory_inference_top (
+  input  logic         clk,
+  input  logic         reset,
+  input  logic         failed_valid,
+  input  logic [191:0] failed_record,
+  input  logic         record_read_enable,
+  input  logic [5:0]   record_read_index,
+  input  logic [2:0]   record_read_word,
+  output logic         record_read_valid,
+  output logic [31:0]  record_read_data,
+  output logic [31:0]  failed_total_count,
+  output logic [6:0]   failed_stored_count,
+  output logic         failed_overflow,
+  output logic [15:0]  first_failed_index,
+  output logic         first_failed_valid,
+  output logic [15:0]  last_failed_index,
+  output logic         last_failed_valid,
+  output logic         total_saturated,
+  output logic         protocol_error,
+  input  logic         index_write_valid,
+  input  logic [1:0]   index_write_phase,
+  input  logic [8:0]   index_write_address,
+  input  logic [15:0]  index_write_data,
+  input  logic         index_read_req,
+  input  logic [1:0]   index_read_phase,
+  input  logic [8:0]   index_read_address,
+  output logic         index_read_valid,
+  output logic [15:0]  index_read_data
+);
+  v41_r1f_failed_txn_logger FAILED_RECORD_STORE (
+    .clk,
+    .reset,
+    .r1f_failed_txn_valid(failed_valid),
+    .r1f_failed_txn_record(failed_record),
+    .record_read_enable,
+    .record_read_index,
+    .record_read_word,
+    .record_read_valid,
+    .record_read_data,
+    .total_count(failed_total_count),
+    .stored_count(failed_stored_count),
+    .overflow(failed_overflow),
+    .first_failed_txn_index(first_failed_index),
+    .first_failed_txn_index_valid(first_failed_valid),
+    .last_failed_txn_index(last_failed_index),
+    .last_failed_txn_index_valid(last_failed_valid),
+    .total_count_saturated(total_saturated),
+    .input_protocol_error(protocol_error)
+  );
+
+  r1h_probe_index_bram_store PROBE_INDEX_STORE (
+    .clk,
+    .rst(reset),
+    .write_valid(index_write_valid),
+    .write_phase(index_write_phase),
+    .write_address(index_write_address),
+    .write_data(index_write_data),
+    .read_req(index_read_req),
+    .read_phase(index_read_phase),
+    .read_address(index_read_address),
+    .read_valid(index_read_valid),
+    .read_data(index_read_data)
+  );
+endmodule
