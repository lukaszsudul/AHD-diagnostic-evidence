   assign tri_block_read_index = r1f_probe_detail_read_word[4:0] - 5'd19;
-  assign tri_index_read_phase = r1f_probe_index_read_phase;
-  assign tri_index_read_word = r1f_probe_index_read_word;
-
   always_comb begin
     integer phase_number;
     logic [4:0] phase_word;
@@ -773,7 +787,7 @@ module ahd_capture_top_xdma #(
     .SAFE_PROBE_BANK(8'h00), .SAFE_PROBE_REGISTER(8'h85),
     .SAFE_PROBE_DATA(8'h00), .SAFE_PROBE_TARGET_PROVEN(1'b1)
   ) R1F_MEASUREMENT_REGS (
-    .offset(host_req_addr[13:0]),
+    .offset(r1h_req_offset),
     .autoinit_waddr_opportunities(r1f_phase_counters[31:0]),
     .autoinit_waddr_nacks(r1f_phase_counters[63:32]),
     .autoinit_regaddr_opportunities(r1f_phase_counters[95:64]),
@@ -823,16 +837,46 @@ module ahd_capture_top_xdma #(
     .probe_detail_read_word(r1f_probe_detail_read_word),
     .probe_detail_read_select(r1f_probe_detail_read_select),
     .probe_detail_read_data(r1f_probe_detail_read_data),
-    .record_read_index(r1f_record_read_index),
-    .record_read_word(r1f_record_read_word),
-    .record_read_data(r1f_record_read_data),
+    .record_read_index(r1f_record_decode_index),
+    .record_read_word(r1f_record_decode_word),
+    .record_read_select(r1f_record_read_select),
     .probe_index_read_phase(r1f_probe_index_read_phase),
     .probe_index_read_word(r1f_probe_index_read_word),
     .probe_index_read_select(r1f_probe_index_read_select),
-    .probe_index_read_data(tri_index_read_data),
     .read_data(r1f_read_data)
   );
 
+  // The complete R1f/R1h page uses one registered, one-outstanding read
+  // service.  Scalar values are captured at request acceptance; record words
+  // use one BRAM read and packed index words use two ordered BRAM reads.
+  v41_r1h_mmio_read_service R1H_MMIO_READ_SERVICE (
+    .clk(axi_aclk), .reset((~axi_aresetn) || nvp_por_reset),
+    .req_valid(r1h_req_valid), .req_ready(r1h_req_ready),
+    .req_offset(r1h_req_offset),
+    .rsp_valid(r1h_rsp_valid), .rsp_ready(r1h_rsp_ready),
+    .rsp_data(r1h_rsp_data),
+    .scalar_read_data(r1f_read_data),
+    .record_select(r1f_record_read_select),
+    .record_index(r1f_record_decode_index),
+    .record_word(r1f_record_decode_word),
+    .probe_index_select(r1f_probe_index_read_select),
+    .probe_index_phase(r1f_probe_index_read_phase),
+    .probe_index_word(r1f_probe_index_read_word),
+    .record_read_enable(r1f_record_read_enable),
+    .record_read_index(r1f_record_read_index),
+    .record_read_word(r1f_record_read_word),
+    .record_read_valid(r1f_record_read_valid),
+    .record_read_data(r1f_record_read_data),
+    .index_read_enable(tri_index_read_req),
+    .index_read_phase(tri_index_read_phase),
+    .index_read_address(tri_index_read_address),
+    .index_read_valid(tri_index_read_valid),
+    .index_read_data(tri_index_read_data),
+    .waddr_index_stored_count(tri_waddr_index_stored_count),
+    .regaddr_index_stored_count(tri_regaddr_index_stored_count),
+    .data_index_stored_count(tri_data_index_stored_count)
+  );
+
   v41_r1e_measurement_regs R1E_MEASUREMENT_REGS (
     .offset(host_req_addr[7:0]),
     .freerun_count(lifecycle_freerun_count),
@@ -910,7 +954,10 @@ module ahd_capture_top_xdma #(
     .app_rsp_valid(app_rsp_valid), .app_rsp_ready(app_rsp_ready),
     .app_rsp_rdata(app_rsp_rdata),
     .measurement_read_data(measurement_read_data),
-    .r1f_read_data(r1f_read_data),
+    .r1h_req_valid(r1h_req_valid), .r1h_req_ready(r1h_req_ready),
+    .r1h_req_offset(r1h_req_offset),
+    .r1h_rsp_valid(r1h_rsp_valid), .r1h_rsp_ready(r1h_rsp_ready),
+    .r1h_rsp_data(r1h_rsp_data),
     .capture_request_busy(telemetry_capture_request_busy),
     .capture_busy(telemetry_capture_busy),
     .capture_armed(telemetry_capture_armed),
diff --git a/rtl/v41/control_status_regs.sv b/rtl/v41/control_status_regs.sv
index 370fa72..0a6141c 100644
--- a/rtl/v41/control_status_regs.sv
+++ b/rtl/v41/control_status_regs.sv
@@ -36,7 +36,13 @@ module v41_control_status_regs #(
   input  logic [31:0] app_rsp_rdata,
 
   input  logic [31:0] measurement_read_data,
-  input  logic [31:0] r1f_read_data,
+
+  output logic        r1h_req_valid,
+  input  logic        r1h_req_ready,
+  output logic [13:0] r1h_req_offset,
+  input  logic        r1h_rsp_valid,
+  output logic        r1h_rsp_ready,
+  input  logic [31:0] r1h_rsp_data,
 
   input  logic        capture_request_busy,
   input  logic        capture_busy,
@@ -90,11 +96,11 @@ module v41_control_status_regs #(
   wire         measurement_read_select = !host_req_write &&
                                           host_req_addr >= 17'h02000 &&
                                           host_req_addr <= 17'h0209f;
-  wire         r1f_read_select = !host_req_write &&
+  wire         r1h_read_select = !host_req_write &&
                                  host_req_addr >= 17'h020a0 &&
                                  host_req_addr <= 17'h035ff;
   wire         local_select = (host_req_addr[16:8] == 9'b0) ||
-                              measurement_read_select || r1f_read_select;
+                              measurement_read_select || r1h_read_select;
 
   function automatic [31:0] apply_be(
     input [31:0] old_value, input [31:0] new_value, input [3:0] be);
@@ -185,11 +191,16 @@ module v41_control_status_regs #(
   assign app_req_addr = host_req_addr;
   assign app_req_wdata = host_req_wdata;
   assign app_req_be = host_req_be;
-  assign host_req_ready = local_select ? !local_rsp_valid : app_req_ready;
+  assign r1h_req_valid = host_req_valid && r1h_read_select;
+  assign r1h_req_offset = host_req_addr[13:0];
+  assign host_req_ready = r1h_read_select ? r1h_req_ready :
+                          local_select ? !local_rsp_valid : app_req_ready;
 
-  assign host_rsp_valid = local_rsp_valid || app_rsp_valid;
-  assign host_rsp_rdata = local_rsp_valid ? local_rsp_rdata : app_rsp_rdata;
-  assign app_rsp_ready = host_rsp_ready && !local_rsp_valid;
+  assign host_rsp_valid = local_rsp_valid || r1h_rsp_valid || app_rsp_valid;
+  assign host_rsp_rdata = local_rsp_valid ? local_rsp_rdata :
+                          r1h_rsp_valid ? r1h_rsp_data : app_rsp_rdata;
+  assign r1h_rsp_ready = host_rsp_ready && !local_rsp_valid;
+  assign app_rsp_ready = host_rsp_ready && !local_rsp_valid && !r1h_rsp_valid;
 
   always_ff @(posedge clk) begin
     if (reset) begin
@@ -200,13 +211,13 @@ module v41_control_status_regs #(
       if (local_rsp_valid && host_rsp_ready)
         local_rsp_valid <= 1'b0;
 
-      if (host_req_valid && host_req_ready && local_select) begin
+      if (host_req_valid && host_req_ready && local_select &&
+          !r1h_read_select) begin
         if (host_req_write) begin
           if (host_req_addr[7:0] == 8'h34)
             scratch_rw <= apply_be(scratch_rw, host_req_wdata, host_req_be);
         end else begin
           local_rsp_rdata <= host_req_addr[1:0] != 2'b00 ? 32'b0 :
-                             r1f_read_select ? r1f_read_data :
                              measurement_read_select ? measurement_read_data :
                              local_read(host_req_addr[7:0]);
           local_rsp_valid <= 1'b1;
diff --git a/rtl/v41/nvp_i2c_tri_phase_probe.sv b/rtl/v41/nvp_i2c_tri_phase_probe.sv
index 13b55e9..6fe85f2 100644
--- a/rtl/v41/nvp_i2c_tri_phase_probe.sv
+++ b/rtl/v41/nvp_i2c_tri_phase_probe.sv
@@ -125,9 +125,11 @@ module nvp_i2c_tri_phase_probe #(
   output logic        regaddr_nack_index_overflow,
   output logic        data_nack_index_overflow,
 
+  input  logic        index_read_req,
   input  logic [1:0]  index_read_phase,
-  input  logic [7:0]  index_read_word,
-  output logic [31:0] index_read_data,
+  input  logic [8:0]  index_read_address,
+  output logic        index_read_valid,
+  output logic [15:0] index_read_data,
   input  logic [1:0]  block_read_phase,
   input  logic [3:0]  block_read_index,
   output logic [31:0] block_read_nack_count
@@ -649,10 +651,21 @@ module nvp_i2c_tri_phase_probe #(
   logic [31:0] consecutive_nacks [0:2];
   logic previous_outcome_valid [0:2];
   logic previous_outcome_nack [0:2];
+  // Completed blocks are sparse, single-write records.  With payload reset
+  // removed this 30x32 array is eligible for distributed RAM; separate valid
+  // metadata supplies deterministic zero for blocks that have not completed.
+  (* ram_style = "distributed" *)
   logic [31:0] block_nack_count [0:2][0:BLOCK_COUNT_PER_PHASE-1];
-  logic [15:0] nack_index_memory [0:2][0:NACK_INDEX_CAPACITY_PER_PHASE-1];
+  logic block_nack_count_valid [0:2][0:BLOCK_COUNT_PER_PHASE-1];
+  logic [31:0] block_live_nack_count [0:2];
+  logic [15:0] block_opportunity_position [0:2];
+  logic [3:0] block_current_index [0:2];
   logic [15:0] nack_index_stored_count [0:2];
   logic nack_index_overflow [0:2];
+  logic        index_payload_write_valid;
+  logic [1:0]  index_payload_write_phase;
+  logic [8:0]  index_payload_write_address;
+  logic [15:0] index_payload_write_data;
 
   logic [31:0] reg_prereq_waddr_opportunities;
   logic [31:0] reg_prereq_waddr_acks;
@@ -666,7 +679,24 @@ module nvp_i2c_tri_phase_probe #(
 
   integer reset_phase;
   integer reset_block;
-  integer target_block;
+
+  // Three physically independent 512x16 BRAM-backed payload stores.  The
+  // scientific count/overflow metadata remains local to this module; payload
+  // RAM is never reset and is exposed only through one synchronous entry-read
+  // port for the R1h one-outstanding MMIO service.
+  r1h_probe_index_bram_store INDEX_PAYLOAD_STORE (
+    .clk,
+    .rst,
+    .write_valid(index_payload_write_valid),
+    .write_phase(index_payload_write_phase),
+    .write_address(index_payload_write_address),
+    .write_data(index_payload_write_data),
+    .read_req(index_read_req),
+    .read_phase(index_read_phase),
+    .read_address(index_read_address),
+    .read_valid(index_read_valid),
+    .read_data(index_read_data)
+  );
 
   task automatic launch_transaction(
     input logic [1:0] kind,
@@ -706,10 +736,33 @@ module nvp_i2c_tri_phase_probe #(
     input integer phase_number,
     input logic outcome_nack
   );
-    integer block_number;
+    logic [31:0] next_block_nack_count;
     begin
-      block_number = target_opportunities[phase_number] / BLOCK_SIZE;
+      next_block_nack_count = block_live_nack_count[phase_number] +
+                              (outcome_nack ? 32'd1 : 32'd0);
       target_opportunities[phase_number] <= target_opportunities[phase_number] + 1'b1;
+
+      // Track the ten fixed-size blocks without division or modulo logic.
+      // The completing opportunity commits the updated count exactly once;
+      // the next opportunity starts the next block from zero.
+      if (block_opportunity_position[phase_number] + 1'b1 >= BLOCK_SIZE) begin
+        if (block_current_index[phase_number] < BLOCK_COUNT_PER_PHASE) begin
+          block_nack_count[phase_number][block_current_index[phase_number]] <=
+            next_block_nack_count;
+          block_nack_count_valid[phase_number][block_current_index[phase_number]] <=
+            1'b1;
+        end
+        block_live_nack_count[phase_number] <= 32'b0;
+        block_opportunity_position[phase_number] <= 16'b0;
+        if (block_current_index[phase_number] < BLOCK_COUNT_PER_PHASE)
+          block_current_index[phase_number] <=
+            block_current_index[phase_number] + 1'b1;
+      end else begin
+        block_live_nack_count[phase_number] <= next_block_nack_count;
+        block_opportunity_position[phase_number] <=
+          block_opportunity_position[phase_number] + 1'b1;
+      end
+
       if (!previous_outcome_valid[phase_number]) begin
         previous_outcome_valid[phase_number] <= 1'b1;
         previous_outcome_nack[phase_number] <= outcome_nack;
@@ -734,13 +787,13 @@ module nvp_i2c_tri_phase_probe #(
         if (consecutive_nacks[phase_number] + 1'b1 >
             max_consecutive_nacks[phase_number])
           max_consecutive_nacks[phase_number] <= consecutive_nacks[phase_number] + 1'b1;
-        if (block_number < BLOCK_COUNT_PER_PHASE)
-          block_nack_count[phase_number][block_number] <=
-            block_nack_count[phase_number][block_number] + 1'b1;
         if (nack_index_stored_count[phase_number] <
             NACK_INDEX_CAPACITY_PER_PHASE) begin
-          nack_index_memory[phase_number][nack_index_stored_count[phase_number]] <=
-            target_opportunities[phase_number][15:0];
+          index_payload_write_valid <= 1'b1;
+          index_payload_write_phase <= phase_number[1:0];
+          index_payload_write_address <=
+            nack_index_stored_count[phase_number][8:0];
+          index_payload_write_data <= target_opportunities[phase_number][15:0];
           nack_index_stored_count[phase_number] <=
             nack_index_stored_count[phase_number] + 1'b1;
         end else begin
@@ -804,6 +857,10 @@ module nvp_i2c_tri_phase_probe #(
       data_prereq_regaddr_opportunities_i <= 32'b0;
       data_prereq_regaddr_acks_i <= 32'b0;
       data_prereq_regaddr_nacks_i <= 32'b0;
+      index_payload_write_valid <= 1'b0;
+      index_payload_write_phase <= 2'b0;
+      index_payload_write_address <= 9'b0;
+      index_payload_write_data <= 16'b0;
       for (reset_phase = 0; reset_phase < 3; reset_phase = reset_phase + 1) begin
         transaction_attempts[reset_phase] <= 32'b0;
         target_opportunities[reset_phase] <= 32'b0;
@@ -820,12 +877,16 @@ module nvp_i2c_tri_phase_probe #(
         previous_outcome_nack[reset_phase] <= 1'b0;
         nack_index_stored_count[reset_phase] <= 16'b0;
         nack_index_overflow[reset_phase] <= 1'b0;
+        block_live_nack_count[reset_phase] <= 32'b0;
+        block_opportunity_position[reset_phase] <= 16'b0;
+        block_current_index[reset_phase] <= 4'b0;
         for (reset_block = 0; reset_block < BLOCK_COUNT_PER_PHASE;
              reset_block = reset_block + 1)
-          block_nack_count[reset_phase][reset_block] <= 32'b0;
+          block_nack_count_valid[reset_phase][reset_block] <= 1'b0;
       end
     end else begin
       ll_start <= 1'b0;
+      index_payload_write_valid <= 1'b0;
       if (init_done)
         legacy_init_done_seen_i <= 1'b1;
       case (high_state)
@@ -1173,27 +1234,13 @@ module nvp_i2c_tri_phase_probe #(
     regaddr_nack_index_overflow = nack_index_overflow[1];
     data_nack_index_overflow = nack_index_overflow[2];
 
-    // Each 32-bit MMIO word packs two chronological 16-bit, zero-based
-    // target-opportunity indices: {index[2w+1], index[2w]}.  Stored-count
-    // bounds force every unused half-word to deterministic zero.
-    index_read_data = 32'b0;
-    if (index_read_phase < 3) begin
-      if ({index_read_word, 1'b0} < NACK_INDEX_CAPACITY_PER_PHASE &&
-          {index_read_word, 1'b0} <
-            nack_index_stored_count[index_read_phase])
