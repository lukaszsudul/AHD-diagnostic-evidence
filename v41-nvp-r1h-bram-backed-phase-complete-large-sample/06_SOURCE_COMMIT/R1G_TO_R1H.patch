+    .autoinit_data_nacks(DATA_NACKS),
+    .autoinit_raddr_opportunities(RADDR_OPPORTUNITIES),
+    .autoinit_raddr_nacks(RADDR_NACKS),
+    .autoinit_transaction_starts(TX_STARTS),
+    .autoinit_transaction_completions(TX_COMPLETIONS),
+    .autoinit_failed_transactions(FAILED_TXNS),
+    .autoinit_timeout_transactions(TIMEOUT_TXNS),
+    .phase_counters_final(1'b1),
+    .phase_counter_saturation(1'b0),
+    .legacy_aggregate_nack_count(LEGACY_NACKS),
+    .legacy_first8_reconciliation_supported(1'b1),
+    .failed_txn_total_count(FAILED_TXNS),
+    .failed_txn_stored_count(7'd64),
+    .failed_txn_overflow(1'b0),
+    .first_failed_txn_index(16'h0123),
+    .first_failed_txn_index_valid(1'b1),
+    .last_failed_txn_index(16'h4567),
+    .last_failed_txn_index_valid(1'b1),
+    .next_transaction_serial(16'h89ab),
+    .transaction_serial_overflow(1'b0),
+    .failed_txn_total_count_saturated(1'b0),
+    .failed_txn_input_protocol_error(1'b0),
+    .bank_invariant_check_count(BANK_CHECKS),
+    .bank_invariant_error_count(BANK_ERRORS),
+    .first_bank_invariant_error(FIRST_BANK_ERROR),
+    .final_physical_bank(8'hcd),
+    .final_physical_bank_valid(1'b1),
+    .tri_phase_probe_status(PROBE_STATUS),
+    .probe_timeout_count_total(PROBE_TIMEOUTS),
+    .probe_setup_restore_status(SETUP_RESTORE),
+    .safe_target_pre_readback(8'h12),
+    .safe_target_pre_readback_valid(1'b1),
+    .safe_target_post_readback(8'h34),
+    .safe_target_post_readback_valid(1'b1),
+    .original_bank_readback(8'h56),
+    .original_bank_readback_valid(1'b1),
+    .restored_bank_readback(8'h78),
+    .restored_bank_readback_valid(1'b1),
+    .restored_bank_verified(1'b1),
+    .probe_start_freerun(48'h0123_4567_89ab),
+    .probe_done_freerun(48'hcdef_0123_4567),
+    .probe_detail_read_word(candidate_detail_word),
+    .probe_detail_read_select(candidate_detail_select),
+    .probe_detail_read_data(candidate_detail_data),
+    .record_read_index(candidate_record_index),
+    .record_read_word(candidate_record_word),
+    .record_read_select(candidate_record_select),
+    .probe_index_read_phase(candidate_index_phase),
+    .probe_index_read_word(candidate_index_word),
+    .probe_index_read_select(candidate_index_select),
+    .read_data(candidate_scalar_data)
+  );
+
+  // Exact R1g decoder, compiled from commit e112a5add... with only its module
+  // identifier macro-renamed.  Its combinational payload inputs are the oracle
+  // for the latency-insensitive R1g-to-R1h transaction comparison.
+  v41_r1g_measurement_regs_reference #(
+    .SAFE_PROBE_BANK(8'h00),
+    .SAFE_PROBE_REGISTER(8'h85),
+    .SAFE_PROBE_DATA(8'h00),
+    .SAFE_PROBE_TARGET_PROVEN(1'b1)
+  ) reference_decoder (
+    .offset(host_req_addr[13:0]),
+    .autoinit_waddr_opportunities(WADDR_OPPORTUNITIES),
+    .autoinit_waddr_nacks(WADDR_NACKS),
+    .autoinit_regaddr_opportunities(REGADDR_OPPORTUNITIES),
+    .autoinit_regaddr_nacks(REGADDR_NACKS),
+    .autoinit_data_opportunities(DATA_OPPORTUNITIES),
+    .autoinit_data_nacks(DATA_NACKS),
+    .autoinit_raddr_opportunities(RADDR_OPPORTUNITIES),
+    .autoinit_raddr_nacks(RADDR_NACKS),
+    .autoinit_transaction_starts(TX_STARTS),
+    .autoinit_transaction_completions(TX_COMPLETIONS),
+    .autoinit_failed_transactions(FAILED_TXNS),
+    .autoinit_timeout_transactions(TIMEOUT_TXNS),
+    .phase_counters_final(1'b1),
+    .phase_counter_saturation(1'b0),
+    .legacy_aggregate_nack_count(LEGACY_NACKS),
+    .legacy_first8_reconciliation_supported(1'b1),
+    .failed_txn_total_count(FAILED_TXNS),
+    .failed_txn_stored_count(7'd64),
+    .failed_txn_overflow(1'b0),
+    .first_failed_txn_index(16'h0123),
+    .first_failed_txn_index_valid(1'b1),
+    .last_failed_txn_index(16'h4567),
+    .last_failed_txn_index_valid(1'b1),
+    .next_transaction_serial(16'h89ab),
+    .transaction_serial_overflow(1'b0),
+    .failed_txn_total_count_saturated(1'b0),
+    .failed_txn_input_protocol_error(1'b0),
+    .bank_invariant_check_count(BANK_CHECKS),
+    .bank_invariant_error_count(BANK_ERRORS),
+    .first_bank_invariant_error(FIRST_BANK_ERROR),
+    .final_physical_bank(8'hcd),
+    .final_physical_bank_valid(1'b1),
+    .tri_phase_probe_status(PROBE_STATUS),
+    .probe_timeout_count_total(PROBE_TIMEOUTS),
+    .probe_setup_restore_status(SETUP_RESTORE),
+    .safe_target_pre_readback(8'h12),
+    .safe_target_pre_readback_valid(1'b1),
+    .safe_target_post_readback(8'h34),
+    .safe_target_post_readback_valid(1'b1),
+    .original_bank_readback(8'h56),
+    .original_bank_readback_valid(1'b1),
+    .restored_bank_readback(8'h78),
+    .restored_bank_readback_valid(1'b1),
+    .restored_bank_verified(1'b1),
+    .probe_start_freerun(48'h0123_4567_89ab),
+    .probe_done_freerun(48'hcdef_0123_4567),
+    .probe_detail_read_word(reference_detail_word),
+    .probe_detail_read_select(reference_detail_select),
+    .probe_detail_read_data(reference_detail_data),
+    .record_read_index(reference_record_index),
+    .record_read_word(reference_record_word),
+    .record_read_data(reference_record_data),
+    .probe_index_read_phase(reference_index_phase),
