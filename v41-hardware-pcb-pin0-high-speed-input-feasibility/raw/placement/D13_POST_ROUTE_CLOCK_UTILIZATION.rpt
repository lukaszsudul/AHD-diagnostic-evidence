# Location of BUFG Primitives 
set_property LOC BUFGCTRL_X0Y16 [get_cells u_ref27_bufg]

# Location of BUFIO Primitives 
set_property LOC BUFIO_X0Y0 [get_cells u_vclk2_bufio]
set_property LOC BUFIO_X0Y4 [get_cells u_vclk1_bufio]

# Location of BUFR Primitives 
set_property LOC BUFR_X0Y1 [get_cells u_vclk2_bufr]
set_property LOC BUFR_X0Y5 [get_cells u_vclk1_bufr]

# Location of IO Primitives which is load of clock spine

# Location of clock ports
set_property LOC IOB_X0Y78 [get_ports ref27]
set_property LOC IOB_X0Y72 [get_ports vclk1]
set_property LOC IOB_X0Y22 [get_ports vclk2]

# Clock net "vclk2_div" driven by instance "u_vclk2_bufr" located at site "BUFR_X0Y1"
#startgroup
create_pblock {CLKAG_vclk2_div}
add_cells_to_pblock [get_pblocks  {CLKAG_vclk2_div}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL } -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="vclk2_div"}]]]
resize_pblock [get_pblocks {CLKAG_vclk2_div}] -add {CLOCKREGION_X0Y0:CLOCKREGION_X0Y0}
#endgroup

# Clock net "vclk1_div" driven by instance "u_vclk1_bufr" located at site "BUFR_X0Y5"
#startgroup
create_pblock {CLKAG_vclk1_div}
add_cells_to_pblock [get_pblocks  {CLKAG_vclk1_div}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL } -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="vclk1_div"}]]]
resize_pblock [get_pblocks {CLKAG_vclk1_div}] -add {CLOCKREGION_X0Y1:CLOCKREGION_X0Y1}
#endgroup

# Clock net "ref27_global" driven by instance "u_ref27_bufg" located at site "BUFGCTRL_X0Y16"
#startgroup
create_pblock {CLKAG_ref27_global}
add_cells_to_pblock [get_pblocks  {CLKAG_ref27_global}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL } -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="ref27_global"}]]]
