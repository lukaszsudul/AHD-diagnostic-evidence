+
+function Get-AbsoluteAsciiPath {
+    param(
+        [Parameter(Mandatory = $true)][string]$Path,
+        [Parameter(Mandatory = $true)][string]$Label,
+        [switch]$MustExist
+    )
+    if ([string]::IsNullOrWhiteSpace($Path)) {
+        throw "$Label is required"
+    }
+    $full = [IO.Path]::GetFullPath($Path)
+    if ($full -notmatch '^[A-Za-z]:\\' -or $full -match '[^\x20-\x7e]' -or
+        $full -match '["&|<>^%!]') {
+        throw "$Label must be an absolute, ASCII-only Windows path without cmd metacharacters: $full"
+    }
+    if ($MustExist -and -not (Test-Path -LiteralPath $full)) {
+        throw "$Label does not exist: $full"
+    }
+    return $full.TrimEnd([char]'\', [char]'/')
+}
