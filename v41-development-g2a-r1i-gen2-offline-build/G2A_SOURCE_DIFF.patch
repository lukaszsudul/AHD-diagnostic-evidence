+    foreach ($marker in @(
+        'FULL_BUILD', 'PROVENANCE_ONLY', 'G2A_EXPECTED_RUNTIME_PROVENANCE.txt',
+        'PROVENANCE_ROUND_TRIP=PASS', 'PROVENANCE_PREFLIGHT=PASS',
+        'PROVENANCE_ONLY_EXIT_BEFORE_BUILD=PASS',
+        'set reconstructed_commit [join $git_words ""]',
+        'enforce_gen2_xdma_pipe_cdc_disposition',
+        'PASS_EXACT_GEN2_XDMA_PIPE_CLOCK_MUX',
+        'BROAD_CDC_WAIVER_APPLIED=NO')) {
+        Assert-Contract -Name ("G2A_HARNESS_MARKER_" + ($marker -replace '[^A-Za-z0-9]', '_').ToUpperInvariant()) `
+            -Condition ($g2aBuildText.Contains($marker)) -Details $marker
+    }
+    $earlyExitIndex = $g2aBuildText.IndexOf('PROVENANCE_ONLY_EXIT_BEFORE_BUILD=PASS', [StringComparison]::Ordinal)
+    $createProjectIndex = $g2aBuildText.IndexOf('create_project', [StringComparison]::Ordinal)
+    Assert-Contract -Name 'PROVENANCE_EXIT_TEXT_PRECEDES_PROJECT_COMMANDS' -Condition (
+        $earlyExitIndex -ge 0 -and $createProjectIndex -gt $earlyExitIndex
+    ) -Details "early_exit_index=$earlyExitIndex create_project_index=$createProjectIndex"
+    $forbiddenHardwarePattern = '(?im)^\s*(open_hw|connect_hw_server|open_hw_target|program_hw_devices|refresh_hw_device|close_hw_target|close_hw_manager)\b'
+    Assert-Contract -Name 'NO_HARDWARE_COMMAND_IN_G2A_HARNESS' -Condition (
+        -not [regex]::IsMatch($g2aBuildText, $forbiddenHardwarePattern)
+    ) -Details 'No hardware-manager or programming Tcl command is executable from g2a_build.tcl.'
+
+    $pythonPath = $null
+    $pythonPrefix = @()
+    $vivadoRoot = Split-Path -Parent (Split-Path -Parent $VivadoBat)
+    $bundledPythonRoots = @(Get-ChildItem -LiteralPath (Join-Path $vivadoRoot 'tps/win64') `
+        -Directory -Filter 'python-*' -ErrorAction SilentlyContinue | Sort-Object Name -Descending)
+    foreach ($pythonRoot in $bundledPythonRoots) {
+        $candidate = Join-Path $pythonRoot.FullName 'python.exe'
+        if (Test-Path -LiteralPath $candidate) {
+            $pythonPath = $candidate
+            break
+        }
+    }
+    if ($null -eq $pythonPath) {
+        $pyLauncher = Get-Command py.exe -ErrorAction SilentlyContinue
+        if ($null -ne $pyLauncher -and $pyLauncher.Source -notmatch '\\WindowsApps\\') {
+            $pythonPath = $pyLauncher.Source
+            $pythonPrefix = @('-3')
+        }
+    }
+    if ($null -eq $pythonPath) {
+        $pathPython = Get-Command python.exe -ErrorAction SilentlyContinue
+        if ($null -ne $pathPython -and $pathPython.Source -notmatch '\\WindowsApps\\') {
+            $pythonPath = $pathPython.Source
+        }
+    }
+    Assert-Contract -Name 'PYTHON_INTERPRETER_AVAILABLE' -Condition ($null -ne $pythonPath) `
+        -Details $(if ($null -ne $pythonPath) { $pythonPath } else { 'No executable Python interpreter found; WindowsApps aliases are rejected.' })
+    $pythonTestFiles = @(Get-ChildItem -LiteralPath (Join-Path $RepoRoot 'tests/python') -Filter 'test_*.py' -File |
+        Sort-Object Name)
+    Assert-Contract -Name 'INHERITED_PYTHON_TESTS_DISCOVERED' -Condition ($pythonTestFiles.Count -gt 0) `
+        -Details "count=$($pythonTestFiles.Count)"
+    foreach ($testFile in $pythonTestFiles) {
+        $testLog = Join-Path $runRoot ("python_" + $testFile.BaseName + '.log')
+        $pythonResult = Invoke-OfflineChild -Executable $pythonPath `
+            -Arguments (@($pythonPrefix) + @($testFile.FullName)) -WorkingDirectory $RepoRoot `
+            -LogPath $testLog -ChildEnvironment $childEnvironment
+        Assert-Contract -Name ("PYTHON_TEST_" + $testFile.BaseName.ToUpperInvariant()) `
+            -Condition ($pythonResult.ExitCode -eq 0) `
+            -Details "exit=$($pythonResult.ExitCode) log=$testLog"
+    }
+    $script:Receipt.python_tests = 'PASS'
+
+    if ($SkipSim) {
+        $script:Receipt.focused_simulation = 'NOT_RUN'
+        Add-Check -Name 'R1I_FOCUSED_SIMULATION' -Status NOT_RUN -Details 'Explicit -SkipSim request.'
+    } else {
+        $focusedRunner = Join-Path $RepoRoot 'tests/v41/run_r1i_focused_sim.ps1'
+        # Reuse the current PowerShell host so its inherited PSModulePath stays
+        # compatible with the child.  Forcing Windows PowerShell from pwsh can
+        # hide Microsoft.PowerShell.Utility (and therefore Get-FileHash).
+        $powershellExe = [Diagnostics.Process]::GetCurrentProcess().MainModule.FileName
+        if ([string]::IsNullOrWhiteSpace($powershellExe) -or
+            -not (Test-Path -LiteralPath $powershellExe -PathType Leaf)) {
+            throw 'Unable to resolve the current PowerShell executable for the focused simulation child.'
+        }
+        $focusedEvidence = Join-Path $runRoot 'r1i_focused_sim'
+        $focusedLog = Join-Path $runRoot 'r1i_focused_sim.console.log'
+        $focusedResult = Invoke-OfflineChild -Executable $powershellExe -Arguments @(
+            '-NoLogo', '-NoProfile', '-NonInteractive', '-ExecutionPolicy', 'Bypass',
+            '-File', $focusedRunner,
+            '-RepoRoot', $RepoRoot,
+            '-EvidenceRoot', $focusedEvidence,
+            '-VivadoBin', (Split-Path -Parent $VivadoBat)
+        ) -WorkingDirectory $runRoot -LogPath $focusedLog -ChildEnvironment $childEnvironment
+        $focusedMarkers = $focusedResult.Combined -match 'PASS R1I_FOCUSED_WIRE_SEMANTIC_SUITE' -and
+            $focusedResult.Combined -match 'TEST_INPUT_HASHES_STABLE_DURING_COMPILE_AND_RUN=PASS'
+        Assert-Contract -Name 'R1I_FOCUSED_SIMULATION' -Condition (
+            $focusedResult.ExitCode -eq 0 -and $focusedMarkers
+        ) -Details "exit=$($focusedResult.ExitCode) markers=$focusedMarkers log=$focusedLog"
+        $script:Receipt.focused_simulation = 'PASS'
+    }
+
+    $statusBeforeProvenance = (Invoke-GitText -Arguments @(
+        'status', '--porcelain=v1', '--untracked-files=all'
+    )).Text
+    if ($PreCommit) {
+        $script:Receipt.provenance_tests = 'NOT_RUN'
+        Add-Check -Name 'PROVENANCE_HARNESS_RUNTIME_TESTS' -Status NOT_RUN `
+            -Details 'PreCommit mode: runtime provenance tests require a clean, committed four-file source tree.'
+    } else {
+        Assert-Contract -Name 'CLEAN_COMMITTED_SOURCE_FOR_PROVENANCE' -Condition (
+            [string]::IsNullOrWhiteSpace($statusBeforeProvenance)
+        ) -Details "git_status=$statusBeforeProvenance"
+        $vivadoVersionLog = Join-Path $runRoot 'vivado_version.log'
+        $vivadoVersion = Invoke-OfflineChild -Executable $VivadoBat -Arguments @('-version') `
+            -WorkingDirectory $runRoot -LogPath $vivadoVersionLog -ChildEnvironment $childEnvironment
+        Assert-Contract -Name 'EXACT_VIVADO_VERSION' -Condition (
+            $vivadoVersion.ExitCode -in @(0, 1) -and
+            $vivadoVersion.Combined -match 'Vivado\s+v2025\.2' -and
+            $vivadoVersion.Combined -match 'SW Build\s+6299465'
+        ) -Details "exit=$($vivadoVersion.ExitCode) log=$vivadoVersionLog"
+
+        $provenanceRoot = Join-Path $runRoot 'provenance_tests'
+        [void][IO.Directory]::CreateDirectory($provenanceRoot)
+        $sourceCommit = $head
+        $sourceTree = $headTree
+        $bitFilename = 'AHD_V41_G2A.bit'
+
+        $positiveRoot = Join-Path $provenanceRoot 'positive'
+        [void][IO.Directory]::CreateDirectory($positiveRoot)
+        $positiveBuild = Join-Path $positiveRoot 'build_must_not_exist'
+        $positiveEvidence = Join-Path $positiveRoot 'evidence'
+        $positiveLog = Join-Path $positiveRoot 'vivado.console.log'
+        $positiveResult = Invoke-OfflineChild -Executable $VivadoBat -Arguments @(
+            '-mode', 'batch', '-source', $g2aBuildPath,
+            '-log', (Join-Path $positiveRoot 'vivado.log'),
+            '-journal', (Join-Path $positiveRoot 'vivado.jou'),
+            '-tclargs', $RepoRoot, $positiveBuild, $positiveEvidence,
+            $sourceCommit, $sourceTree, $bitFilename, 'PROVENANCE_ONLY'
+        ) -WorkingDirectory $positiveRoot -LogPath $positiveLog -ChildEnvironment $childEnvironment
+        Assert-Contract -Name 'PROVENANCE_ONLY_POSITIVE_EXIT' -Condition ($positiveResult.ExitCode -eq 0) `
+            -Details "exit=$($positiveResult.ExitCode) log=$positiveLog"
+        $positiveReceipt = Join-Path $positiveEvidence 'G2A_EXPECTED_RUNTIME_PROVENANCE.txt'
+        Assert-Contract -Name 'PROVENANCE_ONLY_POSITIVE_RECEIPT_EXISTS' -Condition (Test-Path -LiteralPath $positiveReceipt) `
+            -Details $positiveReceipt
+        $positiveText = [IO.File]::ReadAllText($positiveReceipt)
+        foreach ($marker in @(
+            "SOURCE_COMMIT_REQUESTED=$sourceCommit",
+            "SOURCE_COMMIT_ACTUAL=$sourceCommit",
+            "SOURCE_TREE_REQUESTED=$sourceTree",
+            "SOURCE_TREE_ACTUAL=$sourceTree",
+            'PROVENANCE_ROUND_TRIP=PASS',
+            'PROVENANCE_PREFLIGHT=PASS',
+            'PROVENANCE_ONLY_EXIT_BEFORE_BUILD=PASS')) {
+            Assert-Contract -Name ("PROVENANCE_RECEIPT_" + ($marker.Split('=')[0] -replace '[^A-Za-z0-9]', '_').ToUpperInvariant()) `
+                -Condition ($positiveText.Contains($marker)) -Details $marker
+        }
+        for ($word = 0; $word -lt 5; $word++) {
+            $expectedWord = $sourceCommit.Substring($word * 8, 8)
+            Assert-Contract -Name "PROVENANCE_RECEIPT_GIT_SHA_W$word" -Condition (
+                $positiveText -match ("(?im)^GIT_SHA_W" + $word + "=(?:0x)?" + $expectedWord + '$')
+            ) -Details "word=$expectedWord"
+        }
+        Assert-NoProjectCreation -Name 'PROVENANCE_ONLY_POSITIVE_NO_PROJECT' `
+            -BuildRoot $positiveBuild -CaseRoot $positiveRoot
+
+        $invalidRoot = Join-Path $provenanceRoot 'invalid_mode'
+        [void][IO.Directory]::CreateDirectory($invalidRoot)
+        $invalidBuild = Join-Path $invalidRoot 'build_must_not_exist'
+        $invalidEvidence = Join-Path $invalidRoot 'evidence_must_not_exist'
+        $invalidLog = Join-Path $invalidRoot 'vivado.console.log'
+        $invalidResult = Invoke-OfflineChild -Executable $VivadoBat -Arguments @(
+            '-mode', 'batch', '-source', $g2aBuildPath,
+            '-log', (Join-Path $invalidRoot 'vivado.log'),
+            '-journal', (Join-Path $invalidRoot 'vivado.jou'),
+            '-tclargs', $RepoRoot, $invalidBuild, $invalidEvidence,
+            $sourceCommit, $sourceTree, $bitFilename, 'INVALID_MODE'
+        ) -WorkingDirectory $invalidRoot -LogPath $invalidLog -ChildEnvironment $childEnvironment
+        Assert-Contract -Name 'INVALID_MODE_NEGATIVE_REJECTED' -Condition (
+            $invalidResult.ExitCode -ne 0 -and
+            $invalidResult.Combined -match '(?i)(execution mode|PROVENANCE_ONLY|invalid mode)'
+        ) -Details "exit=$($invalidResult.ExitCode) log=$invalidLog"
+        Assert-NoProjectCreation -Name 'INVALID_MODE_NEGATIVE_NO_PROJECT' `
+            -BuildRoot $invalidBuild -CaseRoot $invalidRoot
+
+        $mismatchRoot = Join-Path $provenanceRoot 'round_trip_mismatch'
+        [void][IO.Directory]::CreateDirectory($mismatchRoot)
+        $mutatedHarness = Join-Path $mismatchRoot 'g2a_build_one_word_mismatch.tcl'
+        $mutationTarget = 'set reconstructed_commit [join $git_words ""]'
+        $mutationReplacement = @'
+set mutated_word [lindex $git_words 2]
+if {$mutated_word eq "00000000"} { set mutated_word "00000001" } else { set mutated_word "00000000" }
+set reconstructed_commit [join [lreplace $git_words 2 2 $mutated_word] ""]
+'@.TrimEnd()
+        $targetCount = [regex]::Matches($g2aBuildText, [regex]::Escape($mutationTarget)).Count
+        Assert-Contract -Name 'ROUND_TRIP_MUTATION_TARGET_SINGULAR' -Condition ($targetCount -eq 1) `
+            -Details "target_count=$targetCount"
+        $mutatedText = $g2aBuildText.Replace($mutationTarget, $mutationReplacement)
+        [IO.File]::WriteAllText($mutatedHarness, $mutatedText, $Utf8NoBom)
+        Assert-Contract -Name 'MUTATED_HARNESS_OUTSIDE_REPOSITORY' -Condition (
+            -not ($mutatedHarness + [IO.Path]::DirectorySeparatorChar).StartsWith(
+                $repoPrefix, [StringComparison]::OrdinalIgnoreCase)
+        ) -Details $mutatedHarness
+        $mismatchBuild = Join-Path $mismatchRoot 'build_must_not_exist'
+        $mismatchEvidence = Join-Path $mismatchRoot 'evidence_must_not_exist'
+        $mismatchLog = Join-Path $mismatchRoot 'vivado.console.log'
+        $mismatchResult = Invoke-OfflineChild -Executable $VivadoBat -Arguments @(
+            '-mode', 'batch', '-source', $mutatedHarness,
+            '-log', (Join-Path $mismatchRoot 'vivado.log'),
+            '-journal', (Join-Path $mismatchRoot 'vivado.jou'),
+            '-tclargs', $RepoRoot, $mismatchBuild, $mismatchEvidence,
+            $sourceCommit, $sourceTree, $bitFilename, 'PROVENANCE_ONLY'
+        ) -WorkingDirectory $mismatchRoot -LogPath $mismatchLog -ChildEnvironment $childEnvironment
+        Assert-Contract -Name 'ROUND_TRIP_ONE_WORD_MISMATCH_REJECTED' -Condition (
+            $mismatchResult.ExitCode -ne 0 -and
+            $mismatchResult.Combined -match '(?i)provenance round-trip mismatch'
+        ) -Details "exit=$($mismatchResult.ExitCode) log=$mismatchLog"
+        Assert-NoProjectCreation -Name 'ROUND_TRIP_MISMATCH_NO_PROJECT' `
+            -BuildRoot $mismatchBuild -CaseRoot $mismatchRoot
+        $script:Receipt.provenance_tests = 'PASS'
+    }
+
+    $statusAfter = (Invoke-GitText -Arguments @(
+        'status', '--porcelain=v1', '--untracked-files=all'
+    )).Text
+    Assert-Contract -Name 'SOURCE_TREE_UNCHANGED_BY_OFFLINE_TESTS' -Condition (
+        $statusAfter -ceq $statusBeforeProvenance
+    ) -Details "status_before=$statusBeforeProvenance status_after=$statusAfter"
+    $offlineActions = @('Git', 'offline Python fixtures')
+    if (-not $SkipSim) { $offlineActions += 'inherited xsim tools' }
+    if (-not $PreCommit) { $offlineActions += 'Vivado batch provenance mode' }
+    Add-Check -Name 'HARDWARE_PROHIBITION' -Status PASS `
+        -Details "Runner invoked only $($offlineActions -join ', '); no hardware command or network/DUT action exists."
+    $script:Receipt.hardware_accessed = $false
+    $script:Receipt.result = $(if ($PreCommit) { 'PASS_PRECOMMIT_STATIC' } else { 'PASS' })
+} catch {
+    $exitCode = 1
+    if (-not $script:FailureRecorded) {
+        Add-Check -Name 'RUNNER_EXCEPTION' -Status FAIL -Details $_.Exception.Message
+    }
+    $script:Receipt.first_failure = $_.Exception.Message
+    $script:Receipt.result = 'FAIL'
+} finally {
+    Write-Receipts
+}
+
+Write-Output "G2A_OFFLINE_CHECK_RESULT=$($script:Receipt.result)"
+Write-Output "G2A_OFFLINE_JSON_RECEIPT=$(Join-Path $EvidenceRoot 'G2A_OFFLINE_CHECK_RECEIPT.json')"
+Write-Output "G2A_OFFLINE_TEXT_RECEIPT=$(Join-Path $EvidenceRoot 'G2A_OFFLINE_CHECK_RECEIPT.txt')"
+if ($exitCode -ne 0) {
+    Write-Error $script:Receipt.first_failure
+}
+exit $exitCode
