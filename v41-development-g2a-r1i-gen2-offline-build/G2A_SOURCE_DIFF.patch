+    evidence_root = $EvidenceRoot
+    run_root = $null
+    base_commit = $BaseCommit
+    base_tree = $BaseTree
+    integration_branch = $IntegrationBranch
+    integration_head = $null
+    integration_tree = $null
+    changed_files = @()
+    child_environment = [ordered]@{
+        XILINX_LOCAL_USER_DATA = 'NO'
