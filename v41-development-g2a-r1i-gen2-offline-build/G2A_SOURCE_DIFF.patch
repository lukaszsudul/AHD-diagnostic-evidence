+    exit 1
+}
+
+$Utf8NoBom = New-Object Text.UTF8Encoding($false)
+$script:FailureRecorded = $false
+$script:Receipt = [ordered]@{
+    task = 'AHD_V41_G2A_OFFLINE_CONTRACT_CHECKS'
+    result = 'RUNNING'
