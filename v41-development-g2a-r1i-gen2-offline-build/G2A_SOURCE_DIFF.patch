+
+function Add-Check {
+    param(
+        [Parameter(Mandatory = $true)][string]$Name,
+        [Parameter(Mandatory = $true)][ValidateSet('PASS', 'FAIL', 'NOT_RUN')][string]$Status,
+        [string]$Details = ''
+    )
+    $script:Receipt.checks += [ordered]@{
+        name = $Name
+        status = $Status
+        details = [string]$Details
+    }
+    Write-Output "CHECK=$Name STATUS=$Status DETAILS=$Details"
+}
+
+function Assert-Contract {
+    param(
+        [Parameter(Mandatory = $true)][string]$Name,
+        [Parameter(Mandatory = $true)][bool]$Condition,
+        [Parameter(Mandatory = $true)][string]$Details
+    )
+    if ($Condition) {
+        Add-Check -Name $Name -Status PASS -Details $Details
+        return
+    }
+    Add-Check -Name $Name -Status FAIL -Details $Details
+    $script:FailureRecorded = $true
+    throw "CHECK_FAILED[$Name]: $Details"
+}
+
+function Write-Receipts {
+    $script:Receipt.ended_utc = [DateTime]::UtcNow.ToString('o')
+    $jsonPath = Join-Path $EvidenceRoot 'G2A_OFFLINE_CHECK_RECEIPT.json'
+    $textPath = Join-Path $EvidenceRoot 'G2A_OFFLINE_CHECK_RECEIPT.txt'
+    [IO.File]::WriteAllText(
+        $jsonPath,
+        ($script:Receipt | ConvertTo-Json -Depth 12),
+        $Utf8NoBom)
+
+    $lines = New-Object Collections.Generic.List[string]
+    $lines.Add("TASK=$($script:Receipt.task)")
+    $lines.Add("RESULT=$($script:Receipt.result)")
+    $lines.Add("MODE=$($script:Receipt.mode)")
+    $lines.Add("BASE_COMMIT=$($script:Receipt.base_commit)")
+    $lines.Add("BASE_TREE=$($script:Receipt.base_tree)")
+    $lines.Add("INTEGRATION_BRANCH=$($script:Receipt.integration_branch)")
+    $lines.Add("INTEGRATION_HEAD=$($script:Receipt.integration_head)")
+    $lines.Add("INTEGRATION_TREE=$($script:Receipt.integration_tree)")
+    $lines.Add("PYTHON_TESTS=$($script:Receipt.python_tests)")
+    $lines.Add("FOCUSED_SIMULATION=$($script:Receipt.focused_simulation)")
+    $lines.Add("PROVENANCE_TESTS=$($script:Receipt.provenance_tests)")
+    $lines.Add('HARDWARE_ACCESSED=NO')
+    $lines.Add("FIRST_FAILURE=$($script:Receipt.first_failure)")
+    foreach ($check in @($script:Receipt.checks)) {
+        $detail = ([string]$check.details) -replace '[\r\n|]+', ' '
+        $lines.Add("CHECK|$($check.name)|$($check.status)|$detail")
+    }
+    [IO.File]::WriteAllLines($textPath, $lines, $Utf8NoBom)
+}
+
+function Invoke-GitText {
+    param(
+        [Parameter(Mandatory = $true)][string[]]$Arguments,
+        [int[]]$AllowedExitCodes = @(0)
+    )
+    $output = & git --no-optional-locks -c "safe.directory=$RepoRoot" -C $RepoRoot @Arguments 2>&1
+    $code = $LASTEXITCODE
+    $text = (@($output | ForEach-Object { [string]$_ }) -join "`n").TrimEnd()
+    if ($AllowedExitCodes -notcontains $code) {
+        throw "git $($Arguments -join ' ') failed with exit $code`: $text"
+    }
+    return [pscustomobject]@{ ExitCode = $code; Text = $text }
+}
+
+function Get-FileGitBlobSha1 {
+    param([Parameter(Mandatory = $true)][string]$LiteralPath)
+    $bytes = [IO.File]::ReadAllBytes($LiteralPath)
+    $header = [Text.Encoding]::ASCII.GetBytes("blob $($bytes.Length)`0")
+    $input = New-Object byte[] ($header.Length + $bytes.Length)
+    [Array]::Copy($header, 0, $input, 0, $header.Length)
+    [Array]::Copy($bytes, 0, $input, $header.Length, $bytes.Length)
+    $sha1 = [Security.Cryptography.SHA1]::Create()
+    try {
+        return (($sha1.ComputeHash($input) | ForEach-Object { $_.ToString('x2') }) -join '')
+    } finally {
+        $sha1.Dispose()
+    }
+}
+
+function Get-TclConfigDictionary {
+    param(
+        [Parameter(Mandatory = $true)][string]$Text,
+        [Parameter(Mandatory = $true)][string]$ProcedureName
+    )
+    $pattern = '(?ms)^\s*proc\s+' + [regex]::Escape($ProcedureName) +
+        '\s+\{\}\s+\{(?<body>.*?)^\}'
+    $procedure = [regex]::Match($Text, $pattern)
+    if (-not $procedure.Success) {
+        throw "Tcl procedure not found or malformed: $ProcedureName"
+    }
+    $values = @{}
+    foreach ($match in [regex]::Matches(
+            $procedure.Groups['body'].Value,
+            '(?m)^\s*(CONFIG\.[A-Za-z0-9_]+)\s+\{([^}\r\n]+)\}')) {
+        $key = $match.Groups[1].Value
+        if ($values.ContainsKey($key)) {
+            throw "duplicate property $key in Tcl procedure $ProcedureName"
+        }
+        $values[$key] = $match.Groups[2].Value
+    }
+    if ($values.Count -eq 0) {
+        throw "no CONFIG properties found in Tcl procedure $ProcedureName"
+    }
+    return $values
+}
+
+function Get-XciConfigValue {
+    param(
+        [Parameter(Mandatory = $true)]$ComponentParameters,
+        [Parameter(Mandatory = $true)][string]$Name
+    )
+    $property = $ComponentParameters.PSObject.Properties[$Name]
+    if ($null -eq $property -or $null -eq $property.Value -or $property.Value.Count -ne 1) {
+        throw "XCI property missing or not singular: CONFIG.$Name"
+    }
+    return [string]$property.Value[0].value
+}
+
+function Quote-CmdToken {
+    param([Parameter(Mandatory = $true)][string]$Token)
+    if ($Token -match '[\r\n"&|<>^%!]') {
+        throw "unsafe child-process argument rejected: $Token"
+    }
+    return [char]34 + $Token + [char]34
+}
+
+function Invoke-OfflineChild {
+    param(
+        [Parameter(Mandatory = $true)][string]$Executable,
+        [Parameter(Mandatory = $true)][string[]]$Arguments,
+        [Parameter(Mandatory = $true)][string]$WorkingDirectory,
+        [Parameter(Mandatory = $true)][string]$LogPath,
+        [Parameter(Mandatory = $true)][hashtable]$ChildEnvironment
+    )
+    $tokens = @($Executable) + $Arguments | ForEach-Object { Quote-CmdToken -Token ([string]$_) }
+    $psi = New-Object Diagnostics.ProcessStartInfo
+    $psi.FileName = $env:ComSpec
+    $psi.Arguments = '/d /s /c ' + [char]34 + ($tokens -join ' ') + [char]34
+    $psi.WorkingDirectory = $WorkingDirectory
+    $psi.UseShellExecute = $false
+    $psi.CreateNoWindow = $true
+    $psi.WindowStyle = [Diagnostics.ProcessWindowStyle]::Hidden
+    $psi.RedirectStandardOutput = $true
+    $psi.RedirectStandardError = $true
+    foreach ($key in $ChildEnvironment.Keys) {
+        $psi.EnvironmentVariables[[string]$key] = [string]$ChildEnvironment[$key]
+    }
+    $process = New-Object Diagnostics.Process
+    $process.StartInfo = $psi
+    try {
+        if (-not $process.Start()) {
+            throw "child process did not start: $Executable"
+        }
+        $stdoutTask = $process.StandardOutput.ReadToEndAsync()
+        $stderrTask = $process.StandardError.ReadToEndAsync()
+        $process.WaitForExit()
+        $stdout = $stdoutTask.GetAwaiter().GetResult()
+        $stderr = $stderrTask.GetAwaiter().GetResult()
+        $combined = $stdout
+        if (-not [string]::IsNullOrEmpty($stderr)) {
+            if (-not [string]::IsNullOrEmpty($combined)) { $combined += "`r`n" }
+            $combined += $stderr
+        }
+        [IO.File]::WriteAllText($LogPath, $combined, $Utf8NoBom)
+        return [pscustomobject]@{
+            ExitCode = $process.ExitCode
+            Stdout = $stdout
+            Stderr = $stderr
+            Combined = $combined
+        }
+    } finally {
+        $process.Dispose()
+    }
+}
+
+function Assert-NoProjectCreation {
+    param(
+        [Parameter(Mandatory = $true)][string]$Name,
+        [Parameter(Mandatory = $true)][string]$BuildRoot,
+        [Parameter(Mandatory = $true)][string]$CaseRoot
+    )
+    $projectArtifacts = @()
+    if (Test-Path -LiteralPath $CaseRoot) {
+        $projectArtifacts = @(Get-ChildItem -LiteralPath $CaseRoot -Recurse -Force -ErrorAction Stop |
+            Where-Object {
+                $_.Name -match '\.xpr$|\.runs$|\.srcs$|\.gen$|\.cache$' -or
+                $_.Name -eq 'project'
+            } | ForEach-Object { $_.FullName })
+    }
+    Assert-Contract -Name $Name -Condition (
+        -not (Test-Path -LiteralPath $BuildRoot) -and $projectArtifacts.Count -eq 0
+    ) -Details "build_root_absent=$(-not (Test-Path -LiteralPath $BuildRoot)); project_artifact_count=$($projectArtifacts.Count)"
+}
+
+$exitCode = 0
+try {
+    $RepoRoot = Get-AbsoluteAsciiPath -Path $RepoRoot -Label 'RepoRoot' -MustExist
+    $VivadoBat = Get-AbsoluteAsciiPath -Path $VivadoBat -Label 'VivadoBat' -MustExist
+    $script:Receipt.repo_root = $RepoRoot
+
+    $repoPrefix = $RepoRoot + [IO.Path]::DirectorySeparatorChar
+    $evidencePrefix = $EvidenceRoot + [IO.Path]::DirectorySeparatorChar
+    Assert-Contract -Name 'EVIDENCE_OUTSIDE_SOURCE_TREE' -Condition (
+        -not $evidencePrefix.StartsWith($repoPrefix, [StringComparison]::OrdinalIgnoreCase)
+    ) -Details "repo=$RepoRoot evidence=$EvidenceRoot"
+    Assert-Contract -Name 'GIT_REPOSITORY' -Condition (Test-Path -LiteralPath (Join-Path $RepoRoot '.git')) `
+        -Details "repository=$RepoRoot"
+
+    $runId = [DateTime]::UtcNow.ToString('yyyyMMddTHHmmssfffZ') + '_' + [Guid]::NewGuid().ToString('N')
+    $runRoot = Join-Path $EvidenceRoot (Join-Path 'offline_runs' $runId)
+    $tempRoot = Join-Path $runRoot 'tmp'
+    [void][IO.Directory]::CreateDirectory($tempRoot)
+    $script:Receipt.run_root = $runRoot
+    $script:Receipt.child_environment.TEMP = $tempRoot
+    $script:Receipt.child_environment.TMP = $tempRoot
+    $childEnvironment = @{
+        XILINX_LOCAL_USER_DATA = 'NO'
+        XILINX_TCLAPP_REPO = $TclAppRepository
+        TEMP = $tempRoot
