+dict for {key value} $counts { lappend terminal_lines "$key=$value" }
+if {$result != 0} {
+  lappend terminal_lines "BUILD=FAIL" "ERROR=$failure" "ERROR_INFO=[dict get $options -errorinfo]"
+  write_lines [file join $build_root BUILD_RESULT.txt] $terminal_lines
+  puts stderr "R1I_BUILD_FAIL: $failure"
+  catch {close_project}
+  exit 1
+}
+lappend terminal_lines "BUILD=PASS" "SOURCE_TO_BIT_PROVENANCE=PASS"
+write_lines [file join $build_root BUILD_RESULT.txt] $terminal_lines
+catch {close_project}
+puts "R1I_BUILD_PASS BIT_SHA256=$bit_sha"
+exit 0
diff --git a/scripts/v41/r1i_vivado_portable_launch.ps1 b/scripts/v41/r1i_vivado_portable_launch.ps1
new file mode 100644
index 0000000000000000000000000000000000000000..e0e4dc50932710a46a0e4095593c18e9388c6dbe
--- /dev/null
+++ b/scripts/v41/r1i_vivado_portable_launch.ps1
@@ -0,0 +1,66 @@
+[CmdletBinding()]
+param(
+    [Parameter(Mandatory)][string]$RepositoryRoot,
+    [Parameter(Mandatory)][string]$BuildRoot,
+    [Parameter(Mandatory)][ValidatePattern('^[0-9a-f]{40}$')][string]$SourceCommit,
+    [Parameter(Mandatory)][ValidatePattern('^[0-9a-f]{40}$')][string]$SourceTree,
+    [Parameter(Mandatory)][ValidateSet(1,2)][int]$Attempt
+)
+# R1i-R2's one bounded harness correction. Vivado initializes the Tcl Store
+# before -source runs. Isolate only its child APPDATA to a writable ASCII path;
+# do not modify the real user profile, Tcl installation, RTL, XDC or flow.
+$ErrorActionPreference='Stop'
+Set-StrictMode -Version Latest
+$repo=$RepositoryRoot
+$out=$BuildRoot
+foreach($path in @($repo,$out)){
+    if($path -notmatch '^[A-Za-z]:\\[\x20-\x7e]+$' -or $path -match '["&|<>^%!]'){
+        throw 'Build paths must be absolute local ASCII paths without shell metacharacters'
+    }
+}
+$portableAppData=Join-Path (Split-Path $out -Parent) 'portable_vivado_appdata'
+[void][IO.Directory]::CreateDirectory($portableAppData)
+$vivado='C:\AMDDesignTools\2025.2\Vivado\bin\vivado.bat'
+$arguments=@('-mode','batch','-source',(Join-Path $repo 'scripts\v41\r1i_build.tcl'),
+    '-log',(Join-Path $out 'vivado.log'),'-journal',(Join-Path $out 'vivado.jou'),
+    '-tclargs',$repo,$out,$SourceCommit,$SourceTree,[string]$Attempt)
+$quoted=@($vivado)+$arguments | ForEach-Object { [char]34+[string]$_+[char]34 }
+$psi=[Diagnostics.ProcessStartInfo]::new()
+$psi.FileName=$env:ComSpec
+$psi.Arguments='/d /s /c '+[char]34+($quoted -join ' ')+[char]34
+$psi.WorkingDirectory=$out
+$psi.UseShellExecute=$false
+$psi.CreateNoWindow=$true
+$psi.WindowStyle=[Diagnostics.ProcessWindowStyle]::Hidden
+$psi.RedirectStandardOutput=$true
+$psi.RedirectStandardError=$true
+$psi.Environment['APPDATA']=$portableAppData
+$utf8=[Text.UTF8Encoding]::new($false)
+$receipt=[ordered]@{
+    Attempt=$Attempt;SourceCommit=$SourceCommit;SourceTree=$SourceTree;
+    Correction='CHILD_ONLY_PORTABLE_APPDATA';ChildAppData=$portableAppData;
+    ParentAppDataChanged=$false;SourceOrConstraintDelta=$false;
+    ImplementationCommandDelta=$false;Executable=$vivado;Arguments=$arguments;
+    StartedUtc=[DateTime]::UtcNow.ToString('o');ProcessId=$null;ProcessExitCode=$null;EndedUtc=$null
+}
+$process=[Diagnostics.Process]::new()
+$process.StartInfo=$psi
+try{
+    if(-not $process.Start()){throw 'Vivado child did not start'}
+    $receipt.ProcessId=$process.Id
+    [IO.File]::WriteAllText((Join-Path $out 'PORTABLE_LAUNCH.json'),($receipt|ConvertTo-Json -Depth 8),$utf8)
+    $stdoutTask=$process.StandardOutput.ReadToEndAsync()
+    $stderrTask=$process.StandardError.ReadToEndAsync()
+    Write-Output "VIVADO_PORTABLE_CHILD_STARTED PID=$($process.Id) ATTEMPT=$Attempt"
+    $process.WaitForExit()
+    $stdout=$stdoutTask.GetAwaiter().GetResult()
+    $stderr=$stderrTask.GetAwaiter().GetResult()
+    [IO.File]::WriteAllText((Join-Path $out 'PROCESS_STDOUT.log'),$stdout,$utf8)
+    [IO.File]::WriteAllText((Join-Path $out 'PROCESS_STDERR.log'),$stderr,$utf8)
+    $code=$process.ExitCode
+    $receipt.ProcessExitCode=$code
+    $receipt.EndedUtc=[DateTime]::UtcNow.ToString('o')
+    [IO.File]::WriteAllText((Join-Path $out 'PORTABLE_PROCESS_EXIT.json'),($receipt|ConvertTo-Json -Depth 8),$utf8)
+    Write-Output "VIVADO_PORTABLE_CHILD_EXIT=$code"
+}finally{$process.Dispose()}
+exit $code
diff --git a/scripts/v41/read_nvp_r1i.py b/scripts/v41/read_nvp_r1i.py
new file mode 100644
index 0000000000000000000000000000000000000000..ae16ddce315ef10cf50e2f31f74068ca36104093
--- /dev/null
+++ b/scripts/v41/read_nvp_r1i.py
@@ -0,0 +1,400 @@
+#!/usr/bin/env python3
+"""Bounded read-only R1i PoC reader; exact R1h reader remains unmodified.
+
+R1i retains all old wire fields. A failed-record entry now means a failed
+physical attempt, so up to four consecutive entries may share one logical
+transaction serial. R1i-only checks model first-NACK abort and qualified
+timeouts explicitly; the unmodified R1h control uses its original decoder.
+No write, ioctl, mmap, DMA or device-control primitive is implemented.
+"""
+from __future__ import annotations
+
+import argparse
+import csv
+import itertools
+import json
+import os
+import re
+import sys
+import time
+from pathlib import Path
+from typing import Any, Mapping, Sequence
+
+try:
+    import read_nvp_r1f as r1h
+except ModuleNotFoundError:
+    from . import read_nvp_r1f as r1h
+
+R1IDecodeError = r1h.R1FDecodeError
+_word = r1h._word
+_require = r1h._require
+_reserved_zero = r1h._reserved_zero
+_nullable = r1h._nullable
+POC_BASE = 0x3600
+POC_END_EXCLUSIVE = 0x3680
+POC_OFFSETS = tuple(range(POC_BASE, POC_END_EXCLUSIVE, 4))
+READ_OFFSETS = tuple(sorted(set(r1h.READ_OFFSETS + POC_OFFSETS)))
+POC_MAGIC = 0x52314950
+POC_VERSION = 1
+POLICY_FLAGS = 0x3F
+PHASE_NAMES = ("WADDR", "REGADDR", "DATA", "RADDR")
+PHASE_FIELDS = ("ack_opportunities", "legacy_early_would_nack",
+                "qualified_nack", "early_nack_but_qualified_ack")
+TAIL_FIELDS = (
+    "raw_qualified_nack_count", "recovered_transaction_count",
+    "recovered_nack_count", "unrecovered_transaction_count",
+    "retry_exhausted_count", "retry_success_on_retry_1",
+    "retry_success_on_retry_2", "retry_success_on_retry_3",
+    "scl_high_wait_max_base_cycles", "scl_high_timeout_count",
+    "first_early_false_nack_transaction", "first_recovered_transaction",
+    "first_unrecovered_transaction",
+)
+R1H_SOURCE_COMMIT = "c4f4bfcf577c92c3021d1fe83c05878dd12e001c"
+
+
+def collect_word_map(fd: int, os_module=os) -> dict[int, int]:
+    """Keep the exact inherited read inventory, then read all32 POC words."""
+    result = r1h.collect_word_map(fd, os_module)
+    for offset in POC_OFFSETS:
+        result[offset] = r1h.read_word(fd, offset, os_module)
+    return result
+
+
+def _decode_record(raw: Sequence[int], entry: int) -> dict[str, Any]:
+    """Decode the unchanged64x192 wire format with R1i attempt semantics."""
+    _require(len(raw) == 6, "record must contain six words")
+    w0, w1, w2, w3, w4, w5 = map(int, raw)
+    transaction_index, table_slot = w0 & 0xFFFF, (w0 >> 16) & 0xFFFF
+    legacy_operation, phase, kind = w1 & 0xFF, (w1 >> 8) & 0xF, (w1 >> 12) & 0xF
+    opportunity_bitmap, nack_bitmap = (w1 >> 16) & 0xF, (w1 >> 20) & 0xF
+    nack_count, timeout = (w1 >> 24) & 7, bool((w1 >> 27) & 1)
+    completed, valid = bool((w1 >> 28) & 1), bool((w1 >> 29) & 1)
+    register_raw, write_raw, read_raw = w2 & 0xFF, (w2 >> 8) & 0xFF, (w2 >> 16) & 0xFF
+    reg_valid, write_valid, read_valid = (bool((w2 >> bit) & 1) for bit in (24, 25, 26))
+    requested_valid, physical_before_valid = (bool((w2 >> bit) & 1) for bit in (27, 28))
+    selector_valid, verify_expected_valid, verify_observed_valid = (
+        bool((w2 >> bit) & 1) for bit in (29, 30, 31))
+    requested_raw, physical_before_raw = w3 & 0xFF, (w3 >> 8) & 0xFF
+    selector_raw, verify_expected_raw = (w3 >> 16) & 0xFF, (w3 >> 24) & 0xFF
+    verify_observed_raw, physical_after_raw = w4 & 0xFF, (w4 >> 8) & 0xFF
+    physical_after_valid = bool((w4 >> 16) & 1)
+    verify_result, update_reason, fsm_state = (w4 >> 17) & 7, (w4 >> 20) & 0xF, (w4 >> 24) & 0xFF
+    fsm_context, terminal_error = w5 & 0xFF, (w5 >> 8) & 0xFF
+    _require(w1 >> 30 == 0 and w5 >> 16 == 0,
+             f"record {entry}: reserved bits nonzero")
+    _require(valid, f"record {entry}: record_valid=0")
+    _require(phase in r1h.AUTOINIT_PHASE_NAMES, f"record {entry}: reserved phase")
+    _require(kind in r1h.TRANSACTION_KIND_NAMES, f"record {entry}: reserved kind")
+    _require(nack_bitmap & ~opportunity_bitmap == 0,
+             f"record {entry}: NACK outside attempted phase")
+    _require(nack_count == nack_bitmap.bit_count() and nack_count <= 1,
+             f"record {entry}: first-NACK abort permits at most one NACK")
+    _require(nack_bitmap != 0 or timeout or terminal_error != 0,
+             f"record {entry}: no failure cause")
+    _require(completed or timeout, f"record {entry}: incomplete non-timeout attempt")
+    # ACK opportunities are sampled qualified phases, not bytes merely sent.
+    # A timeout before the first ACK legitimately has an empty bitmap.
+    prefixes = (0, 1, 3, 11) if kind in r1h.READ_KINDS else (0, 1, 3, 7)
+    _require(opportunity_bitmap in prefixes, f"record {entry}: non-prefix opportunities")
+    _require(opportunity_bitmap != 0 or timeout or terminal_error == 0x06,
+             f"record {entry}: empty opportunities without timeout or START-SDA-stuck")
+    if nack_bitmap:
+        _require(opportunity_bitmap == {1: 1, 2: 3, 4: 7, 8: 11}[nack_bitmap],
+                 f"record {entry}: later phase attempted after first NACK")
+    if kind in r1h.READ_KINDS:
+        _require(not write_valid, f"record {entry}: read kind has write data")
+    else:
+        _require(not read_valid, f"record {entry}: write kind has read data")
+    _require((table_slot != 0xFFFF) == (kind in r1h.INIT_TABLE_KINDS),
+             f"record {entry}: table-slot validity mismatch")
+    if selector_valid:
+        _require(reg_valid and register_raw == 0xFF,
+                 f"record {entry}: selector without register0xFF")
+    _require(verify_result in r1h.BANK_VERIFY_RESULT_NAMES,
+             f"record {entry}: reserved verify result")
+    _require(update_reason in r1h.BANK_UPDATE_REASON_NAMES,
+             f"record {entry}: reserved bank update reason")
+    if verify_result == 1:
+        _require(verify_expected_valid and verify_observed_valid and
+                 verify_expected_raw == verify_observed_raw,
+                 f"record {entry}: matched verify lacks equal valid bytes")
+    # The byte encoding is unchanged; R1i appends bounded-wait/retry states.
+    _require(fsm_state < 42, f"record {entry}: reserved R1i FSM state")
+    return {
+        "entry": entry, "raw_words": [f"0x{value:08X}" for value in raw],
+        "transaction_index_16": transaction_index,
+        "table_slot_index_16": table_slot,
+        "legacy_operation_index_8": legacy_operation,
+        "legacy_operation_index_authoritative": False,
+        "autoinit_phase_code": phase, "autoinit_phase": r1h.AUTOINIT_PHASE_NAMES[phase],
+        "transaction_kind_code": kind, "transaction_kind": r1h.TRANSACTION_KIND_NAMES[kind],
+        "phase_opportunity_bitmap": opportunity_bitmap,
+        "phase_nack_bitmap": nack_bitmap, "nack_count_within_transaction": nack_count,
+        "timeout": timeout, "transaction_completed": completed, "record_valid": valid,
+        "register_address": _nullable(register_raw, reg_valid),
+        "write_data": _nullable(write_raw, write_valid), "read_data": _nullable(read_raw, read_valid),
+        "requested_bank": _nullable(requested_raw, requested_valid),
+        "physical_bank_before": _nullable(physical_before_raw, physical_before_valid),
+        "selector_value_sent": _nullable(selector_raw, selector_valid),
+        "bank_verify_expected": _nullable(verify_expected_raw, verify_expected_valid),
+        "bank_verify_observed": _nullable(verify_observed_raw, verify_observed_valid),
+        "physical_bank_after": _nullable(physical_after_raw, physical_after_valid),
+        "valid_bits": {
+            "register_address": reg_valid, "write_data": write_valid, "read_data": read_valid,
+            "requested_bank": requested_valid, "physical_bank_before": physical_before_valid,
+            "selector_value": selector_valid, "verify_expected": verify_expected_valid,
+            "verify_observed": verify_observed_valid, "physical_bank_after": physical_after_valid},
+        "bank_verify_result_code": verify_result,
+        "bank_verify_result": r1h.BANK_VERIFY_RESULT_NAMES[verify_result],
+        "bank_update_reason_code": update_reason,
+        "bank_update_reason": r1h.BANK_UPDATE_REASON_NAMES[update_reason],
+        "fsm_state": fsm_state, "fsm_context": fsm_context,
+        "terminal_error_code": terminal_error,
+    }
+
+
+def _decode_log(words: Mapping[int, int], failed_attempts: int) -> dict[str, Any]:
+    total, stored = _word(words, 0x2120), _word(words, 0x2124)
+    overflow_word = _word(words, 0x2128)
+    _reserved_zero(overflow_word, 1, "R1I_FAILED_TXN_OVERFLOW")
+    overflow = bool(overflow_word)
+    first, last = _word(words, 0x212C), _word(words, 0x2130)
+    status, next_serial = _word(words, 0x2134), _word(words, 0x2138)
+    _reserved_zero(first, 0xFFFF, "FIRST_FAILED_TXN_INDEX")
+    _reserved_zero(last, 0xFFFF, "LAST_FAILED_TXN_INDEX")
+    _reserved_zero(status, 0x3FF, "LOG_STATUS")
+    _reserved_zero(next_serial, 0xFFFF, "NEXT_TRANSACTION_SERIAL")
+    _require(total == failed_attempts, "failed-log total differs from failed attempts")
+    _require(stored == min(total, 64), "stored failed attempts not min(total,64)")
+    _require(overflow == (total > 64), "failed-log overflow must start at attempt65")
+    _require(bool(status & 4) == overflow and status & 0x78 == 0x78 and status & 0x380 == 0,
+             "failed-log coherence/protocol/saturation status invalid")
+    _require(bool(status & 1) == (total > 0) and bool(status & 2) == (total > 0),
+             "failed-log endpoint validity mismatch")
+    raw_records = [[_word(words, 0x2400 + entry*24 + word*4) for word in range(6)]
+                   for entry in range(64)]
+    records = [_decode_record(raw_records[entry], entry) for entry in range(stored)]
+    _require(all(not any(raw) for raw in raw_records[stored:]),
+             "unused failed-record entry must be zero")
+    serials = [record["transaction_index_16"] for record in records]
+    _require(all(a <= b for a, b in zip(serials, serials[1:])),
+             "R1i failed attempt serials must be nondecreasing")
+    for serial, group in itertools.groupby(records, key=lambda rec: rec["transaction_index_16"]):
+        attempts = list(group)
+        _require(len(attempts) <= 4, f"logical transaction {serial} exceeds four failed attempts")
+        identity_fields = ("table_slot_index_16", "legacy_operation_index_8",
+                           "autoinit_phase_code", "transaction_kind_code", "register_address",
+                           "write_data", "requested_bank")
+        identity = tuple(attempts[0][key] for key in identity_fields)
+        _require(all(tuple(item[key] for key in identity_fields) == identity for item in attempts),
+                 f"logical transaction {serial} changed bytes/context across retry")
+    if records:
+        _require(first == serials[0] and (overflow or last == serials[-1]),
+                 "failed-log first/last serial mismatch")
+    else:
+        _require(first == 0 and last == 0, "empty failed log endpoints must be zero")
+    return {
+        "total": total, "stored": stored, "overflow": overflow,
+        "first_index": first if total else None, "last_index": last if total else None,
+        "next_transaction_serial": next_serial, "records": records,
+        "all_64_entries_raw_words": [[f"0x{value:08X}" for value in raw] for raw in raw_records],
+        "structural_consistency": "PASS",
+        "record_semantics": "FAILED_PHYSICAL_ATTEMPTS_LOGICAL_SERIAL_REPEATS_AT_MOST_FOUR",
+    }
+
+
+def decode_poc_page(words: Mapping[int, int], phase_counters: Mapping[str, Any]) -> dict[str, Any]:
+    for word_index, expected in enumerate((POC_MAGIC, POC_VERSION, POLICY_FLAGS)):
+        _require(_word(words, POC_BASE + word_index*4) == expected,
+                 f"R1i POC header word{word_index} mismatch")
+    phases = {
+        phase: {field: _word(words, POC_BASE + (3 + index*4 + lane)*4)
+                for lane, field in enumerate(PHASE_FIELDS)}
+        for index, phase in enumerate(PHASE_NAMES)
+    }
+    result = {field: _word(words, POC_BASE + (19 + index)*4)
+              for index, field in enumerate(TAIL_FIELDS)}
+    for phase, fields in phases.items():
+        old = phase_counters[phase]
+        _require(fields["ack_opportunities"] == old["opportunities"] and
+                 fields["qualified_nack"] == old["nacks"],
+                 f"R1i {phase} counters disagree with inherited R1h page")
+        _require(fields["early_nack_but_qualified_ack"] <= fields["legacy_early_would_nack"] and
+                 fields["early_nack_but_qualified_ack"] <= old["acks"],
+                 f"R1i {phase} early-false-NACK count inconsistent")
+        # An early observation can be captured before a qualified-high timeout
+        # prevents that phase's ACK decision; it is not an ACK opportunity.
+        _require(fields["legacy_early_would_nack"] <=
+                 old["opportunities"] + result["scl_high_timeout_count"],
+                 f"R1i {phase} early observation exceeds attempts")
+    raw_nacks = sum(fields["qualified_nack"] for fields in phases.values())
+    _require(result["raw_qualified_nack_count"] == raw_nacks,
+             "R1i raw qualified NACK total differs from phase sum")
+    _require(result["recovered_nack_count"] <= raw_nacks,
+             "R1i recovered NACKs exceed raw NACKs")
+    _require(result["recovered_transaction_count"] ==
+             sum(result[f"retry_success_on_retry_{index}"] for index in (1, 2, 3)),
+             "R1i recovered transaction count differs from retry-success sum")
+    # A bus which stays unsafe after bounded STOP recovery terminates without
+    # attempting a new START. Such a terminal failure need not consume all4
+    # attempts; exhaustion is therefore a subset of unrecovered transactions.
+    _require(result["retry_exhausted_count"] <= result["unrecovered_transaction_count"],
+             "R1i exhausted transactions exceed unrecovered transactions")
+    result["early_false_nack_count"] = sum(
+        fields["early_nack_but_qualified_ack"] for fields in phases.values())
+    for counter, first_field in (
+        ("early_false_nack_count", "first_early_false_nack_transaction"),
+        ("recovered_transaction_count", "first_recovered_transaction"),
+        ("unrecovered_transaction_count", "first_unrecovered_transaction"),
+    ):
+        value = result[first_field]
+        _require((value == 0xFFFFFFFF) == (result[counter] == 0),
+                 f"R1i {first_field} sentinel/event-count mismatch")
+        _require(value == 0xFFFFFFFF or value <= 0xFFFF,
+                 f"R1i {first_field} exceeds logical serial width")
+    return {"magic": POC_MAGIC, "version": POC_VERSION, "policy_flags": POLICY_FLAGS,
+            "phases": phases, **result}
+
+
+def validate_runtime(words: Mapping[int, int], expect: str,
+                     expected_source: str | None = None) -> dict[str, Any]:
+    _require([_word(words, address) for address in (0, 4, 8)] ==
+             [0xA40A0C07, 0x0000400B, 0x00031002], "runtime common identity mismatch")
+    actual_source = "".join(f"{_word(words, address):08x}" for address in range(0x10, 0x24, 4))
+    if expect == "r1h":
+        expected_source = R1H_SOURCE_COMMIT
+    if expected_source is not None:
+        _require(re.fullmatch(r"[0-9a-fA-F]{40}", expected_source) is not None,
+                 "expected source must be exact40-hex commit")
+        _require(actual_source == expected_source.lower(), "runtime source commit mismatch")
+    flags = _word(words, 0x2C)
+    if expect in ("r1i", "r1h"):
+        _require(flags == 2, "diagnostic runtime BUILD_FLAGS mismatch")
+    else:
+        _require(_word(words, 0x2000) == 0 and _word(words, 0x2040) == 0,
+                 "formal diagnostic magic is nonzero")
+    return {"common_identity": "A40A0C07 / 0000400B / 00031002",
+            "source_commit": actual_source, "build_flags": flags}
+
+
+def decode_word_map(words: Mapping[int, int], expect: str = "r1i",
+                    require_scientific_valid: bool = True,
+                    expected_source: str | None = None,
+                    require_runtime: bool = False) -> dict[str, Any]:
+    if expect not in ("r1i", "r1h", "formal"):
+        raise ValueError("expect must be r1i, r1h or formal")
+    runtime = (validate_runtime(words, expect, expected_source)
+               if require_runtime or expected_source is not None else None)
+    if expect != "r1i":
+        result = r1h.decode_word_map(words, "r1f" if expect == "r1h" else "formal",
+                                     require_scientific_valid)
+        _require(all(_word(words, offset) == 0 for offset in POC_OFFSETS),
+                 "unmodified control/formal POC range must be zero")
+        result = {**result, "image": expect, "poc_range_zero": True}
+    else:
+        legacy = r1h._decode_legacy(words)
+        header = r1h._decode_header(words)
+        phase_counters = r1h._decode_phase_counters(words, legacy)
+        log = _decode_log(words, phase_counters["transactions"]["failed"])
+        poc = decode_poc_page(words, phase_counters)
+        result = {
+            "image": "r1i", "header": header, "phase_counters": phase_counters,
+            "failed_transaction_log": log,
+            "legacy_reconciliation": r1h._reconcile_legacy(log, legacy),
+            "bank_invariants": r1h._decode_bank_invariants(words),
+            "probe": r1h._decode_probe(words), "poc": poc,
+            "raw_local_telemetry": {f"0x{address:05X}": _word(words, address)
+                                    for address in r1h.LOCAL_OFFSETS},
+            "raw_r1e_page": {f"0x{address:05X}": _word(words, address)
+                             for address in r1h.R1E_OFFSETS},
+            "legacy_17_words": [f"0x{_word(words, address):08X}" for address in r1h.LEGACY17_OFFSETS],
+            "legacy_ordered_nack": legacy, "lifecycle": r1h._decode_lifecycle(words),
+            "init_done": bool(_word(words, 0x8C) & 1),
+            "init_error": bool(_word(words, 0x8C) & 2),
+        }
+        if require_scientific_valid:
+            # Same R1h probe/log/bank integrity; only image label is adapted.
+            r1h.validate_scientific_sample({**result, "image": "r1f"})
+            _require(result["init_done"], "R1i INIT_DONE is not set")
+    result["raw_poc_page"] = {f"0x{address:05X}": _word(words, address) for address in POC_OFFSETS}
+    if runtime is not None:
+        result["runtime"] = runtime
+    return result
+
+
+def static_projection(decoded: Mapping[str, Any]) -> dict[str, Any]:
+    result = r1h.static_projection(decoded)
+    for key in ("poc", "raw_poc_page", "poc_range_zero", "runtime", "init_done", "init_error"):
+        if key in decoded:
+            result[key] = decoded[key]
+    return result
+
+
+def write_outputs(decoded: Mapping[str, Any], words: Mapping[int, int], output_dir: Path) -> None:
+    r1h.write_outputs(decoded, words, output_dir)
+    # Expand the inventory without changing the inherited decoder/export file.
+    with (output_dir / "raw_mmio_inventory.csv").open("w", newline="", encoding="utf-8") as handle:
+        writer = csv.writer(handle)
+        writer.writerow(("offset", "value"))
+        writer.writerows((f"0x{address:05X}", f"0x{_word(words, address):08X}")
+                         for address in READ_OFFSETS)
+
+
+def main(argv: Sequence[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    source = parser.add_mutually_exclusive_group(required=True)
+    source.add_argument("--node", help="exact already-proven XDMA user node; O_RDONLY only")
+    source.add_argument("--input-json", type=Path, help="offline sparse word map")
+    parser.add_argument("--expect", choices=("r1i", "r1h", "formal"), required=True)
+    parser.add_argument("--expected-source", help="exact local POC40-hex commit; required for live R1i")
+    parser.add_argument("--twice", action="store_true")
+    parser.add_argument("--delay", type=float, default=1.0)
+    parser.add_argument("--output-dir", type=Path)
+    args = parser.parse_args(argv)
+    if args.node and args.expect == "r1i":
+        _require(args.expected_source is not None, "live R1i requires --expected-source")
+    fd = None
+    captures: list[tuple[dict[int, int], float]] = []
+    try:
+        if args.node:
+            fd = os.open(args.node, os.O_RDONLY | os.O_CLOEXEC)
+        for index in range(2 if args.twice else 1):
+            if index:
+                time.sleep(max(args.delay, 0.0))
+            words = r1h._load_fixture(args.input_json) if args.input_json else collect_word_map(fd)
+            captures.append((words, time.monotonic()))
+            if args.output_dir:
+                # Preserve complete read-only raw data before any decode gate.
+                folder = args.output_dir / f"T{index}"
+                folder.mkdir(parents=True, exist_ok=True)
+                (folder / "raw_word_map.json").write_text(json.dumps({
+                    "words": {f"0x{key:05X}": f"0x{value:08X}" for key, value in words.items()}
+                }, indent=2) + "\n", encoding="utf-8")
+    finally:
+        if fd is not None:
+            os.close(fd)
+    decoded = [decode_word_map(words, args.expect, expected_source=args.expected_source,
+                               require_runtime=bool(args.node or args.expected_source))
+               for words, _ in captures]
+    if len(decoded) == 2:
+        _require(static_projection(decoded[0]) == static_projection(decoded[1]),
+                 "R1i/control T0/T1 static telemetry mismatch")
+    result = {"T0": decoded[0], "T1": decoded[1] if len(decoded) == 2 else None,
+              "READ_ONLY": "YES", "STATIC_SNAPSHOTS_MATCH": "YES" if len(decoded) == 2 else "NOT_REQUESTED",
+              "capture_monotonic_seconds": [timestamp for _, timestamp in captures]}
+    if args.output_dir:
+        for index, ((words, _), item) in enumerate(zip(captures, decoded)):
+            write_outputs(item, words, args.output_dir / f"T{index}")
+        (args.output_dir / "snapshots.json").write_text(json.dumps(result, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+    print(json.dumps(result, indent=2, sort_keys=True))
+    print("READ_ONLY=YES")
+    print(f"STATIC_SNAPSHOTS_MATCH={result['STATIC_SNAPSHOTS_MATCH']}")
+    return 0
+
+
+if __name__ == "__main__":
+    try:
+        raise SystemExit(main())
+    except R1IDecodeError as error:
+        print(f"R1I_DECODE_ERROR={error}", file=sys.stderr)
+        raise SystemExit(2)
diff --git a/tests/python/test_nvp_r1i_tools.py b/tests/python/test_nvp_r1i_tools.py
