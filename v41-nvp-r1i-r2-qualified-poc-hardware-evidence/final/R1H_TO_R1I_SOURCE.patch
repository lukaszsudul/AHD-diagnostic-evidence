+// R1i's 32-word, read-only causal telemetry page. The input is in the same
+// axi_aclk/autonomous clock domain. The unchanged R1h read service captures
+// one scalar word at accepted request and holds it under host backpressure.
+// No old address, payload store, write path or latency is changed here.
+module v41_r1i_poc_scalar_mux (
+  input  logic [13:0]   offset,
+  input  logic [1023:0] telemetry,
+  input  logic [31:0]   legacy_scalar_read_data,
+  output logic [31:0]   scalar_read_data
+);
+  always_comb begin
+    scalar_read_data = legacy_scalar_read_data;
+    if (offset >= 14'h3600 && offset <= 14'h367f) begin
+      scalar_read_data = 32'b0;
+      if (offset[1:0] == 2'b00)
+        scalar_read_data = telemetry[offset[6:2]*32 +: 32];
+    end
+  end
+endmodule
