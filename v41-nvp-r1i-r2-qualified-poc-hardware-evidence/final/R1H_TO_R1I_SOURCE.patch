index 0000000000000000000000000000000000000000..1bddd9e9b6182b42ab6ebbf5ade5cdc71c2a39ed
--- /dev/null
+++ b/tests/python/test_nvp_r1i_tools.py
@@ -0,0 +1,232 @@
+#!/usr/bin/env python3
+"""R1i host fixtures; no device access and no FPGA-programming operations."""
+from __future__ import annotations
+
+import contextlib
+import io
+import json
+import struct
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+REPOSITORY = HERE.parents[1]
+sys.path.insert(0, str(REPOSITORY / "scripts" / "v41"))
+sys.path.insert(0, str(HERE))
+import read_nvp_r1i as reader
+import read_nvp_r1f as old_reader
+import test_nvp_r1f_tools as old_fixtures
+
+POC_COMMIT = "0123456789abcdef0123456789abcdef01234567"
+
+
+def make_valid_words() -> dict[int, int]:
+    words = old_fixtures.make_valid_words()
+    words.update({0: 0xA40A0C07, 4: 0x0000400B, 8: 0x00031002,
+                  0x2C: 2, 0x8C: 1, 0x2100: 14, 0x2104: 14, 0x2108: 3,
+                  0x2120: 3, 0x2124: 3})
+    for index in range(5):
+        words[0x10 + index*4] = int(POC_COMMIT[index*8:index*8 + 8], 16)
+    # Same logical transaction, successively failing WADDR, REGADDR, DATA;
+    # byte/context fields stay identical and the final fourth attempt succeeds.
+    old_record = [words[0x2400 + index*4] for index in range(6)]
+    for entry, (opps, nack) in enumerate(((1, 1), (3, 2), (7, 4))):
+        record = list(old_record)
+        record[1] = (old_record[1] & 0xFFFF) | (opps << 16) | (nack << 20) | (1 << 24) | (1 << 28) | (1 << 29)
+        for index, value in enumerate(record):
+            words[0x2400 + entry*24 + index*4] = value
+    page = [reader.POC_MAGIC, 1, reader.POLICY_FLAGS]
+    for phase in reader.PHASE_NAMES:
+        opp_address, nack_address = old_reader.PHASES[phase]
+        nacks = words[nack_address]
+        page.extend((words[opp_address], nacks + 2, nacks, 2))
+    page.extend((3, 1, 3, 0, 0, 0, 0, 1, 9, 0, 0, 10, 0xFFFFFFFF))
+    assert len(page) == 32
+    words.update({reader.POC_BASE + index*4: value for index, value in enumerate(page)})
+    return words
+
+
+class ReadOnlyOS:
+    def __init__(self, words: dict[int, int]) -> None:
+        self.words = words
+        self.calls: list[tuple[int, int, int]] = []
+
+    def pread(self, fd: int, count: int, offset: int) -> bytes:
+        assert fd == 91 and count == 4
+        self.calls.append((fd, count, offset))
+        return struct.pack("<I", self.words.get(offset, 0))
+
+    def write(self, *args):
+        raise AssertionError("MMIO writes forbidden")
+
+    pwrite = write
+    ioctl = write
+    mmap = write
+
+
+class R1IReaderTests(unittest.TestCase):
+    def test_complete_valid_poc_page_and_retry_log(self):
+        words = make_valid_words()
+        result = reader.decode_word_map(words, expected_source=POC_COMMIT, require_runtime=True)
+        self.assertEqual(result["image"], "r1i")
+        self.assertTrue(result["init_done"])
+        self.assertFalse(result["init_error"])
+        self.assertEqual(result["poc"]["early_false_nack_count"], 8)
+        self.assertEqual(result["poc"]["recovered_transaction_count"], 1)
+        self.assertEqual(result["poc"]["recovered_nack_count"], 3)
+        self.assertEqual(result["poc"]["retry_success_on_retry_3"], 1)
+        self.assertEqual(result["poc"]["first_unrecovered_transaction"], 0xFFFFFFFF)
+        self.assertEqual([record["transaction_index_16"] for record in result["failed_transaction_log"]["records"]], [10, 10, 10])
+        self.assertEqual(result["legacy_reconciliation"]["expanded_event_count"], 3)
+
+    def test_old_reader_is_not_relaxed_for_r1i_serials(self):
+        with self.assertRaisesRegex(old_reader.R1FDecodeError, "strictly chronological"):
+            old_reader.decode_word_map(make_valid_words())
+
+    def test_retry_cannot_change_bytes_or_context(self):
+        words = make_valid_words()
+        words[0x2420] ^= 0x10
+        with self.assertRaisesRegex(reader.R1IDecodeError, "changed bytes/context"):
+            reader.decode_word_map(words)
+
+    def test_nonmonotonic_logical_serial_is_rejected(self):
+        words = make_valid_words()
+        words[0x2418] -= 1
+        with self.assertRaisesRegex(reader.R1IDecodeError, "nondecreasing"):
+            reader.decode_word_map(words)
+
+    def test_maximum_four_failed_attempts(self):
+        words = make_valid_words()
+        raw = [words[0x2400 + index*4] for index in range(6)]
+        for entry in range(5):
+            for index, value in enumerate(raw):
+                words[0x2400 + entry*24 + index*4] = value
+        words[0x2120] = words[0x2124] = 5
+        with self.assertRaisesRegex(reader.R1IDecodeError, "exceeds four"):
+            reader._decode_log(words, 5)
+
+    def test_abort_bitmap_forbids_later_attempted_phase(self):
+        words = make_valid_words()
+        words[0x2404] |= 2 << 16
+        with self.assertRaisesRegex(reader.R1IDecodeError, "later phase"):
+            reader.decode_word_map(words)
+
+    def test_timeout_before_first_ack_and_new_fsm_decode(self):
+        words = make_valid_words()
+        raw = [words[0x2400 + index*4] for index in range(6)]
+        raw[1] = (raw[1] & 0xFFFF) | (1 << 27) | (1 << 29)
+        raw[4] = (raw[4] & 0xFFFFFF) | (41 << 24)
+        result = reader._decode_record(raw, 0)
+        self.assertEqual(result["phase_opportunity_bitmap"], 0)
+        self.assertTrue(result["timeout"])
+        self.assertEqual(result["fsm_state"], 41)
+        raw[1] &= ~(1 << 27)
+        with self.assertRaises(reader.R1IDecodeError):
+            reader._decode_record(raw, 0)
+
+    def test_start_sda_stuck_before_ack_has_exact_failure_code(self):
+        words = make_valid_words()
+        raw = [words[0x2400 + index*4] for index in range(6)]
+        raw[1] = (raw[1] & 0xFFFF) | (1 << 28) | (1 << 29)
+        raw[5] = (raw[5] & 0xFF) | (6 << 8)
+        result = reader._decode_record(raw, 0)
+        self.assertEqual(result["phase_opportunity_bitmap"], 0)
+        self.assertFalse(result["timeout"])
+        self.assertEqual(result["terminal_error_code"], 6)
+        raw[5] = (raw[5] & 0xFF) | (8 << 8)
+        with self.assertRaisesRegex(reader.R1IDecodeError, "empty opportunities"):
+            reader._decode_record(raw, 0)
+
+    def test_magic_version_policy_and_sentinel_gates(self):
+        for address in (0x3600, 0x3604, 0x3608):
+            words = make_valid_words()
+            words[address] ^= 1
+            with self.assertRaisesRegex(reader.R1IDecodeError, "header"):
+                reader.decode_word_map(words)
+        words = make_valid_words()
+        words[0x367C] = 0
+        with self.assertRaisesRegex(reader.R1IDecodeError, "sentinel"):
+            reader.decode_word_map(words)
+
+    def test_causal_counter_cross_page_coherence(self):
+        for address in (0x360C, 0x3614, 0x364C, 0x3650):
+            words = make_valid_words()
+            words[address] += 1
+            with self.assertRaises(reader.R1IDecodeError):
+                reader.decode_word_map(words)
+
+    def test_terminal_unsafe_bus_is_not_falsely_retry_exhaustion(self):
+        words = make_valid_words()
+        words[0x3658] = 1
+        words[0x367C] = 12
+        result = reader.decode_word_map(words)
+        self.assertEqual(result["poc"]["unrecovered_transaction_count"], 1)
+        self.assertEqual(result["poc"]["retry_exhausted_count"], 0)
+
+    def test_control_and_formal_use_frozen_decoder_and_zero_page(self):
+        words = old_fixtures.make_valid_words()
+        control = reader.decode_word_map(words, expect="r1h")
+        self.assertEqual(control["phase_counters"], old_reader.decode_word_map(words)["phase_counters"])
+        self.assertTrue(control["poc_range_zero"])
+        words[0x3600] = reader.POC_MAGIC
+        with self.assertRaisesRegex(reader.R1IDecodeError, "must be zero"):
+            reader.decode_word_map(words, expect="r1h")
+        formal = reader.decode_word_map({}, expect="formal")
+        self.assertTrue(formal["r1f_reserved_range_zero"])
+        self.assertTrue(formal["poc_range_zero"])
+
+    def test_runtime_provenance_and_build_flags(self):
+        words = make_valid_words()
+        reader.validate_runtime(words, "r1i", POC_COMMIT)
+        with self.assertRaisesRegex(reader.R1IDecodeError, "commit mismatch"):
+            reader.validate_runtime(words, "r1i", reader.R1H_SOURCE_COMMIT)
+        with self.assertRaisesRegex(reader.R1IDecodeError, "commit mismatch"):
+            reader.decode_word_map(words, expected_source=reader.R1H_SOURCE_COMMIT)
+        words[0x2C] = 0
+        with self.assertRaisesRegex(reader.R1IDecodeError, "BUILD_FLAGS"):
+            reader.validate_runtime(words, "r1i", POC_COMMIT)
+
+    def test_read_inventory_is_bounded_and_read_only(self):
+        words = make_valid_words()
+        backend = ReadOnlyOS(words)
+        actual = reader.collect_word_map(91, backend)
+        self.assertEqual(set(actual), set(reader.READ_OFFSETS))
+        self.assertTrue(set(old_reader.READ_OFFSETS).issubset(reader.READ_OFFSETS))
+        self.assertEqual(len(set(reader.READ_OFFSETS) - set(old_reader.READ_OFFSETS)), 32)
+        self.assertEqual(len(backend.calls), len(reader.READ_OFFSETS) + 12)
+        self.assertEqual(actual[0x3600], reader.POC_MAGIC)
+
+    def test_static_projection_includes_entire_poc_page(self):
+        a = reader.decode_word_map(make_valid_words())
+        b = reader.decode_word_map(make_valid_words())
+        self.assertEqual(reader.static_projection(a), reader.static_projection(b))
+        b["raw_poc_page"]["0x03600"] ^= 1
+        self.assertNotEqual(reader.static_projection(a), reader.static_projection(b))
+
+    def test_cli_preserves_raw_before_decode_and_full_inventory(self):
+        with tempfile.TemporaryDirectory() as folder:
+            root = Path(folder)
+            fixture = root / "fixture.json"
+            fixture.write_text(json.dumps({"words": {hex(key): value for key, value in make_valid_words().items()}}))
+            output = root / "valid"
+            with contextlib.redirect_stdout(io.StringIO()):
+                self.assertEqual(reader.main(["--input-json", str(fixture), "--expect", "r1i", "--twice", "--delay", "0", "--output-dir", str(output)]), 0)
+            snapshots = json.loads((output / "snapshots.json").read_text())
+            self.assertEqual(snapshots["STATIC_SNAPSHOTS_MATCH"], "YES")
+            inventory = (output / "T1" / "raw_mmio_inventory.csv").read_text()
+            self.assertIn("0x0367C,0xFFFFFFFF", inventory)
+            self.assertTrue((output / "T0" / "raw_word_map.json").is_file())
+            bad = make_valid_words()
+            bad[0x3604] = 2
+            fixture.write_text(json.dumps({"words": {hex(key): value for key, value in bad.items()}}))
+            output = root / "invalid"
+            with self.assertRaises(reader.R1IDecodeError):
+                reader.main(["--input-json", str(fixture), "--expect", "r1i", "--twice", "--delay", "0", "--output-dir", str(output)])
+            self.assertTrue((output / "T0" / "raw_word_map.json").is_file())
+            self.assertTrue((output / "T1" / "raw_word_map.json").is_file())
+
+
+if __name__ == "__main__":
+    unittest.main()
