+proc write_lines {path lines} {
+  set f [open $path w]
+  fconfigure $f -encoding utf-8 -translation lf
+  foreach line $lines { puts $f $line }
+  close $f
+}
+proc write_text {path value} {
+  set f [open $path w]
+  fconfigure $f -encoding utf-8 -translation lf
+  puts -nonewline $f $value
+  close $f
+}
+proc read_text {path} {
+  set f [open $path r]
+  fconfigure $f -encoding utf-8
+  set text [read $f]
+  close $f
+  return $text
+}
+proc sha256_file {path} {
+  set output [exec certutil.exe -hashfile [file nativename $path] SHA256]
+  foreach line [split $output "\n"] {
+    set v [string toupper [string map [list " " "" "\t" "" "\r" ""] [string trim $line]]]
+    if {[regexp {^[0-9A-F]{64}$} $v]} { return $v }
+  }
+  error "SHA256 unavailable for $path"
+}
+proc git_value {args} {
+  global repo_root
+  return [string trim [exec git --no-optional-locks -C $repo_root {*}$args]]
+}
+proc optional_report {label command} {
+  global build_root
+  if {[catch {uplevel 1 $command} msg]} {
+    set f [open [file join $build_root OPTIONAL_REPORT_FAILURES.txt] a]
+    puts $f "$label=$msg"
+    close $f
+    puts "OPTIONAL_REPORT_NONBLOCKING: $label: $msg"
+  }
+}
+proc utilization_value {text wanted} {
+  foreach line [split $text "\n"] {
+    set cols [split $line "|"]
+    if {[llength $cols] < 7} { continue }
+    if {[string trimright [string trim [lindex $cols 1]] "*"] eq $wanted} {
+      set value [string map [list "," "" " " ""] [string trim [lindex $cols 2]]]
+      if {[string is integer -strict $value]} { return $value }
+    }
+  }
+  error "required utilization value unavailable: $wanted"
+}
+proc resources {stage} {
