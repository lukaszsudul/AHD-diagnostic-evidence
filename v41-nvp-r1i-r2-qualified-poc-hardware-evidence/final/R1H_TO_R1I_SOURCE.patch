+library ieee;
+use ieee.std_logic_1164.all;
+library r1h_ref;
+
+-- A test-only adapter binds the exact immutable R1h master in a separate
+-- library. No reference RTL is reconstructed or modified for this test.
+entity r1i_master_test_adapter is
+  generic (REF_MODE : natural := 0; CLK_HZ : positive := 1000000;
+           I2C_HZ : positive := 25000);
+  port (
+    clk, rst, start, scl_i, sda_i : in std_logic;
+    scl_oen, sda_oen, busy, done, any_error : out std_logic;
+    values, afe_values : out std_logic_vector(127 downto 0);
+    output_values : out std_logic_vector(63 downto 0);
+    read_errors, aux_errors, afe_errors : out std_logic_vector(15 downto 0);
+    write_errors, original_ff, restored_ff, meta_bank, phys_bank : out std_logic_vector(7 downto 0);
+    phys_bank_valid, first_valid : out std_logic;
+    phase_dbg, step_dbg, last_reg, last_wdata, last_rdata, i2c_state, first_code : out std_logic_vector(7 downto 0);
+    last_op : out std_logic_vector(2 downto 0);
+    nack_count, timeout_count, serial_next : out std_logic_vector(15 downto 0);
+    phase_counts : out std_logic_vector(255 downto 0);
+    txn_counts : out std_logic_vector(127 downto 0);
+    record_valid : out std_logic;
+    failed_record : out std_logic_vector(191 downto 0);
+    bank_errors : out std_logic_vector(31 downto 0);
+    poc : out std_logic_vector(1023 downto 0)
+  );
+end entity;
+
+architecture sim of r1i_master_test_adapter is
+begin
+  candidate : if REF_MODE = 0 generate
+    dut : entity work.nvp_i2c_bringup_seq_v38ek
+      generic map (CLK_HZ => CLK_HZ, I2C_HZ => I2C_HZ)
+      port map (
+        clk=>clk, rst=>rst, start=>start, range_sel=>"10", window_sel=>"000",
+        poll_only=>'0', output_sel=>x"A", channel_sel=>"00", auto_enable=>'0', stage_sel=>"10",
+        scl_i=>scl_i, sda_i=>sda_i, scl_oen=>scl_oen, sda_oen=>sda_oen,
+        busy=>busy, done=>done, any_error=>any_error, values=>values,
+        output_values=>output_values, afe_values=>afe_values,
+        read_error_mask=>read_errors, aux_error_mask=>aux_errors,
+        afe_error_mask=>afe_errors, write_error_mask=>write_errors,
+        original_ff=>original_ff, restored_ff=>restored_ff,
+        meta_bank=>meta_bank, phys_bank=>phys_bank, phys_bank_valid=>phys_bank_valid,
+        range_dbg=>open, window_dbg=>open, poll_only_dbg=>open,
+        output_dbg=>open, stage_dbg=>open, op_index_dbg=>open, state_dbg=>open,
+        autoinit_fsm_dbg=>phase_dbg, step_index_dbg=>step_dbg, table_length_dbg=>open,
+        last_op_dbg=>last_op, last_reg_dbg=>last_reg, last_wdata_dbg=>last_wdata,
+        last_rdata_dbg=>last_rdata, last_ack_dbg=>open,
+        first_error_valid_dbg=>first_valid, first_error_code_dbg=>first_code,
+        first_error_step_dbg=>open, first_error_meta_bank_dbg=>open,
+        first_error_phys_bank_dbg=>open, first_error_reg_dbg=>open,
+        first_error_data_dbg=>open, nack_count_dbg=>nack_count,
+        nack_log_count_dbg=>open, nack_log_overflow_dbg=>open, nack_log_dbg=>open,
+        timeout_count_dbg=>timeout_count, i2c_fsm_dbg=>i2c_state,
+        r1f_phase_counters_dbg=>phase_counts, r1f_transaction_counters_dbg=>txn_counts,
+        r1f_transaction_serial_next_dbg=>serial_next,
+        r1f_transaction_serial_overflow_dbg=>open,
+        r1f_failed_txn_record_valid_dbg=>record_valid,
+        r1f_failed_txn_record_dbg=>failed_record,
+        r1f_bank_invariant_check_count_dbg=>open,
+        r1f_bank_invariant_error_count_dbg=>bank_errors,
+        r1f_first_bank_invariant_error_dbg=>open,
+        r1i_poc_telemetry_dbg=>poc);
+  end generate;
+  reference : if REF_MODE = 1 generate
+    poc <= (others => '0');
+    dut : entity r1h_ref.nvp_i2c_bringup_seq_v38ek
+      generic map (CLK_HZ => CLK_HZ, I2C_HZ => I2C_HZ)
+      port map (
+        clk=>clk, rst=>rst, start=>start, range_sel=>"10", window_sel=>"000",
+        poll_only=>'0', output_sel=>x"A", channel_sel=>"00", auto_enable=>'0', stage_sel=>"10",
+        scl_i=>scl_i, sda_i=>sda_i, scl_oen=>scl_oen, sda_oen=>sda_oen,
+        busy=>busy, done=>done, any_error=>any_error, values=>values,
+        output_values=>output_values, afe_values=>afe_values,
+        read_error_mask=>read_errors, aux_error_mask=>aux_errors,
+        afe_error_mask=>afe_errors, write_error_mask=>write_errors,
+        original_ff=>original_ff, restored_ff=>restored_ff,
+        meta_bank=>meta_bank, phys_bank=>phys_bank, phys_bank_valid=>phys_bank_valid,
+        range_dbg=>open, window_dbg=>open, poll_only_dbg=>open,
+        output_dbg=>open, stage_dbg=>open, op_index_dbg=>open, state_dbg=>open,
+        autoinit_fsm_dbg=>phase_dbg, step_index_dbg=>step_dbg, table_length_dbg=>open,
+        last_op_dbg=>last_op, last_reg_dbg=>last_reg, last_wdata_dbg=>last_wdata,
+        last_rdata_dbg=>last_rdata, last_ack_dbg=>open,
+        first_error_valid_dbg=>first_valid, first_error_code_dbg=>first_code,
+        first_error_step_dbg=>open, first_error_meta_bank_dbg=>open,
+        first_error_phys_bank_dbg=>open, first_error_reg_dbg=>open,
+        first_error_data_dbg=>open, nack_count_dbg=>nack_count,
+        nack_log_count_dbg=>open, nack_log_overflow_dbg=>open, nack_log_dbg=>open,
+        timeout_count_dbg=>timeout_count, i2c_fsm_dbg=>i2c_state,
+        r1f_phase_counters_dbg=>phase_counts, r1f_transaction_counters_dbg=>txn_counts,
+        r1f_transaction_serial_next_dbg=>serial_next,
+        r1f_transaction_serial_overflow_dbg=>open,
+        r1f_failed_txn_record_valid_dbg=>record_valid,
+        r1f_failed_txn_record_dbg=>failed_record,
+        r1f_bank_invariant_check_count_dbg=>open,
+        r1f_bank_invariant_error_count_dbg=>bank_errors,
+        r1f_first_bank_invariant_error_dbg=>open);
+  end generate;
+end architecture;
diff --git a/tests/v41/run_r1i_focused_sim.ps1 b/tests/v41/run_r1i_focused_sim.ps1
new file mode 100644
index 0000000000000000000000000000000000000000..47fc3c65b3b73976a41b2821a4606d7ad10a2695
--- /dev/null
