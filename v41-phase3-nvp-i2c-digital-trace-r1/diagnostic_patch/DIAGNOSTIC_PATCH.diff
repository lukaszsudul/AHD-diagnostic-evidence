@@ -0,0 +1,50 @@
+param(
+    [Parameter(Mandatory = $true)][string]$BaseExport,
+    [Parameter(Mandatory = $true)][string]$DiagnosticSource,
+    [Parameter(Mandatory = $true)][string]$OutputDirectory
+)
+
+$ErrorActionPreference = 'Stop'
+$base = (Resolve-Path -LiteralPath $BaseExport).Path
+$source = (Resolve-Path -LiteralPath $DiagnosticSource).Path
+if (Test-Path -LiteralPath (Join-Path $source '.git')) {
+    throw 'Diagnostic source must not contain .git'
+}
+New-Item -ItemType Directory -Force -Path $OutputDirectory | Out-Null
+$output = (Resolve-Path -LiteralPath $OutputDirectory).Path
+$utf8NoBom = [System.Text.UTF8Encoding]::new($false)
+
+$manifestLines = [System.Collections.Generic.List[string]]::new()
+Get-ChildItem -LiteralPath $source -Recurse -File |
+    Sort-Object FullName |
+    ForEach-Object {
+        $relative = $_.FullName.Substring($source.Length).TrimStart('\', '/')
+        $relative = $relative.Replace('\', '/')
+        $sha = (Get-FileHash -LiteralPath $_.FullName -Algorithm SHA256).Hash
+        $manifestLines.Add("$sha  $relative")
+    }
+$manifestPath = Join-Path $output 'DIAGNOSTIC_SOURCE_MANIFEST_SHA256.txt'
+[System.IO.File]::WriteAllLines($manifestPath, $manifestLines, $utf8NoBom)
+
+$patchPath = Join-Path $output 'DIAGNOSTIC_PATCH.diff'
+$gitOutput = & git -c core.autocrlf=false -c core.safecrlf=false diff `
+    --no-index --binary --no-renames --src-prefix='a/' --dst-prefix='b/' `
+    -- $base $source 2>&1
+$gitExit = $LASTEXITCODE
+if ($gitExit -notin @(0, 1)) {
+    throw "git diff --no-index failed with exit $gitExit`n$($gitOutput -join "`n")"
+}
+[System.IO.File]::WriteAllLines($patchPath, [string[]]$gitOutput, $utf8NoBom)
+
+$patchSha = (Get-FileHash -LiteralPath $patchPath -Algorithm SHA256).Hash
+$manifestSha = (Get-FileHash -LiteralPath $manifestPath -Algorithm SHA256).Hash
+[System.IO.File]::WriteAllText(
+    (Join-Path $output 'DIAGNOSTIC_PATCH_SHA256.txt'),
+    "$patchSha  DIAGNOSTIC_PATCH.diff`n", $utf8NoBom)
+[System.IO.File]::WriteAllText(
+    (Join-Path $output 'DIAGNOSTIC_SOURCE_MANIFEST_FILE_SHA256.txt'),
+    "$manifestSha  DIAGNOSTIC_SOURCE_MANIFEST_SHA256.txt`n", $utf8NoBom)
+
+"DIAGNOSTIC_PATCH_SHA256=$patchSha"
+"DIAGNOSTIC_SOURCE_MANIFEST_SHA256=$manifestSha"
+"DIAGNOSTIC_SOURCE_FILE_COUNT=$($manifestLines.Count)"
