@@ -0,0 +1,373 @@
+if {$argc != 7} {
+  puts stderr "usage: build_nvp_trace_diagnostic.tcl SOURCE_ROOT BUILD_ROOT EVIDENCE_ROOT BASE_FUNCTIONAL_COMMIT DIAGNOSTIC_PATCH_SHA256 DIAGNOSTIC_SOURCE_MANIFEST_SHA256 BIT_FILENAME"
+  exit 2
+}
+
+set source_root [file normalize [lindex $argv 0]]
+set build_root [file normalize [lindex $argv 1]]
+set evidence_root [file normalize [lindex $argv 2]]
+set source_commit [string tolower [lindex $argv 3]]
+set patch_sha [string tolower [lindex $argv 4]]
+set source_manifest_sha [string tolower [lindex $argv 5]]
+set bit_filename [lindex $argv 6]
+source [file join $source_root scripts v41 xdma_config_common.tcl]
+
+proc write_lines {path lines} {
+  file mkdir [file dirname $path]
+  set fh [open $path w]
+  fconfigure $fh -translation lf
+  foreach line $lines { puts $fh $line }
+  close $fh
+}
+
+proc require_files {paths} {
+  foreach path $paths {
+    if {![file isfile $path]} { error "required file missing: $path" }
+  }
+}
+
+proc read_text {path} {
+  set fh [open $path r]
+  set text [read $fh]
+  close $fh
+  return $text
+}
+
+proc utilization_row {text wanted} {
+  set normalized_wanted [string trimright $wanted "*"]
+  foreach line [split $text "\n"] {
+    set columns [split $line "|"]
+    set actual [string trimright [string trim [lindex $columns 1]] "*"]
+    if {[llength $columns] >= 7 && $actual eq $normalized_wanted} {
+      return [list [string trim [lindex $columns 2]] \
+                   [string trim [lindex $columns 5]]]
+    }
+  }
+  error "utilization row '$wanted' not found"
+}
+
+if {![regexp {^[0-9a-f]{40}$} $source_commit]} {
+  error "BASE_FUNCTIONAL_COMMIT must be exactly 40 lowercase hex digits"
+}
+if {![regexp {^[0-9a-f]{64}$} $patch_sha]} {
+  error "DIAGNOSTIC_PATCH_SHA256 must be exactly 64 lowercase hex digits"
+}
+if {![regexp {^[0-9a-f]{64}$} $source_manifest_sha]} {
+  error "DIAGNOSTIC_SOURCE_MANIFEST_SHA256 must be exactly 64 lowercase hex digits"
+}
+if {[file exists [file join $source_root .git]]} {
+  error "ephemeral diagnostic source root must not contain .git"
+}
+
+set git_words [list]
+for {set word_index 0} {$word_index < 5} {incr word_index} {
+  set first [expr {$word_index * 8}]
+  lappend git_words [string range $source_commit $first [expr {$first + 7}]]
+}
+set patch_words [list]
+for {set word_index 0} {$word_index < 8} {incr word_index} {
+  set first [expr {$word_index * 8}]
+  lappend patch_words [string range $patch_sha $first [expr {$first + 7}]]
+}
+set generics [join [list \
+  "SLOT_COUNT=2" \
+  "DIAG_BASE_COMMIT_W0=32'h[lindex $git_words 0]" \
+  "DIAG_BASE_COMMIT_W1=32'h[lindex $git_words 1]" \
+  "DIAG_BASE_COMMIT_W2=32'h[lindex $git_words 2]" \
+  "DIAG_BASE_COMMIT_W3=32'h[lindex $git_words 3]" \
+  "DIAG_BASE_COMMIT_W4=32'h[lindex $git_words 4]" \
+  "DIAG_PATCH_SHA_W0=32'h[lindex $patch_words 0]" \
+  "DIAG_PATCH_SHA_W1=32'h[lindex $patch_words 1]" \
+  "DIAG_PATCH_SHA_W2=32'h[lindex $patch_words 2]" \
+  "DIAG_PATCH_SHA_W3=32'h[lindex $patch_words 3]" \
+  "DIAG_PATCH_SHA_W4=32'h[lindex $patch_words 4]" \
+  "DIAG_PATCH_SHA_W5=32'h[lindex $patch_words 5]" \
+  "DIAG_PATCH_SHA_W6=32'h[lindex $patch_words 6]" \
+  "DIAG_PATCH_SHA_W7=32'h[lindex $patch_words 7]"] " "]
+
+file mkdir $build_root
+file mkdir $evidence_root
+cd $build_root
+
+set project_name v41_nvp_trace_diagnostic_only
+set project_dir [file join $build_root project]
+create_project -force $project_name $project_dir -part $v41_xdma::part
+set_property target_language Verilog [current_project]
+set_property simulator_language Mixed [current_project]
+set_property XPM_LIBRARIES {XPM_CDC XPM_MEMORY} [current_project]
+
+set sv_files [list \
+  [file join $source_root rtl v41 axi_lite_host_bridge.sv] \
+  [file join $source_root rtl v41 control_status_regs.sv] \
+  [file join $source_root rtl pio pio_slot_adapter.sv] \
+  [file join $source_root rtl pio pio_bar_target.sv] \
