@@ -26,7 +26,8 @@ entity v40a_nvp_autoinit is
     init_busy    : out std_logic;
     init_done    : out std_logic;
     init_error   : out std_logic;
-    diag_detail  : out std_logic_vector(735 downto 0)
+    diag_detail  : out std_logic_vector(735 downto 0);
+    trace_sample : out std_logic_vector(63 downto 0)
