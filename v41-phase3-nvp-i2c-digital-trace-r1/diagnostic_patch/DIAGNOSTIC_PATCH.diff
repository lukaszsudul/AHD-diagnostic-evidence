+
+  task automatic host_read(input logic [16:0] address,
+                           output logic [31:0] value);
+    begin
+      @(negedge clk);
+      host_req_addr = address;
+      host_req_write = 1'b0;
+      host_req_valid = 1'b1;
+      while (!host_req_ready) @(negedge clk);
+      @(posedge clk);
+      @(negedge clk);
+      host_req_valid = 1'b0;
+      while (!host_rsp_valid) @(posedge clk);
+      value = host_rsp_rdata;
+      @(negedge clk);
+    end
+  endtask
+
+  task automatic host_write(input logic [16:0] address,
+                            input logic [31:0] value);
+    begin
+      @(negedge clk);
+      host_req_addr = address;
+      host_req_wdata = value;
+      host_req_be = 4'hF;
+      host_req_write = 1'b1;
+      host_req_valid = 1'b1;
+      while (!host_req_ready) @(negedge clk);
+      @(posedge clk);
+      @(negedge clk);
+      host_req_valid = 1'b0;
+      host_req_write = 1'b0;
