+`timescale 1ns/1ps
+
+module tb_nvp_trace_observer;
+  localparam integer DEPTH = 32;
+  localparam integer PRE = 24;
+  localparam integer POST = 8;
+  localparam integer AW = $clog2(DEPTH);
+
+  logic clk = 1'b0;
