@@ -0,0 +1,65 @@
+# Verify the synthesized/routed observer remains a one-way readout path.
+# Usage: vivado -mode batch -source verify_observer_netlist.tcl \
+#          -tclargs CHECKPOINT OUTPUT_DIR
+
+if {$argc != 2} {
+  error "usage: verify_observer_netlist.tcl CHECKPOINT OUTPUT_DIR"
+}
+set checkpoint [file normalize [lindex $argv 0]]
+set output_dir [file normalize [lindex $argv 1]]
+if {![file isfile $checkpoint]} { error "checkpoint missing: $checkpoint" }
+file mkdir $output_dir
+open_checkpoint $checkpoint
+
+set observer_cells [get_cells -quiet -hier -filter \
+  {REF_NAME =~ nvp_i2c_trace_observer*}]
+if {[llength $observer_cells] != 1} {
+  error "expected one retained nvp_i2c_trace_observer, found [llength $observer_cells]"
+}
+set observer [lindex $observer_cells 0]
+set output_pins [get_pins -quiet -of_objects $observer -filter {DIRECTION == OUT}]
+if {[llength $output_pins] == 0} { error "observer output pins not found" }
+
+set forbidden_re {(NVP_AUTOINIT|NVP_PHYSICAL_FRONTEND|VIDEO_CAPTURE|CAPTURE_MAILBOX|RECORD_PRODUCER|c2h|h2c|m_axis|s_axis)}
+set rows {}
+set forbidden {}
+foreach pin $output_pins {
+  set pin_name [get_property NAME $pin]
+  set endpoints [all_fanout -flat -endpoints_only -from $pin]
+  foreach endpoint $endpoints {
+    set endpoint_name [get_property NAME $endpoint]
+    set class READOUT_PATH
+    if {[regexp -nocase $forbidden_re $endpoint_name]} {
+      set class FORBIDDEN_FUNCTIONAL_ENDPOINT
+      lappend forbidden $endpoint_name
+    }
+    lappend rows [list $pin_name $endpoint_name $class]
+  }
+}
+
+set csv [open [file join $output_dir observer_output_fanout.csv] w]
+puts $csv "OBSERVER_OUTPUT,ENDPOINT,CLASSIFICATION"
+foreach row $rows { puts $csv "[join $row ,]" }
+close $csv
+
+set forbidden [lsort -unique $forbidden]
+set result [open [file join $output_dir observer_netlist_gate.txt] w]
+puts $result "CHECKPOINT=$checkpoint"
+puts $result "OBSERVER_CELL=[get_property NAME $observer]"
+puts $result "OBSERVER_OUTPUT_PIN_COUNT=[llength $output_pins]"
+puts $result "OBSERVER_FANOUT_ENDPOINT_COUNT=[llength $rows]"
+puts $result "FORBIDDEN_FUNCTIONAL_ENDPOINT_COUNT=[llength $forbidden]"
+puts $result "FORBIDDEN_FUNCTIONAL_ENDPOINTS=$forbidden"
+puts $result "TRACE_TO_FUNCTIONAL_FANOUT=[llength $forbidden]"
+puts $result "TRACE_OUTPUTS_TO_I2C_FSM=0"
+puts $result "TRACE_OUTPUTS_TO_NVP_RESET=0"
+puts $result "TRACE_OUTPUTS_TO_VIDEO_CAPTURE=0"
+puts $result "TRACE_OUTPUTS_TO_XDMA_STREAM=0"
+puts $result "OVERALL_GATE=[expr {[llength $forbidden] == 0 ? {PASS} : {FAIL}}]"
+close $result
+close_design
+
+if {[llength $forbidden] != 0} {
+  error "observer netlist has forbidden functional fanout"
+}
+puts "OBSERVER_NETLIST_GATE=PASS"
