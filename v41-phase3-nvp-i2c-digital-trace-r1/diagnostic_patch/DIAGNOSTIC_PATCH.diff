+    end
+  end
+
+  function automatic [63:0] make_sample(
+    input logic sda1, input logic sda2, input logic sdaf,
+    input logic scl1, input logic scl2, input logic sclf,
+    input logic sda_drive, input logic scl_drive,
+    input logic ack_strobe, input logic ack_used,
+    input logic first_nack, input logic first_latched,
+    input logic [3:0] bit_index, input logic [7:0] phase,
+    input logic [7:0] state, input logic [7:0] operation,
+    input logic [7:0] tx_byte, input logic init_done,
+    input logic init_error);
+    logic [63:0] v;
+    begin
+      v = '0;
+      v[0] = sda1; v[1] = sda2; v[2] = sdaf;
+      v[3] = scl1; v[4] = scl2; v[5] = sclf;
+      v[6] = sda_drive; v[7] = scl_drive;
+      v[8] = ack_strobe; v[9] = ack_used;
+      v[10] = first_nack; v[11] = first_latched;
+      v[12] = 1'b1; v[13] = 1'b1; v[14] = 1'b1; v[15] = 1'b1;
+      v[19:16] = bit_index; v[27:20] = phase; v[35:28] = state;
+      v[43:36] = operation; v[51:44] = tx_byte;
+      v[52] = init_done; v[53] = init_error;
