+        trace_sample[11] = 1'b1;
+        @(posedge clk);
+        timeout = timeout + 1;
+      end
+      if (!trace_frozen) $fatal(1, "trace did not freeze");
+      if (trace_overflow) $fatal(1, "unexpected trace overflow");
+    end
+  endtask
