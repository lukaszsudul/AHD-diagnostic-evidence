+              else
+                r1f_tx_slot_r <= x"FFFF";
+              end if;
+
+              tx_kind_v := x"0";
+              tx_context_v := x"00";
+              case phase is
+                when PH_ORIGINAL =>
+                  tx_context_v := std_logic_vector(to_unsigned(t_preinit_action'pos(preinit_action), 8));
+                  case preinit_action is
+                    when PREINIT_READ_ORIGINAL => tx_kind_v := x"1";
+                    when PREINIT_FORCE_BANK0_WRITE => tx_kind_v := x"2";
+                    when PREINIT_FORCE_BANK0_VERIFY => tx_kind_v := x"3";
+                  end case;
+                when PH_INIT =>
+                  tx_context_v := std_logic_vector(to_unsigned(slot_idx mod 256, 8));
+                  case init_action is
+                    when INIT_BANK_WRITE => tx_kind_v := x"4";
