+              ll_raddr_ack <= !sda_filtered;
+              if (sda_filtered) begin
+                ll_error <= 1'b1;
+                ll_state <= LL_STOP_A;
+              end else begin
+                ll_bit_index <= 3'd7;
+                ll_rx_byte <= 8'b0;
+                ll_state <= LL_READ_LOW;
+              end
+            end
+            LL_READ_LOW: ll_state <= LL_READ_HIGH;
+            LL_READ_HIGH: if (scl_filtered) begin
