+          ll_success <= 1'b0;
+          ll_timeout <= 1'b0;
+          ll_error <= 1'b0;
+          ll_kind_latched <= ll_cmd_kind;
+          ll_reg_latched <= ll_cmd_reg;
+          ll_data_latched <= ll_cmd_data;
+          ll_waddr_reached <= 1'b0;
+          ll_waddr_ack <= 1'b0;
+          ll_reg_reached <= 1'b0;
+          ll_reg_ack <= 1'b0;
+          ll_data_reached <= 1'b0;
+          ll_data_ack <= 1'b0;
+          ll_raddr_reached <= 1'b0;
+          ll_raddr_ack <= 1'b0;
+          ll_read_data <= 8'b0;
