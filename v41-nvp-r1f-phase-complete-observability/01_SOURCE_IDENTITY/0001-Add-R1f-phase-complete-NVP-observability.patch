+    "SOURCE_GIT_COMMIT=$source_commit" \
+    "SOURCE_GIT_TREE=$source_tree" \
+    "PROGRAM_RETRY_AUTHORIZED=NO" \
+    "TERMINAL_ERROR=$flow_error" \
+    "ERROR_INFO_BEGIN" \
+    $error_info \
+    "ERROR_INFO_END"]
+  puts stderr "R1F_ONE_CLEAN_BUILD_CONSUMED=YES"
+  puts stderr "R1F_BUILD_TERMINAL_FAILURE=$flow_error"
+  exit 1
+}
