+    r1f_probe_setup_restore_status[11] = tri_probe_aborted &&
+        tri_probe_abort_code >= 8'h01 && tri_probe_abort_code <= 8'h04;
+    r1f_probe_setup_restore_status[12] = tri_probe_aborted &&
+        (tri_probe_abort_code >= 8'h07 ||
