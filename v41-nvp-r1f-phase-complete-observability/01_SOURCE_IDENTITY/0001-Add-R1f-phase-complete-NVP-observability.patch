+    .legacy_bus_idle_qualified, .legacy_scl_timeout,
+    .legacy_bus_idle_timeout,
+    .index_read_phase, .index_read_word, .index_read_data,
+    .block_read_phase, .block_read_index, .block_read_nack_count
+  );
+
+  initial begin : run_test
+    integer watchdog;
+    repeat (4) @(posedge clk);
+    rst = 1'b0;
+    watchdog = 0;
+    while (!probe_terminal && watchdog < 1000) begin
+      @(posedge clk);
+      watchdog = watchdog + 1;
+    end
+    if (!probe_terminal || probe_done || !probe_aborted)
+      $fatal(1, "idle-timeout test did not terminate as an abort");
+    if (probe_abort_code != 8'h01 || probe_restore_failure_code != 8'h00)
+      $fatal(1, "unexpected idle-timeout codes primary=%02x secondary=%02x",
+             probe_abort_code, probe_restore_failure_code);
+    if (!legacy_init_done_seen || !legacy_guard_complete ||
+        legacy_bus_idle_qualified || legacy_scl_timeout ||
+        !legacy_bus_idle_timeout)
+      $fatal(1, "preserved R1e bus-idle-timeout status semantics mismatch");
+    if (!probe_scl_release || !probe_sda_release)
+      $fatal(1, "probe lines not released after idle-timeout abort");
+    $display("TRI_PHASE_PROBE_IDLE_TIMEOUT_COMPAT_PASS cycles=%0d", watchdog);
+    $finish;
+  end
+endmodule
diff --git a/tests/v41/tb_nvp_i2c_tri_phase_probe_index_overflow.sv b/tests/v41/tb_nvp_i2c_tri_phase_probe_index_overflow.sv
new file mode 100644
index 0000000000000000000000000000000000000000..0f0d7854324bdb7141d7af7ddfec15d8c56873e8
--- /dev/null
+++ b/tests/v41/tb_nvp_i2c_tri_phase_probe_index_overflow.sv
@@ -0,0 +1,144 @@
+`timescale 1ns/1ps
+
+module tb_nvp_i2c_tri_phase_probe_index_overflow;
+  logic clk = 0, rst = 1;
+  logic [47:0] freerun_count = 0;
+  logic raw_scl_i, raw_sda_i;
+  logic probe_scl_release, probe_sda_release, probe_active;
+  logic probe_done, probe_aborted, probe_terminal;
+  logic [7:0] probe_abort_code;
+  logic [15:0] waddr_nack_index_stored_count;
+  logic [15:0] regaddr_nack_index_stored_count;
+  logic [15:0] data_nack_index_stored_count;
+  logic waddr_nack_index_overflow, regaddr_nack_index_overflow;
+  logic data_nack_index_overflow;
+  logic [15:0] waddr_first_nack_index, waddr_last_nack_index;
+  logic [15:0] regaddr_first_nack_index, regaddr_last_nack_index;
+  logic [15:0] data_first_nack_index, data_last_nack_index;
+  logic [31:0] waddr_max_consecutive_nacks, waddr_adjacent_nack_pairs;
+  logic [31:0] regaddr_max_consecutive_nacks, regaddr_adjacent_nack_pairs;
+  logic [31:0] data_max_consecutive_nacks, data_adjacent_nack_pairs;
+  logic [31:0] waddr_run_count, regaddr_run_count, data_run_count;
+  logic [1:0] index_read_phase = 0;
+  logic [7:0] index_read_word = 0;
+  logic [31:0] index_read_data;
+  logic [1:0] block_read_phase = 0;
+  logic [3:0] block_read_index = 0;
+  logic [31:0] block_read_nack_count;
+  logic slave_sda_release;
+  logic [7:0] slave_bank = 8'h02;
+  logic [7:0] slave_read_value;
+
+  always #500 clk = ~clk;
+  always_ff @(posedge clk) freerun_count <= freerun_count + 1'b1;
+  assign raw_scl_i = probe_scl_release;
+  assign raw_sda_i = probe_sda_release && slave_sda_release;
+
+  always_comb begin
+    slave_read_value = (dut.ll_reg_latched == 8'hff) ? slave_bank : 8'h00;
+    slave_sda_release = 1'b1;
+    case (dut.ll_state)
+      6'd6, 6'd7:
+        slave_sda_release = probe_active && dut.current_phase == 2'd0;
+      6'd10, 6'd11:
+        slave_sda_release = probe_active && dut.current_phase == 2'd1;
+      6'd14, 6'd15:
+        slave_sda_release = probe_active && dut.current_phase == 2'd2;
+      6'd22, 6'd23: slave_sda_release = 1'b0;
+      6'd24, 6'd25:
+        slave_sda_release = slave_read_value[dut.ll_bit_index];
+      default: slave_sda_release = 1'b1;
+    endcase
+  end
+
+  always_ff @(posedge clk)
+    if (dut.ll_done && dut.ll_success && dut.ll_kind_latched == 2'd2 &&
+        dut.ll_reg_latched == 8'hff)
+      slave_bank <= dut.ll_data_latched;
+
+  nvp_i2c_tri_phase_probe #(
+    .CLK_HZ(1000000), .PROBE_I2C_HZ(25000),
+    .TARGET_OPPORTUNITIES_PER_PHASE(6), .BLOCK_COUNT_PER_PHASE(2),
+    .NACK_INDEX_CAPACITY_PER_PHASE(4),
+    .MAX_TRANSACTION_ATTEMPTS_PER_PHASE(8),
+    .POST_INIT_GUARD_CYCLES(4), .SCL_TIMEOUT_CYCLES(200),
+    .BUS_IDLE_TIMEOUT_CYCLES(2000)
+  ) dut (
+    .clk, .rst, .init_done(1'b1), .init_busy(1'b0), .nvp_rst(1'b1),
+    .init_scl_release(1'b1), .init_sda_release(1'b1),
+    .raw_scl_i, .raw_sda_i, .freerun_count,
+    .probe_scl_release, .probe_sda_release, .probe_active, .probe_done,
+    .probe_aborted, .probe_terminal, .probe_abort_code,
+    .waddr_first_nack_index, .waddr_last_nack_index,
+    .waddr_max_consecutive_nacks, .waddr_adjacent_nack_pairs,
+    .waddr_run_count, .regaddr_first_nack_index,
+    .regaddr_last_nack_index, .regaddr_max_consecutive_nacks,
+    .regaddr_adjacent_nack_pairs, .regaddr_run_count,
+    .data_first_nack_index, .data_last_nack_index,
+    .data_max_consecutive_nacks, .data_adjacent_nack_pairs, .data_run_count,
+    .waddr_nack_index_stored_count, .regaddr_nack_index_stored_count,
+    .data_nack_index_stored_count, .waddr_nack_index_overflow,
+    .regaddr_nack_index_overflow, .data_nack_index_overflow,
+    .index_read_phase, .index_read_word, .index_read_data,
+    .block_read_phase, .block_read_index, .block_read_nack_count
+  );
+
+  task automatic check_phase(input logic [1:0] phase_number);
+    begin
+      index_read_phase = phase_number; index_read_word = 0; #1;
+      if (index_read_data !== 32'h00010000)
+        $fatal(1, "phase %0d packed word0 mismatch", phase_number);
+      index_read_word = 1; #1;
+      if (index_read_data !== 32'h00030002)
+        $fatal(1, "phase %0d packed word1 mismatch", phase_number);
+      index_read_word = 2; #1;
+      if (index_read_data !== 0)
+        $fatal(1, "phase %0d out-of-capacity word not zero", phase_number);
+      block_read_phase = phase_number; block_read_index = 0; #1;
+      if (block_read_nack_count !== 3)
+        $fatal(1, "phase %0d block0 mismatch", phase_number);
+      block_read_index = 1; #1;
+      if (block_read_nack_count !== 3)
+        $fatal(1, "phase %0d block1 mismatch", phase_number);
+    end
+  endtask
+
+  initial begin : run_test
+    integer watchdog;
+    repeat (8) @(posedge clk);
+    rst <= 0;
+    watchdog = 0;
+    while (!probe_terminal && watchdog < 150000) begin
+      @(posedge clk);
+      watchdog++;
+    end
+    if (!probe_terminal || !probe_done || probe_aborted || probe_abort_code != 0)
+      $fatal(1, "index-overflow test did not complete validly");
+    repeat (3) @(posedge clk);
+    if (waddr_nack_index_stored_count != 4 ||
+        regaddr_nack_index_stored_count != 4 ||
+        data_nack_index_stored_count != 4 ||
+        !waddr_nack_index_overflow || !regaddr_nack_index_overflow ||
+        !data_nack_index_overflow)
+      $fatal(1, "per-phase index overflow/count mismatch");
+    if (waddr_first_nack_index != 0 || regaddr_first_nack_index != 0 ||
+        data_first_nack_index != 0 || waddr_last_nack_index != 5 ||
+        regaddr_last_nack_index != 5 || data_last_nack_index != 5)
+      $fatal(1, "zero-based first/last index mismatch");
+    if (waddr_max_consecutive_nacks != 6 ||
+        regaddr_max_consecutive_nacks != 6 ||
+        data_max_consecutive_nacks != 6 ||
+        waddr_adjacent_nack_pairs != 5 ||
+        regaddr_adjacent_nack_pairs != 5 ||
+        data_adjacent_nack_pairs != 5 || waddr_run_count != 1 ||
+        regaddr_run_count != 1 || data_run_count != 1)
+      $fatal(1, "all-NACK sequence statistics mismatch");
+    check_phase(0);
+    check_phase(1);
+    check_phase(2);
+    if (!probe_scl_release || !probe_sda_release || slave_bank != 8'h02)
+      $fatal(1, "terminal release/restoration mismatch");
+    $display("TRI_PHASE_PROBE_INDEX_OVERFLOW_PASS cycles=%0d", watchdog);
+    $finish;
+  end
+endmodule
