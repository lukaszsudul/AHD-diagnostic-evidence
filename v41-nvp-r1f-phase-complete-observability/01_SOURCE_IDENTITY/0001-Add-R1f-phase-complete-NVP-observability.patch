+  wire [6:0] stored_count;
+  wire overflow;
+  wire [15:0] first_failed_txn_index;
+  wire first_failed_txn_index_valid;
+  wire [15:0] last_failed_txn_index;
+  wire last_failed_txn_index_valid;
+  wire total_count_saturated;
+  wire input_protocol_error;
+  logic [191:0] expected_record;
+
+  always #5 clk = ~clk;
+
+  v41_r1f_failed_txn_logger dut (.*);
+
+  function automatic [191:0] make_record(input integer txn_index);
+    reg [191:0] value;
+    begin
+      value = '0;
+      value[15:0] = txn_index[15:0];
+      value[31:16] = 16'hffff;
+      value[39:32] = txn_index[7:0];
+      value[43:40] = 4'd0; // PH_ORIGINAL
+      value[47:44] = 4'd1; // ORIGINAL_BANK_READ
+      value[51:48] = 4'b0001;
+      value[55:52] = 4'b0001;
+      value[58:56] = 3'd1;
+      value[60] = 1'b1; // transaction completed
+      value[61] = 1'b1; // record valid
+      value[71:64] = 8'hff;
+      value[88] = 1'b1; // register valid
+      value[95:88] = value[95:88] | 8'h01;
+      value[103:96] = 8'h5a;
+      value[135:128] = 8'h5a;
+      value[144] = 1'b1;
+      value[159:152] = 8'h1e;
+      make_record = value;
+    end
+  endfunction
+
+  task automatic fail(input string message);
+    begin
+      $display("FAIL: %s", message);
+      $fatal(1);
+    end
+  endtask
+
+  task automatic push_record(input integer txn_index);
+    begin
+      @(negedge clk);
+      r1f_failed_txn_record = make_record(txn_index);
+      r1f_failed_txn_valid = 1'b1;
+      @(negedge clk);
+      r1f_failed_txn_valid = 1'b0;
+      r1f_failed_txn_record = '0;
+    end
+  endtask
+
+  task automatic expect_word(
+      input integer index, input integer word_number, input [31:0] expected);
+    begin
+      record_read_index = index[5:0];
+      record_read_word = word_number[2:0];
+      #1;
+      if (record_read_data !== expected)
+        fail($sformatf("record %0d word %0d expected %08x got %08x",
+                       index, word_number, expected, record_read_data));
+    end
+  endtask
+
+  integer i;
+  initial begin
+    repeat (3) @(posedge clk);
+    @(negedge clk);
+    reset = 1'b0;
+
+    for (i = 0; i < 64; i = i + 1)
+      expect_word(i, 0, 32'b0);
+    if (total_count != 0 || stored_count != 0 || overflow)
+      fail("reset counters are not zero");
+
+    push_record(0);
+    expected_record = make_record(0);
+    if (total_count != 1 || stored_count != 1 || overflow)
+      fail("first append counters");
+    if (!first_failed_txn_index_valid || first_failed_txn_index != 0)
+      fail("transaction index zero was not represented with explicit validity");
+    if (!last_failed_txn_index_valid || last_failed_txn_index != 0)
+      fail("first last-index state");
+    expect_word(0, 0, 32'hffff0000);
+    expect_word(0, 1, expected_record[63:32]);
+    expect_word(0, 5, expected_record[191:160]);
+    expect_word(1, 0, 32'b0);
+
+    for (i = 1; i < 64; i = i + 1)
+      push_record(i);
+    if (total_count != 64 || stored_count != 64 || overflow)
+      fail("exact capacity must not overflow");
+    if (first_failed_txn_index != 0 || last_failed_txn_index != 63)
+      fail("first/last at exact capacity");
+    expect_word(0, 0, 32'hffff0000);
+    expect_word(63, 0, 32'hffff003f);
+
+    push_record(64);
+    if (total_count != 65 || stored_count != 64 || !overflow)
+      fail("65th failure overflow semantics");
+    if (first_failed_txn_index != 0 || last_failed_txn_index != 64)
+      fail("first/last after overflow");
+    expect_word(0, 0, 32'hffff0000);
+    expect_word(63, 0, 32'hffff003f);
+
+    push_record(65);
+    if (total_count != 66 || stored_count != 64 || !overflow ||
+        last_failed_txn_index != 65)
+      fail("total must continue after overflow without overwrite");
+    expect_word(0, 0, 32'hffff0000);
+    expect_word(63, 0, 32'hffff003f);
+    if (input_protocol_error || total_count_saturated)
+      fail("well-formed records raised protocol/saturation error");
+
+    @(negedge clk);
+    reset = 1'b1;
+    repeat (2) @(posedge clk);
+    #1;
+    if (total_count != 0 || stored_count != 0 || overflow)
+      fail("second reset counters");
+    for (i = 0; i < 64; i = i + 1)
+      expect_word(i, 0, 32'b0);
+
+    $display("R1F_FAILED_TRANSACTION_LOG_MATCH_SCOREBOARD=PASS");
+    $display("R1F_LOG_64_EXACT_OVERFLOW_65=PASS");
+    $display("R1F_LOG_UNUSED_ZERO_IMMUTABLE=PASS");
+    $finish;
+  end
+endmodule
diff --git a/tests/v41/tb_r1f_measurement_regs.sv b/tests/v41/tb_r1f_measurement_regs.sv
new file mode 100644
index 0000000000000000000000000000000000000000..6d64fbab3df6b6966e699ce8056935fcc50a9923
--- /dev/null
+++ b/tests/v41/tb_r1f_measurement_regs.sv
@@ -0,0 +1,188 @@
+`timescale 1ns/1ps
+
+module tb_r1f_measurement_regs;
+  logic [13:0] offset;
+  logic [31:0] autoinit_waddr_opportunities = 32'd100;
+  logic [31:0] autoinit_waddr_nacks = 32'd1;
+  logic [31:0] autoinit_regaddr_opportunities = 32'd99;
+  logic [31:0] autoinit_regaddr_nacks = 32'd2;
+  logic [31:0] autoinit_data_opportunities = 32'd97;
+  logic [31:0] autoinit_data_nacks = 32'd3;
+  logic [31:0] autoinit_raddr_opportunities = 32'd10;
+  logic [31:0] autoinit_raddr_nacks = 32'd4;
+  logic [31:0] autoinit_transaction_starts = 32'd110;
+  logic [31:0] autoinit_transaction_completions = 32'd110;
+  logic [31:0] autoinit_failed_transactions = 32'd8;
+  logic [31:0] autoinit_timeout_transactions = 32'd0;
+  logic phase_counters_final = 1'b1;
+  logic phase_counter_saturation = 1'b0;
+  logic [31:0] legacy_aggregate_nack_count = 32'd10;
+  logic legacy_first8_reconciliation_supported = 1'b1;
+  logic [31:0] failed_txn_total_count = 32'd8;
+  logic [6:0] failed_txn_stored_count = 7'd8;
+  logic failed_txn_overflow = 1'b0;
+  logic [15:0] first_failed_txn_index = 16'd2;
+  logic first_failed_txn_index_valid = 1'b1;
+  logic [15:0] last_failed_txn_index = 16'd109;
+  logic last_failed_txn_index_valid = 1'b1;
+  logic [15:0] next_transaction_serial = 16'd110;
+  logic transaction_serial_overflow = 1'b0;
+  logic failed_txn_total_count_saturated = 1'b0;
+  logic failed_txn_input_protocol_error = 1'b0;
+  logic [31:0] bank_invariant_check_count = 32'd42;
+  logic [31:0] bank_invariant_error_count = 32'd0;
+  logic [31:0] first_bank_invariant_error = 32'd0;
+  logic [7:0] final_physical_bank = 8'h05;
+  logic final_physical_bank_valid = 1'b1;
+  logic [31:0] tri_phase_probe_status = 32'h000003fb;
+  logic [31:0] probe_timeout_count_total = 32'd0;
+  logic [31:0] probe_setup_restore_status = 32'h000007ff;
+  logic [7:0] safe_target_pre_readback = 8'haa;
+  logic safe_target_pre_readback_valid = 1'b1;
+  logic [7:0] safe_target_post_readback = 8'haa;
+  logic safe_target_post_readback_valid = 1'b1;
+  logic [7:0] original_bank_readback = 8'h09;
+  logic original_bank_readback_valid = 1'b1;
+  logic [7:0] restored_bank_readback = 8'h09;
+  logic restored_bank_readback_valid = 1'b1;
+  logic restored_bank_verified = 1'b1;
+  logic [47:0] probe_start_freerun = 48'h0123456789ab;
+  logic [47:0] probe_done_freerun = 48'h0abcdef01234;
+  wire [6:0] probe_detail_read_word;
+  wire probe_detail_read_select;
+  logic [31:0] probe_detail_read_data;
+  wire [5:0] record_read_index;
+  wire [2:0] record_read_word;
+  logic [31:0] record_read_data;
+  wire [1:0] probe_index_read_phase;
+  wire [7:0] probe_index_read_word;
+  wire probe_index_read_select;
+  logic [31:0] probe_index_read_data;
+  wire [31:0] read_data;
+  wire [31:0] formal_read_data;
+
+  always_comb begin
+    probe_detail_read_data = 32'hd0000000 | probe_detail_read_word;
+    record_read_data = 32'ha0000000 |
+                       ({26'b0, record_read_index} << 3) |
+                       record_read_word;
+    probe_index_read_data = 32'he0000000 |
+                            ({30'b0, probe_index_read_phase} << 8) |
+                            probe_index_read_word;
+  end
+
+  v41_r1f_measurement_regs #(
+    .SAFE_PROBE_BANK(8'h05),
+    .SAFE_PROBE_REGISTER(8'h55),
+    .SAFE_PROBE_DATA(8'haa),
+    .SAFE_PROBE_TARGET_PROVEN(1'b1)
+  ) dut (.*);
+
+  v41_r1f_formal_zero_model formal_model (
+    .offset(offset), .read_data(formal_read_data));
+
+  task automatic fail(input string message);
+    begin
+      $display("FAIL: %s", message);
+      $fatal(1);
+    end
+  endtask
+
+  task automatic expect_read(input [13:0] address, input [31:0] expected);
+    begin
+      offset = address;
+      #1;
+      if (read_data !== expected)
+        fail($sformatf("read %04x expected %08x got %08x",
+                       address, expected, read_data));
+    end
+  endtask
+
+  integer address;
+  initial begin
+    expect_read(14'h20a0, 32'h31463152);
+    expect_read(14'h20a4, 32'd1);
+    expect_read(14'h20a8, 32'h000007ff);
+    expect_read(14'h20ac, 32'd1);
+    expect_read(14'h20b0, 32'd192);
+    expect_read(14'h20b4, 32'd6);
+    expect_read(14'h20b8, 32'd64);
+    expect_read(14'h20bc, 32'd7);
+    expect_read(14'h20c0, 32'h80aa5505);
+    expect_read(14'h20c4, 32'd25000);
+    expect_read(14'h20cc, 32'd10000);
+    expect_read(14'h20dc, 32'd512);
+    expect_read(14'h20e0, 32'd100);
+    expect_read(14'h20e4, 32'd1);
+    expect_read(14'h2110, 32'h0000000f);
+    expect_read(14'h2118, 32'd10);
+    expect_read(14'h211c, 32'h00000007);
+    expect_read(14'h2120, 32'd8);
+    expect_read(14'h2124, 32'd8);
+    expect_read(14'h212c, 32'd2);
+    expect_read(14'h2130, 32'd109);
+    expect_read(14'h2134, 32'h0000007b);
+    expect_read(14'h2138, 32'd110);
+    expect_read(14'h2148, 32'h00000105);
+    expect_read(14'h2158, 32'h000001aa);
+    expect_read(14'h2164, 32'h00000309);
+    expect_read(14'h2168, 32'h456789ab);
+    expect_read(14'h216c, 32'h00000123);
+    expect_read(14'h2178, 32'b0);
+
+    expect_read(14'h2200, 32'hd0000000);
+    if (!probe_detail_read_select || probe_detail_read_word != 0)
+      fail("probe detail base routing");
+    expect_read(14'h23fc, 32'hd000007f);
+    if (!probe_detail_read_select || probe_detail_read_word != 7'h7f)
+      fail("probe detail end routing");
+
+    expect_read(14'h2400, 32'ha0000000);
+    if (record_read_index != 0 || record_read_word != 0)
+      fail("record zero word zero routing");
+    expect_read(14'h2414, 32'ha0000005);
+    if (record_read_index != 0 || record_read_word != 5)
+      fail("record zero word five routing");
+    expect_read(14'h2418, 32'ha0000008);
+    if (record_read_index != 1 || record_read_word != 0)
+      fail("record one routing");
+    expect_read(14'h29fc, 32'ha00001fd);
+    if (record_read_index != 63 || record_read_word != 5)
+      fail("record 63 word five routing");
+
+    expect_read(14'h2a00, 32'he0000000);
+    if (!probe_index_read_select || probe_index_read_phase != 0 ||
+        probe_index_read_word != 0)
+      fail("WADDR index base routing");
+    expect_read(14'h2dfc, 32'he00000ff);
+    expect_read(14'h2e00, 32'he0000100);
+    if (probe_index_read_phase != 1 || probe_index_read_word != 0)
+      fail("REGADDR index base routing");
+    expect_read(14'h31fc, 32'he00001ff);
+    expect_read(14'h3200, 32'he0000200);
+    if (probe_index_read_phase != 2 || probe_index_read_word != 0)
+      fail("DATA index base routing");
+    expect_read(14'h35fc, 32'he00002ff);
+
+    offset = 14'h20a1;
+    #1;
+    if (read_data != 0 || probe_detail_read_select ||
+        probe_index_read_select)
+      fail("unaligned read must return zero without submodule selection");
+    expect_read(14'h2000, 32'b0);
+    expect_read(14'h3600, 32'b0);
+
+    for (address = 14'h20a0; address <= 14'h35fc; address = address + 4) begin
+      offset = address[13:0];
+      #1;
+      if (formal_read_data !== 32'b0)
+        fail($sformatf("formal zero model nonzero at %04x", address));
+    end
+
+    $display("R1F_REGISTER_MAP_DECODE=PASS");
+    $display("R1F_RECORD_RANGE_LAST_WORD_0X29FC=PASS");
+    $display("R1F_INDEX_LOG_512_PER_PHASE=PASS");
+    $display("FORMAL_R1F_RANGE_ZERO_FIXTURE=PASS_ALL_1368_DWORDS");
+    $finish;
+  end
+endmodule
diff --git a/tests/v41/tb_r1f_preinit_arbitration.sv b/tests/v41/tb_r1f_preinit_arbitration.sv
new file mode 100644
index 0000000000000000000000000000000000000000..f224e50b7e19a181ae07c7ceb5459bf3552009a5
--- /dev/null
+++ b/tests/v41/tb_r1f_preinit_arbitration.sv
@@ -0,0 +1,69 @@
+`timescale 1ns/1ps
+
+module tb_r1f_preinit_arbitration;
+  logic clk = 1'b0;
+  logic rst = 1'b1;
+  logic init_done = 1'b0;
+  logic init_busy = 1'b1;
+  logic nvp_rst = 1'b1;
+  logic init_scl_release = 1'b1;
+  logic init_sda_release = 1'b1;
+  logic raw_scl_i, raw_sda_i;
+  logic [47:0] freerun_count = 48'b0;
+  logic probe_scl_release, probe_sda_release;
+  logic probe_active, probe_done, probe_aborted, probe_terminal;
+  logic [1:0] index_read_phase = 2'b0;
+  logic [7:0] index_read_word = 8'b0;
+  logic [1:0] block_read_phase = 2'b0;
+  logic [3:0] block_read_index = 4'b0;
+
+  wire effective_scl_release = init_scl_release & probe_scl_release;
+  wire effective_sda_release = init_sda_release & probe_sda_release;
+
+  assign raw_scl_i = effective_scl_release;
+  assign raw_sda_i = effective_sda_release;
+  always #5 clk = ~clk;
+
+  nvp_i2c_tri_phase_probe #(
+    .CLK_HZ(1_000_000),
+    .PROBE_I2C_HZ(25_000),
+    .TARGET_OPPORTUNITIES_PER_PHASE(10),
+    .BLOCK_COUNT_PER_PHASE(10),
+    .NACK_INDEX_CAPACITY_PER_PHASE(4),
+    .MAX_TRANSACTION_ATTEMPTS_PER_PHASE(12),
+    .POST_INIT_GUARD_CYCLES(4)
+  ) dut (
+    .clk, .rst, .init_done, .init_busy, .nvp_rst,
+    .init_scl_release, .init_sda_release,
+    .raw_scl_i, .raw_sda_i, .freerun_count,
+    .probe_scl_release, .probe_sda_release,
+    .probe_active, .probe_done, .probe_aborted, .probe_terminal,
+    .index_read_phase, .index_read_word,
+    .block_read_phase, .block_read_index
+  );
+
+  always_ff @(posedge clk) begin
+    freerun_count <= freerun_count + 1'b1;
+    if (!rst) begin
+      if (probe_scl_release !== 1'b1 || probe_sda_release !== 1'b1)
+        $fatal(1, "probe drove an open-drain line before init_done");
+      if (probe_active !== 1'b0 || probe_done !== 1'b0 ||
+          probe_aborted !== 1'b0 || probe_terminal !== 1'b0)
+        $fatal(1, "probe entered a state before init_done");
+      if (effective_scl_release !== init_scl_release ||
+          effective_sda_release !== init_sda_release)
+        $fatal(1, "effective arbitration changed an autoinit release request");
+      // Exercise every release-request combination while init_done remains 0.
+      init_scl_release <= freerun_count[0] ^ freerun_count[2];
+      init_sda_release <= freerun_count[1] ^ freerun_count[3];
+    end
+  end
+
+  initial begin
+    repeat (8) @(posedge clk);
+    rst <= 1'b0;
+    repeat (5000) @(posedge clk);
+    $display("PASS R1F_PRE_INIT_EFFECTIVE_OPEN_DRAIN_ARBITRATION");
+    $finish;
+  end
+endmodule
diff --git a/tests/v41/tb_r1f_preinit_equivalence.vhd b/tests/v41/tb_r1f_preinit_equivalence.vhd
new file mode 100644
index 0000000000000000000000000000000000000000..805ccdca32b890b80556798ab485db0b44b15338
--- /dev/null
+++ b/tests/v41/tb_r1f_preinit_equivalence.vhd
@@ -0,0 +1,180 @@
+library ieee;
+use ieee.std_logic_1164.all;
+use ieee.numeric_std.all;
+use std.env.all;
+
+library r1e_ref;
+
+entity tb_r1f_preinit_equivalence is
+end entity;
+
+architecture sim of tb_r1f_preinit_equivalence is
+  constant C_CLK_HZ : positive := 62_500_000;
+  constant C_I2C_HZ : positive := 25_000;
+
+  signal clk : std_logic := '0';
+  signal rst : std_logic := '1';
+  signal common_scl_i : std_logic;
+  signal common_sda_i : std_logic;
+
+  signal ref_scl_oen, ref_sda_oen : std_logic;
+  signal ref_nvp_rst, ref_en1x, ref_en3x : std_logic;
+  signal ref_busy, ref_done, ref_error : std_logic;
+  signal ref_diag : std_logic_vector(735 downto 0);
+
+  signal cand_scl_oen, cand_sda_oen : std_logic;
+  signal cand_nvp_rst, cand_en1x, cand_en3x : std_logic;
+  signal cand_busy, cand_done, cand_error : std_logic;
+  signal cand_diag : std_logic_vector(735 downto 0);
+  signal cand_phase_counters : std_logic_vector(255 downto 0);
+  signal cand_txn_counters : std_logic_vector(127 downto 0);
+  signal cand_txn_serial : std_logic_vector(15 downto 0);
+  signal cand_txn_serial_overflow : std_logic;
+  signal cand_record_valid : std_logic;
+  signal cand_record : std_logic_vector(191 downto 0);
+  signal cand_inv_checks, cand_inv_errors : std_logic_vector(31 downto 0);
+  signal cand_first_inv_error : std_logic_vector(31 downto 0);
+
+  signal model_bank : std_logic_vector(7 downto 0) := x"07";
+  signal previous_i2c_state : std_logic_vector(7 downto 0) := (others => '0');
+  signal read_bit_idx : integer range 0 to 7 := 7;
+  signal post_done_cycles : natural := 0;
+begin
+  clk <= not clk after 8 ns;
+
+  -- Both implementations receive the same resolved-bus inputs. The model is
+  -- driven from the immutable R1e reference; any candidate divergence is
+  -- detected cycle-by-cycle rather than allowed to perturb the stimulus.
+  common_scl_i <= ref_scl_oen;
+  bus_model : process(all)
+    variable state_number : natural;
+    variable read_byte : std_logic_vector(7 downto 0);
+  begin
+    state_number := to_integer(unsigned(ref_diag(167 downto 160)));
+    read_byte := (others => '0');
+    if ref_diag(63 downto 56) = x"FF" then
+      read_byte := model_bank;
+    end if;
+    if state_number = 7 or state_number = 11 or
+       state_number = 15 or state_number = 23 then
+      common_sda_i <= '0';
+    elsif state_number = 25 then
+      common_sda_i <= read_byte(read_bit_idx);
+    else
+      common_sda_i <= '1';
+    end if;
+  end process;
+
+  reference : entity r1e_ref.v40a_nvp_autoinit
+    generic map(
+      CLK_HZ => C_CLK_HZ,
+      I2C_HZ => C_I2C_HZ,
+      ENABLE_MAREK_INIT_TABLE => 1
+    )
+    port map(
+      clk => clk, rst => rst,
+      scl_i => common_scl_i, sda_i => common_sda_i,
+      scl_oen => ref_scl_oen, sda_oen => ref_sda_oen,
+      nvp_rst => ref_nvp_rst,
+      nvp_en_vdd1x => ref_en1x, nvp_en_vdd3x => ref_en3x,
+      init_busy => ref_busy, init_done => ref_done,
+      init_error => ref_error, diag_detail => ref_diag
+    );
+
+  candidate : entity work.v40a_nvp_autoinit
+    generic map(
+      CLK_HZ => C_CLK_HZ,
+      I2C_HZ => C_I2C_HZ,
+      ENABLE_MAREK_INIT_TABLE => 1
+    )
+    port map(
+      clk => clk, rst => rst,
+      scl_i => common_scl_i, sda_i => common_sda_i,
+      scl_oen => cand_scl_oen, sda_oen => cand_sda_oen,
+      nvp_rst => cand_nvp_rst,
+      nvp_en_vdd1x => cand_en1x, nvp_en_vdd3x => cand_en3x,
+      init_busy => cand_busy, init_done => cand_done,
+      init_error => cand_error, diag_detail => cand_diag,
+      r1f_phase_counters => cand_phase_counters,
+      r1f_transaction_counters => cand_txn_counters,
+      r1f_transaction_serial_next => cand_txn_serial,
+      r1f_transaction_serial_overflow => cand_txn_serial_overflow,
+      r1f_failed_txn_record_valid => cand_record_valid,
+      r1f_failed_txn_record => cand_record,
+      r1f_bank_invariant_check_count => cand_inv_checks,
+      r1f_bank_invariant_error_count => cand_inv_errors,
+      r1f_first_bank_invariant_error => cand_first_inv_error
+    );
+
+  model_state : process(clk)
+    variable state_number : natural;
+  begin
+    if rising_edge(clk) then
+      state_number := to_integer(unsigned(ref_diag(167 downto 160)));
+      previous_i2c_state <= ref_diag(167 downto 160);
+      if rst = '1' then
+        model_bank <= x"07";
+        read_bit_idx <= 7;
+      else
+        if state_number = 24 and previous_i2c_state = x"17" then
+          read_bit_idx <= 7;
+        elsif state_number = 24 and previous_i2c_state = x"19" and
+              read_bit_idx > 0 then
+          read_bit_idx <= read_bit_idx - 1;
+        end if;
+        if state_number = 28 and previous_i2c_state = x"0F" and
+           ref_diag(63 downto 56) = x"FF" then
+          model_bank <= ref_diag(71 downto 64);
+        end if;
+      end if;
+    end if;
+  end process;
+
+  cycle_equivalence : process(clk)
+  begin
+    if rising_edge(clk) then
+      if rst = '0' then
+        assert cand_nvp_rst = ref_nvp_rst
+          report "nvp_rst changed before reference init_done" severity failure;
+        assert cand_en1x = ref_en1x and cand_en3x = ref_en3x
+          report "power-enable behavior changed before reference init_done" severity failure;
+        assert cand_scl_oen = ref_scl_oen and cand_sda_oen = ref_sda_oen
+          report "autoinit open-drain release request changed" severity failure;
+        assert cand_busy = ref_busy and cand_done = ref_done and
+               cand_error = ref_error
+          report "autoinit terminal/control output changed" severity failure;
+        assert cand_diag = ref_diag
+          report "legacy diag_detail or transaction/state stream changed" severity failure;
+      end if;
+
+      if ref_done = '1' and cand_done = '1' then
+        post_done_cycles <= post_done_cycles + 1;
+        if post_done_cycles = 3 then
+          assert cand_inv_errors = x"00000000"
+            report "candidate bank invariant error in all-ACK equivalence run" severity failure;
+          assert cand_first_inv_error = x"00000000"
+            report "unexpected first bank invariant error record" severity failure;
+          assert to_integer(unsigned(cand_inv_checks)) =
+                 12 * to_integer(unsigned(cand_txn_counters(31 downto 0)))
+            report "bank invariant check count is not 12 per transaction"
+            severity failure;
+          assert cand_txn_serial_overflow = '0'
+            report "unexpected transaction serial overflow" severity failure;
+          report "PASS PRE_INIT_DONE_CYCLE_EQUIVALENCE" severity note;
+          report "PASS AUTOINIT_TRANSACTION_STREAM_BYTE_IDENTICAL" severity note;
+          report "PASS AUTOINIT_FUNCTIONAL_STATE_SEQUENCE_IDENTICAL" severity note;
+          stop;
+        end if;
+      end if;
+    end if;
+  end process;
+
+  stimulus : process
+  begin
+    wait for 10 us;
+    wait until falling_edge(clk);
+    rst <= '0';
+    wait for 3 sec;
+    assert false report "pre-init equivalence timeout" severity failure;
+  end process;
+end architecture;
diff --git a/tests/v41/tb_r1f_transaction_serial_counter.vhd b/tests/v41/tb_r1f_transaction_serial_counter.vhd
new file mode 100644
index 0000000000000000000000000000000000000000..e58d7e859e659d7e9787ddc861b31ddb0cbd5375
--- /dev/null
+++ b/tests/v41/tb_r1f_transaction_serial_counter.vhd
@@ -0,0 +1,62 @@
+library ieee;
+use ieee.std_logic_1164.all;
+use ieee.numeric_std.all;
+use std.env.all;
+
+entity tb_r1f_transaction_serial_counter is
+end entity;
+
+architecture sim of tb_r1f_transaction_serial_counter is
+  signal clk : std_logic := '0';
+  signal rst : std_logic := '1';
+  signal clear_run : std_logic := '0';
+  signal transaction_start : std_logic := '0';
+  signal current_index, next_index : std_logic_vector(15 downto 0);
+  signal overflow : std_logic;
+begin
+  clk <= not clk after 5 ns;
+
+  dut : entity work.r1f_transaction_serial_counter
+    port map(
+      clk => clk, rst => rst, clear_run => clear_run,
+      transaction_start => transaction_start,
+      current_index => current_index, next_index => next_index,
+      overflow => overflow
+    );
+
+  stimulus : process
+  begin
+    wait for 20 ns;
+    wait until falling_edge(clk);
+    rst <= '0';
+    for expected_index in 0 to 300 loop
+      transaction_start <= '1';
+      wait until rising_edge(clk);
+      wait for 1 ns;
+      assert to_integer(unsigned(current_index)) = expected_index
+        report "16-bit transaction serial mismatch" severity failure;
+      assert to_integer(unsigned(next_index)) = expected_index + 1
+        report "16-bit next-serial mismatch" severity failure;
+      assert overflow = '0'
+        report "serial overflow before index 300" severity failure;
+      wait until falling_edge(clk);
+      transaction_start <= '0';
+      wait until rising_edge(clk);
+      wait until falling_edge(clk);
+    end loop;
+    assert current_index = x"012C" and next_index = x"012D"
+      report "authoritative index 300 was not represented uniquely"
+      severity failure;
+    report "PASS TRANSACTION_INDEX_16_UNIQUE_AT_300" severity note;
+
+    clear_run <= '1';
+    wait until rising_edge(clk);
+    wait for 1 ns;
+    assert current_index = x"0000" and next_index = x"0000" and
+           overflow = '0'
+      report "per-run serial clear contract failed" severity failure;
+    report "PASS R1F_TRANSACTION_SERIAL_CLEAR" severity note;
+    stop;
+    wait;
+  end process;
+end architecture;
