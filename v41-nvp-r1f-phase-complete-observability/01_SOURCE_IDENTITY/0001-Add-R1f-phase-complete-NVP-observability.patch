+"""Frozen reference model for the R1f interleaved tri-phase probe."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from pathlib import Path
+import random
+import unittest
+
+
+PH_WADDR = 0
+PH_REGADDR = 1
+PH_DATA = 2
+
+
+@dataclass
+class PhaseStats:
+    target: int
+    blocks: int = 10
+    index_capacity: int = 512
+    opportunities: int = 0
+    acks: int = 0
+    nacks: int = 0
+    first_nack: int | None = None
+    last_nack: int | None = None
+    max_consecutive_nacks: int = 0
+    adjacent_nack_pairs: int = 0
+    runs: int = 0
+    indices: list[int] = field(default_factory=list)
+    index_overflow: bool = False
+    block_nacks: list[int] = field(init=False)
+    _previous: bool | None = None
+    _streak: int = 0
+
+    def __post_init__(self) -> None:
+        if self.target <= 0 or self.target > 0xFFFF:
+            raise ValueError("target must fit the 16-bit zero-based index")
+        if self.blocks <= 0 or self.target % self.blocks:
+            raise ValueError("target must divide evenly into blocks")
+        self.block_nacks = [0] * self.blocks
+
+    def record(self, nack: bool) -> None:
+        """Record one physically reached target opportunity (zero based)."""
+        if self.opportunities >= self.target:
+            raise AssertionError("target opportunity overrun")
+        index = self.opportunities
+        if self._previous is None:
+            self.runs = 1
+        elif self._previous != nack:
+            self.runs += 1
+        if nack:
+            self.nacks += 1
+            self.first_nack = index if self.first_nack is None else self.first_nack
+            self.last_nack = index
+            if self._previous:
+                self.adjacent_nack_pairs += 1
+            self._streak += 1
+            self.max_consecutive_nacks = max(self.max_consecutive_nacks,
+                                             self._streak)
+            self.block_nacks[index // (self.target // self.blocks)] += 1
+            if len(self.indices) < self.index_capacity:
+                self.indices.append(index)
+            else:
+                self.index_overflow = True
+        else:
+            self.acks += 1
+            self._streak = 0
+        self._previous = nack
+        self.opportunities += 1
+
+    def packed_index_word(self, word: int) -> int:
+        low_pos = 2 * word
+        high_pos = low_pos + 1
+        low = self.indices[low_pos] if low_pos < len(self.indices) else 0
+        high = self.indices[high_pos] if high_pos < len(self.indices) else 0
+        return low | (high << 16)
+
+
+class AttemptLimit(RuntimeError):
+    def __init__(self, phase: int, model: "TriPhaseModel") -> None:
+        super().__init__(f"attempt limit hit for phase {phase}")
+        self.phase = phase
+        self.model = model
+
+
+class TriPhaseModel:
+    """Round-robin scheduler with exact prerequisite/target reach semantics."""
+
+    def __init__(
+        self,
+        target: int,
+        target_nacks: tuple[set[int], set[int], set[int]],
+        prereq_waddr_nack_attempts: tuple[set[int], set[int], set[int]] =
+        (set(), set(), set()),
+        prereq_regaddr_nack_attempts: tuple[set[int], set[int], set[int]] =
+        (set(), set(), set()),
+        max_attempts: int = 12000,
+        blocks: int = 10,
+        capacity: int = 512,
+    ) -> None:
+        self.stats = [PhaseStats(target, blocks, capacity) for _ in range(3)]
+        self.target_nacks = target_nacks
+        self.pre_w_nacks = prereq_waddr_nack_attempts
+        self.pre_reg_nacks = prereq_regaddr_nack_attempts
+        self.max_attempts = max_attempts
+        self.attempts = [0, 0, 0]
+        self.pre_w_opps = [0, 0, 0]
+        self.pre_w_acks = [0, 0, 0]
+        self.pre_w_nack_count = [0, 0, 0]
+        self.pre_reg_opps = [0, 0, 0]
+        self.pre_reg_acks = [0, 0, 0]
+        self.pre_reg_nack_count = [0, 0, 0]
+        self.rounds = 0
+        self.attempt_limit_status = 0
+
+    def run(self) -> None:
+        while any(s.opportunities < s.target for s in self.stats):
+            for phase in (PH_WADDR, PH_REGADDR, PH_DATA):
+                stat = self.stats[phase]
+                if stat.opportunities >= stat.target:
+                    continue
+                if self.attempts[phase] >= self.max_attempts:
+                    self.attempt_limit_status |= 1 << phase
+                    raise AttemptLimit(phase, self)
+                self.attempts[phase] += 1
+                attempt = self.attempts[phase]
+
+                if phase in (PH_REGADDR, PH_DATA):
+                    self.pre_w_opps[phase] += 1
+                    if attempt in self.pre_w_nacks[phase]:
+                        self.pre_w_nack_count[phase] += 1
+                        continue
+                    self.pre_w_acks[phase] += 1
+
+                if phase == PH_DATA:
+                    self.pre_reg_opps[phase] += 1
+                    if attempt in self.pre_reg_nacks[phase]:
+                        self.pre_reg_nack_count[phase] += 1
+                        continue
+                    self.pre_reg_acks[phase] += 1
+
+                index = stat.opportunities
+                stat.record(index in self.target_nacks[phase])
+            self.rounds += 1
+
+
+class TriPhaseProbeModelTests(unittest.TestCase):
+    def test_all_ack(self) -> None:
+        model = TriPhaseModel(100, (set(), set(), set()), blocks=10)
+        model.run()
+        self.assertEqual(model.attempts, [100, 100, 100])
+        self.assertEqual(model.rounds, 100)
+        for stat in model.stats:
+            self.assertEqual((stat.opportunities, stat.acks, stat.nacks),
+                             (100, 100, 0))
+            self.assertEqual(stat.runs, 1)
+            self.assertEqual(stat.block_nacks, [0] * 10)
+
+    def test_29_of_10000_address_pattern(self) -> None:
+        positions = {100 + 337 * i for i in range(29)}
+        model = TriPhaseModel(10000, (positions, set(), set()))
+        model.run()
+        waddr = model.stats[PH_WADDR]
+        self.assertEqual(waddr.nacks, 29)
+        self.assertEqual(waddr.acks, 9971)
+        self.assertEqual(waddr.first_nack, min(positions))
+        self.assertEqual(waddr.last_nack, max(positions))
+        self.assertEqual(waddr.indices, sorted(positions))
+        self.assertFalse(waddr.index_overflow)
+
+    def test_independent_deterministic_bernoulli_patterns(self) -> None:
+        rng = random.Random(0x6134C)
+        patterns = tuple(
+            {i for i in range(10000) if rng.random() < probability}
+            for probability in (0.0029, 0.0041, 0.0017)
+        )
+        model = TriPhaseModel(10000, patterns)
+        model.run()
+        for phase, stat in enumerate(model.stats):
+            self.assertEqual(stat.nacks, len(patterns[phase]))
+            self.assertEqual(stat.acks + stat.nacks, 10000)
+            self.assertEqual(sum(stat.block_nacks), stat.nacks)
+
+    def test_clustered_run_adjacent_and_block_statistics(self) -> None:
+        clustered = {100, 101, 102, 700, 701}
+        model = TriPhaseModel(1000, (clustered, set(), set()), blocks=10)
+        model.run()
+        stat = model.stats[0]
+        self.assertEqual(stat.max_consecutive_nacks, 3)
+        self.assertEqual(stat.adjacent_nack_pairs, 3)
+        self.assertEqual(stat.runs, 5)
+        self.assertEqual(stat.block_nacks[1], 3)
+        self.assertEqual(stat.block_nacks[7], 2)
+
+    def test_prerequisite_nacks_do_not_create_target_opportunities(self) -> None:
+        model = TriPhaseModel(
+            8,
+            ({1, 5}, {2}, {0, 1}),
+            prereq_waddr_nack_attempts=(set(), {1}, {1}),
+            prereq_regaddr_nack_attempts=(set(), set(), {2}),
+            max_attempts=12,
+            blocks=2,
+            capacity=4,
+        )
+        model.run()
+        self.assertEqual(model.attempts, [8, 9, 10])
+        self.assertEqual(model.rounds, 10)
+        self.assertEqual([s.opportunities for s in model.stats], [8, 8, 8])
+        self.assertEqual((model.pre_w_opps[1], model.pre_w_acks[1],
+                          model.pre_w_nack_count[1]), (9, 8, 1))
+        self.assertEqual((model.pre_w_opps[2], model.pre_w_acks[2],
+                          model.pre_w_nack_count[2]), (10, 9, 1))
+        self.assertEqual((model.pre_reg_opps[2], model.pre_reg_acks[2],
+                          model.pre_reg_nack_count[2]), (9, 8, 1))
+        self.assertEqual(model.stats[0].packed_index_word(0), 0x00050001)
+        self.assertEqual(model.stats[1].packed_index_word(0), 0x00000002)
+        self.assertEqual(model.stats[2].packed_index_word(0), 0x00010000)
+
+    def test_zero_based_index_and_512_entry_overflow(self) -> None:
+        model = TriPhaseModel(600, (set(range(600)), set(), set()),
+                              blocks=10, capacity=512)
+        model.run()
+        stat = model.stats[0]
+        self.assertEqual(stat.first_nack, 0)
+        self.assertEqual(stat.last_nack, 599)
+        self.assertEqual(len(stat.indices), 512)
+        self.assertTrue(stat.index_overflow)
+        self.assertEqual(stat.packed_index_word(0), 0x00010000)
+        self.assertEqual(stat.packed_index_word(255), 0x01FF01FE)
+        self.assertEqual(stat.packed_index_word(256), 0)
+
+    def test_attempt_limit_bitmap_and_no_fabricated_target_sample(self) -> None:
+        with self.assertRaises(AttemptLimit) as caught:
+            TriPhaseModel(
+                10,
+                (set(), set(), set()),
+                prereq_waddr_nack_attempts=(set(), set(range(1, 13)), set()),
+                max_attempts=12,
+                blocks=10,
+            ).run()
+        model = caught.exception.model
+        self.assertEqual(caught.exception.phase, PH_REGADDR)
+        self.assertEqual(model.attempt_limit_status, 0b010)
+        self.assertEqual(model.attempts[PH_REGADDR], 12)
+        self.assertEqual(model.stats[PH_REGADDR].opportunities, 0)
+
+    def test_frozen_safe_target_and_production_defaults_in_rtl(self) -> None:
+        rtl = (Path(__file__).resolve().parents[2] / "rtl" / "v41" /
+               "nvp_i2c_tri_phase_probe.sv").read_text(encoding="utf-8")
+        for exact in (
+            "localparam logic [7:0] SAFE_BANK = 8'h00;",
+            "localparam logic [7:0] SAFE_REG = 8'h85;",
+            "localparam logic [7:0] SAFE_DATA = 8'h00;",
+            "parameter integer PROBE_I2C_HZ = 25000",
+            "parameter integer TARGET_OPPORTUNITIES_PER_PHASE = 10000",
+            "parameter integer BLOCK_COUNT_PER_PHASE = 10",
+            "parameter integer NACK_INDEX_CAPACITY_PER_PHASE = 512",
+            "parameter integer MAX_TRANSACTION_ATTEMPTS_PER_PHASE = 12000",
+        ):
+            self.assertIn(exact, rtl)
+        self.assertNotIn("parameter integer SAFE_BANK", rtl)
+        self.assertNotIn("parameter integer SAFE_REG", rtl)
+        self.assertNotIn("parameter integer SAFE_DATA", rtl)
+
+
+if __name__ == "__main__":
+    unittest.main(verbosity=2)
