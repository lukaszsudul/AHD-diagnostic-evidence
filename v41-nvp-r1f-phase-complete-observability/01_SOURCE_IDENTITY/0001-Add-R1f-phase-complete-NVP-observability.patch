index 0000000000000000000000000000000000000000..58c6d7cfdddc23ebde8ccafa75d4c2bc40839e96
--- /dev/null
+++ b/rtl/nvp/r1f_transaction_serial_counter.vhd
@@ -0,0 +1,44 @@
+library ieee;
+use ieee.std_logic_1164.all;
+use ieee.numeric_std.all;
+
+-- Diagnostic-only independent transaction serial. No output from this entity
+-- is permitted to drive functional I2C control.
+entity r1f_transaction_serial_counter is
+  port(
+    clk               : in  std_logic;
+    rst               : in  std_logic;
+    clear_run         : in  std_logic;
+    transaction_start : in  std_logic;
+    current_index     : out std_logic_vector(15 downto 0);
+    next_index        : out std_logic_vector(15 downto 0);
+    overflow          : out std_logic
+  );
+end entity;
+
+architecture rtl of r1f_transaction_serial_counter is
+  signal current_r : unsigned(15 downto 0) := (others => '0');
+  signal next_r : unsigned(15 downto 0) := (others => '0');
+  signal overflow_r : std_logic := '0';
+begin
+  current_index <= std_logic_vector(current_r);
+  next_index <= std_logic_vector(next_r);
+  overflow <= overflow_r;
+
+  process(clk)
+  begin
+    if rising_edge(clk) then
+      if rst = '1' or clear_run = '1' then
+        current_r <= (others => '0');
+        next_r <= (others => '0');
+        overflow_r <= '0';
+      elsif transaction_start = '1' then
+        current_r <= next_r;
+        if next_r = x"FFFF" then
+          overflow_r <= '1';
+        end if;
+        next_r <= next_r + 1;
+      end if;
+    end if;
+  end process;
+end architecture;
