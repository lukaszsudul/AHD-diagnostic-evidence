index 0000000000000000000000000000000000000000..16c8c28119174e868df894c0fc44d3f638f30250
--- /dev/null
+++ b/tests/v41/tb_nvp_i2c_tri_phase_probe_secondary_restore_failure.sv
@@ -0,0 +1,98 @@
+`timescale 1ns/1ps
+
+module tb_nvp_i2c_tri_phase_probe_secondary_restore_failure;
+  logic clk = 0, rst = 1;
+  logic [47:0] freerun_count = 0;
+  logic raw_scl_i, raw_sda_i;
+  logic probe_scl_release, probe_sda_release;
+  logic probe_done, probe_aborted, probe_terminal;
+  logic [7:0] probe_abort_code, probe_restore_failure_code;
+  logic original_bank_restored, original_bank_restore_verified;
+  logic [7:0] restored_bank_readback;
+  logic restored_bank_readback_valid;
+  logic [1:0] index_read_phase = 0;
+  logic [7:0] index_read_word = 0;
+  logic [31:0] index_read_data;
+  logic [1:0] block_read_phase = 0;
+  logic [3:0] block_read_index = 0;
+  logic [31:0] block_read_nack_count;
+  logic slave_sda_release;
+  logic [7:0] slave_bank = 8'h02;
+  logic [7:0] slave_read_value;
+
+  always #500 clk = ~clk;
+  always_ff @(posedge clk) freerun_count <= freerun_count + 1'b1;
+  assign raw_scl_i = probe_scl_release;
+  assign raw_sda_i = probe_sda_release && slave_sda_release;
+
+  always_comb begin
+    if (dut.ll_reg_latched == 8'hff)
+      // H_ABORT_VERIFY_WAIT is enum value 24.  Preserve the actual successful
+      // Bank-2 write but return a mismatching verified-read byte of Bank 3.
+      slave_read_value = (dut.high_state == 6'd24) ? 8'h03 : slave_bank;
+    else
+      slave_read_value = 8'h01; // force primary safe-target pre-read failure
+    slave_sda_release = 1'b1;
+    case (dut.ll_state)
+      6'd6, 6'd7, 6'd10, 6'd11, 6'd14, 6'd15,
+      6'd22, 6'd23: slave_sda_release = 1'b0;
+      6'd24, 6'd25:
+        slave_sda_release = slave_read_value[dut.ll_bit_index];
+      default: slave_sda_release = 1'b1;
+    endcase
+  end
+
+  always_ff @(posedge clk)
+    if (dut.ll_done && dut.ll_success && dut.ll_kind_latched == 2'd2 &&
+        dut.ll_reg_latched == 8'hff)
+      slave_bank <= dut.ll_data_latched;
+
+  nvp_i2c_tri_phase_probe #(
+    .CLK_HZ(1000000), .PROBE_I2C_HZ(25000),
+    .TARGET_OPPORTUNITIES_PER_PHASE(4), .BLOCK_COUNT_PER_PHASE(2),
+    .NACK_INDEX_CAPACITY_PER_PHASE(4),
+    .MAX_TRANSACTION_ATTEMPTS_PER_PHASE(6),
+    .POST_INIT_GUARD_CYCLES(4), .SCL_TIMEOUT_CYCLES(200),
+    .BUS_IDLE_TIMEOUT_CYCLES(2000)
+  ) dut (
+    .clk, .rst, .init_done(1'b1), .init_busy(1'b0), .nvp_rst(1'b1),
+    .init_scl_release(1'b1), .init_sda_release(1'b1),
+    .raw_scl_i, .raw_sda_i, .freerun_count,
+    .probe_scl_release, .probe_sda_release, .probe_done, .probe_aborted,
+    .probe_terminal, .probe_abort_code, .probe_restore_failure_code,
+    .original_bank_restored, .original_bank_restore_verified,
+    .restored_bank_readback, .restored_bank_readback_valid,
+    .index_read_phase, .index_read_word, .index_read_data,
+    .block_read_phase, .block_read_index, .block_read_nack_count
+  );
+
+  initial begin : run_test
+    integer watchdog;
+    repeat (8) @(posedge clk);
+    rst <= 0;
+    watchdog = 0;
+    while (!probe_terminal && watchdog < 50000) begin
+      @(posedge clk);
+      watchdog++;
+    end
+    if (!probe_terminal)
+      $fatal(1, "secondary-restore-failure test did not terminate");
+    repeat (3) @(posedge clk);
+    if (probe_done || !probe_aborted || probe_abort_code != 8'h04)
+      $fatal(1, "primary setup failure was not preserved");
+    if (probe_restore_failure_code != 8'h0a)
+      $fatal(1, "secondary restore-verify code mismatch: %02x",
+             probe_restore_failure_code);
+    if (!original_bank_restored || original_bank_restore_verified)
+      $fatal(1, "restore write/verification distinction lost");
+    if (!restored_bank_readback_valid || restored_bank_readback != 8'h03)
+      $fatal(1, "mismatching restoration readback not preserved");
+    if (slave_bank != 8'h02)
+      $fatal(1, "behavioral slave did not retain written restored Bank 2");
+    if (!probe_scl_release || !probe_sda_release)
+      $fatal(1, "lines not released after secondary restoration failure");
+    $display("TRI_PHASE_PROBE_SECONDARY_RESTORE_FAILURE_PASS cycles=%0d",
+             watchdog);
+    $finish;
+  end
+endmodule
diff --git a/tests/v41/tb_nvp_i2c_tri_phase_probe_timeout.sv b/tests/v41/tb_nvp_i2c_tri_phase_probe_timeout.sv
new file mode 100644
index 0000000000000000000000000000000000000000..465d136f077ab08e170e0823f69fc225851820a9
--- /dev/null
+++ b/tests/v41/tb_nvp_i2c_tri_phase_probe_timeout.sv
@@ -0,0 +1,127 @@
+`timescale 1ns/1ps
+
+module tb_nvp_i2c_tri_phase_probe_timeout;
+  logic clk = 1'b0;
+  logic rst = 1'b1;
+  logic [47:0] freerun_count = 0;
+  logic raw_scl_i, raw_sda_i;
+  logic probe_scl_release, probe_sda_release;
+  logic probe_active, probe_done, probe_aborted, probe_terminal;
+  logic [7:0] probe_abort_code;
+  logic [7:0] probe_restore_failure_code;
+  logic legacy_init_done_seen, legacy_guard_complete;
+  logic legacy_bus_idle_qualified, legacy_scl_timeout;
+  logic legacy_bus_idle_timeout;
+  logic original_bank_restored, original_bank_restore_verified;
+  logic [7:0] restored_bank_readback;
+  logic restored_bank_readback_valid;
+  logic [31:0] waddr_transaction_attempts;
+  logic [31:0] waddr_target_opportunities;
+  logic [31:0] waddr_timeouts;
+  logic [31:0] probe_timeout_count_total;
+  logic [1:0] index_read_phase = 0;
+  logic [7:0] index_read_word = 0;
+  logic [31:0] index_read_data;
+  logic [1:0] block_read_phase = 0;
+  logic [3:0] block_read_index = 0;
+  logic [31:0] block_read_nack_count;
+
+  logic slave_sda_release;
+  logic [7:0] slave_bank = 8'h02;
+  logic [7:0] slave_read_value;
+  logic stretch_scl = 1'b0;
+  logic stretch_injected = 1'b0;
+
+  always #500 clk = ~clk;
+  always_ff @(posedge clk) freerun_count <= freerun_count + 1'b1;
+  assign raw_scl_i = probe_scl_release && !stretch_scl;
+  assign raw_sda_i = probe_sda_release && slave_sda_release;
+
+  always_comb begin
+    slave_read_value = (dut.ll_reg_latched == 8'hff) ? slave_bank : 8'h00;
+    slave_sda_release = 1'b1;
+    case (dut.ll_state)
+      6'd6, 6'd7, 6'd10, 6'd11, 6'd14, 6'd15,
+      6'd22, 6'd23: slave_sda_release = 1'b0;
+      6'd24, 6'd25:
+        slave_sda_release = slave_read_value[dut.ll_bit_index];
+      default: slave_sda_release = 1'b1;
+    endcase
+  end
+
+  always_ff @(posedge clk) begin
+    if (dut.ll_done && dut.ll_success &&
+        dut.ll_kind_latched == 2'd2 && dut.ll_reg_latched == 8'hff)
+      slave_bank <= dut.ll_data_latched;
+    if (probe_active && !stretch_injected && dut.ll_state == 6'd5) begin
+      stretch_scl <= 1'b1;
+      stretch_injected <= 1'b1;
+    end
+    if (dut.ll_timeout)
+      stretch_scl <= 1'b0;
+  end
+
+  nvp_i2c_tri_phase_probe #(
+    .CLK_HZ(1000000), .PROBE_I2C_HZ(25000),
+    .TARGET_OPPORTUNITIES_PER_PHASE(4), .BLOCK_COUNT_PER_PHASE(2),
+    .NACK_INDEX_CAPACITY_PER_PHASE(4),
+    .MAX_TRANSACTION_ATTEMPTS_PER_PHASE(6),
+    .POST_INIT_GUARD_CYCLES(4), .SCL_TIMEOUT_CYCLES(20),
+    .BUS_IDLE_TIMEOUT_CYCLES(2000)
+  ) dut (
+    .clk, .rst,
+    .init_done(1'b1), .init_busy(1'b0), .nvp_rst(1'b1),
+    .init_scl_release(1'b1), .init_sda_release(1'b1),
+    .raw_scl_i, .raw_sda_i, .freerun_count,
+    .probe_scl_release, .probe_sda_release, .probe_active, .probe_done,
+    .probe_aborted, .probe_terminal, .probe_abort_code,
+    .probe_restore_failure_code,
+    .legacy_init_done_seen, .legacy_guard_complete,
+    .legacy_bus_idle_qualified, .legacy_scl_timeout,
+    .legacy_bus_idle_timeout,
+    .original_bank_restored, .original_bank_restore_verified,
+    .restored_bank_readback, .restored_bank_readback_valid,
+    .waddr_transaction_attempts, .waddr_target_opportunities,
+    .waddr_timeouts, .probe_timeout_count_total,
+    .index_read_phase, .index_read_word, .index_read_data,
+    .block_read_phase, .block_read_index, .block_read_nack_count
+  );
+
+  initial begin : run_test
+    integer watchdog;
+    repeat (8) @(posedge clk);
+    rst <= 1'b0;
+    watchdog = 0;
+    while (!probe_terminal && watchdog < 50000) begin
+      @(posedge clk);
+      watchdog = watchdog + 1;
+    end
+    if (!probe_terminal)
+      $fatal(1, "timeout test did not terminate");
+    repeat (3) @(posedge clk);
+    if (!stretch_injected || stretch_scl)
+      $fatal(1, "SCL timeout injection did not complete");
+    if (probe_done || !probe_aborted || probe_abort_code != 8'h06)
+      $fatal(1, "wrong timeout abort status done=%b abort=%b code=%02x",
+             probe_done, probe_aborted, probe_abort_code);
+    if (probe_restore_failure_code != 0)
+      $fatal(1, "unexpected secondary restoration failure");
+    if (probe_timeout_count_total != 1 || waddr_timeouts != 1)
+      $fatal(1, "timeout count mismatch total=%0d waddr=%0d",
+             probe_timeout_count_total, waddr_timeouts);
+    if (waddr_transaction_attempts != 1 || waddr_target_opportunities != 0)
+      $fatal(1, "unreached target phase was incorrectly counted");
+    if (!original_bank_restored || !original_bank_restore_verified ||
+        !restored_bank_readback_valid || restored_bank_readback != 8'h02 ||
+        slave_bank != 8'h02)
+      $fatal(1, "timeout abort did not restore original bank");
+    if (!probe_scl_release || !probe_sda_release)
+      $fatal(1, "probe lines not released after timeout abort");
+    if (!legacy_init_done_seen || !legacy_guard_complete ||
+        !legacy_bus_idle_qualified || !legacy_scl_timeout ||
+        legacy_bus_idle_timeout)
+      $fatal(1, "preserved R1e SCL-timeout status semantics mismatch");
+    $display("TRI_PHASE_PROBE_TIMEOUT_PASS cycles=%0d", watchdog);
+    $finish;
+  end
+endmodule
diff --git a/tests/v41/tb_r1f_failed_txn_logger.sv b/tests/v41/tb_r1f_failed_txn_logger.sv
