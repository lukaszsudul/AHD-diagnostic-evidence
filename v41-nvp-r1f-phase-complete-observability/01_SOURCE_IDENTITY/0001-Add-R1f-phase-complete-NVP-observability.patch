+    r1f_probe_setup_restore_status[8] = tri_original_bank_restored;
+    r1f_probe_setup_restore_status[9] =
+        tri_original_bank_restore_verified;
+    r1f_probe_setup_restore_status[10] = probe_scl_release &&
