+    LL_WAIT_IDLE,
+    LL_START_A,
+    LL_START_B,
+    LL_SEND_W_LOW,
+    LL_SEND_W_HIGH,
+    LL_ACK_W_LOW,
+    LL_ACK_W_HIGH,
+    LL_SEND_REG_LOW,
+    LL_SEND_REG_HIGH,
+    LL_ACK_REG_LOW,
+    LL_ACK_REG_HIGH,
+    LL_SEND_DATA_LOW,
+    LL_SEND_DATA_HIGH,
+    LL_ACK_DATA_LOW,
+    LL_ACK_DATA_HIGH,
+    LL_REP_LOW,
+    LL_REP_HIGH,
+    LL_REP_START_A,
+    LL_REP_START_B,
+    LL_SEND_R_LOW,
+    LL_SEND_R_HIGH,
+    LL_ACK_R_LOW,
+    LL_ACK_R_HIGH,
+    LL_READ_LOW,
+    LL_READ_HIGH,
+    LL_MASTER_NACK_LOW,
+    LL_MASTER_NACK_HIGH,
+    LL_STOP_A,
+    LL_STOP_B,
+    LL_STOP_C,
+    LL_ABORT_RELEASE
