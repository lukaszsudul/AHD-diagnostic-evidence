             when START_W_A =>
+              -- This is the inherited controller's actual START-command
+              -- attempt.  In the normal case it performs the physical SDA
+              -- high-to-low edge while SCL is released.  A pre-existing
+              -- stuck-low SDA cannot create that edge, but still consumes one
+              -- unique attempted-transaction serial and is recorded as the
+              -- distinct terminal error class 0x06.  This diagnostic wording
+              -- avoids aliasing failed START attempts without changing flow.
