   type t_nack_log is array (0 to 7) of std_logic_vector(63 downto 0);
 
+  function sat_inc32(value : unsigned(31 downto 0)) return unsigned is
+  begin
+    if value = x"FFFFFFFF" then return value; end if;
+    return value + 1;
+  end function;
+
+  function sat_add32(value : unsigned(31 downto 0); amount : natural)
+    return unsigned is
+    variable wide : unsigned(32 downto 0);
+  begin
+    wide := ('0' & value) + to_unsigned(amount, 33);
+    if wide(32) = '1' then return unsigned'(x"FFFFFFFF"); end if;
+    return wide(31 downto 0);
+  end function;
+
+  function popcount4(value : std_logic_vector(3 downto 0)) return natural is
+    variable result : natural range 0 to 4 := 0;
+  begin
+    for i in value'range loop
+      if value(i) = '1' then result := result + 1; end if;
+    end loop;
+    return result;
+  end function;
