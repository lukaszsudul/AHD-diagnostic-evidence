@@ -0,0 +1,112 @@
+`timescale 1ns/1ps
+
+module tb_nvp_i2c_tri_phase_probe_attempt_limit;
+  logic clk = 0, rst = 1;
+  logic [47:0] freerun_count = 0;
+  logic raw_scl_i, raw_sda_i;
+  logic probe_scl_release, probe_sda_release, probe_active;
+  logic probe_done, probe_aborted, probe_terminal;
+  logic [7:0] probe_abort_code;
+  logic [7:0] probe_restore_failure_code;
+  logic original_bank_restored, original_bank_restore_verified;
+  logic [7:0] restored_bank_readback;
+  logic restored_bank_readback_valid;
+  logic [31:0] waddr_target_opportunities;
+  logic [31:0] regaddr_transaction_attempts, regaddr_target_opportunities;
+  logic [31:0] data_target_opportunities;
+  logic [31:0] round_robin_scheduler_rounds;
+  logic [1:0] current_scheduler_phase;
+  logic [2:0] attempt_limit_status;
+  logic [1:0] index_read_phase = 0;
+  logic [7:0] index_read_word = 0;
+  logic [31:0] index_read_data;
+  logic [1:0] block_read_phase = 0;
+  logic [3:0] block_read_index = 0;
+  logic [31:0] block_read_nack_count;
+  logic slave_sda_release;
+  logic [7:0] slave_bank = 8'h02;
+  logic [7:0] slave_read_value;
+
+  always #500 clk = ~clk;
+  always_ff @(posedge clk) freerun_count <= freerun_count + 1'b1;
+  assign raw_scl_i = probe_scl_release;
+  assign raw_sda_i = probe_sda_release && slave_sda_release;
+
+  always_comb begin
+    slave_read_value = (dut.ll_reg_latched == 8'hff) ? slave_bank : 8'h00;
+    slave_sda_release = 1'b1;
+    case (dut.ll_state)
+      6'd6, 6'd7:
+        slave_sda_release = probe_active && dut.current_phase == 2'd1;
+      6'd10, 6'd11, 6'd14, 6'd15, 6'd22, 6'd23:
+        slave_sda_release = 1'b0;
+      6'd24, 6'd25:
+        slave_sda_release = slave_read_value[dut.ll_bit_index];
+      default: slave_sda_release = 1'b1;
+    endcase
+  end
+
+  always_ff @(posedge clk)
+    if (dut.ll_done && dut.ll_success && dut.ll_kind_latched == 2'd2 &&
+        dut.ll_reg_latched == 8'hff)
+      slave_bank <= dut.ll_data_latched;
+
+  nvp_i2c_tri_phase_probe #(
+    .CLK_HZ(1000000), .PROBE_I2C_HZ(25000),
+    .TARGET_OPPORTUNITIES_PER_PHASE(4), .BLOCK_COUNT_PER_PHASE(2),
+    .NACK_INDEX_CAPACITY_PER_PHASE(4),
+    .MAX_TRANSACTION_ATTEMPTS_PER_PHASE(4),
+    .POST_INIT_GUARD_CYCLES(4), .SCL_TIMEOUT_CYCLES(200),
+    .BUS_IDLE_TIMEOUT_CYCLES(2000)
+  ) dut (
+    .clk, .rst, .init_done(1'b1), .init_busy(1'b0), .nvp_rst(1'b1),
+    .init_scl_release(1'b1), .init_sda_release(1'b1),
+    .raw_scl_i, .raw_sda_i, .freerun_count,
+    .probe_scl_release, .probe_sda_release, .probe_active, .probe_done,
+    .probe_aborted, .probe_terminal, .probe_abort_code,
+    .probe_restore_failure_code,
+    .original_bank_restored, .original_bank_restore_verified,
+    .restored_bank_readback, .restored_bank_readback_valid,
+    .waddr_target_opportunities, .regaddr_transaction_attempts,
+    .regaddr_target_opportunities, .data_target_opportunities,
+    .round_robin_scheduler_rounds, .current_scheduler_phase,
+    .attempt_limit_status,
+    .index_read_phase, .index_read_word, .index_read_data,
+    .block_read_phase, .block_read_index, .block_read_nack_count
+  );
+
+  initial begin : run_test
+    integer watchdog;
+    repeat (8) @(posedge clk);
+    rst <= 0;
+    watchdog = 0;
+    while (!probe_terminal && watchdog < 100000) begin
+      @(posedge clk);
+      watchdog++;
+    end
+    if (!probe_terminal)
+      $fatal(1, "attempt-limit test did not terminate");
+    repeat (3) @(posedge clk);
+    if (probe_done || !probe_aborted || probe_abort_code != 8'h05)
+      $fatal(1, "wrong attempt-limit terminal status");
+    if (probe_restore_failure_code != 0)
+      $fatal(1, "unexpected secondary restoration failure");
+    if (attempt_limit_status != 3'b010 || current_scheduler_phase != 2'd3)
+      $fatal(1, "attempt-limit bitmap/phase mismatch bitmap=%03b phase=%0d",
+             attempt_limit_status, current_scheduler_phase);
+    if (regaddr_transaction_attempts != 4 ||
+        regaddr_target_opportunities != 0)
+      $fatal(1, "REGADDR target samples fabricated or cap mismatch");
+    if (waddr_target_opportunities != 4 || data_target_opportunities != 4 ||
+        round_robin_scheduler_rounds != 4)
+      $fatal(1, "round-robin completion accounting mismatch");
+    if (!original_bank_restored || !original_bank_restore_verified ||
+        !restored_bank_readback_valid || restored_bank_readback != 8'h02 ||
+        slave_bank != 8'h02)
+      $fatal(1, "attempt-limit abort did not restore original bank");
+    if (!probe_scl_release || !probe_sda_release)
+      $fatal(1, "lines not released after attempt-limit abort");
+    $display("TRI_PHASE_PROBE_ATTEMPT_LIMIT_PASS cycles=%0d", watchdog);
+    $finish;
+  end
