diff --git a/tests/v41/tb_nvp_i2c_tri_phase_probe_abort_restore.sv b/tests/v41/tb_nvp_i2c_tri_phase_probe_abort_restore.sv
new file mode 100644
index 0000000000000000000000000000000000000000..6343054a2c23e86267b346dd390010a6ebb12f92
--- /dev/null
+++ b/tests/v41/tb_nvp_i2c_tri_phase_probe_abort_restore.sv
@@ -0,0 +1,134 @@
+`timescale 1ns/1ps
+
+module tb_nvp_i2c_tri_phase_probe_abort_restore;
+  logic clk = 1'b0;
+  logic rst = 1'b1;
+  logic [47:0] freerun_count = 48'b0;
+  logic raw_scl_i, raw_sda_i;
+  logic probe_scl_release, probe_sda_release;
+  logic probe_active, probe_done, probe_aborted, probe_terminal;
+  logic [7:0] probe_abort_code;
+  logic [7:0] probe_restore_failure_code;
+  logic [7:0] entry_bank;
+  logic entry_bank_valid;
+  logic [7:0] safe_target_pre_value;
+  logic safe_target_pre_valid, safe_target_pre_ok;
+  logic original_bank_restored, original_bank_restore_verified;
+  logic [7:0] safe_bank_readback, restored_bank_readback;
+  logic safe_bank_readback_valid, restored_bank_readback_valid;
+  logic [31:0] waddr_target_opportunities;
+  logic [31:0] regaddr_target_opportunities;
+  logic [31:0] data_target_opportunities;
+  logic [31:0] probe_timeout_count_total;
+  logic [1:0] index_read_phase = 0;
+  logic [7:0] index_read_word = 0;
+  logic [31:0] index_read_data;
+  logic [1:0] block_read_phase = 0;
+  logic [3:0] block_read_index = 0;
+  logic [31:0] block_read_nack_count;
+
+  logic slave_sda_release;
+  logic [7:0] slave_bank = 8'h02;
+  logic [7:0] slave_read_value;
+  integer bank_select_write_count = 0;
+
+  always #500 clk = ~clk;
+  always_ff @(posedge clk) freerun_count <= freerun_count + 1'b1;
+  assign raw_scl_i = probe_scl_release;
+  assign raw_sda_i = probe_sda_release && slave_sda_release;
+
+  always_comb begin
+    // Bank reads are coherent.  The frozen safe register intentionally reads
+    // back 1 rather than the required 0, forcing the pre-read abort contract.
+    slave_read_value = (dut.ll_reg_latched == 8'hff) ? slave_bank : 8'h01;
+    slave_sda_release = 1'b1;
+    case (dut.ll_state)
+      6'd6, 6'd7, 6'd10, 6'd11, 6'd14, 6'd15,
+      6'd22, 6'd23: slave_sda_release = 1'b0;
+      6'd24, 6'd25:
+        slave_sda_release = slave_read_value[dut.ll_bit_index];
+      default: slave_sda_release = 1'b1;
+    endcase
+  end
+
+  always_ff @(posedge clk) begin
+    if (dut.ll_done && dut.ll_success &&
+        dut.ll_kind_latched == 2'd2 && dut.ll_reg_latched == 8'hff) begin
+      slave_bank <= dut.ll_data_latched;
+      bank_select_write_count <= bank_select_write_count + 1;
+    end
+  end
+
+  nvp_i2c_tri_phase_probe #(
+    .CLK_HZ(1000000),
+    .PROBE_I2C_HZ(25000),
+    .TARGET_OPPORTUNITIES_PER_PHASE(4),
+    .BLOCK_COUNT_PER_PHASE(2),
+    .NACK_INDEX_CAPACITY_PER_PHASE(4),
+    .MAX_TRANSACTION_ATTEMPTS_PER_PHASE(6),
+    .POST_INIT_GUARD_CYCLES(4),
+    .SCL_TIMEOUT_CYCLES(200),
+    .BUS_IDLE_TIMEOUT_CYCLES(2000)
+  ) dut (
+    .clk, .rst,
+    .init_done(1'b1), .init_busy(1'b0), .nvp_rst(1'b1),
+    .init_scl_release(1'b1), .init_sda_release(1'b1),
+    .raw_scl_i, .raw_sda_i, .freerun_count,
+    .probe_scl_release, .probe_sda_release, .probe_active, .probe_done,
+    .probe_aborted, .probe_terminal, .probe_abort_code,
+    .probe_restore_failure_code,
+    .entry_bank, .entry_bank_valid,
+    .safe_bank_readback, .safe_bank_readback_valid,
+    .safe_target_pre_value, .safe_target_pre_valid, .safe_target_pre_ok,
+    .original_bank_restored, .original_bank_restore_verified,
+    .restored_bank_readback, .restored_bank_readback_valid,
+    .waddr_target_opportunities, .regaddr_target_opportunities,
+    .data_target_opportunities, .probe_timeout_count_total,
+    .index_read_phase, .index_read_word, .index_read_data,
+    .block_read_phase, .block_read_index, .block_read_nack_count
+  );
+
+  initial begin : run_test
+    integer watchdog;
+    repeat (8) @(posedge clk);
+    rst <= 1'b0;
+    watchdog = 0;
+    while (!probe_terminal && watchdog < 50000) begin
+      @(posedge clk);
+      watchdog = watchdog + 1;
+    end
+    if (!probe_terminal)
+      $fatal(1, "abort test did not terminate");
+    repeat (3) @(posedge clk);
+    if (probe_done || !probe_aborted || probe_abort_code != 8'h04)
+      $fatal(1, "wrong abort result done=%b aborted=%b code=%02x",
+             probe_done, probe_aborted, probe_abort_code);
+    if (probe_restore_failure_code != 0)
+      $fatal(1, "unexpected secondary restore failure %02x",
+             probe_restore_failure_code);
+    if (!safe_bank_readback_valid || safe_bank_readback != 8'h00)
+      $fatal(1, "safe-bank verification readback not preserved");
+    if (!entry_bank_valid || entry_bank != 8'h02 || slave_bank != 8'h02)
+      $fatal(1, "entry-bank restoration mismatch");
+    if (!safe_target_pre_valid || safe_target_pre_value != 8'h01 ||
+        safe_target_pre_ok)
+      $fatal(1, "pre-read mismatch was not captured exactly");
+    if (!original_bank_restored || !original_bank_restore_verified ||
+        !restored_bank_readback_valid || restored_bank_readback != 8'h02)
+      $fatal(1, "best-effort abort restoration was not verified");
+    if (bank_select_write_count != 2)
+      $fatal(1, "expected one safe-bank write and one restoration, got %0d",
+             bank_select_write_count);
+    if (probe_active || waddr_target_opportunities != 0 ||
+        regaddr_target_opportunities != 0 || data_target_opportunities != 0)
+      $fatal(1, "phase probe ran after failed setup");
+    if (probe_timeout_count_total != 0)
+      $fatal(1, "unexpected timeout");
+    if (!probe_scl_release || !probe_sda_release)
+      $fatal(1, "lines not released after abort");
+    if (index_read_data != 0 || block_read_nack_count != 0)
+      $fatal(1, "unused diagnostic memory did not read zero");
+    $display("TRI_PHASE_PROBE_ABORT_RESTORE_PASS cycles=%0d", watchdog);
+    $finish;
+  end
+endmodule
diff --git a/tests/v41/tb_nvp_i2c_tri_phase_probe_attempt_limit.sv b/tests/v41/tb_nvp_i2c_tri_phase_probe_attempt_limit.sv
