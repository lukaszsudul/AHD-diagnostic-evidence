set _xlnx_shared_i10 [filter [get_cells -quiet -hier -regexp .*G2B_ONECH_C2H/(records_abandoned_axi|commit_seen_axi|stream_reset_busy_axi|stream_reset_is_hard_axi|transport_followup_hard_axi|reset_epoch_axi|global_stream_next_axi|last_global_axi|last_channel_axi|last_global_valid_axi|last_channel_valid_axi|reset_events_axi|axis_state|snapshot_busy_axi|snapshot_valid_axi|fatal_clear_qualified_axi|axi_hard_episode)_reg.*] {IS_SEQUENTIAL == 1}]
set_max_delay -datapath_only -from [get_cells -quiet -hier -regexp {.*G2B_ONECH_C2H/hard_event_baseline_hold_source_reg\[[0-9]+\]}] -to [get_pins -quiet -of_objects [get_cells -quiet -hier -regexp {.*G2B_ONECH_C2H/hard_event_baseline_sync1_axi_reg\[[0-9]+\]}] -filter {REF_PIN_NAME == D}] 6.000
set_bus_skew -from [get_cells -quiet -hier -regexp {.*G2B_ONECH_C2H/hard_event_baseline_hold_source_reg\[[0-9]+\]}] -to [get_pins -quiet -of_objects [get_cells -quiet -hier -regexp {.*G2B_ONECH_C2H/hard_event_baseline_sync1_axi_reg\[[0-9]+\]}] -filter {REF_PIN_NAME == D}] 3.000
