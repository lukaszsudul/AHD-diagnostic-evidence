# G0P8C5A non-PCIe board constraints.
# Sources: v39A_SC1 source-synchronous XDC, ahd_capture_card_pins_v05e_ready,
# and the generated PCIe X0Y0 placement XDC in the read-only main project.

# NVP6134C channel 1. Physical pins are not swapped; RTL corrects VDO 4/5.
current_instance -quiet
set_property PACKAGE_PIN A14 [get_ports {vdo1_data[0]}]
set_property PACKAGE_PIN B14 [get_ports {vdo1_data[1]}]
set_property PACKAGE_PIN A15 [get_ports {vdo1_data[2]}]
set_property PACKAGE_PIN B15 [get_ports {vdo1_data[3]}]
set_property PACKAGE_PIN B16 [get_ports {vdo1_data[4]}]
set_property PACKAGE_PIN A17 [get_ports {vdo1_data[5]}]
set_property PACKAGE_PIN B17 [get_ports {vdo1_data[6]}]
set_property PACKAGE_PIN C18 [get_ports {vdo1_data[7]}]
set_property IOSTANDARD LVCMOS33 [get_ports {vdo1_data[*]}]
set_property PACKAGE_PIN E13 [get_ports vclk1]
set_property IOSTANDARD LVCMOS33 [get_ports vclk1]

# CFGBVS and CONFIG_VOLTAGE remain in the configuration-bank constraint file.
# The Phase 1A empirical VDO timing model is applied separately by
# vdo_input_timing.xdc.


####################################################################################
# Constraints from file : 'vdo_input_timing.xdc'
####################################################################################

# v41 Phase 1A: empirically qualified NVP6134C VDO1 input timing.
#
# The public NVP6134C Rev. 1.0 data sheet does not publish VDO clock-to-output
# min/max values.  It does specify that Bank 1 register 0xCD[3:0] delays VCLK1
# in approximately VCLK/16 increments.  The frozen autoinit programs 0xCD=0x4A
# (148.5 MHz selector 4, delay selector 10).
#
# The preserved v38EI/v38EJ full 16-position hardware sweep measured the two
# cyclic capture-eye boundaries: position 8 is the transition, positions 9-15
# have zero rise/fall edge mismatch, and position 0 is outside that window.
# Relative to the frozen phase-10 operating point, the conservative measured
# data-valid margins are therefore one complete phase step before the capture
# edge and five complete phase steps after it.  These margins include the
# physical board interconnect used by the sweep; the board owner established
# that the A15T and A35T PCB connectivity is unchanged.
#
# Vivado's center-aligned rising-edge source-synchronous template maps the
# measured valid-before/valid-after intervals as:
#   input_delay_max = period - valid_before
#   input_delay_min = valid_after
# Full derivation, source locations, limitations, and arithmetic are recorded
# in docs/v41/phase1/V41_VDO_INPUT_TIMING_DERIVATION.md.

# Vivado constraint time values are quantized to 1 ps.  These literals are the
# documented derived values above rounded to that resolution; keeping the
# arithmetic variables makes the derivation auditable without invoking Tcl
# commands that Vivado's restricted XDC parser rejects.


# The physical interface is SDR.  The frontend uses a calibrated minimum
# IDELAYE2 path and only IDDR Q1 (rising-edge data); Q2 is deliberately
# unconnected.  Exclude the otherwise inferred
# falling-edge capture check so the constraints describe the implemented
# functional sampling edge, not the discarded Q2 observation.


####################################################################################
# Constraints from file : 'pcie_pio.xdc'
####################################################################################

# G0P8C5A PCIe-only constraints, isolated for direct reuse by the future XDMA
# integration. MGT pins deliberately have no IOSTANDARD property.
set_property LOC IBUFDS_GTE2_X0Y0 [get_cells PCIE_REFCLK_IBUF]
set_property PACKAGE_PIN D6 [get_ports sys_clk_p]
set_property PACKAGE_PIN D5 [get_ports sys_clk_n]
set_property PACKAGE_PIN C8 [get_ports sys_rst_n]
set_property IOSTANDARD LVCMOS33 [get_ports sys_rst_n]
set_property PULLTYPE PULLUP [get_ports sys_rst_n]

set_property LOC GTPE2_CHANNEL_X0Y3 [get_cells -hier -filter {REF_NAME == GTPE2_CHANNEL}]
set_property PACKAGE_PIN G3 [get_ports {pci_exp_rxn[0]}]
set_property PACKAGE_PIN G4 [get_ports {pci_exp_rxp[0]}]
set_property PACKAGE_PIN B1 [get_ports {pci_exp_txn[0]}]
set_property PACKAGE_PIN B2 [get_ports {pci_exp_txp[0]}]
set_property LOC GTPE2_COMMON_X0Y0 [get_cells -hier -filter {REF_NAME == GTPE2_COMMON}]
set_property LOC PCIE_X0Y0 [get_cells -hier -filter {REF_NAME == PCIE_2_1}]



####################################################################################
# Constraints from file : 'nvp_control.xdc'
####################################################################################

# A35T 1CH diagnostic candidate. The physical board designer confirmed that
# NVP U6 pin 62 / ~RSTB is connected to FPGA package pin R17. The former R18
# reset mapping and former R17 IRQ mapping are intentionally not inherited.
set_property PACKAGE_PIN R17 [get_ports nvp_rst]
set_property PACKAGE_PIN T17 [get_ports nvp_scl]
set_property PACKAGE_PIN T18 [get_ports nvp_sda]
set_property PACKAGE_PIN A9 [get_ports nvp_en_vdd1x]
set_property PACKAGE_PIN A10 [get_ports nvp_en_vdd3x]
set_property IOSTANDARD LVCMOS33 [get_ports nvp_rst]
set_property IOSTANDARD LVCMOS33 [get_ports nvp_scl]
set_property IOSTANDARD LVCMOS33 [get_ports nvp_sda]
set_property IOSTANDARD LVCMOS33 [get_ports nvp_en_vdd1x]
set_property IOSTANDARD LVCMOS33 [get_ports nvp_en_vdd3x]

# NVP IRQ is not consumed anywhere in v40 RTL. Its physical pin on the new
# board is unproven, so the unused top-level input is removed rather than
# guessed or assigned to the now-authoritative reset pin R17.

# Bonded NVP MPP inputs are observed only; G0P8C3 does not drive them.
set_property PACKAGE_PIN V16 [get_ports {nvp_mpp[0]}]
set_property PACKAGE_PIN V17 [get_ports {nvp_mpp[1]}]
set_property PACKAGE_PIN U16 [get_ports {nvp_mpp[2]}]
set_property PACKAGE_PIN U17 [get_ports {nvp_mpp[3]}]
set_property IOSTANDARD LVCMOS33 [get_ports {nvp_mpp[*]}]


####################################################################################
# Constraints from file : 'cdc.xdc'
####################################################################################

# G0P8C3 scoped bundled-data CDC constraints. The build Tcl counts and asserts
# every collection immediately before implementation; an empty or unexpected
# collection is an implementation-gate failure.
# In this integrated top, malformed is the last consumed status field and
# synthesis retains bits 0..259 at both sides. Historical unconsumed
# dropped/arm-rejected source bits are correctly trimmed.


# G0P8C5C diagnostic event counters cross as source-registered Gray code into
# two-flop synchronizers.  The datapath-only bound replaces meaningless
# unrelated-clock setup analysis, while bus skew keeps the Gray vector compact.

# Autonomous init asserts these reset controls asynchronously by design; each
# destination is part of an explicit assertion-async/release-sync chain.


####################################################################################
# Constraints from file : 'g2b_cdc.xdc'
####################################################################################

# AHD v41 G2B CDC constraints. These constraints are additive to the accepted
# legacy cdc.xdc and name only the new G2B hierarchy.

# Every asynchronous request, acknowledgement, event, live status, and commit
# vector enters through an explicitly ASYNC_REG-marked first stage.

# Source-held snapshot Gray words cross through two explicit vector
# synchronizers. Bound the unrelated-clock datapath and keep each Gray vector
# compact at the first stage.

# The snapshot epoch echo is a stable-data token qualifier. It follows the
# same two-stage and bounded-bus method as the held Gray words.

# Stable-data mailbox payloads are held from request launch through returned
# acknowledgement. The toggle provides coherency; these constraints provide a
# physical bound and bus-skew limit for the bundled data.

# Bus skew is meaningful within one acknowledged payload, not across the
# unrelated enable, transport, snapshot, ownership, and per-slot release
# protocols collected by the aggregate max-delay bound above.  Constrain each
# coherent payload independently while retaining the 6 ns bound over every
# valid AXI-to-source mailbox path.


# Synthesis can merge the ownership-hold flops with the same-edge AXIS staging
# flops.  The union names both RTL identities so the physical launch set stays
# nonempty under rebuilt hierarchy without preserving logic artificially.


# Keep only real sequential launch elements.  Synthesized descriptor arrays
# contain both logical RAM macros (not valid timing startpoints) and their
# sequential RAM primitive leaves. The split makes that distinction explicit
# and keeps the physical mailbox constraint free of path-segmentation objects.
# Vivado's XDC evaluator rejects the Tcl concat command.  A quoted collection
# union preserves the same 212 sequential launch objects and is accepted by
# read_xdc (validated against the prior post-opt checkpoint).

# Split source-to-AXI bundled data at its protocol capture boundary.  Attempt
# and generation may synthesize as distributed RAM while epoch remains flops;
# a field-wide skew check avoids comparing inactive slots or reset-return
# state against unrelated scheduler consumers.

# The source-side hard-clear baseline is a stable mailbox qualified by the
# synchronized clear-boundary token. Bound and compact it at its first AXI
# synchronizer stage so the baseline is coherent when the token is consumed.


####################################################################################
# Constraints from file : 'configuration_bank.xdc'
####################################################################################

# G0P8C3R2 configuration-bank properties.
# KiCad U4 E12 (CFGBVS_0), U4 E10/R10 (VCCO_0), U1.6 (VOUT), and TP1
# are all on PCB net Vcco; TP1 is labelled 3,3V.
set_property CONFIG_VOLTAGE 3.3 [current_design]
set_property CFGBVS VCCO [current_design]


