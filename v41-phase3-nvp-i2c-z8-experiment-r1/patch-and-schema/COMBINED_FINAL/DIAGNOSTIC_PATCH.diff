+      r2_sample[5:3] = {3{scl_level}};
+      r2_sample[6] = sda_drive;
+      r2_sample[7] = scl_drive;
+      r2_sample[8] = tick;
+      r2_sample[9] = ack_strobe;
+      r2_sample[10] = ack_used;
+      r2_sample[11] = first_nack;
+      r2_sample[13] = 1'b1;
+      r2_sample[14] = 1'b1;
+      r2_sample[15] = 1'b1;
+      r2_sample[16] = !done;
+      r2_sample[17] = done;
+      r2_sample[18] = error;
+      r2_sample[39:32] = phase;
+      r2_sample[47:40] = 8'h0B;
+      r2_sample[55:48] = operation;
+      r2_sample[63:56] = slot;
+      r2_sample[71:64] = 8'h01;
+      r2_sample[95:88] = 8'h00;
+      r2_sample[103:96] = 8'h00;
+      r2_sample[111:104] = 8'h00;
+      r2_sample[119:112] = reg_addr;
+      r2_sample[127:120] = value;
+      r2_sample[135:128] = reg_addr;
+      r2_sample[143:136] = value;
+      r2_sample[151:144] = tx;
+      if (first_nack) begin
+        r2_sample[159:152] = phase;
+        r2_sample[167:160] = operation;
+        r2_sample[191:184] = reg_addr;
+        r2_sample[199:192] = value;
+      end
+    end
+  endtask
+
+  task automatic ack_event(
+      input [7:0] phase, input [7:0] operation, input [7:0] slot,
+      input [7:0] tx, input [7:0] reg_addr, input [7:0] value,
+      input bit original_r1_ack, input integer shadow_mode,
+      input bit z8_consumed_ack,
+      input bit first_nack);
+    integer cycle;
+    bit sda, scl;
+    begin
+      // Original functional decision: SCL is still LOW and driven LOW.
+      @(negedge clk);
+      set_r2(phase, operation, slot, tx, reg_addr, value,
+             original_r1_ack ? 1'b0 : 1'b1, 1'b0,
+             1'b0, 1'b1, 1'b1, 1'b1, original_r1_ack,
+             1'b0, 1'b0, 1'b0);
+      trace_sample = '0;
