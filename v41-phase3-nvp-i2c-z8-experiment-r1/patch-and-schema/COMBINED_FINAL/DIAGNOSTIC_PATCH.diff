+++ b/observer-r2/rtl/diag/nvp_i2c_r2_observer.sv
@@ -0,0 +1,429 @@
+`timescale 1ns/1ps
+
+// Ephemeral R2/Z8 observer-only recorder.  The module has no functional output:
+// every output is frozen metadata or a read-only BRAM port.  capture_reset is
+// the configuration-time NVP POR only; PCIe user_reset is deliberately absent.
+(* keep_hierarchy = "yes" *) module nvp_i2c_r2_observer #(
+  parameter integer CONTEXT_DEPTH = 512,
+  parameter integer SHADOW_DEPTH = 256,
+  parameter integer HALF_PHASE_CYCLES = 626,
+  parameter integer MID_HIGH_OFFSET_CYCLES = 313,
+  parameter integer CONTEXT_ADDR_WIDTH = $clog2(CONTEXT_DEPTH),
+  parameter integer SHADOW_ADDR_WIDTH = $clog2(SHADOW_DEPTH),
+  parameter integer PHASE_COUNT_WIDTH = $clog2(HALF_PHASE_CYCLES + 2)
+) (
+  input  logic                         sample_clk,
+  input  logic                         capture_reset,
+  input  logic [200:0]                 r2_sample,
+
+  output logic                         context_frozen,
+  output logic                         context_full,
+  output logic                         context_overflow,
+  output logic [1:0]                   context_trigger_reason,
+  output logic [CONTEXT_ADDR_WIDTH-1:0] context_final_write_index,
+  output logic [CONTEXT_ADDR_WIDTH:0]   context_valid_count,
+  output logic [31:0]                  context_total_ticks,
+  input  logic                         context_read_clk,
+  input  logic                         context_read_enable,
+  input  logic [CONTEXT_ADDR_WIDTH-1:0] context_read_address,
+  output logic [127:0]                 context_read_data,
+
+  output logic                         shadow_frozen,
+  output logic                         shadow_full,
+  output logic                         shadow_overflow,
+  output logic [1:0]                   shadow_trigger_reason,
+  output logic [SHADOW_ADDR_WIDTH-1:0] shadow_final_write_index,
+  output logic [SHADOW_ADDR_WIDTH:0]   shadow_valid_count,
+  output logic [31:0]                  shadow_total_events,
+  output logic [31:0]                  shadow_false_nack_count,
+  output logic [31:0]                  shadow_real_nack_count,
+  output logic [31:0]                  shadow_invalid_window_count,
+  input  logic                         shadow_read_clk,
+  input  logic                         shadow_read_enable,
+  input  logic [SHADOW_ADDR_WIDTH-1:0] shadow_read_address,
+  output logic [255:0]                 shadow_read_data
+);
+  initial begin
+    if (CONTEXT_DEPTH < 2 || (CONTEXT_DEPTH & (CONTEXT_DEPTH - 1)) != 0)
+      $error("CONTEXT_DEPTH must be a power of two");
+    if (SHADOW_DEPTH < 2 || (SHADOW_DEPTH & (SHADOW_DEPTH - 1)) != 0)
+      $error("SHADOW_DEPTH must be a power of two");
+    if (HALF_PHASE_CYCLES < 8)
+      $error("HALF_PHASE_CYCLES is too small");
+    if (MID_HIGH_OFFSET_CYCLES < 2 ||
+        MID_HIGH_OFFSET_CYCLES >= HALF_PHASE_CYCLES)
+      $error("MID_HIGH_OFFSET_CYCLES must lie inside the half phase");
+  end
+
+  wire fsm_tick = r2_sample[8];
+  wire ack_decision_strobe = r2_sample[9];
+  wire ack_value_used = r2_sample[10];
+  wire first_nack_event = r2_sample[11];
+  wire z8_ack_pending = r2_sample[28];
+  wire z8_midpoint_strobe = r2_sample[29];
+  wire z8_sample_valid = r2_sample[30];
+  wire z8_consume_strobe = r2_sample[31];
+  wire z8_sampled_scl = r2_sample[200];
+  wire init_done = r2_sample[17];
+  wire init_error = r2_sample[18];
+  wire qualified_scl_high = !r2_sample[6] && !r2_sample[7] &&
+                            r2_sample[5];
+
+  // ------------------------------------------------------------------------
+  // FSM-tick context ring: 512 x 128 in the production R2 geometry.
+  // ------------------------------------------------------------------------
+  (* ram_style = "block" *) logic [127:0] context_memory [0:CONTEXT_DEPTH-1];
+  logic [CONTEXT_ADDR_WIDTH-1:0] context_write_index;
+  logic [15:0] context_sequence;
+  logic [127:0] context_word;
+
+  always_comb begin
+    context_word = '0;
+    context_word[15:0] = context_sequence;
+    context_word[23:16] = r2_sample[47:40];       // state
+    context_word[31:24] = r2_sample[39:32];       // byte phase
+    context_word[35:32] = r2_sample[27:24];       // bit index
+    context_word[43:36] = r2_sample[55:48];       // operation index
+    context_word[51:44] = r2_sample[63:56];       // slot index
+    context_word[55:52] = r2_sample[67:64];       // high-level init phase
+    context_word[57:56] = r2_sample[73:72];       // preinit action
+    context_word[59:58] = r2_sample[81:80];       // init action
+    context_word[67:60] = r2_sample[95:88];       // meta bank
+    context_word[75:68] = r2_sample[103:96];      // physical bank
+    context_word[76] = r2_sample[19];             // physical bank valid
+    context_word[77] = r2_sample[20];             // read operation
+    context_word[78] = r2_sample[6];              // SDA drive low
+    context_word[79] = r2_sample[7];              // SCL drive low
+    context_word[80] = r2_sample[2];              // filtered SDA
+    context_word[81] = r2_sample[5];              // filtered SCL
+    context_word[82] = ack_decision_strobe;
+    context_word[83] = ack_value_used;
+    context_word[84] = first_nack_event;
+    context_word[85] = r2_sample[16];              // init active
+    context_word[86] = init_done;
+    context_word[87] = init_error;
+    context_word[95:88] = r2_sample[111:104];      // pending bank
+    context_word[103:96] = r2_sample[119:112];     // pending register
+    context_word[111:104] = r2_sample[127:120];    // pending data
+    context_word[119:112] = r2_sample[135:128];    // active register
+    context_word[127:120] = r2_sample[143:136];    // active write data
+  end
+
+  always_ff @(posedge sample_clk) begin
+    if (capture_reset) begin
+      context_write_index <= '0;
+      context_final_write_index <= '0;
+      context_valid_count <= '0;
+      context_total_ticks <= '0;
+      context_sequence <= '0;
+      context_frozen <= 1'b0;
+      context_full <= 1'b0;
+      context_overflow <= 1'b0;
+      context_trigger_reason <= 2'd0;
+    end else if (!context_frozen) begin
+      if (fsm_tick) begin
+        context_memory[context_write_index] <= context_word;
+        context_final_write_index <= context_write_index;
+        context_write_index <= context_write_index + 1'b1;
+        context_sequence <= context_sequence + 1'b1;
+        context_total_ticks <= context_total_ticks + 1'b1;
+        if (!context_full) begin
+          if (context_valid_count == CONTEXT_DEPTH-1) begin
+            context_valid_count <= CONTEXT_DEPTH;
+            context_full <= 1'b1;
+          end else begin
+            context_valid_count <= context_valid_count + 1'b1;
+          end
+        end
+        if (first_nack_event) begin
+          context_frozen <= 1'b1;
+          context_trigger_reason <= 2'd1;
+        end
+      end
+
+      if (init_done && !first_nack_event) begin
+        context_frozen <= 1'b1;
+        context_trigger_reason <= init_error ? 2'd3 : 2'd2;
+      end
+    end
+  end
+
+  always_ff @(posedge context_read_clk) begin
+    if (context_read_enable)
+      context_read_data <= context_memory[context_read_address];
+  end
+
+  // ------------------------------------------------------------------------
+  // Correct-phase shadow ACK event recorder.  A functional ACK decision starts
+  // an event; the monitor then observes the unchanged real SCL-high interval.
+  // It cannot drive or alter any functional signal.
+  // ------------------------------------------------------------------------
+  (* ram_style = "block" *) logic [255:0] shadow_memory [0:SHADOW_DEPTH-1];
+  logic [SHADOW_ADDR_WIDTH-1:0] shadow_write_index;
+  logic shadow_active;
+  logic [PHASE_COUNT_WIDTH-1:0] shadow_cycle_offset;
+
+  logic [7:0] event_operation;
+  logic [7:0] event_slot;
+  logic [7:0] event_byte_phase;
+  logic [7:0] event_tx_byte;
+  logic [7:0] event_register;
+  logic [7:0] event_write_value;
+  logic [7:0] event_meta_bank;
+  logic [7:0] event_phys_bank;
+  logic event_phys_bank_valid;
+  logic [7:0] event_init_phase;
+  logic [7:0] event_preinit_action;
+  logic [7:0] event_init_action;
+  logic event_original_r1_ack;
+  logic event_decision_sda;
+  logic event_decision_scl;
+  logic event_decision_sda_drive;
+  logic event_decision_scl_drive;
+  logic event_scl_high_seen;
+  logic event_sda_released_all;
+  logic event_scl_released_all;
+  logic event_early_valid;
+  logic [2:0] event_early_sda;
+  logic [2:0] event_early_scl;
+  logic event_early_sda_drive;
+  logic event_early_scl_drive;
+  logic [PHASE_COUNT_WIDTH-1:0] event_early_offset;
+  logic event_mid_valid;
+  logic [2:0] event_mid_sda;
+  logic [2:0] event_mid_scl;
+  logic event_mid_sda_drive;
+  logic event_mid_scl_drive;
+  logic [PHASE_COUNT_WIDTH-1:0] event_mid_offset;
+
+  wire [PHASE_COUNT_WIDTH-1:0] current_offset = shadow_cycle_offset + 1'b1;
+  wire late_valid_now = qualified_scl_high;
+  wire interval_count_valid = (current_offset == HALF_PHASE_CYCLES);
+  logic [255:0] shadow_event_word;
+
+  always_comb begin
+    shadow_event_word = '0;
+    shadow_event_word[15:0] = shadow_total_events[15:0];
+    shadow_event_word[23:16] = event_operation;
+    shadow_event_word[31:24] = event_slot;
+    shadow_event_word[39:32] = event_byte_phase;
+    shadow_event_word[47:40] = event_tx_byte;
+    shadow_event_word[55:48] = event_register;
+    shadow_event_word[63:56] = event_write_value;
+    shadow_event_word[71:64] = event_meta_bank;
+    shadow_event_word[79:72] = event_phys_bank;
+    shadow_event_word[80] = event_phys_bank_valid;
+    // At the end-of-high store tick ACK_VALUE_USED is the Z8 midpoint result.
+    // The original R1 would-have-used result is retained separately at bit 94.
+    shadow_event_word[81] = ack_value_used;
+    shadow_event_word[82] = event_decision_sda;
+    shadow_event_word[83] = event_decision_scl;
+    shadow_event_word[84] = event_decision_sda_drive;
+    shadow_event_word[85] = event_decision_scl_drive;
+    shadow_event_word[86] = first_nack_event;
+    shadow_event_word[87] = event_scl_high_seen || qualified_scl_high;
+    shadow_event_word[88] = event_early_valid;
+    shadow_event_word[89] = event_mid_valid;
+    shadow_event_word[90] = late_valid_now;
+    shadow_event_word[91] = event_sda_released_all && !r2_sample[6];
+    shadow_event_word[92] = event_scl_released_all && !r2_sample[7];
+    shadow_event_word[93] = interval_count_valid;
+    shadow_event_word[94] = event_original_r1_ack;
+    shadow_event_word[95] = z8_consume_strobe && !z8_sample_valid;
+    shadow_event_word[98:96] = event_early_sda;
+    shadow_event_word[101:99] = event_early_scl;
+    shadow_event_word[102] = event_early_sda_drive;
+    shadow_event_word[103] = event_early_scl_drive;
+    shadow_event_word[106:104] = event_mid_sda;
+    shadow_event_word[109:107] = event_mid_scl;
+    shadow_event_word[110] = event_mid_sda_drive;
+    shadow_event_word[111] = event_mid_scl_drive;
+    shadow_event_word[114:112] = r2_sample[2:0];
+    shadow_event_word[117:115] = r2_sample[5:3];
+    shadow_event_word[118] = r2_sample[6];
+    shadow_event_word[119] = r2_sample[7];
+    shadow_event_word[129:120] = event_early_offset;
+    shadow_event_word[139:130] = event_mid_offset;
+    shadow_event_word[149:140] = current_offset;
+    shadow_event_word[159:150] = current_offset;
+    shadow_event_word[167:160] = event_init_phase;
+    shadow_event_word[175:168] = event_preinit_action;
+    shadow_event_word[183:176] = event_init_action;
+    shadow_event_word[191:184] = r2_sample[111:104];
+    shadow_event_word[199:192] = r2_sample[119:112];
+    shadow_event_word[207:200] = r2_sample[127:120];
+    shadow_event_word[215:208] = r2_sample[159:152];
+    shadow_event_word[223:216] = r2_sample[167:160];
+    shadow_event_word[231:224] = r2_sample[175:168];
+    shadow_event_word[239:232] = r2_sample[191:184];
+    shadow_event_word[247:240] = r2_sample[199:192];
+    shadow_event_word[248] = r2_sample[16];
+    shadow_event_word[249] = r2_sample[17];
+    shadow_event_word[250] = r2_sample[18];
+    shadow_event_word[251] = !(event_scl_high_seen || qualified_scl_high);
+    shadow_event_word[252] = !ack_value_used && event_mid_valid && !event_mid_sda[2];
+    shadow_event_word[253] = !ack_value_used && event_mid_valid && event_mid_sda[2];
+    shadow_event_word[254] = !event_mid_valid;
+    shadow_event_word[255] = z8_sampled_scl;
+  end
+
+  always_ff @(posedge sample_clk) begin
+    if (capture_reset) begin
+      shadow_write_index <= '0;
+      shadow_final_write_index <= '0;
+      shadow_valid_count <= '0;
+      shadow_total_events <= '0;
+      shadow_false_nack_count <= '0;
+      shadow_real_nack_count <= '0;
+      shadow_invalid_window_count <= '0;
+      shadow_frozen <= 1'b0;
+      shadow_full <= 1'b0;
+      shadow_overflow <= 1'b0;
+      shadow_trigger_reason <= 2'd0;
+      shadow_active <= 1'b0;
+      shadow_cycle_offset <= '0;
+      event_operation <= '0;
+      event_slot <= '0;
+      event_byte_phase <= '0;
+      event_tx_byte <= '0;
+      event_register <= '0;
+      event_write_value <= '0;
+      event_meta_bank <= '0;
+      event_phys_bank <= '0;
+      event_phys_bank_valid <= 1'b0;
+      event_init_phase <= '0;
+      event_preinit_action <= '0;
+      event_init_action <= '0;
+      event_original_r1_ack <= 1'b0;
+      event_decision_sda <= 1'b1;
+      event_decision_scl <= 1'b1;
+      event_decision_sda_drive <= 1'b0;
+      event_decision_scl_drive <= 1'b0;
+      event_scl_high_seen <= 1'b0;
+      event_sda_released_all <= 1'b1;
+      event_scl_released_all <= 1'b1;
+      event_early_valid <= 1'b0;
+      event_early_sda <= 3'b111;
+      event_early_scl <= 3'b111;
+      event_early_sda_drive <= 1'b0;
+      event_early_scl_drive <= 1'b0;
+      event_early_offset <= '0;
+      event_mid_valid <= 1'b0;
+      event_mid_sda <= 3'b111;
+      event_mid_scl <= 3'b111;
+      event_mid_sda_drive <= 1'b0;
+      event_mid_scl_drive <= 1'b0;
+      event_mid_offset <= '0;
+    end else if (!shadow_frozen) begin
+      if (ack_decision_strobe) begin
+        if (shadow_active) begin
+          shadow_overflow <= 1'b1;
+          shadow_frozen <= 1'b1;
+          shadow_trigger_reason <= 2'd3;
+        end else begin
+          shadow_active <= 1'b1;
+          shadow_cycle_offset <= '0;
+          event_operation <= r2_sample[55:48];
+          event_slot <= r2_sample[63:56];
+          event_byte_phase <= r2_sample[39:32];
+          event_tx_byte <= r2_sample[151:144];
+          event_register <= r2_sample[135:128];
+          event_write_value <= r2_sample[143:136];
+          event_meta_bank <= r2_sample[95:88];
+          event_phys_bank <= r2_sample[103:96];
+          event_phys_bank_valid <= r2_sample[19];
+          event_init_phase <= r2_sample[71:64];
+          event_preinit_action <= r2_sample[79:72];
+          event_init_action <= r2_sample[87:80];
+          event_original_r1_ack <= ack_value_used;
+          event_decision_sda <= r2_sample[2];
+          event_decision_scl <= r2_sample[5];
+          event_decision_sda_drive <= r2_sample[6];
+          event_decision_scl_drive <= r2_sample[7];
+          event_scl_high_seen <= 1'b0;
+          event_sda_released_all <= !r2_sample[6];
+          // SCL is intentionally still driven LOW at the old functional
+          // decision instant; the unchanged FSM releases it after this edge.
+          event_scl_released_all <= 1'b1;
+          event_early_valid <= 1'b0;
+          event_early_sda <= 3'b111;
+          event_early_scl <= 3'b111;
+          event_early_sda_drive <= 1'b0;
+          event_early_scl_drive <= 1'b0;
+          event_early_offset <= '0;
+          event_mid_valid <= 1'b0;
+          event_mid_sda <= 3'b111;
+          event_mid_scl <= 3'b111;
+          event_mid_sda_drive <= 1'b0;
+          event_mid_scl_drive <= 1'b0;
+          event_mid_offset <= MID_HIGH_OFFSET_CYCLES;
+        end
+      end else if (shadow_active) begin
+        shadow_cycle_offset <= current_offset;
+        event_sda_released_all <= event_sda_released_all && !r2_sample[6];
+        event_scl_released_all <= event_scl_released_all && !r2_sample[7];
+
+        if (qualified_scl_high) begin
+          event_scl_high_seen <= 1'b1;
+          if (!event_early_valid) begin
+            event_early_valid <= 1'b1;
+            event_early_sda <= r2_sample[2:0];
+            event_early_scl <= r2_sample[5:3];
+            event_early_sda_drive <= r2_sample[6];
+            event_early_scl_drive <= r2_sample[7];
+            event_early_offset <= current_offset;
+          end
+        end
+
+        if (current_offset == MID_HIGH_OFFSET_CYCLES) begin
+          event_mid_valid <= qualified_scl_high;
+          event_mid_sda <= r2_sample[2:0];
+          event_mid_scl <= r2_sample[5:3];
+          event_mid_sda_drive <= r2_sample[6];
+          event_mid_scl_drive <= r2_sample[7];
+          event_mid_offset <= current_offset;
+        end
+
+        if (fsm_tick) begin
+          shadow_memory[shadow_write_index] <= shadow_event_word;
+          shadow_final_write_index <= shadow_write_index;
+          shadow_write_index <= shadow_write_index + 1'b1;
+          shadow_total_events <= shadow_total_events + 1'b1;
+          shadow_active <= 1'b0;
+          if (!shadow_full) begin
+            if (shadow_valid_count == SHADOW_DEPTH-1) begin
+              shadow_valid_count <= SHADOW_DEPTH;
+              shadow_full <= 1'b1;
+            end else begin
+              shadow_valid_count <= shadow_valid_count + 1'b1;
+            end
+          end
+
+          if (!interval_count_valid) begin
+            shadow_overflow <= 1'b1;
+            shadow_invalid_window_count <= shadow_invalid_window_count + 1'b1;
+          end else if (!event_mid_valid) begin
+            shadow_invalid_window_count <= shadow_invalid_window_count + 1'b1;
+          end else if (!ack_value_used && !event_mid_sda[2]) begin
+            shadow_false_nack_count <= shadow_false_nack_count + 1'b1;
+          end else if (!ack_value_used && event_mid_sda[2]) begin
+            shadow_real_nack_count <= shadow_real_nack_count + 1'b1;
+          end
+
+          if (first_nack_event) begin
+            shadow_frozen <= 1'b1;
+            shadow_trigger_reason <= 2'd1;
+          end
+        end
+      end else if (init_done) begin
+        shadow_frozen <= 1'b1;
+        shadow_trigger_reason <= init_error ? 2'd3 : 2'd2;
+      end
+    end
+  end
+
+  always_ff @(posedge shadow_read_clk) begin
+    if (shadow_read_enable)
+      shadow_read_data <= shadow_memory[shadow_read_address];
+  end
+endmodule
diff --git a/observer-r2/rtl/diag/nvp_i2c_trace_observer.sv b/observer-r2/rtl/diag/nvp_i2c_trace_observer.sv
new file mode 100644
index 0000000..01b73f6
--- /dev/null
+++ b/observer-r2/rtl/diag/nvp_i2c_trace_observer.sv
@@ -0,0 +1,125 @@
+`timescale 1ns/1ps
+
+// Ephemeral, one-way NVP/I2C observer.  This block has no functional outputs:
+// every output is diagnostic metadata or the read-only BRAM port.  Capture is
+// reset only by the configuration-time local reset, never PCIe user_reset.
+(* keep_hierarchy = "yes" *) module nvp_i2c_trace_observer #(
+  parameter integer TRACE_DEPTH = 4096,
+  parameter integer PRE_TRIGGER_SAMPLES = 3072,
+  parameter integer POST_TRIGGER_SAMPLES = 1024,
+  parameter integer ADDR_WIDTH = $clog2(TRACE_DEPTH)
+) (
+  input  logic                  sample_clk,
+  input  logic                  capture_reset,
+  input  logic [63:0]           trace_sample,
+  output logic                  trace_frozen,
+  output logic                  trace_triggered,
+  output logic                  trace_full,
+  output logic                  trace_overflow,
+  output logic [1:0]            trace_trigger_reason,
+  output logic [ADDR_WIDTH-1:0] trace_trigger_index,
+  output logic [ADDR_WIDTH-1:0] trace_final_write_index,
+  output logic [ADDR_WIDTH:0]   trace_valid_count,
+
+  input  logic                  read_clk,
+  input  logic                  read_enable,
+  input  logic [ADDR_WIDTH-1:0] read_address,
+  output logic [63:0]           read_data
+);
+  localparam integer POST_COUNT_WIDTH = $clog2(POST_TRIGGER_SAMPLES + 1);
+
+  (* ram_style = "block" *) logic [63:0] trace_memory [0:TRACE_DEPTH-1];
+  logic [ADDR_WIDTH-1:0] write_index;
+  logic [POST_COUNT_WIDTH-1:0] post_remaining;
+  logic first_nack_seen;
+
+  initial begin
+    if (TRACE_DEPTH < 2 || (TRACE_DEPTH & (TRACE_DEPTH - 1)) != 0)
+      $error("TRACE_DEPTH must be a power of two");
+    if (PRE_TRIGGER_SAMPLES + POST_TRIGGER_SAMPLES != TRACE_DEPTH)
+      $error("pre-trigger plus post-trigger samples must equal TRACE_DEPTH");
+    if (POST_TRIGGER_SAMPLES < 1)
+      $error("POST_TRIGGER_SAMPLES must be at least one");
+  end
+
+  always_ff @(posedge sample_clk) begin
+    if (capture_reset) begin
+      write_index <= '0;
+      post_remaining <= '0;
+      first_nack_seen <= 1'b0;
+      trace_frozen <= 1'b0;
+      trace_triggered <= 1'b0;
+      trace_full <= 1'b0;
+      trace_overflow <= 1'b0;
+      trace_trigger_reason <= 2'd0;
+      trace_trigger_index <= '0;
+      trace_final_write_index <= '0;
+      trace_valid_count <= '0;
+    end else if (!trace_frozen) begin
+      trace_memory[write_index] <= trace_sample;
+
+      if (!trace_full) begin
+        if (trace_valid_count == TRACE_DEPTH-1) begin
+          trace_valid_count <= TRACE_DEPTH;
+          trace_full <= 1'b1;
+        end else begin
+          trace_valid_count <= trace_valid_count + 1'b1;
+        end
+      end
+
+      if (!trace_triggered) begin
+        if (trace_sample[10]) begin
+          first_nack_seen <= 1'b1;
+          trace_triggered <= 1'b1;
+          trace_trigger_reason <= 2'd1;
+          trace_trigger_index <= write_index;
+          if (POST_TRIGGER_SAMPLES == 1) begin
+            trace_frozen <= 1'b1;
+            trace_final_write_index <= write_index;
+          end else begin
+            post_remaining <= POST_TRIGGER_SAMPLES - 1;
+          end
+        end else if (trace_sample[52] && !trace_sample[53] &&
+                     !first_nack_seen && !trace_sample[11]) begin
+          trace_triggered <= 1'b1;
+          trace_trigger_reason <= 2'd2;
+          trace_trigger_index <= write_index;
+          if (POST_TRIGGER_SAMPLES == 1) begin
+            trace_frozen <= 1'b1;
+            trace_final_write_index <= write_index;
+          end else begin
+            post_remaining <= POST_TRIGGER_SAMPLES - 1;
+          end
+        end else if (trace_sample[52] && trace_sample[53] &&
+                     !first_nack_seen && !trace_sample[11]) begin
+          trace_triggered <= 1'b1;
+          trace_trigger_reason <= 2'd3;
+          trace_trigger_index <= write_index;
+          if (POST_TRIGGER_SAMPLES == 1) begin
+            trace_frozen <= 1'b1;
+            trace_final_write_index <= write_index;
+          end else begin
+            post_remaining <= POST_TRIGGER_SAMPLES - 1;
+          end
+        end
+      end else if (post_remaining != 0) begin
+        if (post_remaining == 1) begin
+          post_remaining <= '0;
+          trace_frozen <= 1'b1;
+          trace_final_write_index <= write_index;
+        end else begin
+          post_remaining <= post_remaining - 1'b1;
+        end
+      end
+
+      write_index <= write_index + 1'b1;
+    end
+  end
+
+  // Read port is deliberately reset-free so a PCIe user_reset cannot alter
+  // either the BRAM contents or the frozen metadata.
+  always_ff @(posedge read_clk) begin
+    if (read_enable)
+      read_data <= trace_memory[read_address];
+  end
+endmodule
diff --git a/observer-r2/rtl/diag/nvp_trace_host_read_mux.sv b/observer-r2/rtl/diag/nvp_trace_host_read_mux.sv
new file mode 100644
index 0000000..1ab290b
--- /dev/null
+++ b/observer-r2/rtl/diag/nvp_trace_host_read_mux.sv
@@ -0,0 +1,288 @@
+`timescale 1ns/1ps
+
+// Read-only R2/Z8 experimental overlay in proven unused/reserved-zero BAR0 space.
+// Requests outside the four exact diagnostic ranges pass to the unmodified
+// formal 53-register/application path.  Diagnostic writes are consumed with
+// no state effect and are never forwarded.
+(* keep_hierarchy = "yes" *) module nvp_trace_host_read_mux #(
+  parameter integer TRACE_DEPTH = 4096,
+  parameter integer TRACE_SAMPLE_CLOCK_HZ = 62500000,
+  parameter integer TRACE_SAMPLE_WIDTH_BITS = 64,
+  parameter integer TRACE_PRE_TRIGGER_COUNT = 3072,
+  parameter integer TRACE_POST_TRIGGER_COUNT = 1024,
+  parameter integer TRACE_ADDR_WIDTH = $clog2(TRACE_DEPTH),
+  parameter integer CONTEXT_DEPTH = 512,
+  parameter integer CONTEXT_SAMPLE_WIDTH_BITS = 128,
+  parameter integer CONTEXT_ADDR_WIDTH = $clog2(CONTEXT_DEPTH),
+  parameter integer SHADOW_DEPTH = 256,
+  parameter integer SHADOW_SAMPLE_WIDTH_BITS = 256,
+  parameter integer SHADOW_ADDR_WIDTH = $clog2(SHADOW_DEPTH),
+  parameter integer HALF_PHASE_CYCLES = 626,
+  parameter integer MID_HIGH_OFFSET_CYCLES = 313,
+  parameter logic [31:0] BASE_COMMIT_W0 = 32'h0,
+  parameter logic [31:0] BASE_COMMIT_W1 = 32'h0,
+  parameter logic [31:0] BASE_COMMIT_W2 = 32'h0,
+  parameter logic [31:0] BASE_COMMIT_W3 = 32'h0,
+  parameter logic [31:0] BASE_COMMIT_W4 = 32'h0,
+  parameter logic [31:0] PATCH_SHA_W0 = 32'h0,
+  parameter logic [31:0] PATCH_SHA_W1 = 32'h0,
+  parameter logic [31:0] PATCH_SHA_W2 = 32'h0,
+  parameter logic [31:0] PATCH_SHA_W3 = 32'h0,
+  parameter logic [31:0] PATCH_SHA_W4 = 32'h0,
+  parameter logic [31:0] PATCH_SHA_W5 = 32'h0,
+  parameter logic [31:0] PATCH_SHA_W6 = 32'h0,
+  parameter logic [31:0] PATCH_SHA_W7 = 32'h0
+) (
+  input  logic        clk,
+  input  logic        reset,
+
+  input  logic        host_req_valid,
+  output logic        host_req_ready,
+  input  logic        host_req_write,
+  input  logic [16:0] host_req_addr,
+  input  logic [31:0] host_req_wdata,
+  input  logic [3:0]  host_req_be,
+  output logic        host_rsp_valid,
+  input  logic        host_rsp_ready,
+  output logic [31:0] host_rsp_rdata,
+
+  output logic        formal_req_valid,
+  input  logic        formal_req_ready,
+  output logic        formal_req_write,
+  output logic [16:0] formal_req_addr,
+  output logic [31:0] formal_req_wdata,
+  output logic [3:0]  formal_req_be,
+  input  logic        formal_rsp_valid,
+  output logic        formal_rsp_ready,
+  input  logic [31:0] formal_rsp_rdata,
+
+  input  logic        trace_frozen,
+  input  logic        trace_triggered,
+  input  logic        trace_full,
+  input  logic        trace_overflow,
+  input  logic [1:0]  trace_trigger_reason,
+  input  logic [TRACE_ADDR_WIDTH-1:0] trace_trigger_index_physical,
+  input  logic [TRACE_ADDR_WIDTH-1:0] trace_final_write_index,
+  input  logic [TRACE_ADDR_WIDTH:0] trace_valid_count,
+  output logic        trace_read_enable,
+  output logic [TRACE_ADDR_WIDTH-1:0] trace_read_address,
+  input  logic [63:0] trace_read_data,
+
+  input  logic        context_frozen,
+  input  logic        context_full,
+  input  logic        context_overflow,
+  input  logic [1:0]  context_trigger_reason,
+  input  logic [CONTEXT_ADDR_WIDTH-1:0] context_final_write_index,
+  input  logic [CONTEXT_ADDR_WIDTH:0] context_valid_count,
+  input  logic [31:0] context_total_ticks,
+  output logic        context_read_enable,
+  output logic [CONTEXT_ADDR_WIDTH-1:0] context_read_address,
+  input  logic [127:0] context_read_data,
+
+  input  logic        shadow_frozen,
+  input  logic        shadow_full,
+  input  logic        shadow_overflow,
+  input  logic [1:0]  shadow_trigger_reason,
+  input  logic [SHADOW_ADDR_WIDTH-1:0] shadow_final_write_index,
+  input  logic [SHADOW_ADDR_WIDTH:0] shadow_valid_count,
+  input  logic [31:0] shadow_total_events,
+  input  logic [31:0] shadow_false_nack_count,
+  input  logic [31:0] shadow_real_nack_count,
+  input  logic [31:0] shadow_invalid_window_count,
+  output logic        shadow_read_enable,
+  output logic [SHADOW_ADDR_WIDTH-1:0] shadow_read_address,
+  input  logic [255:0] shadow_read_data,
+
+  input  logic [735:0] nvp_detail
+);
+  localparam logic [16:0] DIAG_STATUS_BASE  = 17'h02000;
+  localparam logic [16:0] DIAG_STATUS_END   = 17'h02100;
+  localparam logic [16:0] DIAG_TRACE_BASE   = 17'h03000;
+  localparam logic [16:0] DIAG_TRACE_END    = 17'h0B000;
+  localparam logic [16:0] DIAG_CONTEXT_BASE = 17'h0B000;
+  localparam logic [16:0] DIAG_CONTEXT_END  = 17'h0D000;
+  localparam logic [16:0] DIAG_SHADOW_BASE  = 17'h0D000;
+  localparam logic [16:0] DIAG_SHADOW_END   = 17'h0F000;
+  localparam logic [31:0] DIAG_MAGIC = 32'h4E565052; // "NVPR"
+  localparam logic [31:0] DIAG_SCHEMA_VERSION = 32'h00030000;
+  // bit0 ephemeral, bit1 not-release-candidate, bit2 functional ACK experiment.
+  // Host writes remain unnecessary and have no state effect.
+  localparam logic [31:0] DIAG_FLAGS = 32'h00000007;
+
+  wire status_select = host_req_addr >= DIAG_STATUS_BASE && host_req_addr < DIAG_STATUS_END;
+  wire trace_select = host_req_addr >= DIAG_TRACE_BASE && host_req_addr < DIAG_TRACE_END;
+  wire context_select = host_req_addr >= DIAG_CONTEXT_BASE && host_req_addr < DIAG_CONTEXT_END;
+  wire shadow_select = host_req_addr >= DIAG_SHADOW_BASE && host_req_addr < DIAG_SHADOW_END;
+  wire diag_select = status_select || trace_select || context_select || shadow_select;
+
+  wire [16:0] trace_byte_offset = host_req_addr - DIAG_TRACE_BASE;
+  wire [TRACE_ADDR_WIDTH-1:0] logical_trace_index = trace_byte_offset[TRACE_ADDR_WIDTH+2:3];
+  wire [16:0] context_byte_offset = host_req_addr - DIAG_CONTEXT_BASE;
+  wire [CONTEXT_ADDR_WIDTH-1:0] logical_context_index = context_byte_offset[CONTEXT_ADDR_WIDTH+3:4];
+  wire [16:0] shadow_byte_offset = host_req_addr - DIAG_SHADOW_BASE;
+  wire [SHADOW_ADDR_WIDTH-1:0] logical_shadow_index = shadow_byte_offset[SHADOW_ADDR_WIDTH+4:5];
+
+  logic diag_rsp_valid;
+  logic [31:0] diag_rsp_rdata;
+  logic [1:0] read_wait;
+  logic [1:0] read_kind;
+  logic [2:0] read_word_select;
+
+  function automatic [31:0] status_read(input [7:0] offset);
+    begin
+      case (offset)
+        8'h00: status_read = DIAG_MAGIC;
+        8'h04: status_read = DIAG_SCHEMA_VERSION;
+        8'h08: status_read = DIAG_FLAGS;
+        8'h0C: status_read = {27'b0, trace_overflow, trace_full, trace_frozen, trace_triggered, !trace_frozen};
+        8'h10: status_read = {30'b0, trace_trigger_reason};
+        8'h14: status_read = TRACE_SAMPLE_CLOCK_HZ;
+        8'h18: status_read = TRACE_DEPTH;
+        8'h1C: status_read = TRACE_SAMPLE_WIDTH_BITS;
+        8'h20: status_read = TRACE_PRE_TRIGGER_COUNT;
+        8'h24: status_read = TRACE_POST_TRIGGER_COUNT;
+        8'h28: status_read = TRACE_PRE_TRIGGER_COUNT;
+        8'h2C: status_read = {{(32-TRACE_ADDR_WIDTH){1'b0}}, trace_final_write_index};
+        8'h30: status_read = {31'b0, trace_overflow};
+        8'h34: status_read = BASE_COMMIT_W0;
+        8'h38: status_read = BASE_COMMIT_W1;
+        8'h3C: status_read = BASE_COMMIT_W2;
+        8'h40: status_read = BASE_COMMIT_W3;
+        8'h44: status_read = BASE_COMMIT_W4;
+        8'h48: status_read = PATCH_SHA_W0;
+        8'h4C: status_read = PATCH_SHA_W1;
+        8'h50: status_read = PATCH_SHA_W2;
+        8'h54: status_read = PATCH_SHA_W3;
+        8'h58: status_read = PATCH_SHA_W4;
+        8'h5C: status_read = PATCH_SHA_W5;
+        8'h60: status_read = PATCH_SHA_W6;
+        8'h64: status_read = PATCH_SHA_W7;
+        8'h68: status_read = {31'b0, nvp_detail[80]};
+        8'h6C: status_read = {24'b0, nvp_detail[95:88]};
+        8'h70: status_read = {24'b0, nvp_detail[103:96]};
+        8'h74: status_read = {24'b0, nvp_detail[111:104]};
+        8'h78: status_read = {24'b0, nvp_detail[191:184]};
+        8'h7C: status_read = {24'b0, nvp_detail[119:112]};
+        8'h80: status_read = {24'b0, nvp_detail[127:120]};
+        8'h84: status_read = {{(31-TRACE_ADDR_WIDTH){1'b0}}, trace_valid_count};
+        8'h88: status_read = {{(32-TRACE_ADDR_WIDTH){1'b0}}, trace_trigger_index_physical};
+        8'h8C: status_read = HALF_PHASE_CYCLES;
+        8'h90: status_read = MID_HIGH_OFFSET_CYCLES;
+        8'h94: status_read = CONTEXT_DEPTH;
+        8'h98: status_read = CONTEXT_SAMPLE_WIDTH_BITS;
+        8'h9C: status_read = {27'b0, context_overflow, context_full, context_frozen, |context_trigger_reason, !context_frozen};
+        8'hA0: status_read = {30'b0, context_trigger_reason};
+        8'hA4: status_read = {{(31-CONTEXT_ADDR_WIDTH){1'b0}}, context_valid_count};
+        8'hA8: status_read = {{(32-CONTEXT_ADDR_WIDTH){1'b0}}, context_final_write_index};
+        8'hAC: status_read = context_total_ticks;
+        8'hB0: status_read = SHADOW_DEPTH;
+        8'hB4: status_read = SHADOW_SAMPLE_WIDTH_BITS;
+        8'hB8: status_read = {27'b0, shadow_overflow, shadow_full, shadow_frozen, |shadow_trigger_reason, !shadow_frozen};
+        8'hBC: status_read = {30'b0, shadow_trigger_reason};
+        8'hC0: status_read = {{(31-SHADOW_ADDR_WIDTH){1'b0}}, shadow_valid_count};
+        8'hC4: status_read = {{(32-SHADOW_ADDR_WIDTH){1'b0}}, shadow_final_write_index};
+        8'hC8: status_read = shadow_total_events;
+        8'hCC: status_read = shadow_false_nack_count;
+        8'hD0: status_read = shadow_real_nack_count;
+        8'hD4: status_read = shadow_invalid_window_count;
+        8'hD8: status_read = {15'b0, DIAG_CONTEXT_BASE};
+        8'hDC: status_read = {15'b0, DIAG_SHADOW_BASE};
+        default: status_read = 32'b0;
+      endcase
+    end
+  endfunction
+
+  assign formal_req_valid = host_req_valid && !diag_select;
+  assign formal_req_write = host_req_write;
+  assign formal_req_addr = host_req_addr;
+  assign formal_req_wdata = host_req_wdata;
+  assign formal_req_be = host_req_be;
+  assign host_req_ready = diag_select ? (!diag_rsp_valid && read_wait == 0) : formal_req_ready;
+  assign host_rsp_valid = diag_rsp_valid || formal_rsp_valid;
+  assign host_rsp_rdata = diag_rsp_valid ? diag_rsp_rdata : formal_rsp_rdata;
+  assign formal_rsp_ready = host_rsp_ready && !diag_rsp_valid;
+
+  always_ff @(posedge clk) begin
+    if (reset) begin
+      diag_rsp_valid <= 1'b0;
+      diag_rsp_rdata <= 32'b0;
+      read_wait <= 2'd0;
+      read_kind <= 2'd0;
+      read_word_select <= 3'd0;
+      trace_read_enable <= 1'b0;
+      trace_read_address <= '0;
+      context_read_enable <= 1'b0;
+      context_read_address <= '0;
+      shadow_read_enable <= 1'b0;
+      shadow_read_address <= '0;
+    end else begin
+      trace_read_enable <= 1'b0;
+      context_read_enable <= 1'b0;
+      shadow_read_enable <= 1'b0;
+      if (diag_rsp_valid && host_rsp_ready) diag_rsp_valid <= 1'b0;
+
+      if (read_wait != 0) begin
+        if (read_wait == 1) begin
+          read_wait <= 2'd0;
+          case (read_kind)
+            2'd1: diag_rsp_rdata <= read_word_select[0] ? trace_read_data[63:32] : trace_read_data[31:0];
+            2'd2: case (read_word_select[1:0])
+                    2'd0: diag_rsp_rdata <= context_read_data[31:0];
+                    2'd1: diag_rsp_rdata <= context_read_data[63:32];
+                    2'd2: diag_rsp_rdata <= context_read_data[95:64];
+                    default: diag_rsp_rdata <= context_read_data[127:96];
+                  endcase
+            2'd3: case (read_word_select)
+                    3'd0: diag_rsp_rdata <= shadow_read_data[31:0];
+                    3'd1: diag_rsp_rdata <= shadow_read_data[63:32];
+                    3'd2: diag_rsp_rdata <= shadow_read_data[95:64];
+                    3'd3: diag_rsp_rdata <= shadow_read_data[127:96];
+                    3'd4: diag_rsp_rdata <= shadow_read_data[159:128];
+                    3'd5: diag_rsp_rdata <= shadow_read_data[191:160];
+                    3'd6: diag_rsp_rdata <= shadow_read_data[223:192];
+                    default: diag_rsp_rdata <= shadow_read_data[255:224];
+                  endcase
+            default: diag_rsp_rdata <= 32'b0;
+          endcase
+          diag_rsp_valid <= 1'b1;
+        end else read_wait <= read_wait - 1'b1;
+      end
+
+      if (host_req_valid && host_req_ready && diag_select) begin
+        if (host_req_write) begin
+          // Explicit no-op: no state effect and no forwarding.
+        end else if (host_req_addr[1:0] != 2'b00) begin
+          diag_rsp_rdata <= 32'b0;
+          diag_rsp_valid <= 1'b1;
+        end else if (status_select) begin
+          diag_rsp_rdata <= status_read(host_req_addr[7:0]);
+          diag_rsp_valid <= 1'b1;
+        end else if (trace_select && trace_frozen && trace_full) begin
+          trace_read_address <= trace_final_write_index + 1'b1 + logical_trace_index;
+          trace_read_enable <= 1'b1;
+          read_kind <= 2'd1;
+          read_word_select <= {2'b00, host_req_addr[2]};
+          read_wait <= 2'd2;
+        end else if (context_select && context_frozen && logical_context_index < context_valid_count) begin
+          context_read_address <= context_full ? context_final_write_index + 1'b1 + logical_context_index : logical_context_index;
+          context_read_enable <= 1'b1;
+          read_kind <= 2'd2;
+          read_word_select <= {1'b0, host_req_addr[3:2]};
+          read_wait <= 2'd2;
+        end else if (shadow_select && shadow_frozen && logical_shadow_index < shadow_valid_count) begin
+          shadow_read_address <= shadow_full ? shadow_final_write_index + 1'b1 + logical_shadow_index : logical_shadow_index;
+          shadow_read_enable <= 1'b1;
+          read_kind <= 2'd3;
+          read_word_select <= host_req_addr[4:2];
+          read_wait <= 2'd2;
+        end else begin
+          diag_rsp_rdata <= 32'b0;
+          diag_rsp_valid <= 1'b1;
+        end
+      end
+    end
+  end
+
+  logic [35:0] unused_diag_write_payload;
+  assign unused_diag_write_payload = {host_req_wdata, host_req_be};
+endmodule
