+
+  task automatic set_r2(
+      input [7:0] phase, input [7:0] operation, input [7:0] slot,
+      input [7:0] tx, input [7:0] reg_addr, input [7:0] value,
+      input bit sda_level, input bit scl_level,
+      input bit sda_drive, input bit scl_drive,
+      input bit tick, input bit ack_strobe, input bit ack_used,
+      input bit first_nack, input bit done, input bit error);
+    begin
+      r2_sample = '0;
