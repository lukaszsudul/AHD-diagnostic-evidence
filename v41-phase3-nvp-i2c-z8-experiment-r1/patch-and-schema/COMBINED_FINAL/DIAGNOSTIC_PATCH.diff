+EXPECTED_MAGIC = 0x4E565052
+EXPECTED_SCHEMA = 0x00030000
+EXPECTED_FLAGS = 0x00000007
+EXPECTED_HOSTNAME = "VCDE-DUT-1"
+EXPECTED_IP = "10.132.1.111"
