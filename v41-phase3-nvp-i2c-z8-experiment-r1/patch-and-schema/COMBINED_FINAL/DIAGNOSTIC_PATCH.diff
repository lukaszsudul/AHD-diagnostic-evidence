 architecture rtl of nvp_i2c_bringup_seq_v38ek is
   constant DIVIDER : positive := CLK_HZ / (I2C_HZ * 2);
+  -- The tick counter is inclusive (0..DIVIDER), so one functional half phase
+  -- is DIVIDER+1 clocks.  Z8 samples at the exact integer midpoint without
+  -- adding a state, tick, delay or SCL pulse.
