+      // mode 2: invalid because SCL never qualifies HIGH.
+      for (cycle = 1; cycle <= HALF; cycle = cycle + 1) begin
+        sda = (shadow_mode == 0) ? (cycle < 2) : 1'b1;
+        scl = (shadow_mode == 2) ? 1'b0 : (cycle >= 2);
+        @(negedge clk);
+        set_r2(phase, operation, slot, tx, reg_addr, value,
+               sda, scl, 1'b0, 1'b0, cycle == HALF,
+               1'b0, (cycle == HALF) ? z8_consumed_ack : original_r1_ack,
+               (cycle == HALF) ? first_nack : 1'b0, 1'b0, 1'b0);
+        r2_sample[28] = 1'b1;
+        r2_sample[29] = (cycle == MID);
+        r2_sample[30] = (cycle >= MID) && (shadow_mode != 2);
+        r2_sample[31] = (cycle == HALF);
+        r2_sample[200] = (cycle >= MID) && (shadow_mode != 2);
+        trace_sample[10] = (cycle == HALF) ? first_nack : 1'b0;
+        trace_sample[11] = (cycle == HALF) ? first_nack : 1'b0;
+        @(posedge clk);
+      end
+      @(negedge clk);
+      r2_sample[8] = 1'b0;
+    end
+  endtask
+
+  task automatic host_read(input [16:0] address, output [31:0] value);
+    begin
+      @(negedge clk);
+      host_req_addr = address;
+      host_req_write = 1'b0;
+      host_req_valid = 1'b1;
+      while (!host_req_ready) @(negedge clk);
+      @(posedge clk);
+      @(negedge clk);
+      host_req_valid = 1'b0;
+      while (!host_rsp_valid) @(posedge clk);
+      value = host_rsp_rdata;
+      @(negedge clk);
+    end
+  endtask
+
+  task automatic host_write(input [16:0] address, input [31:0] value);
+    begin
+      @(negedge clk);
+      host_req_addr = address;
+      host_req_wdata = value;
+      host_req_be = 4'hF;
+      host_req_write = 1'b1;
+      host_req_valid = 1'b1;
+      while (!host_req_ready) @(negedge clk);
+      @(posedge clk);
+      @(negedge clk);
+      host_req_valid = 1'b0;
+      host_req_write = 1'b0;
+      host_req_be = 4'h0;
+    end
+  endtask
+
+  task automatic shadow_word(input integer index, output [255:0] value);
+    integer w;
+    reg [31:0] rd;
+    begin
+      value = '0;
+      for (w = 0; w < 8; w = w + 1) begin
+        host_read(17'h0D000 + index * 32 + w * 4, rd);
+        value[w*32 +: 32] = rd;
+      end
+    end
+  endtask
+
+  task automatic context_word_read(input integer index, output [127:0] value);
+    integer w;
+    reg [31:0] rd;
+    begin
+      value = '0;
+      for (w = 0; w < 4; w = w + 1) begin
+        host_read(17'h0B000 + index * 16 + w * 4, rd);
+        value[w*32 +: 32] = rd;
+      end
+    end
+  endtask
+
+  task automatic reset_capture;
+    integer i;
+    begin
+      capture_reset = 1'b1;
+      r2_sample = '0;
+      trace_sample = '0;
+      repeat (3) @(posedge clk);
+      capture_reset = 1'b0;
+      // Make the high-resolution ring full before the scientific event.
+      for (i = 0; i < TRACE_DEPTH + 2; i = i + 1) @(posedge clk);
+    end
+  endtask
+
+  integer timeout;
+  reg [31:0] rd;
+  reg [255:0] event_word;
+  reg [127:0] ctx_word;
+  reg [255:0] retained_event;
+  initial begin
+    repeat (4) @(posedge clk);
+    host_reset = 1'b0;
+    reset_capture();
+
+    // All four ACK paths receive a slave ACK only during real SCL-HIGH.  The
+    // original R1 instant would report NACK; Z8 consumes the midpoint ACK.
+    ack_event(8'h01, 8'h01, 8'h01, 8'h60, 8'hFF, 8'h00, 1'b0, 0, 1'b1, 1'b0);
+    ack_event(8'h02, 8'h01, 8'h01, 8'hFF, 8'hFF, 8'h00, 1'b0, 0, 1'b1, 1'b0);
+    ack_event(8'h03, 8'h01, 8'h01, 8'h00, 8'hFF, 8'h00, 1'b0, 0, 1'b1, 1'b0);
+    ack_event(8'h04, 8'h02, 8'h02, 8'h61, 8'h48, 8'h00, 1'b0, 0, 1'b1, 1'b0);
+    // A real correct-phase NACK remains NACK under Z8 and freezes the rings.
+    ack_event(8'h02, 8'h2A, 8'h2A, 8'h48, 8'h48, 8'h00, 1'b0, 1, 1'b0, 1'b1);
+
+    timeout = 0;
+    while ((!shadow_frozen || !context_frozen || !trace_frozen) && timeout < 40) begin
+      @(posedge clk);
+      timeout = timeout + 1;
+    end
+    if (!shadow_frozen || shadow_trigger_reason != 1 || shadow_total_events != 5)
+      $fatal(1, "shadow first-NACK freeze/count failed");
+    if (shadow_false_nack_count != 0 || shadow_real_nack_count != 1 ||
+        shadow_invalid_window_count != 0 || shadow_overflow)
+      $fatal(1, "Z8 real-NACK classification counters failed");
+    if (!context_frozen || context_trigger_reason != 1 || context_valid_count < 5)
+      $fatal(1, "context first-NACK capture failed");
+
+    host_read(17'h02000, rd);
+    if (rd != 32'h4E565052) $fatal(1, "R2 diagnostic magic mismatch");
+    host_read(17'h0208C, rd);
+    if (rd != HALF) $fatal(1, "half-phase identity mismatch");
+    host_read(17'h00000, rd);
+    if (rd != 32'hA40A0C07) $fatal(1, "formal path changed");
+    // Event zero proves original-R1 NACK versus consumed midpoint ACK.
+    shadow_word(0, event_word);
+    if (event_word[81] != 1'b1 || event_word[94] != 1'b0 ||
+        !event_word[89] || event_word[106] != 1'b0 || event_word[95])
+      $fatal(1, "Z8 corrected ACK event mismatch: %h", event_word);
+    // Event four is the real digital NACK that triggered the frozen capture.
+    shadow_word(4, event_word);
+    if (event_word[39:32] != 8'h02 || event_word[23:16] != 8'h2A ||
+        event_word[81] != 1'b0 || event_word[82] != 1'b1 ||
+        !event_word[89] || event_word[106] != 1'b1 || event_word[252] ||
+        !event_word[253] || event_word[254] || !event_word[93] || event_word[95])
+      $fatal(1, "Z8 real-NACK event record mismatch: %h", event_word);
+    retained_event = event_word;
+    context_word_read(context_valid_count-1, ctx_word);
+    if (!ctx_word[84] || ctx_word[82] || ctx_word[83])
+      $fatal(1, "context trigger row mismatch: %h", ctx_word);
+
+    // Diagnostic write has no effect; PCIe user_reset cannot alter frozen data.
+    host_write(17'h02000, 32'hDEADBEEF);
+    host_read(17'h02000, rd);
+    if (rd != 32'h4E565052) $fatal(1, "diagnostic write changed identity");
+    host_reset = 1'b1;
+    repeat (4) @(posedge clk);
+    if (!shadow_frozen || !context_frozen) $fatal(1, "host reset altered metadata");
+    host_reset = 1'b0;
+    repeat (2) @(posedge clk);
+    shadow_word(4, event_word);
+    if (event_word != retained_event) $fatal(1, "host reset altered shadow BRAM");
+
+    // A real correct-phase NACK is independently classified.
+    reset_capture();
+    ack_event(8'h01, 8'h0E, 8'h0E, 8'h60, 8'h48, 8'h00, 1'b0, 1, 1'b0, 1'b1);
+    repeat (3) @(posedge clk);
+    if (!shadow_frozen || shadow_real_nack_count != 1 ||
+        shadow_false_nack_count != 0 || shadow_invalid_window_count != 0)
+      $fatal(1, "real digital NACK classification failed");
+
+    // SCL-never-high produces an invalid ACK window, not ACK or NACK evidence.
+    reset_capture();
+    ack_event(8'h03, 8'h13, 8'h13, 8'hAA, 8'h48, 8'hAA, 1'b0, 2, 1'b0, 1'b1);
+    repeat (3) @(posedge clk);
+    if (!shadow_frozen || shadow_invalid_window_count != 1 ||
+        shadow_false_nack_count != 0 || shadow_real_nack_count != 0)
+      $fatal(1, "invalid SCL-high window classification failed");
+
+    // Clean all-ACK completion freezes both observer layers with reason 2.
+    reset_capture();
+    ack_event(8'h01, 8'h01, 8'h01, 8'h60, 8'h00, 8'h00, 1'b0, 0, 1'b1, 1'b0);
+    @(negedge clk);
+    set_r2(8'h00, 8'h01, 8'h01, 8'h00, 8'h00, 8'h00,
+           1'b1, 1'b1, 1'b0, 1'b0, 1'b0, 1'b0, 1'b1, 1'b0, 1'b1, 1'b0);
+    trace_sample[52] = 1'b1;
+    trace_sample[53] = 1'b0;
+    repeat (TRACE_POST + 4) @(posedge clk);
+    if (!shadow_frozen || shadow_trigger_reason != 2 ||
+        !context_frozen || context_trigger_reason != 2 ||
+        !trace_frozen || trace_trigger_reason != 2)
+      $fatal(1, "all-ACK completion fallback failed");
+
+    $display("PASS Z8 all four midpoint ACK paths, real/invalid classification, unchanged R2 context/read-only windows, and PCIe-reset retention");
+    $finish;
+  end
+endmodule
