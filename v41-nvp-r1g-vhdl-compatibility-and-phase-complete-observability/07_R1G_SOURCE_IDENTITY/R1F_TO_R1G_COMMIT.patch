From e112a5addb7ac62700a9a71af81bf368fad0bada Mon Sep 17 00:00:00 2001
From: lukaszsudul <103749296+lukaszsudul@users.noreply.github.com>
Date: Mon, 24 Aug 2026 18:36:11 +0200
Subject: [PATCH] Make R1f diagnostics compatible with production VHDL frontend

---
 rtl/nvp/nvp6134c_i2c_bringup.vhd | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/rtl/nvp/nvp6134c_i2c_bringup.vhd b/rtl/nvp/nvp6134c_i2c_bringup.vhd
index ff8ea1d..acde0bc 100644
--- a/rtl/nvp/nvp6134c_i2c_bringup.vhd
+++ b/rtl/nvp/nvp6134c_i2c_bringup.vhd
@@ -991,7 +991,11 @@ begin
               r1f_tx_nack_bitmap_r <= (others => '0');
               r1f_tx_nack_count_r <= (others => '0');
               r1f_tx_reg_r <= reg_addr;
-              r1f_tx_wdata_r <= write_data when is_read_op = '0' else x"00";
+              if is_read_op = '0' then
+                r1f_tx_wdata_r <= write_data;
+              else
+                r1f_tx_wdata_r <= x"00";
+              end if;
               r1f_tx_wdata_valid_r <= not is_read_op;
               if tx_kind_v = x"0" or tx_kind_v = x"1" then
                 -- ORIGINAL_BANK_READ discovers rather than requests a bank.
